<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wms.Web</RootNamespace>
    <UserSecretsId>4b8d3a42-cc08-411c-9a33-3c84ef8f4c19</UserSecretsId>
    <!-- CI overrides this with -p:Version=1.0.${{ github.run_number }} -->
    <Version>1.0.483</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Wms.Core\Wms.Core.csproj" />
    <ProjectReference Include="..\Wms.Data\Wms.Data.csproj" />
  </ItemGroup>
  <!--
    LatestPrNumber: CI passes -p:LatestPrNumber=<PR number from the squash-merge commit
    message>. When not supplied (local/dev builds), fall back to reading it straight out
    of the local git log so the sidebar badge still shows a real number instead of a
    placeholder.
  -->
  <Target Name="ComputeLatestPrNumber" BeforeTargets="GenerateAssemblyInfo" AfterTargets="PrepareForBuild">
    <Exec Condition="'$(LatestPrNumber)' == ''"
          Command="git log -1 --pretty=%25s"
          ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitLastCommitMessage" />
    </Exec>
    <PropertyGroup Condition="'$(LatestPrNumber)' == ''">
      <_ComputedPrNumber>$([System.Text.RegularExpressions.Regex]::Match($(_GitLastCommitMessage), '#(\d+)\)?$').Groups[1].Value)</_ComputedPrNumber>
      <LatestPrNumber Condition="'$(_ComputedPrNumber)' != ''">$(_ComputedPrNumber)</LatestPrNumber>
      <LatestPrNumber Condition="'$(LatestPrNumber)' == ''">unknown</LatestPrNumber>
    </PropertyGroup>
    <!-- Write straight into @(AssemblyAttribute) (what CoreGenerateAssemblyInfo actually
         reads) instead of @(AssemblyMetadata) — the SDK's own AssemblyMetadata-to-
         AssemblyAttribute conversion target runs at an unpredictable point relative to
         this one, so items added here to @(AssemblyMetadata) were silently missing the
         cutoff and never made it into the compiled assembly. -->
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>LatestPrNumber</_Parameter1>
        <_Parameter2>$(LatestPrNumber)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Web" Version="3.10.0" />
    <PackageReference Include="Microsoft.Identity.Web.UI" Version="3.5.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Azure.Identity" Version="1.13.1" />
    <PackageReference Include="MudBlazor" Version="7.15.0" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>
</Project>
