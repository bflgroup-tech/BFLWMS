@page "/robotic/chute-mapping"
@rendermode RenderMode.InteractiveServer
@using Wms.Core
@using Wms.Data.Robotic
@attribute [Authorize(Policy = MenuKeys.ROBOTIC_CHUTE_MAPPING)]
@inject ChuteMappingService Chute
@inject IJSRuntime JS
@inject ISnackbar Snack

<PageTitle>WMS — Chute Mapping</PageTitle>

<style>
    /* dark theme (default) */
    .chute-page {
        --card-bg:      #1e2130;
        --card-text:    #e2e8f0;
        --card-pending: #f87171;
        --card-label:   #64748b;
        --card-iborder: rgba(255,255,255,.07);
    }
    /* light theme overrides */
    html:not([data-theme="dark"]) .chute-page {
        --card-bg:      #ffffff;
        --card-text:    #1e293b;
        --card-pending: #dc2626;
        --card-label:   #64748b;
        --card-iborder: rgba(0,0,0,.1);
    }
    html:not([data-theme="dark"]) .chute-grid-wrap {
        --border: #94a3b8;
    }
    html:not([data-theme="dark"]) .chute-grid-wrap td,
    html:not([data-theme="dark"]) .chute-grid-wrap th {
        border-color: #94a3b8 !important;
    }
</style>

<div class="chute-page" style="display:flex;flex-direction:column;height:calc(100vh - 100px);overflow:hidden">

    <div class="aiwms-page-header" style="flex-shrink:0">
        <h2>Chute Mapping</h2>
        <p>Visual layout of all chute positions by section and direction.</p>
    </div>

    <div style="flex:1;min-height:0;display:flex;gap:8px;overflow:hidden">

        <div style="display:flex;flex-direction:column;width:490px;flex-shrink:0">
            <div style="display:flex;gap:6px;padding:8px 0 4px;flex-shrink:0">
                <input value="@_globalContainerNo" @oninput="OnContainerNoChanged" placeholder="Container Number" class="aiwms-input"
                       style="flex:1;min-width:0" />
                <button class="aiwms-btn aiwms-btn-primary" style="flex-shrink:0"
                        @onclick="LoadGlobalAsync">
                    Load
                </button>
                <button class="aiwms-btn" style="flex-shrink:0;white-space:nowrap;background:#f59e0b;color:#000"
                        disabled="@(!_containerLoaded)"
                        @onclick="AutoAllocateChuteAsync">
                    Auto Config
                </button>
            </div>
            <div style="display:flex;gap:6px;padding:0 0 6px;flex-shrink:0">
                <input @oninput="OnSearchInputAsync" value="@_searchTerm" placeholder="Search ID or Shop Name..." class="aiwms-input"
                       style="flex:1;min-width:0" />
                <button class="aiwms-btn aiwms-btn-secondary" style="flex-shrink:0;white-space:nowrap"
                        @onclick="RefreshAllAsync">
                    Refresh
                </button>
            </div>
            <div style="flex:1;min-height:0;overflow:auto;border:1px solid var(--border);border-radius:4px">
                @{
                    var displayNames = string.IsNullOrWhiteSpace(_searchTerm) || string.IsNullOrWhiteSpace(_globalContainerNo)
                        ? _shopNames
                        : _shopNames.Where(s =>
                            (s.RoboShopId?.ToString().Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                            (s.ShopName?.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();
                    displayNames = _sortQtyDesc switch
                    {
                        true  => displayNames.OrderByDescending(s => s.Qty).ToList(),
                        false => displayNames.OrderBy(s => s.Qty).ToList(),
                        null  => displayNames,
                    };
                }
                <table class="aiwms-table aiwms-table-dense">
                    <thead style="position:sticky;top:0;z-index:1">
                        <tr>
                            <th style="width:55px">ID</th>
                            <th style="width:260px;max-width:260px">Shop Name</th>
                            <th style="text-align:center;width:48px;cursor:pointer;user-select:none" @onclick="ToggleQtySort" title="Sort by Cont Qty">
                                Cont Qty @(_sortQtyDesc == null ? "" : _sortQtyDesc.Value ? "▼" : "▲")
                            </th>
                            <th style="text-align:center;width:38px">Existing Chutes</th>
                            <th style="text-align:center;width:42px">New Chutes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!displayNames.Any())
                        {
                            <tr><td colspan="5" style="color:var(--text-muted)">No results</td></tr>
                        }
                        @foreach (var s in displayNames)
                        {
                            var isRowSelected = _highlightShopId == s.RoboShopId?.ToString();
                            <tr draggable="true"
                                @ondragstart="@(() => { _dragShopId = s.RoboShopId?.ToString(); _dragShopName = s.ShopName ?? ""; })"
                                @onclick="@(() => ToggleHighlight(isRowSelected ? null : s.RoboShopId?.ToString()))"
                                style="cursor:grab;background:@(isRowSelected ? "#FFA500" : "")">
                                <td style="font-weight:600;white-space:nowrap;color:@(isRowSelected ? "#000" : "var(--text-muted)")">@s.RoboShopId</td>
                                <td style="font-weight:600;max-width:260px;word-break:break-word;white-space:normal;color:@(isRowSelected ? "#000" : "var(--text)")">@s.ShopName</td>
                                <td style="font-weight:600;text-align:center;color:@(isRowSelected ? "#000" : "var(--text-muted)")">@(s.Qty > 0 ? s.Qty.ToString() : "")</td>
                                <td style="font-weight:600;text-align:center;color:@(isRowSelected ? "#000" : "var(--text-muted)")">@GetAllocatedChutes(s.RoboShopId?.ToString())</td>
                                <td style="padding:2px 4px" @onclick:stopPropagation>
                                    <input type="text" value="@GetNewChuteInput(s.RoboShopId?.ToString())"
                                           @onchange="@(e => SetNewChuteInput(s.RoboShopId?.ToString(), e.Value?.ToString()))"
                                           class="aiwms-input" style="text-align:center;padding:3px 4px" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div style="display:flex;flex-direction:column;flex:1;min-width:0;overflow:hidden">

            <div style="flex-shrink:0;display:flex;align-items:center;gap:6px;padding:8px 0">
                @foreach (var opt in new[] { "Single", "Double" })
                {
                    var isActive = _layer == opt;
                    <button class="aiwms-btn @(isActive ? "aiwms-btn-primary" : "aiwms-btn-secondary")"
                            @onclick="@(() => ChangeLayerAsync(opt))">
                        @opt
                    </button>
                }
                <span style="width:1px;height:22px;background:var(--border);margin:0 2px"></span>
                @foreach (var dir in new[] { "UP", "DOWN" })
                {
                    var isDirActive = _direction == dir && _layer == "Double";
                    var isDisabled  = _layer == "Single";
                    <button class="aiwms-btn aiwms-btn-secondary" style="background:@(isDirActive ? "#FFA500" : ""); color:@(isDirActive ? "#000" : "")"
                            disabled="@isDisabled"
                            @onclick="@(() => { if (_layer == "Double") _direction = dir; })">
                        @dir
                    </button>
                }
                <label style="display:flex;align-items:center;gap:5px;font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap;margin-left:6px">
                    <input type="checkbox" @bind="_showDisabledOnly" style="cursor:pointer;width:14px;height:14px" />
                    Show disabled chutes (allow mapping changes)
                </label>
                <span style="flex:1"></span>
                <button class="aiwms-btn aiwms-btn-danger" style="white-space:nowrap"
                        @onclick="ClearAllOverrides">
                    Clear All@(_cellOverrides.Count > 0 ? $" ({_cellOverrides.Count})" : "")
                </button>
                <button class="aiwms-btn aiwms-btn-success" style="white-space:nowrap"
                        disabled="@_savingAll"
                        @onclick="SaveAllAsync">
                    @(_savingAll ? "Saving…" : $"Save All{(_cellOverrides.Count > 0 ? $" ({_cellOverrides.Count})" : "")}")
                </button>
            </div>

            @{
                var tableStyle = "border-collapse:collapse;font-size:12px;width:100%;table-layout:fixed";
                var showUp   = _layer != "Single" && (_direction == "UP"   || _direction == "BOTH");
                var showDown = _layer == "Single"  || _direction == "DOWN" || _direction == "BOTH";
                var cols     = Sections.Length * ((showUp ? 1 : 0) + (showDown ? 1 : 0));
                var colPct   = $"{100.0 / cols:F4}%";
                // When filter is on, pack each column's disabled cells to the top
                var _pc = new Dictionary<string, List<(string? Id, int? Status, string? ShopId, string? ShopName, string? TotId)>>();
                if (_showDisabledOnly)
                {
                    foreach (var _s in Sections)
                    {
                        if (showUp)   _pc[$"{_s}:UP"]   = RowNums.Select(r => GetCell(_s, r, "UP")  ).Where(c => c.Id != null && c.Status != 0).ToList();
                        if (showDown) _pc[$"{_s}:DOWN"] = RowNums.Select(r => GetCell(_s, r, "DOWN")).Where(c => c.Id != null && c.Status != 0).ToList();
                    }
                }
                int _pRows = _showDisabledOnly && _pc.Count > 0 ? _pc.Values.Max(v => v.Count) : RowNums.Length;
            }

            <div class="chute-grid-wrap" style="flex-shrink:0;overflow:hidden;scrollbar-gutter:stable">
                <table style="@tableStyle">
                    <colgroup>
                        @for (int i = 0; i < cols; i++) { <col style="width:@colPct" /> }
                    </colgroup>
                    <thead>
                        <tr>
                            @foreach (var sec in Sections)
                            {
                                var secSpan = (showUp ? 1 : 0) + (showDown ? 1 : 0);
                                <th colspan="@secSpan"
                                    style="text-align:center;height:36px;border:1px solid var(--border);
                                           background:#000;color:#fff;
                                           font-size:13px;font-weight:700;letter-spacing:1px;border-right:5px solid #555">
                                    @sec
                                </th>
                            }
                        </tr>
                    </thead>
                </table>
            </div>

            <div class="chute-grid-wrap" style="flex:1;min-height:0;overflow:auto;scrollbar-gutter:stable">
                <table style="@tableStyle">
                    <colgroup>
                        @for (int i = 0; i < cols; i++) { <col style="width:@colPct" /> }
                    </colgroup>
                    <tbody>
                        @for (int _ri = 0; _ri < _pRows; _ri++)
                        {
                            var _rowKey = _showDisabledOnly ? null : RowNums[_ri];
                            <tr>
                                @foreach (var sec in Sections)
                                {
                                    var up = _showDisabledOnly
                                        ? (_pc.TryGetValue($"{sec}:UP",   out var _ul) && _ri < _ul.Count ? _ul[_ri] : (null, null, null, null, null))
                                        : GetCell(sec, _rowKey!, "UP");
                                    var dn = _showDisabledOnly
                                        ? (_pc.TryGetValue($"{sec}:DOWN", out var _dl) && _ri < _dl.Count ? _dl[_ri] : (null, null, null, null, null))
                                        : GetCell(sec, _rowKey!, "DOWN");
                                    @if (showUp)
                                    {
                                        var upOvr    = up.Id != null && _cellOverrides.ContainsKey(up.Id) ? _cellOverrides[up.Id] : default;
                                        var upPend   = upOvr.ShopId != null;
                                        var upTxt    = upPend ? "var(--card-pending,#f87171)" : "var(--card-text,#e2e8f0)";
                                        var upAccent = up.Status == 0 ? "#22c55e" : "#ef4444";
                                        var upHl     = _highlightShopId != null && (upOvr.ShopId ?? up.ShopId) == _highlightShopId;
                                        <td @ondrop="@(async () => await OnDropOnCell(up.Id, up.Status))"
                                            style="border:1px solid var(--border);@(showDown ? "" : "border-right:5px solid #555;")
                                                   padding:5px;height:140px;cursor:default;background:var(--bg)">
                                            @if (up.Id != null)
                                            {
                                                <div style="height:100%;background:@(upHl ? "#FFA500" : "var(--card-bg,#1e2130)");border-radius:6px;
                                                            border:1px solid var(--card-iborder,rgba(255,255,255,.07));border-left:4px solid @upAccent;
                                                            padding:8px 10px;display:flex;flex-direction:column;box-sizing:border-box">
                                                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:2px">
                                                        <span style="font-size:13px;font-weight:700;color:@upTxt;font-family:Consolas,monospace;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@up.Id</span>
                                                        <div style="display:flex;gap:3px;flex-shrink:0;margin-left:4px">
                                                            <span style="font-size:9px;font-weight:700;padding:2px 6px;border-radius:3px;background:#0d9488;color:#fff;white-space:nowrap">UP</span>
                                                            <button class="aiwms-btn @(up.Status == 0 ? "aiwms-btn-danger" : "aiwms-btn-success")"
                                                                    style="font-size:9px;padding:2px 6px;border-radius:3px"
                                                                    @onclick="@(async () => await ToggleStatusAsync(up.Id, up.Status, up.ShopId, up.TotId))" @onclick:stopPropagation>
                                                                @(up.Status == 0 ? "Disable" : "Enable")
                                                            </button>
                                                        </div>
                                                    </div>
                                                    <div style="font-size:10px;color:var(--card-label,#64748b);margin-bottom:8px">@up.TotId</div>
                                                    <div style="display:flex;gap:10px;margin-bottom:3px">
                                                        <div style="font-size:9px;color:var(--card-label,#64748b);text-transform:uppercase;letter-spacing:.4px;white-space:nowrap">Shop ID</div>
                                                        <div style="font-size:9px;color:var(--card-label,#64748b);text-transform:uppercase;letter-spacing:.4px">Shop Name</div>
                                                    </div>
                                                    <div style="display:flex;gap:10px;flex:1;align-items:flex-start">
                                                        <div style="font-size:13px;font-weight:700;color:@upTxt;white-space:nowrap;min-width:36px">@(upOvr.ShopId ?? up.ShopId)</div>
                                                        <div style="font-size:12px;font-weight:700;color:@upTxt;word-break:break-word;white-space:normal;flex:1;line-height:1.3">@(upOvr.ShopName ?? up.ShopName)</div>
                                                    </div>
                                                    @if (up.Id != null && _cellSuccess.TryGetValue(up.Id, out var upOk))
                                                    {
                                                        <div style="font-size:9px;color:#4ade80;margin-top:4px;line-height:1.3">✓ @upOk</div>
                                                    }
                                                    @if (upPend)
                                                    {
                                                        @if (up.Id != null && _cellErrors.TryGetValue(up.Id, out var upErr))
                                                        {
                                                            <div style="font-size:9px;color:#f87171;margin-top:4px;line-height:1.3;word-break:break-word">⚠ @upErr</div>
                                                        }
                                                        <div style="display:flex;justify-content:flex-end;align-items:center;gap:6px;
                                                                    margin-top:4px;border-top:1px solid var(--card-iborder,rgba(255,255,255,.07));padding-top:5px">
                                                            <a @onclick="@(() => ClearOverride(up.Id))" @onclick:stopPropagation
                                                               style="font-size:10px;font-weight:700;color:#60a5fa;text-decoration:underline;cursor:pointer;margin-right:auto">Clear</a>
                                                            <button class="aiwms-btn aiwms-btn-success" style="font-size:10px;padding:3px 12px;border-radius:5px"
                                                                    disabled="@(_savingChuteId == up.Id)"
                                                                    @onclick="@(() => SaveCellAsync(up.Id))" @onclick:stopPropagation>
                                                                @(_savingChuteId == up.Id ? "Saving…" : "Save")
                                                            </button>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </td>
                                    }
                                    @if (showDown)
                                    {
                                        var dnOvr    = dn.Id != null && _cellOverrides.ContainsKey(dn.Id) ? _cellOverrides[dn.Id] : default;
                                        var dnPend   = dnOvr.ShopId != null;
                                        var dnTxt    = dnPend ? "var(--card-pending,#f87171)" : "var(--card-text,#e2e8f0)";
                                        var dnAccent = dn.Status == 0 ? "#22c55e" : "#ef4444";
                                        var dnHl     = _highlightShopId != null && (dnOvr.ShopId ?? dn.ShopId) == _highlightShopId;
                                        <td @ondrop="@(async () => await OnDropOnCell(dn.Id, dn.Status))"
                                            style="border:1px solid var(--border);border-right:5px solid #555;
                                                   padding:5px;height:140px;cursor:default;background:var(--bg)">
                                            @if (dn.Id != null)
                                            {
                                                <div style="height:100%;background:@(dnHl ? "#FFA500" : "var(--card-bg,#1e2130)");border-radius:6px;
                                                            border:1px solid var(--card-iborder,rgba(255,255,255,.07));border-left:4px solid @dnAccent;
                                                            padding:8px 10px;display:flex;flex-direction:column;box-sizing:border-box">
                                                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:2px">
                                                        <span style="font-size:13px;font-weight:700;color:@dnTxt;font-family:Consolas,monospace;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@dn.Id</span>
                                                        <div style="display:flex;gap:3px;flex-shrink:0;margin-left:4px">
                                                            <span style="font-size:9px;font-weight:700;padding:2px 6px;border-radius:3px;background:#7c3aed;color:#fff;white-space:nowrap">DOWN</span>
                                                            <button class="aiwms-btn @(dn.Status == 0 ? "aiwms-btn-danger" : "aiwms-btn-success")"
                                                                    style="font-size:9px;padding:2px 6px;border-radius:3px"
                                                                    @onclick="@(async () => await ToggleStatusAsync(dn.Id, dn.Status, dn.ShopId, dn.TotId))" @onclick:stopPropagation>
                                                                @(dn.Status == 0 ? "Disable" : "Enable")
                                                            </button>
                                                        </div>
                                                    </div>
                                                    <div style="font-size:10px;color:var(--card-label,#64748b);margin-bottom:8px">@dn.TotId</div>
                                                    <div style="display:flex;gap:10px;margin-bottom:3px">
                                                        <div style="font-size:9px;color:var(--card-label,#64748b);text-transform:uppercase;letter-spacing:.4px;white-space:nowrap">Shop ID</div>
                                                        <div style="font-size:9px;color:var(--card-label,#64748b);text-transform:uppercase;letter-spacing:.4px">Shop Name</div>
                                                    </div>
                                                    <div style="display:flex;gap:10px;flex:1;align-items:flex-start">
                                                        <div style="font-size:13px;font-weight:700;color:@dnTxt;white-space:nowrap;min-width:36px">@(dnOvr.ShopId ?? dn.ShopId)</div>
                                                        <div style="font-size:12px;font-weight:700;color:@dnTxt;word-break:break-word;white-space:normal;flex:1;line-height:1.3">@(dnOvr.ShopName ?? dn.ShopName)</div>
                                                    </div>
                                                    @if (dn.Id != null && _cellSuccess.TryGetValue(dn.Id, out var dnOk))
                                                    {
                                                        <div style="font-size:9px;color:#4ade80;margin-top:4px;line-height:1.3">✓ @dnOk</div>
                                                    }
                                                    @if (dnPend)
                                                    {
                                                        @if (dn.Id != null && _cellErrors.TryGetValue(dn.Id, out var dnErr))
                                                        {
                                                            <div style="font-size:9px;color:#f87171;margin-top:4px;line-height:1.3;word-break:break-word">⚠ @dnErr</div>
                                                        }
                                                        <div style="display:flex;justify-content:flex-end;align-items:center;gap:6px;
                                                                    margin-top:4px;border-top:1px solid var(--card-iborder,rgba(255,255,255,.07));padding-top:5px">
                                                            <a @onclick="@(() => ClearOverride(dn.Id))" @onclick:stopPropagation
                                                               style="font-size:10px;font-weight:700;color:#60a5fa;text-decoration:underline;cursor:pointer;margin-right:auto">Clear</a>
                                                            <button class="aiwms-btn aiwms-btn-success" style="font-size:10px;padding:3px 12px;border-radius:5px"
                                                                    disabled="@(_savingChuteId == dn.Id)"
                                                                    @onclick="@(() => SaveCellAsync(dn.Id))" @onclick:stopPropagation>
                                                                @(_savingChuteId == dn.Id ? "Saving…" : "Save")
                                                            </button>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>

<script>
    document.addEventListener('dragover', function (e) { e.preventDefault(); }, false);
    document.addEventListener('dragenter', function (e) { e.preventDefault(); }, false);
</script>

@code {
    private static readonly char[]   Sections = ['A','B','C','D','E'];
    private static readonly string[] RowNums  =
    [
        "001","002","003","004","005","006","007","008",
        "011","012","013","014","015","016","017","018"
    ];

    private string _layer     = "Single";
    private string _direction = "UP";
    private bool   _loading;
    private List<ChuteConfigRow> _rows = [];

    private Dictionary<char, Dictionary<string, Dictionary<string, (string Id, int? Status, string? ShopId, string? ShopName, string? TotId)>>> _grid = new();

    private static readonly System.Text.RegularExpressions.Regex _rx =
        new(@"([A-Ea-e])(\d{3})", System.Text.RegularExpressions.RegexOptions.Compiled);

    private string _globalContainerNo = "";
    private bool   _containerLoaded;
    private string _searchTerm        = "";
    private string? _dragShopId;
    private string  _dragShopName = "";
    private Dictionary<string, (string ShopId, string ShopName)> _cellOverrides = new();
    private Dictionary<string, int> _allocatedCounts = new();
    private CancellationTokenSource? _searchCts;
    private List<ShopNameRow> _shopNames = [];
    private string? _highlightShopId;
    private bool    _showDisabledOnly;
    private Dictionary<string, string> _cellErrors   = new();
    private Dictionary<string, string> _cellSuccess  = new();
    private string? _savingChuteId;
    private bool    _savingAll;
    private Dictionary<string, string> _newChuteInputs = new();
    private bool? _sortQtyDesc;

    private void OnContainerNoChanged(ChangeEventArgs e)
    {
        _globalContainerNo = e.Value?.ToString() ?? "";
        _containerLoaded = false;
    }

    private async Task LoadGlobalAsync()
    {
        if (string.IsNullOrWhiteSpace(_globalContainerNo)) return;
        _containerLoaded = await LoadShopNamesFromProcAsync();
        if (!_containerLoaded)
            Snack.Add($"Load failed for container {_globalContainerNo}.", Severity.Error);
    }

    // Default state (no container loaded yet): straight list from BFLDATA.dbo.DataSettings.
    private async Task LoadShopNamesAsync()
    {
        try { _shopNames = await Chute.GetAllShopNamesAsync(); }
        catch { _shopNames = []; }
    }

    // Only once "Load" is pressed with a container number: per-container list + Qty from the stored procedure.
    private async Task<bool> LoadShopNamesFromProcAsync()
    {
        try { _shopNames = await Chute.GetShopNamesForContainerAsync(_globalContainerNo); return true; }
        catch { _shopNames = []; return false; }
    }

    // Refresh button: clears the Container Number and Search boxes, reloads the full
    // shop list, and reloads the chute grid — a full reset back to the default view.
    private async Task RefreshAllAsync()
    {
        _globalContainerNo = "";
        _containerLoaded   = false;
        _searchTerm        = "";
        await LoadShopNamesAsync();
        await LoadAsync();
    }

    private async Task OnSearchInputAsync(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? "";
        StateHasChanged();

        // When container is loaded, filter happens in-memory — no DB call needed
        if (!string.IsNullOrWhiteSpace(_globalContainerNo)) return;

        // Search cleared → reload default list from DataSettings
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            await LoadShopNamesAsync();
            StateHasChanged();
            return;
        }

        // Container is empty + search term → search DataSettings with debounce
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(400, token);
            _shopNames = await Chute.SearchShopsAsync(_searchTerm, token);
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
        catch { _shopNames = []; StateHasChanged(); }
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadAsync(), LoadShopNamesAsync());
    }

    private async Task ChangeLayerAsync(string layer)
    {
        _layer = layer;
        if (layer == "Double") _direction = "UP";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _rows    = [];
        _grid    = new();
        StateHasChanged();
        try
        {
            int layerNum = _layer == "Double" ? 2 : 1;
            var gridTask   = Chute.GetChuteConfigAsync(layerNum);
            var countTask  = Chute.GetAllocatedChuteCountsAsync();
            await Task.WhenAll(gridTask, countTask);
            _rows            = gridTask.Result;
            _allocatedCounts = countTask.Result;
            BuildGrid();
        }
        catch (Exception ex)
        {
            Snack.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void BuildGrid()
    {
        foreach (var row in _rows)
        {
            if (row.ChuteId is null) continue;
            var m = _rx.Match(row.ChuteId);
            if (!m.Success) continue;
            char   sec    = char.ToUpper(m.Groups[1].Value[0]);
            string rowNum = m.Groups[2].Value;
            string dir    = string.Equals(row.Direction, "DOWN", StringComparison.OrdinalIgnoreCase) ? "DOWN" : "UP";
            if (!_grid.ContainsKey(sec))         _grid[sec]         = new();
            if (!_grid[sec].ContainsKey(rowNum)) _grid[sec][rowNum] = new();
            _grid[sec][rowNum][dir] = (row.ChuteId, row.Status, row.ShopId, row.ShopName, row.TotId);
        }
    }

    private (string? Id, int? Status, string? ShopId, string? ShopName, string? TotId) GetCell(char section, string row, string direction)
    {
        if (_grid.TryGetValue(section, out var s) &&
            s.TryGetValue(row, out var r) &&
            r.TryGetValue(direction, out var cell))
            return cell;
        return (null, null, null, null, null);
    }

    private async Task SaveCellAsync(string? chuteId)
    {
        if (chuteId == null || !_cellOverrides.TryGetValue(chuteId, out var ovr)) return;
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Save mapping for chute {chuteId}?");
        if (!confirmed) return;
        _savingChuteId = chuteId;
        _cellErrors.Remove(chuteId);
        _cellSuccess.Remove(chuteId);
        StateHasChanged();
        try
        {
            var msg = await Chute.SaveChuteMappingAsync(chuteId, ovr.ShopId, ovr.ShopName);
            _cellOverrides.Remove(chuteId);
            _cellErrors.Remove(chuteId);
            _cellSuccess[chuteId] = msg;
            _savingChuteId = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _cellErrors[chuteId] = ex.Message;
            Snack.Add($"Save failed [{chuteId}]: {ex.Message}", Severity.Error);
            _savingChuteId = null;
            StateHasChanged();
        }
    }

    private string GetAllocatedChutes(string? shopId)
    {
        if (string.IsNullOrEmpty(shopId)) return "";
        int db = _allocatedCounts.TryGetValue(shopId, out var c) ? c : 0;

        int delta = 0;
        foreach (var kv in _cellOverrides)
        {
            // Chute is being reassigned TO this shop
            if (kv.Value.ShopId == shopId) delta++;

            // Chute was originally FROM this shop and is being moved away
            var orig = _rows.FirstOrDefault(r => r.ChuteId == kv.Key);
            if (orig?.ShopId == shopId && kv.Value.ShopId != shopId) delta--;
        }

        int total = db + delta;
        return total > 0 ? total.ToString() : "";
    }

    private string GetNewChuteInput(string? shopId) =>
        shopId != null && _newChuteInputs.TryGetValue(shopId, out var v) ? v : "0";

    private void SetNewChuteInput(string? shopId, string? value)
    {
        if (shopId == null) return;
        if (string.IsNullOrWhiteSpace(value)) _newChuteInputs.Remove(shopId);
        else _newChuteInputs[shopId] = value;
    }

    private void ToggleQtySort()
    {
        // Cycle: no sort -> descending -> ascending -> no sort
        _sortQtyDesc = _sortQtyDesc switch
        {
            null  => true,
            true  => false,
            false => null,
        };
    }

    private void ClearOverride(string? chuteId)
    {
        if (chuteId != null) _cellOverrides.Remove(chuteId);
    }

    private async Task OnDropOnCell(string? chuteId, int? status)
    {
        if (chuteId == null || _dragShopId == null) return;
        if (status == 0)
        {
            Snack.Add("This chute is currently enabled. Please disable it before reassigning.", Severity.Warning);
            _dragShopId = null;
            StateHasChanged();
            return;
        }
        try
        {
            var pendingQty = await Chute.GetChutePendingQtyAsync(chuteId);
            if (pendingQty > 0)
            {
                Snack.Add($"This chute has {pendingQty} pending item(s) not yet transferred. Please clear them before reassigning.", Severity.Warning);
                _dragShopId = null;
                StateHasChanged();
                return;
            }
        }
        catch
        {
            Snack.Add("Unable to verify pending items. Please try again.", Severity.Warning);
            _dragShopId = null;
            StateHasChanged();
            return;
        }
        _cellOverrides[chuteId] = (_dragShopId, _dragShopName);
        _dragShopId = null;
        _highlightShopId = null;
        StateHasChanged();
    }

    private async Task ToggleStatusAsync(string? chuteId, int? currentStatus, string? shopId, string? totId)
    {
        if (chuteId == null) return;
        var enabling = currentStatus != 0;
        if (enabling && string.IsNullOrEmpty(shopId))
        {
            Snack.Add($"Cannot enable {chuteId}: Shop ID is not assigned.", Severity.Error);
            return;
        }
        if (enabling && string.IsNullOrEmpty(totId))
        {
            Snack.Add($"Cannot enable {chuteId}: Tote ID is not assigned.", Severity.Error);
            return;
        }
        var action = currentStatus == 0 ? "disable" : "enable";
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to {action} chute {chuteId}?");
        if (!confirmed) return;
        try
        {
            await Chute.ToggleChuteStatusAsync(chuteId, currentStatus ?? 0);
            await LoadAsync();
        }
        catch (Exception ex) { Snack.Add(ex.Message, Severity.Error); }
    }

    private void ToggleHighlight(string? shopId)
    {
        _highlightShopId = _highlightShopId == shopId ? null : shopId;
    }

    private async Task AutoAllocateChuteAsync()
    {
        if (!_showDisabledOnly)
        {
            Snack.Add("Please tick \"Show disabled chutes (allow mapping changes)\" before running Auto Config.", Severity.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(_globalContainerNo)) return;

        await LoadShopNamesFromProcAsync();
        StateHasChanged();

        var shops = _shopNames.Where(s => s.RoboShopId != null).ToList();
        if (shops.Count == 0)
        {
            Snack.Add("No shops found for this container.", Severity.Warning);
            return;
        }

        // Same visibility rules as the grid: which UP/DOWN columns are currently shown.
        var showUp   = _layer != "Single" && (_direction == "UP"   || _direction == "BOTH");
        var showDown = _layer == "Single"  || _direction == "DOWN" || _direction == "BOTH";

        // Disabled, unassigned chutes in on-screen order (Section -> Row -> Direction) — the drop targets.
        var freeCells = new List<string>();
        foreach (var sec in Sections)
        foreach (var row in RowNums)
        {
            if (showUp)
            {
                var up = GetCell(sec, row, "UP");
                if (up.Id != null && up.Status != 0 && !_cellOverrides.ContainsKey(up.Id))
                    freeCells.Add(up.Id);
            }
            if (showDown)
            {
                var dn = GetCell(sec, row, "DOWN");
                if (dn.Id != null && dn.Status != 0 && !_cellOverrides.ContainsKey(dn.Id))
                    freeCells.Add(dn.Id);
            }
        }

        // Randomize so multiple chutes for the same shop land in different sections/rows,
        // instead of always the next consecutive cells in grid order.
        for (int i = freeCells.Count - 1; i > 0; i--)
        {
            int j = Random.Shared.Next(i + 1);
            (freeCells[i], freeCells[j]) = (freeCells[j], freeCells[i]);
        }

        int cellIdx = 0;
        foreach (var shop in shops)
        {
            var shopId = shop.RoboShopId!.ToString()!;
            int want = int.TryParse(GetNewChuteInput(shopId), out var n) ? n : 0;
            if (want <= 0) continue;   // 0 (or blank/invalid) = don't allocate any

            int given = 0;
            while (given < want && cellIdx < freeCells.Count)
            {
                var chuteId = freeCells[cellIdx++];

                int pendingQty;
                try { pendingQty = await Chute.GetChutePendingQtyAsync(chuteId); }
                catch { continue; }             // couldn't verify — leave this chute untouched

                if (pendingQty > 0) continue;   // has pending items — same rule as a manual drop

                _cellOverrides[chuteId] = (shopId, shop.ShopName ?? "");
                given++;
                StateHasChanged();
            }
        }
    }

    private void ClearAllOverrides()
    {
        _cellOverrides.Clear();
        _cellErrors.Clear();
    }

    private async Task SaveAllAsync()
    {
        if (_cellOverrides.Count == 0) return;
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Save all {_cellOverrides.Count} pending change(s)?");
        if (!confirmed) return;
        _savingAll = true;
        StateHasChanged();
        var ids = _cellOverrides.Keys.ToList();
        foreach (var chuteId in ids)
        {
            if (!_cellOverrides.TryGetValue(chuteId, out var ovr)) continue;
            _savingChuteId = chuteId;
            _cellErrors.Remove(chuteId);
            _cellSuccess.Remove(chuteId);
            StateHasChanged();
            try
            {
                var msg = await Chute.SaveChuteMappingAsync(chuteId, ovr.ShopId, ovr.ShopName);
                _cellOverrides.Remove(chuteId);
                _cellSuccess[chuteId] = msg;
            }
            catch (Exception ex)
            {
                _cellErrors[chuteId] = ex.Message;
                Snack.Add($"Save failed [{chuteId}]: {ex.Message}", Severity.Error);
            }
        }
        _savingChuteId = null;
        _savingAll = false;
        await LoadAsync();
    }
}
