@page "/encoding"
@rendermode RenderMode.InteractiveServer
@using System.Text.RegularExpressions
@using Wms.Core
@using Wms.Data.Encoding
@attribute [Authorize(Policy = Wms.Core.MenuKeys.ITEM_ENCODING)]
@inject ItemEncodingService Svc
@inject ICurrentUser Me

<PageTitle>WMS — Item Encoding</PageTitle>

<div class="aiwms-page-header">
    <h2>Item Encoding</h2>
    <p>
        Encode a new item against an open container. Pick a container to enable
        Style / MH4 hierarchy for that container; Size becomes available after
        Division is picked from MH4.
    </p>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="aiwms-alert @(_isError ? "error" : "info")">@_message</div>
}

<div class="aiwms-section">
    <div class="aiwms-card-header">Item</div>
    <div style="display:grid; grid-template-columns: minmax(0,240px) minmax(0,180px) minmax(0,280px) auto minmax(0,300px); gap:12px; align-items:end">
        <div>
            <label class="aiwms-input-lbl">CONTAINER <span class="req">*</span></label>
            <select class="aiwms-input" @bind="_contno" @bind:after="OnContnoChangedAsync" disabled="@_busy">
                <option value="">(pick an open container)</option>
                @foreach (var c in _contnos)
                {
                    <option value="@c.ContNo">@c.ContNo@(string.IsNullOrEmpty(c.ContDesc) ? "" : $" — {c.ContDesc}")</option>
                }
            </select>
        </div>
        <div>
            <label class="aiwms-input-lbl">PO NO</label>
            <select class="aiwms-input" @bind="_pono" disabled="@(_busy || _ponos.Count == 0)">
                <option value=""></option>
                @foreach (var p in _ponos) { <option value="@p.PONo">@p.PONo</option> }
            </select>
        </div>
        <div>
            <label class="aiwms-input-lbl">ITEMCODE (barcode) <span class="req">*</span></label>
            <input class="aiwms-input" @bind="_itemcode" @bind:after="OnItemcodeChangedAsync"
                   maxlength="15" placeholder="e.g. 62810734"
                   style="text-transform:uppercase" disabled="@_busy" />
            @if (!string.IsNullOrEmpty(_itemcodeErr))
            {
                <div style="font-size:11px; color:#D1435B; margin-top:4px">@_itemcodeErr</div>
            }
        </div>
        <button class="aiwms-btn aiwms-btn-secondary"
                @onclick="GenerateBarcodeAsync"
                disabled="@(_busy || string.IsNullOrWhiteSpace(_contno) || string.IsNullOrWhiteSpace(_pono))"
                title="@(string.IsNullOrWhiteSpace(_pono) ? "Pick PONo first" : "Generate the next barcode for this Container + PONo")">
            Generate Barcode
        </button>
        <div>
            <label class="aiwms-input-lbl">ITEM NAME</label>
            <input class="aiwms-input" @bind="_itemname" @bind:after="OnItemnameChanged"
                   maxlength="100" placeholder="Item name / description" disabled="@_busy" />
            @if (!string.IsNullOrEmpty(_itemnameErr))
            {
                <div style="font-size:11px; color:#D1435B; margin-top:4px">@_itemnameErr</div>
            }
        </div>
    </div>
</div>

<div class="aiwms-section">
    <div class="aiwms-card-header">Attributes</div>
    <div style="display:grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap:12px">
        <div>
            <label class="aiwms-input-lbl">BRAND</label>
            <input class="aiwms-input" list="brands-list" @bind="_brand" placeholder="pick from manifest or type to search master…" disabled="@_busy" />
            <datalist id="brands-list">
                @* Manifest brands first (for the picked container), then master brands as fallback. *@
                @foreach (var b in _manifestBrands) { <option value="@b.Brand">from manifest</option> }
                @foreach (var b in _masterBrands.Where(x => !_manifestBrands.Any(m => string.Equals(m.Brand, x.Brand, StringComparison.OrdinalIgnoreCase))))
                { <option value="@b.Brand">from master</option> }
            </datalist>
        </div>
        <div>
            <label class="aiwms-input-lbl">GENDER</label>
            <select class="aiwms-input" @bind="_gender" disabled="@_busy">
                <option value=""></option>
                @foreach (var g in _genders) { <option value="@g.Gender">@g.Gender</option> }
            </select>
        </div>
        <div>
            <label class="aiwms-input-lbl">COLOR</label>
            <select class="aiwms-input" @bind="_color" disabled="@_busy">
                <option value=""></option>
                @foreach (var col in _colors) { <option value="@col.Color">@col.Color</option> }
            </select>
        </div>
    </div>
</div>

<div class="aiwms-section">
    <div class="aiwms-card-header">MH4 Hierarchy</div>
    <p style="margin:0 0 8px 0; color:var(--text-secondary); font-size:12px">
        Only combinations that appear on the picked container's items are listed.
        Pick top-down; each level filters the next.
    </p>
    <div style="display:grid; grid-template-columns: repeat(5, minmax(0,1fr)); gap:12px">
        <div>
            <label class="aiwms-input-lbl">DIVISION</label>
            <select class="aiwms-input" @bind="_division" @bind:after="OnMh4ChangedAsync" disabled="@(_busy || _mh4All.Count == 0)">
                <option value=""></option>
                @foreach (var d in DivisionOptions) { <option value="@d.key">@d.label</option> }
            </select>
        </div>
        <div>
            <label class="aiwms-input-lbl">DEPARTMENT</label>
            <select class="aiwms-input" @bind="_department" @bind:after="OnMh4ChangedAsync" disabled="@(_busy || string.IsNullOrEmpty(_division))">
                <option value=""></option>
                @foreach (var d in DepartmentOptions) { <option value="@d">@d</option> }
            </select>
        </div>
        <div>
            <label class="aiwms-input-lbl">CLASS</label>
            <select class="aiwms-input" @bind="_class" @bind:after="OnMh4ChangedAsync" disabled="@(_busy || string.IsNullOrEmpty(_department))">
                <option value=""></option>
                @foreach (var d in ClassOptions) { <option value="@d">@d</option> }
            </select>
        </div>
        <div>
            <label class="aiwms-input-lbl">FAMILY</label>
            <select class="aiwms-input" @bind="_family" @bind:after="OnMh4ChangedAsync" disabled="@(_busy || string.IsNullOrEmpty(_class))">
                <option value=""></option>
                @foreach (var d in FamilyOptions) { <option value="@d">@d</option> }
            </select>
        </div>
        <div>
            <label class="aiwms-input-lbl">SUBCLASS</label>
            <select class="aiwms-input" @bind="_subclass" disabled="@(_busy || string.IsNullOrEmpty(_family))">
                <option value=""></option>
                @foreach (var d in SubclassOptions) { <option value="@d">@d</option> }
            </select>
        </div>
    </div>
</div>

<div class="aiwms-section">
    <div class="aiwms-card-header">Style + Size</div>
    <div style="display:grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap:12px">
        <div>
            <label class="aiwms-input-lbl">STYLE</label>
            <input class="aiwms-input" list="styles-list" @bind="_style"
                   placeholder="pick from container styles or type a new one"
                   disabled="@(_busy || string.IsNullOrEmpty(_contno))" />
            <datalist id="styles-list">
                @foreach (var s in _styles) { <option value="@s.Style"></option> }
            </datalist>
        </div>
        <div>
            <label class="aiwms-input-lbl">SIZE</label>
            <select class="aiwms-input" @bind="_size" disabled="@(_busy || _sizes.Count == 0)">
                <option value=""></option>
                @foreach (var s in _sizes) { <option value="@s.Size">@s.Size</option> }
            </select>
            @if (string.IsNullOrEmpty(_division))
            {
                <div style="font-size:11px; color:var(--text-muted); margin-top:4px">
                    Pick Division first to see sizes.
                </div>
            }
        </div>
    </div>
</div>

<div class="aiwms-section">
    <div class="aiwms-alert info">
        Phase 2: dropdowns only. Save is coming in Phase 3.
    </div>
</div>

@code {
    private string _contno = "";
    private string _pono = "";
    private string _itemcode = "";
    private string _itemname = "";
    private string _brand = "";
    private string _gender = "";
    private string _color = "";
    private string _division = "";      // "DivID|Division" — DivID first for cascade lookup
    private string _department = "";
    private string _class = "";
    private string _family = "";
    private string _subclass = "";
    private string _style = "";
    private string _size = "";
    private bool   _busy;
    private string _message = "";
    private bool   _isError;

    // Per-field validation messages.
    private string _itemcodeErr = "";
    private string _itemnameErr = "";

    private List<OpenContnoRow> _contnos        = new();
    private List<PONoRow>       _ponos          = new();
    private List<BrandRow>      _manifestBrands = new();
    private List<BrandRow>      _masterBrands   = new();
    private List<GenderRow>     _genders        = new();
    private List<ColorRow>      _colors         = new();
    private List<StyleRow>      _styles         = new();
    private List<SizeRow>       _sizes          = new();
    private List<Mh4Row>        _mh4All         = new();

    // Regex helpers — Itemcode 0-9/A-Z/-  max 15; Itemname letters+digits+space, max 100.
    private static readonly Regex _itemcodeRegex = new(@"^[0-9A-Z\-]{1,15}$", RegexOptions.Compiled);
    private static readonly Regex _itemnameRegex = new(@"^[A-Za-z0-9 ]{1,100}$", RegexOptions.Compiled);

    // Division options built off _mh4All. Key = "DivID|Division", Label = "Division (DivID)".
    private IEnumerable<(string key, string label)> DivisionOptions =>
        _mh4All
            .GroupBy(r => (r.DivID, r.Division))
            .OrderBy(g => g.Key.Division)
            .Select(g => ($"{g.Key.DivID}|{g.Key.Division}", $"{g.Key.Division} ({g.Key.DivID})"));

    private int SelectedDivId
    {
        get
        {
            if (string.IsNullOrEmpty(_division)) return 0;
            var parts = _division.Split('|', 2);
            return int.TryParse(parts[0], out var id) ? id : 0;
        }
    }

    private string SelectedDivisionName
    {
        get
        {
            if (string.IsNullOrEmpty(_division)) return "";
            var parts = _division.Split('|', 2);
            return parts.Length == 2 ? parts[1] : "";
        }
    }

    private IEnumerable<string> DepartmentOptions =>
        _mh4All.Where(r => r.DivID == SelectedDivId)
               .Select(r => r.Department).Where(s => !string.IsNullOrEmpty(s))
               .Distinct().OrderBy(s => s)!;

    private IEnumerable<string> ClassOptions =>
        _mh4All.Where(r => r.DivID == SelectedDivId && r.Department == _department)
               .Select(r => r.Class).Where(s => !string.IsNullOrEmpty(s))
               .Distinct().OrderBy(s => s)!;

    private IEnumerable<string> FamilyOptions =>
        _mh4All.Where(r => r.DivID == SelectedDivId && r.Department == _department && r.Class == _class)
               .Select(r => r.Family).Where(s => !string.IsNullOrEmpty(s))
               .Distinct().OrderBy(s => s)!;

    private IEnumerable<string> SubclassOptions =>
        _mh4All.Where(r => r.DivID == SelectedDivId && r.Department == _department && r.Class == _class && r.Family == _family)
               .Select(r => r.Subclass).Where(s => !string.IsNullOrEmpty(s))
               .Distinct().OrderBy(s => s)!;

    protected override async Task OnInitializedAsync()
    {
        await Me.EnsureLoadedAsync();
        _busy = true;
        try
        {
            _contnos      = await Svc.GetOpenContainersAsync();
            _masterBrands = await Svc.GetMasterBrandsAsync();
            _genders      = await Svc.GetGendersAsync();
            _colors       = await Svc.GetColorsAsync();
        }
        catch (Exception ex) { ShowError($"Load failed: {ex.Message}"); }
        finally { _busy = false; }
    }

    private async Task OnContnoChangedAsync()
    {
        _mh4All         = new(); _division = ""; _department = ""; _class = ""; _family = ""; _subclass = "";
        _styles         = new(); _style = "";
        _sizes          = new(); _size = "";
        _ponos          = new(); _pono = "";
        _manifestBrands = new();
        if (string.IsNullOrWhiteSpace(_contno)) return;
        _busy = true;
        try
        {
            _ponos          = await Svc.GetPONosForContnoAsync(_contno);
            _mh4All         = await Svc.GetMh4ForContnoAsync(_contno);
            _styles         = await Svc.GetStylesForContnoAsync(_contno);
            _manifestBrands = await Svc.GetManifestBrandsForContnoAsync(_contno);
        }
        catch (Exception ex) { ShowError($"Container lookup failed: {ex.Message}"); }
        finally { _busy = false; }
    }

    private async Task OnItemcodeChangedAsync()
    {
        _itemcodeErr = "";
        _itemcode = (_itemcode ?? "").Trim().ToUpperInvariant();
        if (string.IsNullOrEmpty(_itemcode)) return;
        if (!_itemcodeRegex.IsMatch(_itemcode))
        {
            _itemcodeErr = "Only 0-9, A-Z and '-' allowed. Max 15 characters.";
            return;
        }
        // Duplicate check across WMS_ContAllocationData + WMS_Generatebarcode.
        try
        {
            var exists = await Svc.ItemcodeExistsAsync(_itemcode);
            if (exists.InAllocation && exists.InGenerated)
                _itemcodeErr = "Already exists in Container Allocation AND already encoded.";
            else if (exists.InAllocation)
                _itemcodeErr = "Already exists as an allocated item on this Azure DB.";
            else if (exists.InGenerated)
                _itemcodeErr = "Barcode already encoded.";
        }
        catch (Exception ex) { _itemcodeErr = $"Duplicate check failed: {ex.Message}"; }
    }

    private void OnItemnameChanged()
    {
        _itemnameErr = "";
        if (string.IsNullOrEmpty(_itemname)) return;
        // Trim only trailing spaces per spec; leading spaces are allowed to stay
        // while typing but blocked on submit — trimming here trips validation
        // sooner and matches "no trailing spaces".
        var trimmed = _itemname.TrimEnd();
        if (trimmed != _itemname) _itemname = trimmed;
        if (!_itemnameRegex.IsMatch(_itemname))
            _itemnameErr = "Only letters, digits and spaces. Max 100 characters.";
    }

    private async Task GenerateBarcodeAsync()
    {
        _itemcodeErr = "";
        if (string.IsNullOrWhiteSpace(_contno) || string.IsNullOrWhiteSpace(_pono)) return;
        _busy = true;
        try
        {
            var next = await Svc.GetNextBarcodeSrnoAsync(_contno, _pono);
            var candidate = $"{_pono.Trim()}-{next:0000}";
            if (candidate.Length > 15)
            {
                _itemcodeErr = $"Generated barcode '{candidate}' would exceed 15 chars. Trim PO or use shorter SRNO.";
                return;
            }
            _itemcode = candidate;
            await OnItemcodeChangedAsync();  // pick up duplicate + regex re-check
        }
        catch (Exception ex) { ShowError($"Generate Barcode failed: {ex.Message}"); }
        finally { _busy = false; }
    }

    private async Task OnMh4ChangedAsync()
    {
        // Reset the deeper cascade when a higher-level pick changes.
        // Blazor's @bind:after only fires after the bound value is set, so
        // we clear whatever no longer matches.
        if (string.IsNullOrEmpty(_division)) { _department = _class = _family = _subclass = ""; }
        if (!DepartmentOptions.Contains(_department)) _department = "";
        if (!ClassOptions.Contains(_class))           _class = "";
        if (!FamilyOptions.Contains(_family))         _family = "";
        if (!SubclassOptions.Contains(_subclass))     _subclass = "";

        // Sizes are DivID-scoped and only load when Division is picked.
        if (SelectedDivId > 0)
        {
            try   { _sizes = await Svc.GetSizesForDivIdAsync(SelectedDivId); }
            catch (Exception ex) { ShowError($"Size lookup failed: {ex.Message}"); }
        }
        else
        {
            _sizes = new(); _size = "";
        }
    }

    private void ShowError(string m) { _message = m; _isError = true; }
    private void ShowInfo(string m)  { _message = m; _isError = false; }
}
