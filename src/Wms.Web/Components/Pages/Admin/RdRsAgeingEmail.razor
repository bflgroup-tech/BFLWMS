@page "/admin/rd-rs-ageing-email"
@rendermode RenderMode.InteractiveServer
@using Wms.Core
@using Wms.Data.Lpm
@using Wms.Data.Notifications
@using Wms.Web.Hosting
@attribute [Authorize(Policy = MenuKeys.ADMIN_RD_RS_AGEING_EMAIL)]
@inject RdRsAgeingEmailService Svc
@inject RdRsAgeingEmailSender Sender
@inject RdRsAgeingService Ageing
@inject ICurrentUser Me
@inject IJSRuntime JS

<PageTitle>WMS — RD/RS Ageing Email</PageTitle>

<div class="aiwms-page-header">
    <h2>RD / RS Ageing Email</h2>
    <p>Weekly summary of RD (RTV) and RS (MC HOLD) stock by division, with average age in days. Set who receives it and when.</p>
    <AuthorizeView Roles="Admin">
        <p>
            Rows come from <code>racks.dbo.whboxitems</code> for PalletType RD and RS, TypeName from
            <code>BFLDATA.dbo.PalletType</code>, Division per item from <code>datareporting.dbo.vupc_subclass</code>,
            age from the box created date. Config lives in <code>dbo.WmsRdRsAgeingEmailConfig</code> on Azure WMS.
        </p>
    </AuthorizeView>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="aiwms-alert @(_isError ? "error" : "info")">@_message</div>
}

<div class="aiwms-section">
    <div class="aiwms-card-header">Schedule</div>
    <div style="display:grid; grid-template-columns: 1fr 1fr; gap:14px; margin-bottom:14px">
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">RECIPIENTS (TO) *</label>
            <textarea @bind="_recipients" rows="2" disabled="@_busy"
                      placeholder="name@bflgroup.ae; another@bflgroup.ae"
                      style="width:100%; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white; font-family:inherit"></textarea>
        </div>
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">CC (OPTIONAL)</label>
            <textarea @bind="_cc" rows="2" disabled="@_busy"
                      placeholder="CATTEAM@bflgroup.ae"
                      style="width:100%; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white; font-family:inherit"></textarea>
        </div>
    </div>
    <p style="margin:0 0 14px 0; font-size:11px; color:var(--text-secondary)">Separate addresses with a comma or semicolon.</p>

    <div style="display:flex; gap:14px; align-items:end; flex-wrap:wrap">
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">DAY</label>
            <select @bind="_day" disabled="@_busy"
                    style="min-width:150px; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white">
                @for (byte d = 0; d <= 6; d++)
                {
                    var dc = d;
                    <option value="@dc">@(((DayOfWeek)dc).ToString())</option>
                }
            </select>
        </div>
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">TIME (GST)</label>
            <div style="display:flex; gap:6px; align-items:center">
                <select @bind="_hour" disabled="@_busy"
                        style="padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white">
                    @for (byte h = 0; h <= 23; h++) { var hc = h; <option value="@hc">@hc.ToString("00")</option> }
                </select>
                <span style="font-weight:700">:</span>
                <select @bind="_minute" disabled="@_busy"
                        style="padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white">
                    @foreach (var m in new byte[] { 0, 15, 30, 45 }) { <option value="@m">@m.ToString("00")</option> }
                </select>
            </div>
        </div>
        <div>
            <label style="display:flex; align-items:center; gap:6px; cursor:pointer; font-size:13px; padding-bottom:9px">
                <input type="checkbox" @bind="_isActive" disabled="@_busy" />
                <b>Active</b>
            </label>
        </div>
        <button class="aiwms-btn aiwms-btn-primary" @onclick="SaveAsync" disabled="@_busy">Save</button>
        <button class="aiwms-btn aiwms-btn-secondary" @onclick="PreviewAsync" disabled="@_busy">Preview</button>
        <button class="aiwms-btn aiwms-btn-secondary" @onclick="SendTestAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_recipients))">Send Now</button>
    </div>

    @if (!_isActive)
    {
        <p style="margin:12px 0 0 0; font-size:12px; color:#92400e; background:#fef3c7; border:1px solid #f59e0b; border-radius:var(--r-sm); padding:8px 12px">
            Inactive — nothing is sent on schedule. Send Now still works for a one-off.
        </p>
    }
</div>

@if (_conf is not null)
{
    <div class="aiwms-section">
        <div class="aiwms-card-header">Last run</div>
        <table class="aiwms-table aiwms-table-dense" style="font-size:12px; max-width:760px">
            <tbody>
                <tr><td style="width:180px; color:var(--text-secondary)">When</td>
                    <td>@(_conf.LastRunTS?.ToString("dd-MMM-yyyy HH:mm") ?? "never")</td></tr>
                <tr><td style="color:var(--text-secondary)">Status</td>
                    <td style="@(_conf.LastRunStatus?.StartsWith("error") == true ? "color:#991b1b; font-weight:600" : "")">@(_conf.LastRunStatus ?? "—")</td></tr>
                <tr><td style="color:var(--text-secondary)">Rows / Qty sent</td>
                    <td>@(_conf.LastSentRows?.ToString("N0") ?? "—") / @(_conf.LastSentQty?.ToString("N0") ?? "—")</td></tr>
                <tr><td style="color:var(--text-secondary)">Config updated</td>
                    <td>@_conf.UpdatedTS.ToString("dd-MMM-yyyy HH:mm") by @(_conf.UpdatedBy ?? "—")</td></tr>
            </tbody>
        </table>
    </div>
}

@if (_previewRows is not null)
{
    <div class="aiwms-section">
        <div class="aiwms-card-header">
            Preview — @_previewRows.Count.ToString("N0") row(s), @_previewRows.Sum(r => r.TotalQty).ToString("N0") pcs
        </div>
        @if (_previewRows.Count == 0)
        {
            <p style="color:var(--text-secondary); font-size:13px; padding:14px">No RD or RS stock — on schedule, the mail would be skipped rather than sent empty.</p>
        }
        else
        {
            <div style="max-height:520px; overflow:auto">
                <table class="aiwms-table aiwms-table-dense" style="font-size:12px">
                    <thead style="position:sticky; top:0; background:white; z-index:1">
                        <tr>
                            <th>PalletType</th>
                            <th>Typename</th>
                            <th>Division</th>
                            <th style="text-align:right">Total Qty</th>
                            <th style="text-align:right">Avg Age (Days)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _previewRows)
                        {
                            <tr>
                                <td>@r.PalletType</td>
                                <td>@r.TypeName</td>
                                <td>@r.Division</td>
                                <td style="text-align:right">@r.TotalQty.ToString("N0")</td>
                                <td style="text-align:right">@r.AvgAgeDays.ToString("N1")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    private RdRsAgeingEmailConfig? _conf;
    private List<RdRsAgeingRow>? _previewRows;

    private string _recipients = "";
    private string _cc = "";
    private byte _day = 1, _hour = 8, _minute = 0;
    private bool _isActive;

    private bool _busy;
    private string _message = "";
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        await Me.EnsureLoadedAsync();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try
        {
            _conf = await Svc.GetAsync();
            if (_conf is not null)
            {
                _recipients = _conf.Recipients;
                _cc         = _conf.CcRecipients ?? "";
                _day        = _conf.DayOfWeek;
                _hour       = _conf.HourGst;
                _minute     = _conf.MinuteGst;
                _isActive   = _conf.IsActive;
            }
        }
        catch (Exception ex) { ShowError($"Could not load config: {ex.Message}"); }
    }

    private async Task SaveAsync()
    {
        _busy = true; _message = "";
        StateHasChanged();
        try
        {
            await Svc.SaveAsync(_recipients?.Trim() ?? "", string.IsNullOrWhiteSpace(_cc) ? null : _cc.Trim(),
                _day, _hour, _minute, _isActive, Me.Name ?? "");
            await ReloadAsync();
            ShowInfo($"Saved — {(DayOfWeek)_day} at {_hour:00}:{_minute:00} GST, {(_isActive ? "active" : "inactive")}.");
        }
        catch (Exception ex) { ShowError($"Save failed: {ex.Message}"); }
        finally { _busy = false; }
    }

    private async Task PreviewAsync()
    {
        _busy = true; _message = ""; _previewRows = null;
        StateHasChanged();
        try
        {
            _previewRows = await Ageing.GetAgeingAsync();
            ShowInfo($"Preview built from live data — {_previewRows.Count:N0} row(s). Nothing has been sent.");
        }
        catch (Exception ex) { ShowError($"Preview failed: {ex.Message}"); }
        finally { _busy = false; }
    }

    private async Task SendTestAsync()
    {
        var ok = await JS.InvokeAsync<bool>("confirm",
            $"Send the RD/RS ageing email now to:\n\n{_recipients}\n\nThis is a real send, not a preview.");
        if (!ok) return;

        _busy = true; _message = "";
        StateHasChanged();
        try
        {
            var res = await Sender.SendNowAsync(_recipients?.Trim() ?? "", string.IsNullOrWhiteSpace(_cc) ? null : _cc.Trim());
            if (res.Sent) ShowInfo($"Sent — {res.Rows:N0} row(s), {res.TotalQty:N0} pcs.");
            else          ShowInfo($"Not sent — {res.StatusMessage}.");
        }
        catch (Exception ex) { ShowError($"Send failed: {ex.Message}"); }
        finally { _busy = false; }
    }

    private void ShowError(string m) { _message = m; _isError = true; }
    private void ShowInfo(string m)  { _message = m; _isError = false; }
}
