@page "/admin/nightly-batches"
@rendermode RenderMode.InteractiveServer
@using Wms.Core
@using Wms.Data.Lpm
@using Wms.Data.Notifications
@using Wms.Web.Hosting
@attribute [Authorize(Policy = MenuKeys.ADMIN_NIGHTLY_BATCHES)]
@inject MissingExcessSnapshotService Snap
@inject WeeklySalesFromGcpService Gcp
@inject WhStockLastDayFromGcpService WhStock
@inject VolumeGroupWeeklyService Vg
@inject OtsWeeklyService OtsJob
@inject ScheduledJobService Jobs
@inject IncreffSohFromGcpService IncreffSoh
@inject IncreffMfcsSohCompareService IncreffCompare
@inject OtsPoAllocationService Ots
@inject ContainerAllocationDataSyncService Sync
@inject PendingGoodsReceiptEmailService Pgr
@inject PendingGoodsReceiptEmailSender PgrSender
@inject IConfiguration Config
@inject ICurrentUser CurrentUser

<PageTitle>WMS — Nightly Batches Status</PageTitle>

<div class="aiwms-page-header">
    <h2>Nightly Batches Status</h2>
    <p>Every scheduled batch in one place — activation toggles, next fire time, on-demand runs, and the shared run log. All times shown are GST (UTC+4).</p>
</div>

<div class="aiwms-section">
    <div class="aiwms-card-header">Scheduled Jobs</div>
    <table class="aiwms-table aiwms-table-dense">
        <thead>
            <tr>
                <th>Process</th>
                <th>Schedule</th>
                <th>Country</th>
                <th>Active</th>
                <th>Last updated</th>
                <th>By</th>
                <th style="white-space:nowrap">Next scheduled</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var j in _jobs)
            {
                <tr>
                    <td style="white-space:nowrap"><strong>@j.JobName</strong></td>
                    <td style="white-space:nowrap; font-size:11px; color:var(--text-secondary)">@j.Schedule</td>
                    <td>@(string.IsNullOrEmpty(j.Country) ? "" : j.Country)</td>
                    <td>
                        <input type="checkbox" checked="@j.IsActive" disabled="@(_busy || j.ToggleNote is not null)"
                               @onchange="@(e => ToggleJobAsync(j, (bool)e.Value!))" />
                        @if (j.ToggleNote is not null)
                        {
                            <span style="font-size:10px; color:var(--text-secondary); margin-left:6px">@j.ToggleNote</span>
                        }
                    </td>
                    <td style="white-space:nowrap">@(j.UpdatedTS == default ? "" : AsGst(j.UpdatedTS).ToString("yyyy-MM-dd HH:mm") + " GST")</td>
                    <td>@j.UpdatedBy</td>
                    <td style="white-space:nowrap">@(j.NextFire is null ? "—" : j.NextFire.Value.ToString("yyyy-MM-dd HH:mm") + " GST")</td>
                    <td style="white-space:nowrap">
                        @foreach (var (label, action) in j.Actions)
                        {
                            <button class="aiwms-btn aiwms-btn-secondary" style="font-size:11px; padding:4px 8px"
                                    @onclick="action" disabled="@_busy">@label</button>
                        }
                    </td>
                </tr>
            }
            @if (_jobs.Count == 0)
            {
                <tr><td colspan="8" style="font-style:italic; color:var(--text-secondary)">No jobs configured yet. Add a country with the form below.</td></tr>
            }
        </tbody>
    </table>

    <div style="display:flex; gap:8px; align-items:end; margin-top:14px">
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">PROCESS</label>
            <select @bind="_newCountryJob" style="padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;">
                <option value="@MissingExcessSnapshotService.JobName">@MissingExcessSnapshotService.JobName</option>
                <option value="@VolumeGroupWeeklyService.JobName">@VolumeGroupWeeklyService.JobName</option>
                <option value="@WhStockLastDayFromGcpService.JobName">@WhStockLastDayFromGcpService.JobName</option>
            </select>
        </div>
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">ADD COUNTRY</label>
            <input @bind="_newCountry" placeholder="e.g. KSA" style="padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
        </div>
        <button class="aiwms-btn aiwms-btn-secondary" @onclick="AddCountryAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_newCountry))">Add (inactive)</button>
    </div>
    <p style="font-size:11px; color:var(--text-secondary); margin-top:8px">
        Only MissingExcessSnapshot, VolumeGroupWeekly, and WhStockLastDayFromGCP run per country. The rest are single-instance jobs and already have their row above.
    </p>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="aiwms-alert @(_isError ? "error" : "info")" style="margin-top:12px">@_message</div>
    }
</div>

<div class="aiwms-section">
    <div class="aiwms-card-header">Daily sequence</div>
    <p style="font-size:12px; color:var(--text-secondary); margin:0 0 4px 0">
        Daily: <strong>06:00</strong> Volume Group refresh (all countries) + Missing/Excess snapshot → <strong>07:00</strong> OTS generate.
        Weekly sales from BigQuery stays weekly — Monday <strong>01:00</strong>.
        OTS needs Volume Group to have run for <strong>BFLGROUP</strong> the same day. If it has not, the 07:00 run defers and retries hourly rather than computing from a stale snapshot.
    </p>
</div>

<div class="aiwms-section">
    <div class="aiwms-card-header" style="display:flex; align-items:center; justify-content:space-between; gap:10px">
        <span>Recent runs — showing @FilteredRuns.Count of @_runs.Count</span>
        <div style="display:flex; align-items:center; gap:8px">
            <label style="font-size:11px; font-weight:700; color:var(--text-secondary)">PROCESS</label>
            <select @bind="_jobFilter" style="padding:6px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;">
                <option value="">All</option>
                @foreach (var job in JobNames)
                {
                    <option value="@job">@job</option>
                }
            </select>
            <button class="aiwms-btn aiwms-btn-secondary" @onclick="RefreshLogAsync" disabled="@_busy">Reload</button>
        </div>
    </div>
    <table class="aiwms-table aiwms-table-dense">
        <thead>
            <tr>
                <th>RunId</th><th>Job</th><th>Country</th><th>Mode</th><th>Started</th><th>Ended</th>
                <th>Status</th><th style="text-align:right">Rows</th>
                <th style="text-align:right">Days</th><th>Triggered By</th><th>Error</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in FilteredRuns)
            {
                <tr>
                    <td>@r.RunId</td>
                    <td>@r.JobName</td>
                    <td>@r.Country</td>
                    <td>@r.Mode</td>
                    <td>@AsGst(r.StartTS).ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>@(r.EndTS is null ? "" : AsGst(r.EndTS.Value).ToString("yyyy-MM-dd HH:mm:ss"))</td>
                    <td><span class="aiwms-pill @StatusPill(r.Status)">@r.Status</span></td>
                    <td style="text-align:right">@r.RowsProcessed</td>
                    <td style="text-align:right">@r.DatesProcessed</td>
                    <td>@r.TriggeredBy</td>
                    <td style="max-width:380px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap" title="@r.ErrorMessage">@r.ErrorMessage</td>
                </tr>
            }
            @if (FilteredRuns.Count == 0)
            {
                <tr><td colspan="11" style="font-style:italic; color:var(--text-secondary)">No runs @(_jobFilter == "" ? "yet" : "for this process").</td></tr>
            }
        </tbody>
    </table>
</div>

@code {
    // One rendered row of the Scheduled Jobs table. Every job — per-country or
    // single-instance, DB-toggled or config-gated — is projected into this shape
    // so the markup stays a single <tr> template.
    private sealed record JobVm(
        string    JobName,
        string    Schedule,
        string?   Country,
        bool      IsActive,
        DateTime  UpdatedTS,
        string?   UpdatedBy,
        DateTime? NextFire,
        Func<bool, Task> Toggle,
        List<(string Label, EventCallback Action)> Actions,
        string?   ToggleNote = null);

    private List<JobVm> _jobs = new();
    private List<RptJobRunRow> _runs = new();
    private string _newCountry = "";
    private string _newCountryJob = MissingExcessSnapshotService.JobName;
    private bool _busy;
    private string _message = "";
    private bool _isError;
    private string _jobFilter = "";

    // Every job actually configured, unioned with anything else seen in the log,
    // so a job that's been removed from _jobs still shows up as a filter option
    // for its historical runs.
    private List<string> JobNames =>
        _jobs.Select(j => j.JobName).Union(_runs.Select(r => r.JobName)).Distinct().OrderBy(j => j).ToList();

    private List<RptJobRunRow> FilteredRuns =>
        string.IsNullOrEmpty(_jobFilter) ? _runs : _runs.Where(r => r.JobName == _jobFilter).ToList();

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.EnsureLoadedAsync();
        await ReloadJobsAsync();
        await RefreshLogAsync();
    }

    // ---------------- Row assembly ----------------

    private async Task ReloadJobsAsync()
    {
        var list = new List<JobVm>();
        try
        {
            // 1. MissingExcessSnapshot — per country, daily 06:00.
            foreach (var c in await Snap.GetCountryConfigAsync())
            {
                var country = c.Country;
                list.Add(new JobVm(
                    MissingExcessSnapshotService.JobName, "Daily 06:00", country,
                    c.IsActive, c.UpdatedTS, c.UpdatedBy,
                    c.IsActive ? NextDailyFireGst(new(6, 0, 0)) : null,
                    active => ToggleAndReloadAsync(() => Snap.SetCountryActiveAsync(country, active), country, active),
                    new()
                    {
                        ("Refresh Now (T-1)", EventCallback.Factory.Create(this, () => RefreshYesterdayAsync(country))),
                        ("Backfill from 2026-02-21", EventCallback.Factory.Create(this, () => BackfillAsync(country))),
                    }));
            }

            // 2. WeeklySalesFromGCP — single row keyed by "", Monday 01:00.
            var gcp = (await Gcp.GetCountryConfigAsync()).FirstOrDefault(c => c.Country == "")
                      ?? new RptCountryConfigRow("", false, default, "");
            list.Add(new JobVm(
                WeeklySalesFromGcpService.JobName, "Mon 01:00", null,
                gcp.IsActive, gcp.UpdatedTS, gcp.UpdatedBy,
                gcp.IsActive ? NextWeeklyFireGst(new(1, 0, 0)) : null,
                active => ToggleAndReloadAsync(() => Gcp.SetCountryActiveAsync("", active), WeeklySalesFromGcpService.JobName, active),
                new() { ("Refresh Now", EventCallback.Factory.Create(this, RefreshGcpNowAsync)) }));

            // 2b. WhStockLastDayFromGCP — per country (unlike WeeklySalesFromGCP, this
            //     source already carries its own Country column, so "active" filters
            //     which countries' rows get upserted from one shared BigQuery pull),
            //     daily 11:15 (see Wms.Web.Hosting.WhStockLastDayBatchService).
            foreach (var c in await Jobs.GetConfigAsync(WhStockLastDayFromGcpService.JobName))
            {
                var country = c.Country;
                list.Add(new JobVm(
                    WhStockLastDayFromGcpService.JobName, "Daily 11:15", country,
                    c.IsActive, c.UpdatedTS, c.UpdatedBy,
                    c.IsActive ? NextDailyFireGst(new(11, 15, 0)) : null,
                    active => ToggleAndReloadAsync(() => Jobs.SetActiveAsync(WhStockLastDayFromGcpService.JobName, country, active, CurrentUser.Name ?? ""), country, active),
                    new() { ("Refresh Now", EventCallback.Factory.Create(this, () => RefreshWhStockNowAsync(country))) }));
            }

            // 3. VolumeGroupWeekly — per country, Monday 04:00.
            foreach (var c in await Vg.GetCountryConfigAsync())
            {
                var country = c.Country;
                list.Add(new JobVm(
                    VolumeGroupWeeklyService.JobName, "Daily 06:00", country,
                    c.IsActive, c.UpdatedTS, c.UpdatedBy,
                    c.IsActive ? NextDailyFireGst(new(6, 0, 0)) : null,
                    active => ToggleAndReloadAsync(() => Vg.SetCountryActiveAsync(country, active), country, active),
                    new() { ("Run Now", EventCallback.Factory.Create(this, () => RunVgNowAsync(country))) }));
            }

            // 4. OtsWeekly — single row, Monday 05:00 (one hour after VG).
            var ots = await Jobs.GetSingleRowAsync(OtsWeeklyService.JobName);
            list.Add(new JobVm(
                OtsWeeklyService.JobName, "Daily 07:00", null,
                ots.IsActive, ots.UpdatedTS, ots.UpdatedBy,
                ots.IsActive ? NextDailyFireGst(new(7, 0, 0)) : null,
                active => ToggleSingleAsync(OtsWeeklyService.JobName, active),
                new() { ("Run Now", EventCallback.Factory.Create(this, RunOtsNowAsync)) }));

            // 5. ToteMasterSync — single row, daily 05:00.
            var tote = await Jobs.GetSingleRowAsync(ToteMasterScheduledService.JobName);
            list.Add(new JobVm(
                ToteMasterScheduledService.JobName, "Daily 05:00", null,
                tote.IsActive, tote.UpdatedTS, tote.UpdatedBy,
                tote.IsActive ? NextDailyFireGst(new(5, 0, 0)) : null,
                active => ToggleSingleAsync(ToteMasterScheduledService.JobName, active),
                new() { ("Run Now", EventCallback.Factory.Create(this, RunToteNowAsync)) }));

            // 6. BoxesToWmsProd — single row, every 30 min, and additionally gated by
            //    an App Service config flag. With the flag off the toggle is inert, so
            //    show it disabled rather than implying the checkbox controls anything.
            var boxes = await Jobs.GetSingleRowAsync(BoxesToWmsProdScheduledService.JobName);
            var boxesEnabled = Config.GetValue(BoxesToWmsProdScheduledService.EnabledConfigKey, false);
            list.Add(new JobVm(
                BoxesToWmsProdScheduledService.JobName, "Every 30 min", null,
                boxes.IsActive, boxes.UpdatedTS, boxes.UpdatedBy,
                boxesEnabled && boxes.IsActive ? NextHalfHourGst() : null,
                active => ToggleSingleAsync(BoxesToWmsProdScheduledService.JobName, active),
                new() { ("Run Now", EventCallback.Factory.Create(this, RunBoxesNowAsync)) },
                boxesEnabled ? null : "disabled by config flag"));

            // 7. PendingGoodsReceiptEmail — its activation already lives in its own
            //    table, so mirror that row instead of creating a second source of truth.
            var pgr = await Pgr.GetAsync();
            if (pgr is not null)
            {
                list.Add(new JobVm(
                    "PendingGoodsReceiptEmail", $"Every {pgr.IntervalHours}h", null,
                    pgr.IsActive, pgr.UpdatedTS, pgr.UpdatedBy,
                    pgr.IsActive ? (pgr.LastRunTS?.AddHours(pgr.IntervalHours) ?? DateTime.UtcNow.AddHours(4)) : null,
                    active => TogglePgrAsync(pgr, active),
                    new() { ("Send Now", EventCallback.Factory.Create(this, () => RunPgrNowAsync(pgr))) }));
            }

            // 8. IncreffSohFromGCP — daily 08:00 GST (Wms.Web.Hosting.IncreffSohFromGcpBatchService).
            var increff = await Jobs.GetSingleRowAsync(IncreffSohFromGcpService.JobName);
            list.Add(new JobVm(
                IncreffSohFromGcpService.JobName, "Daily 08:00", null,
                increff.IsActive, increff.UpdatedTS, increff.UpdatedBy,
                increff.IsActive ? NextDailyFireGst(new(8, 0, 0)) : null,
                active => ToggleSingleAsync(IncreffSohFromGcpService.JobName, active),
                new() { ("Refresh Now", EventCallback.Factory.Create(this, RefreshIncreffNowAsync)) }));

            // 9. IncreffMfcsSohCompare — daily 08:15 GST, a fixed 15-minute offset after
            //    IncreffSohFromGCP (not a wait-chain — Wms.Web.Hosting.IncreffMfcsSohCompareBatchService
            //    defers and retries hourly if that job hasn't succeeded yet today).
            var compare = await Jobs.GetSingleRowAsync(IncreffMfcsSohCompareService.JobName);
            list.Add(new JobVm(
                IncreffMfcsSohCompareService.JobName, "Daily 08:15", null,
                compare.IsActive, compare.UpdatedTS, compare.UpdatedBy,
                compare.IsActive ? NextDailyFireGst(new(8, 15, 0)) : null,
                active => ToggleSingleAsync(IncreffMfcsSohCompareService.JobName, active),
                new() { ("Refresh Now", EventCallback.Factory.Create(this, RefreshIncreffCompareNowAsync)) }));
        }
        catch (Exception ex) { Show($"Failed to load jobs: {ex.Message}", true); }

        _jobs = list;
    }

    private async Task RefreshLogAsync()
    {
        try { _runs = await Snap.GetRecentRunsAsync(50); }
        catch (Exception ex) { Show($"Failed to load runs: {ex.Message}", true); }
    }

    // ---------------- Toggles ----------------

    private Task ToggleJobAsync(JobVm j, bool active) => j.Toggle(active);

    private async Task ToggleAndReloadAsync(Func<Task> set, string label, bool active)
    {
        try
        {
            await set();
            Show($"{label} → {(active ? "ACTIVE" : "INACTIVE")}.", false);
            await ReloadJobsAsync();
        }
        catch (Exception ex) { Show($"Toggle failed: {ex.Message}", true); }
    }

    private Task ToggleSingleAsync(string jobName, bool active) =>
        ToggleAndReloadAsync(
            () => Jobs.SetActiveAsync(jobName, ScheduledJobService.SingleRowKey, active, CurrentUser.Name ?? ""),
            jobName, active);

    private Task TogglePgrAsync(PendingGoodsReceiptEmailConfig cfg, bool active) =>
        ToggleAndReloadAsync(
            () => Pgr.SaveAsync(cfg.Recipients, cfg.IntervalHours, active, CurrentUser.Name ?? ""),
            "PendingGoodsReceiptEmail", active);

    private async Task AddCountryAsync()
    {
        var name = _newCountry?.Trim();
        if (string.IsNullOrEmpty(name)) return;
        try
        {
            if (_newCountryJob == VolumeGroupWeeklyService.JobName)
                await Vg.SetCountryActiveAsync(name, false);
            else if (_newCountryJob == WhStockLastDayFromGcpService.JobName)
                await Jobs.SetActiveAsync(WhStockLastDayFromGcpService.JobName, name, false, CurrentUser.Name ?? "");
            else
                await Snap.SetCountryActiveAsync(name, false);

            _newCountry = "";
            Show($"Added {name} (inactive).", false);
            await ReloadJobsAsync();
        }
        catch (Exception ex) { Show($"Add failed: {ex.Message}", true); }
    }

    // ---------------- On-demand runs ----------------

    private async Task RefreshYesterdayAsync(string country)
    {
        _busy = true; Show($"Refreshing {country} for T-1…", false); await InvokeAsync(StateHasChanged);
        var runId = await Snap.StartJobRunAsync("OnDemand", country, CurrentUser.Name);
        try
        {
            var yesterday = DateTime.UtcNow.AddDays(-1).Date;
            var rows = await Snap.RefreshDayAsync(country, yesterday);
            await Snap.FinishJobRunAsync(runId, "Success", rows, 1, null);
            Show($"{country} T-1 done — {rows} rows.", false);
        }
        catch (Exception ex)
        {
            await Snap.FinishJobRunAsync(runId, "Failed", null, 0, ex.Message);
            Show($"Refresh failed: {ex.Message}", true);
        }
        finally { _busy = false; await RefreshLogAsync(); }
    }

    private async Task BackfillAsync(string country)
    {
        _busy = true;
        Show($"Backfilling {country} from 2026-02-21 — this may take several minutes.", false);
        await InvokeAsync(StateHasChanged);
        var runId = await Snap.StartJobRunAsync("Backfill", country, CurrentUser.Name);
        try
        {
            var (days, rows) = await Snap.BackfillRangeAsync(country, MissingExcessSnapshotService.BackfillFloor, DateTime.UtcNow.Date);
            await Snap.FinishJobRunAsync(runId, "Success", rows, days, null);
            Show($"{country} backfill done — {days} days, {rows} rows.", false);
        }
        catch (Exception ex)
        {
            await Snap.FinishJobRunAsync(runId, "Failed", null, 0, ex.Message);
            Show($"Backfill failed: {ex.Message}", true);
        }
        finally { _busy = false; await RefreshLogAsync(); }
    }

    private async Task RefreshGcpNowAsync()
    {
        _busy = true; Show("Refreshing WeeklySalesFromGCP from BigQuery…", false); await InvokeAsync(StateHasChanged);
        var runId = await Gcp.StartJobRunAsync("OnDemand", "", CurrentUser.Name);
        try
        {
            var rows = await Gcp.RefreshCountryAsync("");
            await Gcp.FinishJobRunAsync(runId, "Success", rows, null, null);
            Show($"WeeklySalesFromGCP done — {rows} rows.", false);
        }
        catch (Exception ex)
        {
            await Gcp.FinishJobRunAsync(runId, "Failed", null, 0, ex.Message);
            Show($"Refresh failed: {ex.Message}", true);
        }
        finally { _busy = false; await RefreshLogAsync(); }
    }

    private async Task RunVgNowAsync(string country)
    {
        _busy = true; Show($"Generating VG for {country}…", false); await InvokeAsync(StateHasChanged);
        var runId = await Vg.StartJobRunAsync("OnDemand", country, CurrentUser.Name ?? "");
        try
        {
            var nowGst = DateTime.UtcNow.AddHours(4);
            var (rows, ungraded) = await Ots.GenerateStoreDivGradesAsync(nowGst.Month, nowGst.Year, country);
            var note = ungraded > 0
                ? $"{ungraded} store(s) matched no band and were graded blank — check AvgSalesPct ranges for {country}."
                : null;
            await Vg.FinishJobRunAsync(runId, "Success", rows, note);
            Show($"{country} VG generate done — {rows} rows." + (note is null ? "" : " " + note), ungraded > 0);
        }
        catch (Exception ex)
        {
            await Vg.FinishJobRunAsync(runId, "Failed", null, ex.Message);
            Show($"VG generate failed: {ex.Message}", true);
        }
        finally { _busy = false; await RefreshLogAsync(); }
    }

    private async Task RefreshWhStockNowAsync(string country)
    {
        _busy = true; Show($"Refreshing WhStockLastDayFromGCP for {country}…", false); await InvokeAsync(StateHasChanged);
        var runId = await Jobs.StartRunAsync(WhStockLastDayFromGcpService.JobName, "OnDemand", country, CurrentUser.Name ?? "");
        try
        {
            var rows = await WhStock.RefreshCountryAsync(country);
            await Jobs.FinishRunAsync(runId, "Success", rows, null);
            Show($"{country} WhStockLastDay done — {rows} rows.", false);
        }
        catch (Exception ex)
        {
            await Jobs.FinishRunAsync(runId, "Failed", null, ex.Message);
            Show($"Refresh failed: {ex.Message}", true);
        }
        finally { _busy = false; await RefreshLogAsync(); }
    }

    private async Task RunOtsNowAsync()
    {
        _busy = true; Show("Generating OTS — this can take several minutes…", false); await InvokeAsync(StateHasChanged);
        try
        {
            var (rows, err) = await OtsJob.RunOnceAsync("OnDemand", CurrentUser.Name ?? "");
            if (err is null) Show($"OTS generate done — {rows:N0} rows.", false);
            else             Show($"OTS generate failed: {err}", true);
        }
        finally { _busy = false; await RefreshLogAsync(); }
    }

    private async Task RunToteNowAsync()
    {
        _busy = true; Show("Syncing Tote ID Master…", false); await InvokeAsync(StateHasChanged);
        var runId = await Jobs.StartRunAsync(ToteMasterScheduledService.JobName, "OnDemand", null, CurrentUser.Name ?? "");
        try
        {
            var results = await Sync.SyncToteIDMasterAsync(origin: "Manual", actor: CurrentUser.Name);
            await Jobs.FinishRunAsync(runId, "Success", results.Count, null);
            Show($"Tote sync done — {results.Count} country row(s).", false);
        }
        catch (Exception ex)
        {
            await Jobs.FinishRunAsync(runId, "Failed", null, ex.Message);
            Show($"Tote sync failed: {ex.Message}", true);
        }
        finally { _busy = false; await RefreshLogAsync(); }
    }

    private async Task RunBoxesNowAsync()
    {
        _busy = true; Show("Pushing boxes to WMS prod…", false); await InvokeAsync(StateHasChanged);
        var runId = await Jobs.StartRunAsync(BoxesToWmsProdScheduledService.JobName, "OnDemand", null, CurrentUser.Name ?? "");
        try
        {
            var result = await Sync.SyncBoxesToWmsProdAsync(origin: "Manual", actor: CurrentUser.Name);
            await Jobs.FinishRunAsync(runId, "Success", null, result.Message);
            Show($"Boxes push done — {result.Message}", false);
        }
        catch (Exception ex)
        {
            await Jobs.FinishRunAsync(runId, "Failed", null, ex.Message);
            Show($"Boxes push failed: {ex.Message}", true);
        }
        finally { _busy = false; await RefreshLogAsync(); }
    }

    private async Task RefreshIncreffNowAsync()
    {
        _busy = true; Show("Refreshing ECOM INCREFF SOH from BigQuery (UAE, KSA)…", false); await InvokeAsync(StateHasChanged);
        var runId = await Jobs.StartRunAsync(IncreffSohFromGcpService.JobName, "OnDemand", null, CurrentUser.Name ?? "");
        try
        {
            var rows = await IncreffSoh.RefreshAsync();
            await Jobs.FinishRunAsync(runId, "Success", rows, null);
            Show($"IncreffSohFromGCP done — {rows} rows.", false);
        }
        catch (Exception ex)
        {
            await Jobs.FinishRunAsync(runId, "Failed", null, ex.Message);
            Show($"Refresh failed: {ex.Message}", true);
        }
        finally { _busy = false; await RefreshLogAsync(); }
    }

    private async Task RefreshIncreffCompareNowAsync()
    {
        _busy = true; Show("Comparing IncreffSOH vs MFCS_SOH…", false); await InvokeAsync(StateHasChanged);
        var runId = await Jobs.StartRunAsync(IncreffMfcsSohCompareService.JobName, "OnDemand", null, CurrentUser.Name ?? "");
        try
        {
            var rows = await IncreffCompare.RefreshAsync();
            await Jobs.FinishRunAsync(runId, "Success", rows, null);
            Show($"IncreffMfcsSohCompare done — {rows} rows.", false);
        }
        catch (Exception ex)
        {
            await Jobs.FinishRunAsync(runId, "Failed", null, ex.Message);
            Show($"Compare failed: {ex.Message}", true);
        }
        finally { _busy = false; await RefreshLogAsync(); }
    }

    private async Task RunPgrNowAsync(PendingGoodsReceiptEmailConfig cfg)
    {
        _busy = true; Show("Sending Pending Goods Receipt email…", false); await InvokeAsync(StateHasChanged);
        try
        {
            var res = await PgrSender.SendNowAsync(cfg.Recipients);
            await Pgr.RecordRunAsync(cfg.Id, res.StatusMessage, res.Sent ? res.PendingCount : 0);
            Show(res.Sent ? $"Email sent — {res.PendingCount} pending row(s)." : res.StatusMessage, !res.Sent);
        }
        catch (Exception ex) { Show($"Send failed: {ex.Message}", true); }
        finally { _busy = false; await ReloadJobsAsync(); }
    }

    // ---------------- Time helpers ----------------

    // WmsRptCountryConfig.UpdatedTS and WmsRptJobRun.StartTS/EndTS are ALREADY
    // stored in GST — every writer stamps them with
    // DATEADD(hour, 4, SYSUTCDATETIME()), and the readers pass the value through
    // untouched. The page used to add another +4 on top, so every timestamp here
    // rendered four hours in the future. Display them as-is.
    private static DateTime AsGst(DateTime stored) => stored;

    private static readonly TimeZoneInfo GstTz =
        TimeZoneInfo.FindSystemTimeZoneById(OperatingSystem.IsWindows() ? "Arabian Standard Time" : "Asia/Dubai");

    private static DateTime NowGst() => TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, GstTz);

    // Mirrors each BackgroundService's own fire-time arithmetic. Kept parameterised
    // rather than one helper per job so a schedule change is a single argument.
    private static DateTime NextDailyFireGst(TimeSpan fireTime)
    {
        var nowGst = NowGst();
        var candidate = nowGst.Date.Add(fireTime);
        return nowGst < candidate ? candidate : candidate.AddDays(1);
    }

    private static DateTime NextWeeklyFireGst(TimeSpan fireTime, DayOfWeek day = DayOfWeek.Monday)
    {
        var candidate = NextDailyFireGst(fireTime);
        while (candidate.DayOfWeek != day) candidate = candidate.AddDays(1);
        return candidate;
    }

    private static DateTime NextHalfHourGst()
    {
        var nowGst = NowGst();
        var floor = new DateTime(nowGst.Year, nowGst.Month, nowGst.Day, nowGst.Hour, 0, 0);
        if (nowGst < floor.AddMinutes(30)) return floor.AddMinutes(30);
        return floor.AddHours(1);
    }

    private static string StatusPill(string s) => s switch
    {
        "Success" => "tier1",
        "Running" => "tier3",
        "Failed"  => "tier4",
        _         => "tier2",
    };

    private void Show(string msg, bool isError) { _message = msg; _isError = isError; }
}
