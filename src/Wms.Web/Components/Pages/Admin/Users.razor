@page "/admin/users"
@rendermode RenderMode.InteractiveServer
@attribute [Authorize(Policy = Wms.Core.MenuKeys.ADMIN_USERS)]
@using Wms.Core.Entities
@using Wms.Data
@using Wms.Data.Lpm
@using Wms.Web.Auth
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Caching.Memory
@using Wms.Core
@inject IDbContextFactory<WmsDbContext> DbFactory
@inject BuildingService Build
@inject ICurrentUser Me
@inject ISnackbar Snack
@inject IMemoryCache Cache

<PageTitle>WMS — Users</PageTitle>

<div class="aiwms-page-header">
    <h2>Users &amp; Roles</h2>
    <p>Active users and their assigned roles. Country + Warehouse are required (drives audit trail in lpm.* tables).</p>
</div>

<div class="aiwms-section">
    <div class="aiwms-card-header">Add / update user</div>
    <div class="aiwms-form-row">
        <label>Username</label>
        <input @bind="_newUser" placeholder="BFLDomain\username" autocomplete="off" />
    </div>
    <div class="aiwms-form-row">
        <label>Country</label>
        <select @bind="_newCountry" @bind:after="OnNewCountryChanged">
            <option value="">-- Select --</option>
            @foreach (var c in _countries) { <option value="@c">@c</option> }
        </select>
    </div>
    <div class="aiwms-form-row">
        <label>Warehouse</label>
        <select @bind="_newWarehouse">
            <option value="">-- Select --</option>
            @foreach (var w in WHForCountry(_newCountry)) { <option value="@w.Warehouse">@w.Warehouse</option> }
        </select>
    </div>
    <div class="aiwms-form-row">
        <label>Role</label>
        <select @bind="_newRole">
            @foreach (var r in _roles) { <option value="@r.RoleCode">@r.RoleName</option> }
        </select>
    </div>
    <div style="margin-top:8px"><button class="aiwms-btn aiwms-btn-primary" @onclick="AddUser" disabled="@(string.IsNullOrEmpty(_newUser) || string.IsNullOrEmpty(_newCountry) || string.IsNullOrEmpty(_newWarehouse))">Save</button></div>
    @if (!string.IsNullOrEmpty(_err)) { <div class="aiwms-alert error" style="margin-top:10px">@_err</div> }
</div>

<div class="aiwms-section">
    <div class="aiwms-card-header">All users</div>
    <table class="aiwms-table">
        <thead>
            <tr><th>Username</th><th>Country</th><th>Warehouse</th><th>Active</th><th>Roles</th><th>Created</th><th style="width:220px"></th></tr>
        </thead>
        <tbody>
            @foreach (var u in _users)
            {
                <tr>
                    <td>@u.Username</td>
                    @if (_editingUser == u.Username)
                    {
                        <td>
                            <select @bind="_editCountry" @bind:after="OnEditCountryChanged" style="padding:4px 8px;border:1px solid var(--border);border-radius:4px">
                                <option value="">--</option>
                                @foreach (var c in _countries) { <option value="@c">@c</option> }
                            </select>
                        </td>
                        <td>
                            <select @bind="_editWarehouse" style="padding:4px 8px;border:1px solid var(--border);border-radius:4px">
                                <option value="">--</option>
                                @foreach (var w in WHForCountry(_editCountry)) { <option value="@w.Warehouse">@w.Warehouse</option> }
                            </select>
                        </td>
                        <td>@(u.IsActive ? "Yes" : "No")</td>
                        <td>
                            <div style="display:flex;flex-wrap:wrap;gap:4px">
                                @foreach (var r in _roles)
                                {
                                    var rc = r.RoleCode;
                                    <label style="font-size:11px;display:flex;gap:3px;align-items:center">
                                        <input type="checkbox" checked="@_editRoles.Contains(rc)"
                                               @onchange="@(e => ToggleEditRole(rc, (bool)e.Value!))" />
                                        @rc
                                    </label>
                                }
                            </div>
                        </td>
                        <td>@u.CreateTS.ToString("yyyy-MM-dd")</td>
                        <td>
                            <button class="aiwms-btn aiwms-btn-primary" style="padding:4px 10px;font-size:12px" @onclick="SaveEdit">Save</button>
                            <button class="aiwms-btn aiwms-btn-secondary" style="padding:4px 10px;font-size:12px" @onclick="CancelEdit">Cancel</button>
                        </td>
                    }
                    else
                    {
                        <td>@u.Country</td>
                        <td>@u.Warehouse</td>
                        <td>@(u.IsActive ? "Yes" : "No")</td>
                        <td>@(string.Join(", ", u.UserRoles.Select(ur => ur.RoleCode)))</td>
                        <td>@u.CreateTS.ToString("yyyy-MM-dd")</td>
                        <td>
                            <button class="aiwms-btn aiwms-btn-secondary" style="padding:4px 10px;font-size:12px" @onclick="() => StartEdit(u)">Edit</button>
                            <button class="aiwms-btn aiwms-btn-secondary" style="padding:4px 10px;font-size:12px" @onclick="() => ToggleActive(u.Username)">@(u.IsActive ? "Disable" : "Enable")</button>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="aiwms-section">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:@(_showAllAccess ? "12px" : "0")">
        <div class="aiwms-card-header" style="margin:0">All Users — Access Overview</div>
        <button class="aiwms-btn aiwms-btn-secondary" @onclick="ToggleAllAccessViewAsync">@(_showAllAccess ? "Hide" : "View All Access")</button>
    </div>
    @if (_showAllAccess)
    {
        <div style="margin-bottom:12px; max-width:360px">
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">SEARCH (USERNAME / ROLE / MENU / COUNTRY)</label>
            <input @bind="_accessSearch" @bind:event="oninput" placeholder="Type to filter..." style="width:100%; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
        </div>

        <div style="overflow-x:auto">
        <table class="aiwms-table aiwms-table-dense">
            <thead>
                <tr><th style="width:200px">Username</th><th style="width:160px">Roles</th><th>Menu Access</th><th>Country Access</th></tr>
            </thead>
            <tbody>
                @foreach (var u in FilteredAccessUsers())
                {
                    <tr>
                        <td>@u.Username</td>
                        <td>@string.Join(", ", u.UserRoles.Select(r => r.RoleCode))</td>
                        <td style="word-break:break-word; font-size:12px">@(_allMenuGrants.TryGetValue(u.Username, out var mk) && mk.Count > 0 ? string.Join(", ", mk) : "(none)")</td>
                        <td style="word-break:break-word; font-size:12px">@(_allCountryGrants.TryGetValue(u.Username, out var cg) && cg.Count > 0 ? string.Join(", ", cg) : "(none)")</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
        <div style="font-size:12px; color:var(--text-secondary); margin-top:8px">@FilteredAccessUsers().Count of @_users.Count user(s)</div>
    }
</div>

<div class="aiwms-section">
    <div class="aiwms-card-header">Copy Access — replaces the target user's Menu + Country Access with the source user's</div>
    <div style="display:flex; gap:10px; align-items:end; flex-wrap:wrap">
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">COPY FROM</label>
            <select @bind="_copyFromUser" style="padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white; min-width:240px">
                <option value="">-- Select user --</option>
                @foreach (var u in _users) { <option value="@u.Username">@u.Username</option> }
            </select>
        </div>
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">COPY TO</label>
            <select @bind="_copyToUser" style="padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white; min-width:240px">
                <option value="">-- Select user --</option>
                @foreach (var u in _users) { <option value="@u.Username">@u.Username</option> }
            </select>
        </div>
        <button class="aiwms-btn aiwms-btn-primary" @onclick="CopyAccessAsync"
                disabled="@(string.IsNullOrEmpty(_copyFromUser) || string.IsNullOrEmpty(_copyToUser) || _copyFromUser == _copyToUser)">
            Copy Access
        </button>
    </div>
    @if (!string.IsNullOrEmpty(_copyFromUser) && !string.IsNullOrEmpty(_copyToUser) && _copyFromUser == _copyToUser)
    {
        <div class="aiwms-alert error" style="margin-top:10px">Source and target must be different users.</div>
    }
</div>

<div class="aiwms-section">
    <div class="aiwms-card-header">Menu Access — exact whitelist; a user with no grants sees nothing (Admin role bypasses this list)</div>
    <div style="display:flex; gap:10px; align-items:end; margin-bottom:12px">
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">USER</label>
            <select @bind="_menuUser" @bind:after="LoadMenuGrantsAsync" style="padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white; min-width:280px">
                <option value="">-- Select user --</option>
                @foreach (var u in _users) { <option value="@u.Username">@u.Username</option> }
            </select>
        </div>
        @if (!string.IsNullOrEmpty(_menuUser))
        {
            <button class="aiwms-btn aiwms-btn-primary" @onclick="SaveMenuGrantsAsync">Save Menu Access</button>
            <span style="font-size:12px; color:var(--text-secondary)">@_menuGrants.Count grants</span>
        }
    </div>

    @if (!string.IsNullOrEmpty(_menuUser))
    {
        @foreach (var grp in MenuKeys.All.GroupBy(m => m.Group))
        {
            var groupKeys = grp.Select(m => m.Key).ToList();
            var allOn = groupKeys.All(k => _menuGrants.Contains(k));
            <div style="border:1px solid var(--border-default); border-radius:var(--r-sm); padding:10px 14px; margin-bottom:10px">
                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px">
                    <strong style="font-size:13px">@grp.Key</strong>
                    <label style="display:flex; align-items:center; gap:6px; font-size:12px; cursor:pointer">
                        <input type="checkbox" checked="@allOn" @onchange="@(e => ToggleGroup(groupKeys, (bool)e.Value!))" /> Select all
                    </label>
                </div>
                <div style="display:grid; grid-template-columns: repeat(2, 1fr); gap:6px 14px">
                    @foreach (var menu in grp)
                    {
                        var key = menu.Key;
                        <label style="display:flex; align-items:center; gap:6px; font-size:13px; cursor:pointer">
                            <input type="checkbox" checked="@_menuGrants.Contains(key)" @onchange="@(e => ToggleMenu(key, (bool)e.Value!))" />
                            <span>@(menu.Category is not null ? $"{menu.Category} / " : "")@menu.Label</span>
                            <span style="font-size:10px; color:var(--text-secondary)">(@string.Join("/", menu.DefaultRoles))</span>
                        </label>
                    }
                </div>
            </div>
        }
    }
</div>

<div class="aiwms-section">
    <div class="aiwms-card-header">Country Access — countries whose data this user can see in reports/pages. Admin role bypasses this list.</div>
    <div style="display:flex; gap:10px; align-items:end; margin-bottom:12px">
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">USER</label>
            <select @bind="_countryUser" @bind:after="LoadCountryGrantsAsync" style="padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white; min-width:280px">
                <option value="">-- Select user --</option>
                @foreach (var u in _users) { <option value="@u.Username">@u.Username</option> }
            </select>
        </div>
        @if (!string.IsNullOrEmpty(_countryUser))
        {
            <button class="aiwms-btn aiwms-btn-primary" @onclick="SaveCountryGrantsAsync">Save Country Access</button>
            <span style="font-size:12px; color:var(--text-secondary)">@_countryGrants.Count / @_countries.Count countries</span>
        }
    </div>

    @if (!string.IsNullOrEmpty(_countryUser))
    {
        var allOnC = _countries.All(c => _countryGrants.Contains(c));
        <div style="border:1px solid var(--border-default); border-radius:var(--r-sm); padding:10px 14px; margin-bottom:10px">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px">
                <strong style="font-size:13px">SIM Countries</strong>
                <label style="display:flex; align-items:center; gap:6px; font-size:12px; cursor:pointer">
                    <input type="checkbox" checked="@allOnC" @onchange="@(e => ToggleAllCountries((bool)e.Value!))" /> Select all
                </label>
            </div>
            <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:6px 14px">
                @foreach (var c in _countries)
                {
                    <label style="display:flex; align-items:center; gap:6px; font-size:13px; cursor:pointer">
                        <input type="checkbox" checked="@_countryGrants.Contains(c)" @onchange="@(e => ToggleCountry(c, (bool)e.Value!))" />
                        <span>@c</span>
                    </label>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<WmsUser> _users = new();
    private List<WmsRole> _roles = new();
    private List<WmsWHMaster> _whs = new();
    private List<string> _countries = new();
    private string _newUser = "", _newRole = "WHAssociate", _newCountry = "", _newWarehouse = "";
    private string? _err;

    protected override async Task OnInitializedAsync()
    {
        await Me.EnsureLoadedAsync();
        await using var db = await DbFactory.CreateDbContextAsync();
        _roles = await db.Roles.AsNoTracking().OrderBy(r => r.RoleName).ToListAsync();
        _whs   = await db.WHMasters.AsNoTracking().Where(w => w.Active).OrderBy(w => w.Country).ThenBy(w => w.Warehouse).ToListAsync();
        try { _countries = await Build.GetAllSimCountriesAsync(); }
        catch { _countries = _whs.Select(w => w.Country).Distinct().OrderBy(c => c).ToList(); }
        await Reload();
    }

    private IEnumerable<WmsWHMaster> WHForCountry(string c) =>
        string.IsNullOrEmpty(c) ? Enumerable.Empty<WmsWHMaster>()
                                : _whs.Where(w => w.Country == c);

    // Snap warehouse selections to empty when their parent country changes,
    // so a stale (Country, Warehouse) pair never sneaks past validation.
    private void OnNewCountryChanged()
    {
        if (!WHForCountry(_newCountry).Any(w => w.Warehouse == _newWarehouse))
            _newWarehouse = "";
    }
    private void OnEditCountryChanged()
    {
        if (!WHForCountry(_editCountry).Any(w => w.Warehouse == _editWarehouse))
            _editWarehouse = "";
    }

    private async Task Reload()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _users = await db.Users.AsNoTracking().Include(u => u.UserRoles)
            .OrderBy(u => u.Username).ToListAsync();
    }

    private async Task AddUser()
    {
        _err = null;
        if (!_whs.Any(w => w.Country == _newCountry && w.Warehouse == _newWarehouse && w.Active))
        { _err = $"Warehouse {_newWarehouse} not registered for country {_newCountry} in WHMaster."; return; }

        await using var db = await DbFactory.CreateDbContextAsync();
        var u = await db.Users.FirstOrDefaultAsync(x => x.Username == _newUser);
        if (u is null)
        {
            u = new WmsUser { Username = _newUser, CreatedBy = Me.Name, CreateTS = DateTime.Now,
                IsActive = true, Country = _newCountry, Warehouse = _newWarehouse };
            db.Users.Add(u);
        }
        else
        {
            u.Country = _newCountry; u.Warehouse = _newWarehouse;
        }
        if (!await db.UserRoles.AnyAsync(ur => ur.Username == _newUser && ur.RoleCode == _newRole))
            db.UserRoles.Add(new WmsUserRole { Username = _newUser, RoleCode = _newRole, CreateTS = DateTime.Now });
        await db.SaveChangesAsync();
        Cache.Remove(AuthStateCurrentUser.ProfileCacheKey(_newUser));   // user's next page-load picks up new profile
        Snack.Add($"User {_newUser} saved.", Severity.Success);
        _newUser = "";
        await Reload();
    }

    private async Task ToggleActive(string username)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var u = await db.Users.FirstOrDefaultAsync(x => x.Username == username);
        if (u is null) return;
        u.IsActive = !u.IsActive;
        await db.SaveChangesAsync();
        Cache.Remove(AuthStateCurrentUser.ProfileCacheKey(username));
        await Reload();
    }

    // ---------------- Inline edit ----------------
    private string? _editingUser;
    private string _editCountry = "";
    private string _editWarehouse = "";
    private HashSet<string> _editRoles = new();

    private void StartEdit(WmsUser u)
    {
        _editingUser   = u.Username;
        _editCountry   = u.Country   ?? "";
        _editWarehouse = u.Warehouse ?? "";
        _editRoles     = new HashSet<string>(u.UserRoles.Select(r => r.RoleCode), StringComparer.OrdinalIgnoreCase);
    }

    private void CancelEdit()
    {
        _editingUser = null;
    }

    private void ToggleEditRole(string code, bool on)
    {
        if (on) _editRoles.Add(code);
        else    _editRoles.Remove(code);
    }

    private async Task SaveEdit()
    {
        if (_editingUser is null) return;
        if (!string.IsNullOrEmpty(_editCountry) && !string.IsNullOrEmpty(_editWarehouse) &&
            !_whs.Any(w => w.Country == _editCountry && w.Warehouse == _editWarehouse && w.Active))
        {
            Snack.Add($"WH {_editWarehouse} not in WHMaster for {_editCountry}.", Severity.Error);
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();
        var u = await db.Users.Include(x => x.UserRoles).FirstOrDefaultAsync(x => x.Username == _editingUser);
        if (u is null) { _editingUser = null; return; }
        u.Country   = string.IsNullOrEmpty(_editCountry)   ? null : _editCountry;
        u.Warehouse = string.IsNullOrEmpty(_editWarehouse) ? null : _editWarehouse;

        var existingRoles = u.UserRoles.Select(r => r.RoleCode).ToHashSet(StringComparer.OrdinalIgnoreCase);
        foreach (var add in _editRoles.Where(r => !existingRoles.Contains(r)))
            db.UserRoles.Add(new WmsUserRole { Username = u.Username, RoleCode = add, CreateTS = DateTime.Now });
        foreach (var rem in u.UserRoles.Where(r => !_editRoles.Contains(r.RoleCode)).ToList())
            db.UserRoles.Remove(rem);

        await db.SaveChangesAsync();
        Cache.Remove(AuthStateCurrentUser.ProfileCacheKey(_editingUser));
        Snack.Add($"{_editingUser} updated.", Severity.Success);
        _editingUser = null;
        await Reload();
    }

    // ---------------- All-access overview ----------------
    private bool _showAllAccess;
    private string _accessSearch = "";
    private Dictionary<string, List<string>> _allMenuGrants = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, List<string>> _allCountryGrants = new(StringComparer.OrdinalIgnoreCase);

    // Matches username, role, or any granted menu/country name — so typing e.g.
    // a report's display name surfaces every user who currently has it granted.
    private List<WmsUser> FilteredAccessUsers()
    {
        var term = _accessSearch.Trim();
        if (term.Length == 0) return _users;
        return _users.Where(u =>
            Matches(u.Username, term) ||
            u.UserRoles.Any(r => Matches(r.RoleCode, term)) ||
            (_allMenuGrants.TryGetValue(u.Username, out var mk) && mk.Any(k => Matches(k, term))) ||
            (_allCountryGrants.TryGetValue(u.Username, out var cg) && cg.Any(c => Matches(c, term)))
        ).ToList();
    }

    private static bool Matches(string? value, string term) =>
        !string.IsNullOrEmpty(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);

    private async Task ToggleAllAccessViewAsync()
    {
        _showAllAccess = !_showAllAccess;
        if (_showAllAccess) await RefreshAllAccessSnapshotAsync();
    }

    // Same "Category / Label" text the Menu Access checklist above uses per item —
    // matches what a user actually sees in the left-nav, not the internal MenuKey.
    private static readonly Dictionary<string, string> _menuLabelByKey = MenuKeys.All.ToDictionary(
        m => m.Key,
        m => m.Category is not null ? $"{m.Category} / {m.Label}" : m.Label,
        StringComparer.OrdinalIgnoreCase);

    // Loads every user's grants in two queries (not one per row) — called on
    // first "View All Access" and again after any Save/Copy so the overview
    // never shows stale data if left open across an edit.
    private async Task RefreshAllAccessSnapshotAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var menuRows = await db.UserMenuAccess.AsNoTracking().ToListAsync();
        _allMenuGrants = menuRows.GroupBy(g => g.Username, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key,
                g => g.Select(x => _menuLabelByKey.GetValueOrDefault(x.MenuKey, x.MenuKey)).OrderBy(x => x).ToList(),
                StringComparer.OrdinalIgnoreCase);
        var countryRows = await db.UserCountryAccess.AsNoTracking().ToListAsync();
        _allCountryGrants = countryRows.GroupBy(g => g.Username, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.Select(x => x.Country).OrderBy(x => x).ToList(), StringComparer.OrdinalIgnoreCase);
    }

    // ---------------- Copy access ----------------
    private string _copyFromUser = "";
    private string _copyToUser = "";

    // Makes the target's grants exactly equal the source's (add what's missing,
    // remove what the target has that the source doesn't) rather than merging —
    // "copy access" reads as "make B's access match A's", not "add A's on top".
    private async Task CopyAccessAsync()
    {
        if (string.IsNullOrEmpty(_copyFromUser) || string.IsNullOrEmpty(_copyToUser) || _copyFromUser == _copyToUser) return;

        await using var db = await DbFactory.CreateDbContextAsync();

        var sourceMenuKeys = await db.UserMenuAccess.AsNoTracking()
            .Where(g => g.Username == _copyFromUser).Select(g => g.MenuKey).ToListAsync();
        var sourceMenuSet = sourceMenuKeys.ToHashSet(StringComparer.OrdinalIgnoreCase);
        var targetMenuRows = await db.UserMenuAccess.Where(g => g.Username == _copyToUser).ToListAsync();
        var targetMenuKeys = targetMenuRows.Select(g => g.MenuKey).ToHashSet(StringComparer.OrdinalIgnoreCase);
        foreach (var k in sourceMenuSet.Where(k => !targetMenuKeys.Contains(k)))
            db.UserMenuAccess.Add(new WmsUserMenuAccess {
                Username = _copyToUser, MenuKey = k, GrantedTS = DateTime.Now, GrantedBy = Me.Name });
        foreach (var row in targetMenuRows.Where(r => !sourceMenuSet.Contains(r.MenuKey)))
            db.UserMenuAccess.Remove(row);

        var sourceCountries = await db.UserCountryAccess.AsNoTracking()
            .Where(a => a.Username == _copyFromUser).Select(a => a.Country).ToListAsync();
        var sourceCountrySet = sourceCountries.ToHashSet(StringComparer.OrdinalIgnoreCase);
        var targetCountryRows = await db.UserCountryAccess.Where(a => a.Username == _copyToUser).ToListAsync();
        var targetCountries = targetCountryRows.Select(a => a.Country).ToHashSet(StringComparer.OrdinalIgnoreCase);
        foreach (var c in sourceCountrySet.Where(c => !targetCountries.Contains(c)))
            db.UserCountryAccess.Add(new WmsUserCountryAccess {
                Username = _copyToUser, Country = c, GrantedTS = DateTime.Now, GrantedBy = Me.Name });
        foreach (var row in targetCountryRows.Where(r => !sourceCountrySet.Contains(r.Country)))
            db.UserCountryAccess.Remove(row);

        await db.SaveChangesAsync();
        Cache.Remove(AuthStateCurrentUser.ProfileCacheKey(_copyToUser));
        Cache.Remove(AuthStateCurrentUser.CountryAccessCacheKey(_copyToUser));

        // Keep any currently-open per-user panels in sync with what was just copied.
        if (_menuUser == _copyToUser) await LoadMenuGrantsAsync();
        if (_countryUser == _copyToUser) await LoadCountryGrantsAsync();
        if (_showAllAccess) await RefreshAllAccessSnapshotAsync();

        Snack.Add($"Copied access from {_copyFromUser} to {_copyToUser} ({sourceMenuSet.Count} menu grants, {sourceCountrySet.Count} countries).", Severity.Success);
    }

    // ---------------- Menu access ----------------
    private string _menuUser = "";
    private HashSet<string> _menuGrants = new();

    private async Task LoadMenuGrantsAsync()
    {
        _menuGrants = new();
        if (string.IsNullOrEmpty(_menuUser)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var keys = await db.UserMenuAccess.AsNoTracking()
            .Where(g => g.Username == _menuUser)
            .Select(g => g.MenuKey).ToListAsync();
        _menuGrants = keys.ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    private void ToggleMenu(string key, bool on)
    {
        if (on) _menuGrants.Add(key); else _menuGrants.Remove(key);
    }

    private void ToggleGroup(List<string> keys, bool on)
    {
        if (on) foreach (var k in keys) _menuGrants.Add(k);
        else    foreach (var k in keys) _menuGrants.Remove(k);
    }

    private async Task SaveMenuGrantsAsync()
    {
        if (string.IsNullOrEmpty(_menuUser)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.UserMenuAccess.Where(g => g.Username == _menuUser).ToListAsync();
        var existingKeys = existing.Select(e => e.MenuKey).ToHashSet(StringComparer.OrdinalIgnoreCase);
        // Add new grants
        foreach (var k in _menuGrants.Where(k => !existingKeys.Contains(k)))
            db.UserMenuAccess.Add(new WmsUserMenuAccess {
                Username = _menuUser, MenuKey = k,
                GrantedTS = DateTime.Now, GrantedBy = Me.Name });
        // Remove revoked grants
        foreach (var e in existing.Where(e => !_menuGrants.Contains(e.MenuKey)))
            db.UserMenuAccess.Remove(e);
        await db.SaveChangesAsync();
        Cache.Remove(AuthStateCurrentUser.ProfileCacheKey(_menuUser));
        if (_showAllAccess) await RefreshAllAccessSnapshotAsync();
        Snack.Add($"Menu access saved for {_menuUser} ({_menuGrants.Count} grants).", Severity.Success);
    }

    // ---------------- Country access ----------------
    private string _countryUser = "";
    private HashSet<string> _countryGrants = new(StringComparer.OrdinalIgnoreCase);

    private async Task LoadCountryGrantsAsync()
    {
        _countryGrants = new(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrEmpty(_countryUser)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var rows = await db.UserCountryAccess.AsNoTracking()
            .Where(a => a.Username == _countryUser)
            .Select(a => a.Country).ToListAsync();
        _countryGrants = new HashSet<string>(rows, StringComparer.OrdinalIgnoreCase);
    }

    private void ToggleCountry(string country, bool on)
    {
        if (on) _countryGrants.Add(country); else _countryGrants.Remove(country);
    }

    private void ToggleAllCountries(bool on)
    {
        if (on) foreach (var c in _countries) _countryGrants.Add(c);
        else    _countryGrants.Clear();
    }

    private async Task SaveCountryGrantsAsync()
    {
        if (string.IsNullOrEmpty(_countryUser)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var existing = await db.UserCountryAccess.Where(a => a.Username == _countryUser).ToListAsync();
        var existingCountries = existing.Select(e => e.Country).ToHashSet(StringComparer.OrdinalIgnoreCase);
        foreach (var c in _countryGrants.Where(c => !existingCountries.Contains(c)))
            db.UserCountryAccess.Add(new WmsUserCountryAccess {
                Username = _countryUser, Country = c,
                GrantedTS = DateTime.Now, GrantedBy = Me.Name });
        foreach (var e in existing.Where(e => !_countryGrants.Contains(e.Country)))
            db.UserCountryAccess.Remove(e);
        await db.SaveChangesAsync();
        Cache.Remove(AuthStateCurrentUser.CountryAccessCacheKey(_countryUser));
        if (_showAllAccess) await RefreshAllAccessSnapshotAsync();
        Snack.Add($"Country access saved for {_countryUser} ({_countryGrants.Count} countries).", Severity.Success);
    }
}
