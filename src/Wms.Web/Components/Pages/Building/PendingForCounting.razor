@page "/counting/pending-for-counting"
@rendermode RenderMode.InteractiveServer
@using System.Text
@using Wms.Core
@using Wms.Data.Lpm
@attribute [Authorize(Policy = MenuKeys.PENDING_FOR_COUNTING)]
@inject PendingForCountingService Svc
@inject BulkPoAllocationService BulkSvc
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>WMS — Pending for Counting</PageTitle>

<div class="aiwms-page-header">
    <h2>Pending for Counting</h2>
    <p>Containers received on or after the cut-off date whose goods receipt has not been posted (no row in USAPurchase) and which have not been opened for counting (no row in OpenUSACont). Non-Trade containers are excluded. Oldest receipt first.</p>
</div>

<div class="aiwms-section" style="padding:10px 16px;">
    <div style="display:flex; flex-wrap:wrap; gap:8px; align-items:flex-end;">
        <div style="flex:0 0 170px;">
            <label class="aiwms-filter-label" style="white-space:nowrap;">RECEIPT DATE FROM</label>
            <input type="date" @bind:get="_receiptDtFrom" @bind:set="v => SetIfPlausible(v, d => _receiptDtFrom = d)" @bind:format="yyyy-MM-dd"
                   style="width:100%; padding:5px 7px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:12px; background:white" />
        </div>
        <div style="flex:0 0 200px;">
            <label class="aiwms-filter-label" style="white-space:nowrap;">CONTAINER / PO</label>
            <input type="text" @bind="_search" @bind:event="oninput" placeholder="Filter loaded rows…"
                   style="width:100%; padding:5px 7px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:12px; background:white" />
        </div>
        <div style="display:flex; gap:10px;">
            <button class="aiwms-btn aiwms-btn-primary" @onclick="LoadAsync" disabled="@_loading">
                @(_loading ? "Loading…" : "Load")
            </button>
            <button class="aiwms-btn aiwms-btn-secondary" @onclick="ExportCsvAsync" disabled="@(_loading || _rows.Count == 0)">
                Export to Excel
            </button>
            @* Admin-only: this writes a work queue other people will run. *@
            @if (_isAdmin)
            {
                <button class="aiwms-btn aiwms-btn-primary" @onclick="PushToBulkQueueAsync"
                        disabled="@(_loading || _pushing || FilteredContnos.Count == 0)"
                        title="Push the container numbers currently shown (after filters) into LPMSIM.dbo.WMS_BulkAllocationQueue as a new batch, then run it from Container Allocation.">
                    @(_pushing ? "Pushing…" : $"Push {FilteredContnos.Count} contno(s) to Bulk Queue")
                </button>
            }
        </div>
        @if (AnyColumnFilterActive)
        {
            <button class="aiwms-btn aiwms-btn-secondary" @onclick="ClearColumnFilters">Clear all filters</button>
        }
    </div>

    @* The banner follows the filters. It used to show the load-time totals only, so a
       filtered grid sat under a headline counting rows that were no longer on screen —
       and the Push button, which acts on the filtered set, disagreed with it. *@
    @if (_rows.Count > 0)
    {
        var shownRows = FilteredRows;
        var shownConts = shownRows.Select(r => r.ContNo)
                                  .Where(c => !string.IsNullOrWhiteSpace(c))
                                  .Distinct(StringComparer.OrdinalIgnoreCase).Count();
        var allConts = _rows.Select(r => r.ContNo)
                            .Where(c => !string.IsNullOrWhiteSpace(c))
                            .Distinct(StringComparer.OrdinalIgnoreCase).Count();
        <div class="aiwms-alert info" style="margin-top:12px">
            <b>@shownConts.ToString("N0") container(s)</b> ·
            @shownRows.Count.ToString("N0") row(s) ·
            <b>@shownRows.Sum(r => r.Qty).ToString("N0") pcs</b>
            @if (AnyColumnFilterActive || !string.IsNullOrWhiteSpace(_search))
            {
                <span style="color:var(--text-secondary)">
                    &nbsp;— filtered from @allConts.ToString("N0") container(s),
                    @_rows.Count.ToString("N0") row(s), @_rows.Sum(r => r.Qty).ToString("N0") pcs
                </span>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="aiwms-alert @(_isError ? "error" : "info")" style="margin-top:12px">@_message</div>
    }
</div>

@if (FilteredRows.Count > 0)
{
    <div class="aiwms-section">
        <div style="overflow:auto; max-height:calc(100vh - 300px);">
        <table class="aiwms-table aiwms-table-dense" style="table-layout:fixed; width:100%; border-collapse:separate; border-spacing:0;">
            @* One col per column — Warehouse and Allocation Country were added to the
               header without widths, leaving the last two to share whatever was left. *@
            <colgroup>
                <col style="width:130px;" />  @* Contno            *@
                <col style="width:105px;" />  @* ReceiptDt         *@
                <col style="width:95px;"  />  @* Ageing Days       *@
                <col style="width:120px;" />  @* Warehouse         *@
                <col style="width:150px;" />  @* Allocation Country*@
                <col style="width:100px;" />  @* Processed         *@
                <col style="width:100px;" />  @* PONO              *@
                <col style="width:175px;" />  @* Division          *@
                <col style="width:90px;"  />  @* Qty               *@
                <col style="width:100px;" />  @* LPM               *@
            </colgroup>
            <thead style="position:sticky; top:0; z-index:5; background:var(--bfl-black);">
                <tr>
                    <th style="cursor:pointer" @onclick='() => Sort("ContNo")'>Contno @Arrow("ContNo")</th>
                    <th style="cursor:pointer" @onclick='() => Sort("ReceiptDt")'>ReceiptDt @Arrow("ReceiptDt")</th>
                    <th style="cursor:pointer; text-align:right;" @onclick='() => Sort("AgeingDays")'>Ageing Days @Arrow("AgeingDays")</th>
                    <th style="cursor:pointer" @onclick='() => Sort("Warehouse")' title="bfldata..Contreceipt.Warehouse for this container's receipt.">Warehouse @Arrow("Warehouse")</th>
                    <th style="cursor:pointer" @onclick='() => Sort("AllocationCountry")' title="Distinct hodata..vUSAOrder.AllocationCountry values for this container (refno = Contno).">Allocation Country @Arrow("AllocationCountry")</th>
                    <th style="cursor:pointer" @onclick='() => Sort("ProcessedDt")' title="When this container's allocation was pushed to WMS-Prod-DB (Online..PhotoCheckingResult.Trndate). Blank = not processed yet.">Processed @Arrow("ProcessedDt")</th>
                    <th style="cursor:pointer" @onclick='() => Sort("PONo")'>PONO @Arrow("PONo")</th>
                    <th style="cursor:pointer" @onclick='() => Sort("Division")'>Division @Arrow("Division")</th>
                    <th style="cursor:pointer; text-align:right;" @onclick='() => Sort("Qty")'>Qty @Arrow("Qty")</th>
                    <th style="cursor:pointer" @onclick='() => Sort("LPM")'>LPM @Arrow("LPM")</th>
                </tr>
                @* Excel-style filter row. Each dropdown lists the values still present
                   under the OTHER columns' filters, so narrowing one column narrows the
                   choices in the rest — picking a combination that yields nothing is
                   not offered. Nothing selected = column unfiltered, matching Excel's
                   "all ticked". Qty has no filter: it is a measure, not a category. *@
                <tr style="background:white;">
                    <th style="padding:4px 6px;">@FilterCell("ContNo")</th>
                    <th style="padding:4px 6px;">@FilterCell("ReceiptDt")</th>
                    <th style="padding:4px 6px;">@FilterCell("AgeingDays")</th>
                    <th style="padding:4px 6px;">@FilterCell("Warehouse")</th>
                    <th style="padding:4px 6px;">@FilterCell("AllocationCountry")</th>
                    <th style="padding:4px 6px;">@FilterCell("ProcessedDt")</th>
                    <th style="padding:4px 6px;">@FilterCell("PONo")</th>
                    <th style="padding:4px 6px;">@FilterCell("Division")</th>
                    <th style="padding:4px 6px;"></th>
                    <th style="padding:4px 6px;">@FilterCell("LPM")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in FilteredRows)
                {
                    <tr>
                        <td>@r.ContNo</td>
                        <td>@(r.ReceiptDt?.ToString("dd/MM/yyyy") ?? "")</td>
                        <td style="text-align:right;">@(r.AgeingDays?.ToString("N0") ?? "")</td>
                        <td>@r.Warehouse</td>
                        <td>@r.AllocationCountry</td>
                        <td>@(r.ProcessedDt?.ToString("dd/MM/yyyy") ?? "")</td>
                        <td>@r.PONo</td>
                        <td style="word-break:break-word; white-space:normal;">@r.Division</td>
                        <td style="text-align:right;">@r.Qty.ToString("N0")</td>
                        <td>@r.LPM</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr style="font-weight:600; border-top:2px solid var(--border-default);">
                    <td>Total</td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td style="text-align:right;">@FilteredRows.Sum(r => r.Qty).ToString("N0")</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
        </div>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _isAdmin;
    private bool _pushing;

    /// <summary>
    /// Distinct containers behind the rows currently displayed. The grid is one row
    /// per (container, PO, division, LPM), so a straight row list would queue the
    /// same container many times.
    /// </summary>
    private List<string> FilteredContnos =>
        FilteredRows.Select(r => r.ContNo)
                    .Where(c => !string.IsNullOrWhiteSpace(c))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToList();

    private async Task PushToBulkQueueAsync()
    {
        if (!_isAdmin || _pushing) return;
        var contnos = FilteredContnos;
        if (contnos.Count == 0) return;

        var ok = await JS.InvokeAsync<bool>("confirm",
            $"Push {contnos.Count} container(s) to the Bulk Allocation queue as a new batch?\n\n" +
            string.Join(", ", contnos.Take(15)) + (contnos.Count > 15 ? $", … (+{contnos.Count - 15})" : "") +
            "\n\nRun it from Container Allocation → Bulk PO Allocation.");
        if (!ok) return;

        _pushing = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var (batchNo, inserted) = await BulkSvc.PushBatchAsync(contnos);
            ShowInfo($"Pushed {inserted:N0} container(s) as batch #{batchNo}. " +
                     "Open Container Allocation → Bulk PO Allocation, pick the batch and run it.");
        }
        catch (Exception ex) { ShowError($"Push failed: {ex.Message}"); }
        finally { _pushing = false; }
    }

    private List<PendingForCountingRow> _rows = new();
    private DateTime _receiptDtFrom = PendingForCountingService.DefaultReceiptDtFrom;
    private string _search = "";

    private bool   _loading;
    private string _message = "";
    private bool   _isError;

    // Default matches the server's ORDER BY — oldest receipt first, which is the
    // order the worklist is meant to be worked in.
    private string _sortKey = "ReceiptDt";
    private bool   _sortAsc = true;

    private void Sort(string key)
    {
        if (_sortKey == key) { _sortAsc = !_sortAsc; return; }
        _sortKey = key;
        // First click picks the direction that is actually useful for that column:
        // worst-first on the numbers (most aged, biggest qty), A-Z on the text.
        _sortAsc = key is not ("AgeingDays" or "Qty");
    }

    private string Arrow(string key) => _sortKey != key ? "" : (_sortAsc ? "▲" : "▼");

    // LPM is "SEP-26" / "JAN-27" — sorting those as text puts JAN-27 before
    // SEP-26, which is backwards. Parse to the month it names so the column
    // sorts chronologically; anything unparseable falls to the end.
    private static DateTime LpmOrder(string? lpm) =>
        DateTime.TryParseExact((lpm ?? "").Trim(), "MMM-yy",
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var d)
            ? d : DateTime.MaxValue;

    // ===================== Excel-style column filters =====================

    /// <summary>Shown for an empty cell, so "no value" is pickable like it is in Excel.</summary>
    private const string BlankOption = "(blank)";

    // Column key -> the values ticked in that column's dropdown. An absent or empty
    // entry means the column is unfiltered.
    private readonly Dictionary<string, HashSet<string>> _colFilters = new();

    private bool AnyColumnFilterActive => _colFilters.Values.Any(v => v.Count > 0);

    private void ClearColumnFilters() => _colFilters.Clear();

    /// <summary>
    /// The cell text a column filters on. Must match what the body renders, or the
    /// dropdown would offer values the user cannot see — hence ReceiptDt formats the
    /// same dd/MM/yyyy the row does.
    /// </summary>
    private static string CellValue(PendingForCountingRow r, string col)
    {
        var v = col switch
        {
            "ContNo"            => r.ContNo,
            "ReceiptDt"         => r.ReceiptDt?.ToString("dd/MM/yyyy"),
            "AgeingDays"        => r.AgeingDays?.ToString(),
            "Warehouse"         => r.Warehouse,
            "AllocationCountry" => r.AllocationCountry,
            "ProcessedDt"       => r.ProcessedDt?.ToString("dd/MM/yyyy"),
            "PONo"              => r.PONo,
            "Division"          => r.Division,
            "LPM"               => r.LPM,
            _                   => null,
        };
        return string.IsNullOrWhiteSpace(v) ? BlankOption : v.Trim();
    }

    private bool PassesColumnFilters(PendingForCountingRow r, string? exceptCol)
    {
        foreach (var (col, picked) in _colFilters)
        {
            if (picked.Count == 0 || col == exceptCol) continue;
            if (!picked.Contains(CellValue(r, col))) return false;
        }
        return true;
    }

    private bool PassesSearch(PendingForCountingRow r) =>
        string.IsNullOrWhiteSpace(_search)
        || (r.ContNo?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
        || (r.PONo?.Contains(_search, StringComparison.OrdinalIgnoreCase)   ?? false);

    /// <summary>
    /// Options for one column: the distinct values surviving every OTHER filter, so
    /// the lists stay consistent with each other as the user narrows things down.
    /// Ordered by what the column actually means — dates and LPM chronologically,
    /// ageing numerically — rather than as text, which would put 10 before 7 and
    /// JAN-27 before SEP-26.
    /// </summary>
    private List<string> OptionsFor(string col)
    {
        var values = _rows.Where(r => PassesSearch(r) && PassesColumnFilters(r, col))
                          .Select(r => CellValue(r, col))
                          .Distinct()
                          .ToList();

        return col switch
        {
            "ReceiptDt" or "ProcessedDt"
                         => values.OrderBy(v => DateTime.TryParseExact(v, "dd/MM/yyyy",
                                System.Globalization.CultureInfo.InvariantCulture,
                                System.Globalization.DateTimeStyles.None, out var d) ? d : DateTime.MaxValue).ToList(),
            "AgeingDays" => values.OrderBy(v => int.TryParse(v, out var n) ? n : int.MaxValue).ToList(),
            "LPM"        => values.OrderBy(v => LpmOrder(v)).ToList(),
            _            => values.OrderBy(v => v, StringComparer.OrdinalIgnoreCase).ToList(),
        };
    }

    private RenderFragment FilterCell(string col) => builder =>
    {
        var options = OptionsFor(col);
        var picked  = _colFilters.TryGetValue(col, out var p) ? p : new HashSet<string>();

        builder.OpenComponent<MudSelect<string>>(0);
        builder.AddAttribute(1, "T", "string");
        builder.AddAttribute(2, "Dense", true);
        builder.AddAttribute(3, "MultiSelection", true);
        builder.AddAttribute(4, "SelectAll", true);
        builder.AddAttribute(5, "Variant", Variant.Outlined);
        builder.AddAttribute(6, "Margin", Margin.Dense);
        builder.AddAttribute(7, "Placeholder", "All");
        builder.AddAttribute(8, "Style", "font-size:11px");
        builder.AddAttribute(9, "SelectedValues", (IEnumerable<string>)picked);
        builder.AddAttribute(10, "SelectedValuesChanged",
            EventCallback.Factory.Create<IEnumerable<string>>(this, v => SetColumnFilter(col, v)));
        builder.AddAttribute(11, "ChildContent", (RenderFragment)(b2 =>
        {
            var seq = 0;
            foreach (var o in options)
            {
                b2.OpenComponent<MudSelectItem<string>>(seq++);
                b2.AddAttribute(seq++, "T", "string");
                b2.AddAttribute(seq++, "Value", o);
                b2.CloseComponent();
            }
        }));
        builder.CloseComponent();
    };

    private void SetColumnFilter(string col, IEnumerable<string>? values)
    {
        var set = values is null ? new HashSet<string>() : values.ToHashSet();
        if (set.Count == 0) _colFilters.Remove(col);
        else _colFilters[col] = set;
    }

    private List<PendingForCountingRow> FilteredRows
    {
        get
        {
            IEnumerable<PendingForCountingRow> rows =
                _rows.Where(r => PassesSearch(r) && PassesColumnFilters(r, null));

            Func<PendingForCountingRow, object?> key = _sortKey switch
            {
                "ContNo"     => r => r.ContNo,
                "ReceiptDt"  => r => r.ReceiptDt ?? DateTime.MaxValue,
                "AgeingDays" => r => r.AgeingDays ?? int.MinValue,
                "Warehouse"  => r => r.Warehouse ?? "",
                "AllocationCountry" => r => r.AllocationCountry ?? "",
                "ProcessedDt" => r => r.ProcessedDt ?? DateTime.MaxValue,
                "PONo"       => r => r.PONo ?? "",
                "Division"   => r => r.Division ?? "",
                "Qty"        => r => r.Qty,
                "LPM"        => r => LpmOrder(r.LPM),
                _            => r => r.ReceiptDt ?? DateTime.MaxValue,
            };

            // Container then PO as the tie-break, so rows of the same container
            // stay together whichever column is sorted.
            rows = _sortAsc
                ? rows.OrderBy(key).ThenBy(r => r.ContNo).ThenBy(r => r.PONo)
                : rows.OrderByDescending(key).ThenBy(r => r.ContNo).ThenBy(r => r.PONo);

            return rows.ToList();
        }
    }

    // A pending worklist is worth showing straight away rather than making the
    // operator click Load on arrival; the button stays for refresh / date changes.
    // No auto-load on arrival. The query walks Contreceipt for the whole period and
    // anti-joins USAPurchase + OpenUSACont, so every visit to the page was paying for
    // a scan nobody had asked for yet. Load is now an explicit click.
    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var auth = await AuthState;
            _isAdmin = auth.User.IsInRole(Roles.Admin);
        }
        ShowInfo("Set the receipt date and press Load.");
    }

    // <input type="date"> fires change events mid-typing; Blazor parses those
    // partial values as DateTime.MinValue and would overwrite the field before
    // the user finishes. Ignore anything implausible rather than committing it.
    private static void SetIfPlausible(DateTime v, Action<DateTime> apply)
    {
        if (v.Year > 1900) apply(v);
    }

    private async Task LoadAsync()
    {
        // Drop the column filters: they hold values from the previous result set, and
        // a filter pinned to a container that is no longer pending would show an empty
        // grid with no obvious cause.
        _loading = true; _message = ""; _rows.Clear(); _colFilters.Clear();
        await InvokeAsync(StateHasChanged);
        try
        {
            _rows = await Svc.GetPendingAsync(_receiptDtFrom);
            // The counts live in the banner above, which follows the filters. Saying
            // them here too would just be a second figure to keep in step.
            _message = _rows.Count == 0 ? "No containers pending for counting." : "";
            _isError = false;
        }
        catch (Exception ex) { ShowError($"Load failed: {ex.Message}"); }
        finally { _loading = false; }
    }

    private async Task ExportCsvAsync()
    {
        var rows = FilteredRows;
        var sb = new StringBuilder();
        sb.AppendLine("Contno,ReceiptDt,Ageing Days,Warehouse,Allocation Country,Processed,PONO,Division,Qty,LPM");
        foreach (var r in rows)
            sb.AppendLine($"{Csv(r.ContNo)}," +
                          $"{(r.ReceiptDt.HasValue ? r.ReceiptDt.Value.ToString("yyyy-MM-dd") : "")}," +
                          $"{r.AgeingDays},{Csv(r.Warehouse)},{Csv(r.AllocationCountry)}," +
                          $"{(r.ProcessedDt.HasValue ? r.ProcessedDt.Value.ToString("yyyy-MM-dd") : "")}," +
                          $"{Csv(r.PONo)},{Csv(r.Division)},{r.Qty},{Csv(r.LPM)}");
        sb.AppendLine($"Total,,,,,,,,{rows.Sum(r => r.Qty)},");

        var b64      = Convert.ToBase64String(Encoding.UTF8.GetBytes(sb.ToString()));
        var filename = $"PendingForCounting_{_receiptDtFrom:yyyyMMdd}.csv";
        await JS.InvokeVoidAsync("eval",
            $"(function(){{var a=document.createElement('a');a.href='data:text/csv;base64,{b64}';" +
            $"a.download='{filename}';document.body.appendChild(a);a.click();document.body.removeChild(a);}})();");
    }

    private static string Csv(string? s)
    {
        if (s is null) return "";
        return (s.Contains(',') || s.Contains('"') || s.Contains('\n'))
            ? "\"" + s.Replace("\"", "\"\"") + "\""
            : s;
    }

    private void ShowError(string msg) { _message = msg; _isError = true; }
    private void ShowInfo(string msg)  { _message = msg; _isError = false; }
}
