        ("EOMMonth",        "EOM Month",          "The picked (Month, Year), formatted MMM-yyyy."),
        ("TgtEOMMonth",     "Tgt EOM Month",      "MMM-yyyy of the month Target Week falls in, per BFL_MFP_OUTBOUND_T1. Varies by country because lead weeks do. Falls back to EOM Month when the fiscal calendar has no entry."),
        ("TgtEOM",          "Tgt EOM",            "LPM_EOM_Output.TargetEOM for (Tgt EOM Month, Store, Div)."),
        ("PrevEOMMonth",    "Prev EOM Month",     "The month before Tgt EOM Month — the source month for Prev Month EOM."),
        ("PrevMonthEOM",    "Prev Month EOM",     "LPM_EOM_Output.TargetEOM for (Prev EOM Month, Store, Div); 0 when missing."),
        ("DivisorWeeks",    "Divisor Weeks",      "Count of fiscal weeks in the TARGET EOM month, per BFL_MFP_OUTBOUND_T1. This is the Week Adjustment divisor, so it varies by country with lead weeks."),
        ("WeekAdjustment",  "Week Adjustment",    "(Tgt EOM − Prev Month EOM) ÷ Divisor Weeks. Positive = scaling up, negative = winding down; 0 when Prev Month EOM = 0. Displayed rounded — Current EOW uses the unrounded value."),
        ("CurrentWeek",     "Current Week",       "Latest wk in LPM_OTS_Output — the fiscal week the run is anchored on. Identical on every row."),
        ("TargetWeek",      "Target Week",        "Current Week + No. of Lead Weeks — the fiscal week the lead horizon reaches. Its month is the Tgt EOM Month."),
        ("WeeksMultiplier", "Weeks Multiplier",   "Target Week − the last week of the month BEFORE the target month: how many weeks INTO the target month the target week sits. This multiplies Week Adjustment — it is NOT No. of Lead Weeks."),
        ("CurrentEOW",      "Current EOW",        "Prev Month EOM + (Week Adjustment × Weeks Multiplier). Falls back to Tgt EOM when Prev Month EOM = 0."),
