    private static string Logic(string key) =>
        ColumnLogic.FirstOrDefault(c => c.Key == key).Logic ?? "";

    private RenderFragment SortHeader(string key, string label, string? width = null, bool numeric = false, string? title = null) => builder =>
    {
        var style = "cursor:pointer" + (width is null ? "" : $"; width:{width}");
        if (numeric) style += "; text-align:right";
        var arrow = _sortKey == key ? (_sortAsc ? " ▲" : " ▼") : "";
        builder.OpenElement(0, "th");
        builder.AddAttribute(1, "style", style);
        if (!string.IsNullOrEmpty(title)) builder.AddAttribute(2, "title", title);
        builder.AddAttribute(3, "onclick", EventCallback.Factory.Create(this, () => ToggleSort(key)));
        builder.AddContent(4, label + arrow);
        builder.CloseElement();
    };

    private void ToggleSort(string key)
    {
        if (_sortKey == key) _sortAsc = !_sortAsc;
        else { _sortKey = key; _sortAsc = true; }
    }

    private IEnumerable<OtsPoAllocationRow> FilteredSortedRows =>
        SortedRows.Where(RowMatchesFilters);

    private bool RowMatchesFilters(OtsPoAllocationRow r)
    {
        if (_fCountries.Count > 0 && !_fCountries.Contains(r.Country)) return false;
        if (_selectedDivs.Count > 0 && !_selectedDivs.Contains(r.DivCode)) return false;
        if (!string.IsNullOrWhiteSpace(_fStoreId)
            && !string.Equals(r.StoreID, _fStoreId, StringComparison.OrdinalIgnoreCase)) return false;
        if (_fVolumeGroups.Count > 0 && !_fVolumeGroups.Contains(r.VolumeGroup ?? "")) return false;
        return true;
    }

    private void ClearFilters()
    {
        _fCountries = new(StringComparer.OrdinalIgnoreCase);
        _selectedDivs = new();
        _fStoreLabel = null; _fStoreId = null;
        _fVolumeGroups = new(StringComparer.OrdinalIgnoreCase);
    }

    /// <summary>Distinct StoreID/StoreName options from the loaded rows, formatted
    /// "StoreID — StoreName". Users can type either fragment; matches are case-
    /// insensitive contains-anywhere. Deduped so each store shows once.</summary>
    private Task<IEnumerable<string>> SearchStoreOptions(string? term, CancellationToken ct)
    {
        var q = _rows
            .Select(r => (Id: r.StoreID, Name: r.StoreName ?? ""))
            .GroupBy(x => x.Id, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .OrderBy(x => x.Id, StringComparer.OrdinalIgnoreCase)
            .Select(x => string.IsNullOrEmpty(x.Name) ? x.Id : $"{x.Id} — {x.Name}");

        if (!string.IsNullOrWhiteSpace(term))
            q = q.Where(s => s.IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0);

        return Task.FromResult<IEnumerable<string>>(q.Take(50));
    }

    private void OnStoreFilterChanged(string? label)
    {
        _fStoreLabel = label;
        if (string.IsNullOrWhiteSpace(label)) { _fStoreId = null; return; }
        var dashIdx = label.IndexOf(" — ", StringComparison.Ordinal);
        _fStoreId = (dashIdx > 0 ? label[..dashIdx] : label).Trim();
    }

    private IEnumerable<OtsPoAllocationRow> SortedRows
    {
        get
        {
            Func<OtsPoAllocationRow, object?> k = _sortKey switch
            {
                "Country"         => r => r.Country,
                "StoreID"         => r => r.StoreID,
                "StoreName"       => r => r.StoreName,
                "DivCode"         => r => r.DivCode,
                "Division"        => r => r.Division,
                "VolumeGroup"     => r => VolumeGroupRank(r.VolumeGroup),
                "EOMMonth"        => r => r.EOMMonth,
                "TgtEOMMonth"     => r => r.TgtEOMMonth ?? "",
                "TgtEOM"          => r => r.TgtEOM,
                "PrevEOMMonth"    => r => r.PrevEOMMonth ?? "",
                "PrevMonthEOM"    => r => r.PrevMonthEOM,
                "DivisorWeeks"    => r => r.DivisorWeeks,
                "CurrentWeek"     => r => r.CurrentWeek,
                "TargetWeek"      => r => r.TargetWeek,
                "WeeksMultiplier" => r => r.WeeksMultiplier,
                "WeekAdjustment"  => r => r.WeekAdjustment,
                "CurrentEOW"      => r => r.CurrentEOW,
                "SOHToday"        => r => r.SOHToday,
                "NoOfLeadWeeks"   => r => r.NoOfLeadWeeks,
                "WeekSales"       => r => r.WeekSales,
                "LeadIntransit"   => r => r.LeadIntransit,
                "LeadDCSOH"       => r => r.LeadDCSOH,
                "InTransit"       => r => r.InTransit,
                "Ex2DcSoh"        => r => r.Ex2DcSoh,
                "UaeDcSoh"        => r => r.UaeDcSoh,
                "CountingWIP"     => r => r.CountingWIP,
                "OtsQtyToday"     => r => r.OtsQtyToday,
                "OtsPercentToday" => r => r.OtsPercentToday,
                "OtsTodayRequired"=> r => Math.Max(0, r.OtsQtyToday),
                _ => r => r.Country,
            };
            return _sortAsc ? _rows.OrderBy(k) : _rows.OrderByDescending(k);
        }
    }

    private void ShowError(string m) { _message = m; _isError = true; }
