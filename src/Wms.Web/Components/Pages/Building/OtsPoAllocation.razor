    }

    private async Task ExportExcelAsync()
    {
        if (_rows.Count == 0) return;
        using var wb = new XLWorkbook();
        var ws = wb.AddWorksheet("OTS");
        string[] headers =
        {
            // Layout mirrors the grid: week bookkeeping before Current EOW, and the
            // reference-only Lead columns last.
            "Country","StoreID","Store Name","Divcode","Division","Volume Group",
            "EOM Month","Tgt EOM Month","Tgt EOM","Prev EOM Month","Prev Month EOM","Divisor Weeks","Week Adjustment",
            "Current Week","Target Week","Weeks Multiplier","Current EOW",
            "SOH Today","No. of Lead Weeks","Week Sales",
            "InTransit","Ex2 DC SOH","UAE DC SOH","Counting WIP","OTS Qty Today","OTS % Today","OTS Today Required",
            "Lead InTransit","Lead DC SOH"
        };
        for (int i = 0; i < headers.Length; i++) ws.Cell(1, i + 1).Value = headers[i];
        int row = 2;
        foreach (var r in SortedRows)
        {
            var req = Math.Max(0, r.OtsQtyToday);
            ws.Cell(row, 1).Value  = r.Country;
            ws.Cell(row, 2).Value  = r.StoreID;
            ws.Cell(row, 3).Value  = r.StoreName ?? "";
            ws.Cell(row, 4).Value  = r.DivCode;
            ws.Cell(row, 5).Value  = r.Division ?? "";
            ws.Cell(row, 6).Value  = r.VolumeGroup ?? "";
            ws.Cell(row, 7).Value  = r.EOMMonth;
            ws.Cell(row, 8).Value  = r.TgtEOMMonth ?? "";
            ws.Cell(row, 9).Value  = r.TgtEOM;
            ws.Cell(row,10).Value  = r.PrevEOMMonth ?? "";
            ws.Cell(row,11).Value  = r.PrevMonthEOM;
            ws.Cell(row,12).Value  = r.DivisorWeeks;
            ws.Cell(row,13).Value  = (int)Math.Round(r.WeekAdjustment);
            ws.Cell(row,14).Value  = r.CurrentWeek;
            ws.Cell(row,15).Value  = r.TargetWeek;
            ws.Cell(row,16).Value  = r.WeeksMultiplier;
            ws.Cell(row,17).Value  = r.CurrentEOW;
            ws.Cell(row,18).Value  = r.SOHToday;
            ws.Cell(row,19).Value  = r.NoOfLeadWeeks;
            ws.Cell(row,20).Value  = r.WeekSales;
            ws.Cell(row,21).Value  = r.InTransit;
            ws.Cell(row,22).Value  = r.Ex2DcSoh;
            ws.Cell(row,23).Value  = r.UaeDcSoh;
            ws.Cell(row,24).Value  = r.CountingWIP;
            ws.Cell(row,25).Value  = r.OtsQtyToday;
            ws.Cell(row,26).Value  = (int)Math.Round(r.OtsPercentToday);
            ws.Cell(row,27).Value  = req > 0 ? req : 0;
            ws.Cell(row,28).Value  = r.LeadIntransit;
            ws.Cell(row,29).Value  = r.LeadDCSOH;
            row++;
        }
        // Totals row (column indices match the header layout above)
        ws.Cell(row, 1).Value = "Totals";
        ws.Cell(row, 9).Value  = _totTgtEOM;
        ws.Cell(row,11).Value  = SortedRows.Sum(r => r.PrevMonthEOM);
        ws.Cell(row,17).Value  = SortedRows.Sum(r => r.CurrentEOW);
        ws.Cell(row,18).Value  = _totSOH;
        ws.Cell(row,20).Value  = _totWeekSales;
        ws.Cell(row,21).Value  = _totInTransit;
        ws.Cell(row,22).Value  = _totEx2;
        ws.Cell(row,23).Value  = _totUaeDc;
        ws.Cell(row,24).Value  = _totWIP;
        ws.Cell(row,25).Value  = _totOtsQty;
        ws.Cell(row,27).Value  = _totOtsRequired;
        ws.Cell(row,28).Value  = _totLeadIn;
        ws.Cell(row,29).Value  = _totLeadDc;
        ws.Row(row).Style.Font.Bold = true;
        ws.Columns().AdjustToContents();
        using var ms = new MemoryStream();
        wb.SaveAs(ms);
        var b64 = Convert.ToBase64String(ms.ToArray());
        var name = $"ots-po-allocation-{_year:D4}-{_month:D2}-{_rundate:yyyyMMdd}.xlsx";
        await JS.InvokeVoidAsync("eval",
            $"var link=document.createElement('a');link.href='data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{b64}';link.download='{name}';link.click();");
    }

