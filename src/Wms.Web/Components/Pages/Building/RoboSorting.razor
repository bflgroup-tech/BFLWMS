@page "/counting/robo-sorting"
@rendermode RenderMode.InteractiveServer
@attribute [Authorize(Policy = Wms.Core.MenuKeys.ROBO_SORTING)]
@using Wms.Core
@using Wms.Core.Validation
@using Wms.Data.Auditing
@using Wms.Data.Lpm
@inject BuildingService Build
@inject IActionLogger Audit
@inject ICurrentUser Me
@inject IJSRuntime JS

<PageTitle>WMS — Robo Sorting</PageTitle>

<div class="aiwms-page-header">
    <h2>Robo Sorting</h2>
    <p>Press <kbd>Enter</kbd> in each field — focus advances automatically. Same inputs as Manual Counting, without tote check-in / check-out.</p>
</div>

@if (string.IsNullOrEmpty(Me.Warehouse))
{
    <div class="aiwms-section">
        <div class="aiwms-alert error">Your user profile has no Warehouse assigned. Ask Admin to set Country + Warehouse first.</div>
        <div style="margin-top:8px;font-size:12px;color:var(--text-muted);font-family:Consolas,monospace">
            Diagnostic — auth says you are: <b>@Me.Name</b> | Country=<b>@(Me.Country ?? "(null)")</b> | Warehouse=<b>@(Me.Warehouse ?? "(null)")</b>
        </div>
    </div>
}
else
{

@if (!string.IsNullOrEmpty(_globalErr)) { <div class="aiwms-alert error">@_globalErr</div> }
@if (!string.IsNullOrEmpty(_globalInfo)) { <div class="aiwms-alert info">@_globalInfo</div> }

@if (_lastException is not null)
{
    <div class="aiwms-section" style="border-left:4px solid var(--danger);background:#fff5f5">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
            <div>
                <div style="font-weight:700;color:var(--danger);font-size:14px">@_exContext</div>
                <div style="font-family:Consolas,monospace;font-size:12px;color:#842029">
                    @_lastException.GetType().FullName: @_lastException.Message
                </div>
                @if (!string.IsNullOrEmpty(_exDbOp))
                {
                    <div style="margin-top:6px;font-size:12px;color:#374151"><b>SQL operation:</b> @_exDbOp</div>
                }
            </div>
            <div style="display:flex;gap:6px">
                <button class="aiwms-btn aiwms-btn-secondary" style="padding:4px 10px;font-size:11px"
                        @onclick="() => _showStack = !_showStack">@(_showStack ? "Hide" : "Show") full trace</button>
                <button class="aiwms-btn aiwms-btn-secondary" style="padding:4px 10px;font-size:11px"
                        @onclick="() => { _lastException = null; _exContext = null; _exDbOp = null; _exDbSql = null; }">Dismiss</button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_exDbSql))
        {
            <details style="margin-bottom:6px">
                <summary style="cursor:pointer;font-size:12px;color:#0f172a">Failing SQL</summary>
                <pre style="background:#0f172a;color:#a7f3d0;padding:10px;border-radius:6px;font-size:11px;overflow:auto;max-height:200px;white-space:pre-wrap">@_exDbSql</pre>
            </details>
        }
        @if (_showStack)
        {
            <pre style="background:#1f2937;color:#fef2f2;padding:12px;border-radius:6px;font-size:11px;overflow:auto;max-height:400px;white-space:pre-wrap;word-break:break-word">@_lastException.ToString()</pre>
        }
    </div>
}

<style>
/* Big round SORT button — the primary touch target for a sorting station. */
.robo-sort-btn {
    width: 150px; height: 150px; border-radius: 50%;
    background: var(--bfl-yellow, #FFD400);
    border: 4px solid #1a1a1a;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 4px; cursor: pointer; color: #1a1a1a;
    box-shadow: 0 4px 0 #1a1a1a, 0 6px 14px rgba(0,0,0,.25);
    transition: transform .06s ease, box-shadow .06s ease;
}
.robo-sort-btn:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 5px 0 #1a1a1a, 0 8px 18px rgba(0,0,0,.28); }
.robo-sort-btn:active:not(:disabled) { transform: translateY(4px); box-shadow: 0 0 0 #1a1a1a, 0 2px 6px rgba(0,0,0,.2); }
.robo-sort-btn:disabled { opacity: .4; cursor: not-allowed; box-shadow: 0 4px 0 #999; border-color: #999; color: #555; }
.robo-sort-label { font-size: 20px; font-weight: 900; letter-spacing: .12em; }
</style>

<div style="display:grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap:14px; align-items:start">

    <!-- ============== LEFT: INPUTS ============== -->
    <div class="aiwms-section aiwms-input-frame">
        <div class="aiwms-card-header">Inputs</div>
        <div class="aiwms-input-grid">
            <div class="aiwms-input-row">
                <label class="aiwms-input-lbl">Cont. No <span class="req">*</span></label>
                <input @ref="_contRef" @bind="_contInput" @bind:event="oninput" @onkeydown="OnContKey"
                       class="aiwms-input @(_contOk ? "ok" : "")"
                       placeholder="AEINT6078" autocomplete="off" disabled="@_busy" />
            </div>
            <div class="aiwms-input-row">
                <label class="aiwms-input-lbl">Logistics Box # <span class="req">*</span></label>
                <input @ref="_boxRef" @bind="_boxInput" @bind:event="oninput" @onkeydown="OnBoxKey"
                       class="aiwms-input @(_boxOk ? "ok" : "")"
                       placeholder="AEINT6078-406330/001/010" autocomplete="off"
                       disabled="@(!_contOk || _busy)" />
            </div>
            <div class="aiwms-input-row" style="display:grid; grid-template-columns: minmax(0,150px) minmax(0,1fr); gap:12px">
                <div>
                    <label class="aiwms-input-lbl">PO No</label>
                    <input class="aiwms-input" value="@(_poNumber ?? (_boxOk ? "NA" : ""))" disabled />
                </div>
                <div>
                    <label class="aiwms-input-lbl">Exception</label>
                    <select class="aiwms-input" @bind="_exceptionSelected"
                            disabled="@(!_boxOk || _busy || _exceptionOptions.Count == 0)"
                            title="Applies to the next scan only, then auto-clears">
                        <option value="">— none —</option>
                        @foreach (var e in _exceptionOptions)
                        {
                            <option value="@e.PalletType">@e.PalletType — @e.TypeName</option>
                        }
                    </select>
                </div>
            </div>
            <div class="aiwms-input-row">
                <label class="aiwms-input-lbl">Itemcode (UPC) <span class="req">*</span></label>
                <input @ref="_itemRef"
                       @bind="_itemInput" @bind:event="oninput"
                       @onkeydown="OnItemKey"
                       class="aiwms-input"
                       placeholder="Scan or type item code" autocomplete="off"
                       disabled="@(!_boxOk || _busy)" />
            </div>
        </div>

        <div class="aiwms-input-actions" style="display:flex; gap:10px; align-items:center; flex-wrap:wrap">
            <button class="aiwms-btn aiwms-btn-secondary" @onclick="ResetAll">Reset all</button>
            <div style="font-size:13px; color:var(--text-secondary)">
                Scanned Box Qty: <b style="font-size:14px; color:var(--text-primary)">@_stagedItems.Sum(x => x.Qty)</b>
            </div>
            <div style="flex:1"></div>
            <button class="aiwms-btn aiwms-btn-danger" @onclick="CloseLogisticsAsync"
                    disabled="@(!_boxOk || _busy)"
                    title="Mark this logistics box closed in WmsKNBBoxes">
                Close Logistics
            </button>
        </div>

        <!-- ============== SORT + LABEL PRINT ============== -->
        <div style="display:flex; align-items:center; justify-content:center; gap:22px; padding:18px 0 6px 0; border-top:1px solid var(--border-default); margin-top:12px">
            <button class="robo-sort-btn" @onclick="ScanItem"
                    disabled="@(!_boxOk || _busy || string.IsNullOrWhiteSpace(_itemInput))"
                    title="Sort the scanned item — same action as pressing Enter in Itemcode">
                @* Inline SVG so the button carries no external asset (CSP-safe, scales cleanly). *@
                <svg width="62" height="62" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <line x1="32" y1="6" x2="32" y2="14" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                    <circle cx="32" cy="5" r="3.5" fill="currentColor" />
                    <rect x="12" y="14" width="40" height="30" rx="9" fill="currentColor" />
                    <circle cx="23" cy="27" r="5" fill="var(--bfl-yellow, #FFD400)" />
                    <circle cx="41" cy="27" r="5" fill="var(--bfl-yellow, #FFD400)" />
                    <rect x="24" y="35" width="16" height="4" rx="2" fill="var(--bfl-yellow, #FFD400)" />
                    <rect x="4" y="22" width="6" height="14" rx="3" fill="currentColor" />
                    <rect x="54" y="22" width="6" height="14" rx="3" fill="currentColor" />
                    <rect x="18" y="48" width="28" height="8" rx="4" fill="currentColor" />
                </svg>
                <span class="robo-sort-label">SORT</span>
            </button>

            <div style="display:flex; flex-direction:column; gap:8px">
                <button class="aiwms-btn aiwms-btn-secondary" style="padding:12px 18px; font-size:14px"
                        @onclick="PrintLabelAsync"
                        disabled="@(_lastAlloc is null || _busy)"
                        title="Print the price ticket for the last sorted item">
                    🖨 Print Label
                </button>
                <button class="aiwms-btn aiwms-btn-secondary" style="padding:6px 12px; font-size:11px"
                        @onclick="TestPrintAsync" disabled="@_busy"
                        title="Print a full sample label — no container, box or scan needed">
                    Test print
                </button>

                @* Label geometry lives on the page, not in a constant, because it is
                   found by trial against real stock — a redeploy per attempt is not a
                   workable loop for someone standing at the printer. *@
                <div style="display:flex; gap:4px; align-items:flex-end; margin-top:2px">
                    <div style="width:52px">
                        <label style="display:block; font-size:9px; font-weight:700; color:var(--text-secondary)">W mm</label>
                        <input type="number" @bind="_labelWidthMm" min="10" max="200"
                               style="width:100%; padding:3px 4px; font-size:11px; border:1px solid var(--border-default); border-radius:var(--r-sm)" />
                    </div>
                    <div style="width:52px">
                        <label style="display:block; font-size:9px; font-weight:700; color:var(--text-secondary)">H mm</label>
                        <input type="number" @bind="_labelHeightMm" min="10" max="200"
                               style="width:100%; padding:3px 4px; font-size:11px; border:1px solid var(--border-default); border-radius:var(--r-sm)" />
                    </div>
                    <div style="width:56px">
                        <label style="display:block; font-size:9px; font-weight:700; color:var(--text-secondary)">DPI</label>
                        <select @bind="_labelDpi"
                                style="width:100%; padding:3px 4px; font-size:11px; border:1px solid var(--border-default); border-radius:var(--r-sm)">
                            <option value="203">203</option>
                            <option value="300">300</option>
                        </select>
                    </div>
                </div>
                <button class="aiwms-btn aiwms-btn-secondary" style="padding:4px 10px; font-size:10px"
                        @onclick="ReadMediaAsync" disabled="@_busy"
                        title="Ask the printer what media size it is set to">
                    Read from printer
                </button>
            </div>
        </div>
    </div>

    <!-- ============== RIGHT: ITEM DETAILS + RESULT ============== -->
    <div class="aiwms-section aiwms-item-frame">
        <div class="aiwms-card-header">Item Details</div>
        @if (_lastItem is null)
        {
            <div class="aiwms-output-empty">Scan an item to see details &amp; allocation.</div>
        }
        else
        {
            var it = _lastItem;
            <div class="aiwms-upc-display" style="font-size:18px; padding:6px 10px">
                @it.ItemCode
                @if (_lastAlloc?.ItemSource is { Length: > 0 } src)
                {
                    <span class="aiwms-pill" style="margin-left:8px; font-size:10px; background:#eef; color:#334; border:1px solid #ccd"
                          title="Source: @src">SRC: @src</span>
                }
                @if (_lastAlloc?.Tier == Wms.Data.Lpm.AllocationTier.Tier2_OtsOverflow)
                {
                    <span class="aiwms-pill" style="margin-left:6px; font-size:10px; background:#fee; color:#933; border:1px solid #f99"
                          title="Item is in the container's Order Sheet but all planned qty has been issued — surplus piece.">EXCESS QTY</span>
                }
                else if (_lastAlloc?.Tier == Wms.Data.Lpm.AllocationTier.Tier3_ManualNewItem)
                {
                    <span class="aiwms-pill" style="margin-left:6px; font-size:10px; background:#fee; color:#933; border:1px solid #f99"
                          title="Item is not on the container's Order Sheet at all — sourced from @(_lastAlloc?.ItemSource ?? "external").">EXCESS ITEM</span>
                }
            </div>
            <div class="aiwms-item-grid" style="grid-template-columns: repeat(3, 1fr); gap:8px 14px; font-size:13px">
                <div class="cell"><div class="lbl" style="font-size:11px">Description</div><div class="val" style="font-size:14px; line-height:1.3">@it.ItemName</div></div>
                <div class="cell"><div class="lbl" style="font-size:11px">Style</div><div class="val" style="font-size:14px; line-height:1.3">@it.Style</div></div>
                <div class="cell"><div class="lbl" style="font-size:11px">Size</div><div class="val" style="font-size:14px; line-height:1.3">@it.Size</div></div>
                <div class="cell"><div class="lbl" style="font-size:11px">Color</div><div class="val" style="font-size:14px; line-height:1.3">@it.Color</div></div>
                <div class="cell"><div class="lbl" style="font-size:11px">Brand</div><div class="val" style="font-size:14px; line-height:1.3">@it.Brand</div></div>
                <div class="cell"><div class="lbl" style="font-size:11px">Gender</div><div class="val" style="font-size:14px; line-height:1.3">@it.Gender</div></div>
                <div class="cell"><div class="lbl" style="font-size:11px">Season</div><div class="val" style="font-size:14px; line-height:1.3">@it.Season</div></div>
                <div class="cell"><div class="lbl" style="font-size:11px">HS Code</div><div class="val" style="font-size:14px; line-height:1.3">@it.HsCode</div></div>
                <div class="cell"><div class="lbl" style="font-size:11px">Division</div><div class="val" style="font-size:14px; line-height:1.3">@it.Division</div></div>
                <div class="cell"><div class="lbl" style="font-size:11px">Department</div><div class="val" style="font-size:14px; line-height:1.3">@it.Department</div></div>
                <div class="cell"><div class="lbl" style="font-size:11px">Class</div><div class="val" style="font-size:14px; line-height:1.3">@it.Class</div></div>
                <div class="cell"><div class="lbl" style="font-size:11px">Family / Subclass</div><div class="val" style="font-size:14px; line-height:1.3">@it.Family @(string.IsNullOrEmpty(it.Subclass) ? "" : " / " + it.Subclass)</div></div>
            </div>
        }

        @if (_lastAlloc is { } al)
        {
            <div class="aiwms-result-row" style="background:@(_lastAppliedException is null ? "#22c55e" : "#fde68a"); color:@(_lastAppliedException is null ? "#ffffff" : "inherit"); padding:10px 12px; border-radius:var(--r-sm); border:1px solid @(_lastAppliedException is null ? "#16a34a" : "#f59e0b")">
                <div class="aiwms-result-tag" style="@(_lastAppliedException is null ? "background:#ffffff; color:#166534;" : "")">@(_lastAppliedException is null ? "RESULT" : "EXCEPTION")</div>
                <div class="aiwms-result-value" style="font-size:22px; font-weight:800; line-height:1.2; color:#ffffff">
                    @if (_lastAppliedException is (var exPt, var exName))
                    {
                        <b>@exPt@(string.IsNullOrEmpty(exName) ? "" : " — " + exName)</b>
                        <span class="aiwms-pill tier@((int)al.Tier)" style="margin-left:10px;font-size:11px;font-weight:600"
                              title="Underlying Tier — allocation row @al.AllocationIdNo was tagged with the exception">Tier @((int)al.Tier)</span>
                    }
                    else
                    {
                        @(al.PalletType ?? al.Result)@(string.IsNullOrEmpty(al.PalletTypeName) ? "" : " — " + al.PalletTypeName)
                        @if (!string.IsNullOrEmpty(al.Country))
                        {
                            <span class="aiwms-pill" style="margin-left:10px;font-size:11px;font-weight:700;background:#ffffff;color:#166534;border:1px solid #16a34a"
                                  title="Country of the resolved allocation row">@al.Country</span>
                        }
                        <span class="aiwms-pill tier@((int)al.Tier)" style="margin-left:10px;font-size:11px;font-weight:600"
                              title="@TierTitle(al.Tier)">Tier @((int)al.Tier) — @TierShort(al.Tier)</span>
                        @if (al.Manual)
                        {
                            <span class="aiwms-pill tier4" style="margin-left:6px;font-size:11px;background:#fff3cd;color:#664d03;border:1px solid #ffe69c"
                                  title="Item not in container — added from usa.upcbarcodes at scan time">MANUAL</span>
                        }
                    }
                </div>
            </div>
            <div class="aiwms-result-meta">
                @if (_lastAppliedException is null)
                {
                    <div style="grid-column: span 2"><span class="lbl">Store</span> <b>@(al.StoreId ?? "—")</b>@(string.IsNullOrEmpty(al.StoreName) ? "" : $" — {al.StoreName}")</div>
                    <div><span class="lbl">Division</span> <b>@(al.Division ?? "—")</b></div>
                }
                else
                {
                    <div style="grid-column: span 3; color:#92400e; font-weight:600">Item held for exception — not routed to a store.</div>
                }
                <div><span class="lbl">LPMDt</span> <b>@(al.LpmDt?.ToString("dd/MM/yyyy") ?? "—")</b></div>
                <div><span class="lbl">PO</span> <b>@(al.PoNumber ?? "NA")</b></div>
                @if (_currentBoxNo is not null) { <div><span class="lbl">Box</span> <b>@_currentBoxNo</b></div> }
            </div>
        }
    </div>

</div>

<div class="aiwms-section" style="margin-top:14px">
    <div class="aiwms-card-header" style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px">
        <span>
            My Scans
            @if (_contOk) { <text>— container <b>@_contno</b> — @_todayScans.Count scan(s)</text> }
            else          { <text>— today's scans across all containers — @_todayScans.Count scan(s)</text> }
        </span>
        <button class="aiwms-btn aiwms-btn-secondary" style="font-size:11px; padding:4px 10px"
                @onclick="RefreshTodayScansAsync" disabled="@_busy">Refresh</button>
    </div>
    @if (_todayScans.Count == 0)
    {
        <div style="padding:14px; font-style:italic; color:var(--text-secondary)">
            @(_contOk ? $"No scans by you into container {_contno} yet." : "No scans by you today yet.")
        </div>
    }
    else
    {
        <div style="max-height:340px; overflow:auto">
            <table class="aiwms-table aiwms-table-dense" style="font-size:11px">
                <thead style="position:sticky; top:0; background:white; z-index:1">
                    <tr>
                        <th>TrnDate</th><th>Time</th><th>ContNo</th><th>ItemCode</th>
                        <th>Final Result</th><th>Tier</th><th>Store</th><th>Store Name</th>
                        <th>Division</th><th>Box</th><th>Logistics Box</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _todayScans.OrderByDescending(x => x.ScannedTS))
                    {
                        <tr>
                            <td>@r.ScannedTS.ToString("dd/MM/yyyy")</td>
                            <td>@r.ScannedTS.ToString("HH:mm:ss")</td>
                            <td style="font-family:var(--font-mono)">@r.ContNo</td>
                            <td style="font-family:var(--font-mono)"><b>@r.Itemcode</b></td>
                            <td title="@r.PalletTypeName">@r.PalletType@(string.IsNullOrEmpty(r.PalletTypeName) ? "" : " — " + r.PalletTypeName)@(r.Manual == "Y" ? " ★" : "")</td>
                            <td><span class="aiwms-pill tier@(r.Tier)" style="font-size:10px; padding:1px 6px">@r.Tier</span></td>
                            <td style="font-family:var(--font-mono)">@r.StoreID</td>
                            <td>@r.StoreName</td>
                            <td>@r.Division</td>
                            <td style="font-family:var(--font-mono)">@r.BoxNo</td>
                            <td style="font-family:var(--font-mono)">@r.LogisticsBoxNo</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

}

@code {
    private bool _busy;
    private string? _globalErr, _globalInfo;
    private Exception? _lastException;
    private string? _exContext, _exDbOp, _exDbSql;
    private bool _showStack;

    private ElementReference _contRef, _boxRef, _itemRef;

    private string _contInput = "", _contno = "";
    private bool _contOk;

    private string _boxInput = "", _boxLabel = "";
    private bool _boxOk;
    private string? _poNumber;

    private string _itemInput = "";
    private ItemDetails? _lastItem;
    private AllocationResult? _lastAlloc;
    private string? _currentBoxNo;
    private List<StagedItemRow> _stagedItems = new();

    private List<TodayScanRow> _todayScans = new();

    // Exception dropdown — one-shot: applies to next scan, then auto-clears.
    private List<ExceptionPalletTypeRow> _exceptionOptions = new();
    private string _exceptionSelected = "";
    private (string PalletType, string? TypeName)? _lastAppliedException;

    protected override async Task OnInitializedAsync()
    {
        await Me.EnsureLoadedAsync();
        try { _exceptionOptions = await Build.GetExceptionPalletTypesAsync(); }
        catch { _exceptionOptions = new(); }
        await RefreshTodayScansAsync();
    }

    private async Task RefreshTodayScansAsync()
    {
        try { _todayScans = await Build.GetTodayScansAsync(contno: _contOk ? _contno : null); }
        catch { /* keep prior list */ }
    }

    // Focus survives the re-render that RefreshTodayScansAsync triggers by
    // scheduling it in OnAfterRenderAsync rather than racing the render pipeline.
    private bool _needFocusItem;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(Me.Warehouse))
            await TryFocus(_contRef);
        if (_needFocusItem)
        {
            _needFocusItem = false;
            await TryFocus(_itemRef);
        }
    }

    private async Task OnContKey(KeyboardEventArgs e) { if (e.Key == "Enter") await ValidateContainer(); }
    private async Task OnBoxKey(KeyboardEventArgs e)  { if (e.Key == "Enter") await ValidateBox(); }
    private async Task OnItemKey(KeyboardEventArgs e) { if (e.Key == "Enter") await ScanItem(); }

    private async Task ValidateContainer()
    {
        ClearTransient(); _busy = true;
        try
        {
            var input = (_contInput ?? "").Trim().ToUpperInvariant();
            if (string.IsNullOrEmpty(input)) { _globalErr = "Container number is required."; return; }
            var v = await Build.ValidateContainerAsync(input);
            if (!v.Ok) { _globalErr = v.Error; await Beep(); return; }
            _contno = input; _contOk = true;
            await RefreshTodayScansAsync();
            await Audit.LogAsync("RoboSorting.Container", _contno, 'X', $"RoboSorting/{_contno}", new { event_ = "validate" });
            await TryFocus(_boxRef);
        }
        catch (Exception ex) { CaptureException(ex, "ValidateContainer failed"); }
        finally { _busy = false; }
    }

    private async Task ValidateBox()
    {
        ClearTransient(); _busy = true;
        try
        {
            if (!_contOk) { _globalErr = "Validate container first."; return; }
            var input = (_boxInput ?? "").Trim();
            var v = await Build.ValidateBoxAsync(_contno, input);
            if (!v.Ok) { _globalErr = v.Error; await Beep(); return; }
            _boxLabel = input; _poNumber = v.PoAvailable ? v.PoNumber : null; _boxOk = true;
            await Audit.LogAsync("RoboSorting.Box", $"{_contno}/{_boxLabel}", 'X', $"RoboSorting/{_contno}/{_boxLabel}",
                new { po = _poNumber, has_po = v.PoAvailable });
            await TryFocus(_itemRef);
        }
        catch (Exception ex) { CaptureException(ex, "ValidateBox failed"); }
        finally { _busy = false; }
    }

    // Bound to both Enter-in-Itemcode and the big SORT button — the button is the
    // touch-station equivalent of pressing Enter, not a separate step.
    //
    // Identical to Manual Counting's ScanItem apart from the tote gate, which is
    // deliberately absent: there is no Boxes grid here to Check-In a tote from, and
    // FindOrCreateOpenBoxAsync already creates boxes without requiring one.
    private async Task ScanItem()
    {
        ClearTransient(); _busy = true;
        var raw = _itemInput ?? "";

        _lastItem = null; _lastAlloc = null; _lastAppliedException = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            if (!_boxOk) { _globalErr = "Validate box first."; return; }
            if (string.IsNullOrWhiteSpace(raw)) { _globalErr = "Item code is required."; await Beep(); await TryFocus(_itemRef); return; }

            var iv = ItemCodeValidator.Validate(raw);
            if (!iv.IsValid) { _globalErr = iv.Error; await Beep(); await TryFocus(_itemRef); return; }
            var code = iv.Normalized;

            var item = await Build.GetItemDetailsAsync(_contno, code);
            if (item is null || item.Availability == ItemAvailability.NotFound)
            {
                _globalErr = $"Item {code} not found in Item Master API, Generated Barcodes, or usa.upcbarcodes. " +
                             "Add via Item Encoding, or check the WMS Itemmaster API is reachable and this UPC exists there.";
                await Beep(); await TryFocus(_itemRef); return;
            }

            var alloc = await Build.ResolveAllocationAsync(_contno, code, _poNumber, item.Style);
            if (!alloc.Found) { _globalErr = alloc.Error ?? "Could not resolve allocation."; await Beep(); return; }

            if (!string.IsNullOrEmpty(_exceptionSelected) && alloc.AllocationIdNo is int aid)
            {
                var exOpt = _exceptionOptions.FirstOrDefault(e => e.PalletType == _exceptionSelected);
                var exName = exOpt?.TypeName;
                var (exOk, exErr) = await Build.ApplyExceptionToAllocationAsync(aid, _exceptionSelected, exName);
                if (!exOk)
                {
                    _globalErr = $"Exception apply failed: {exErr}. Item scan will still record without the exception.";
                    await Beep();
                }
                else
                {
                    _lastAppliedException = (_exceptionSelected, exName);
                }
                _exceptionSelected = "";
            }

            string palletType;
            string? division, season;
            DateTime? lpmDt = alloc.LpmDt;
            bool isException = _lastAppliedException is not null;
            if (isException)
            {
                palletType = _lastAppliedException!.Value.PalletType;
                division   = null;
                season     = null;
            }
            else
            {
                palletType = alloc.PalletType ?? "STD";
                division   = alloc.Division ?? item.Division;
                season     = item.Season;
            }

            var boxNo = await Build.FindOrCreateOpenBoxAsync(
                _contno, palletType, division, season, lpmDt, _boxLabel,
                matchDivSeason: !isException);

            await Build.StageItemToBoxAsync(_contno, boxNo, code, alloc, item);

            _currentBoxNo = boxNo;
            _lastItem = item; _lastAlloc = alloc;
            _stagedItems = await Build.GetStagedItemsAsync(boxNo);
            await RefreshTodayScansAsync();

            if (alloc.Tier == AllocationTier.Tier2_OtsOverflow)
                _globalInfo = $"Overflow piece — all allocated rows for {code} are full. Routed to store {alloc.StoreId} by OTS.";
            else if (alloc.Tier == AllocationTier.Tier3_ManualNewItem)
                _globalInfo = $"{code} was not in container {_contno} — added from item master and routed to store {alloc.StoreId} by OTS.";

            await Audit.LogAsync("RoboSorting.Item", $"{_contno}/{boxNo}/{code}", 'I',
                $"RoboSorting/{_contno}/{boxNo}",
                new { code, alloc.Result, tier = (int)alloc.Tier, action = alloc.Action.ToString(),
                      store = alloc.StoreId, manual = alloc.Manual });

            _itemInput = "";
            _needFocusItem = true;
        }
        catch (Exception ex) { CaptureException(ex, $"ScanItem failed (item='{raw}', cont='{_contno}', box='{_boxLabel}')"); await Beep(); }
        finally { _busy = false; _needFocusItem = true; }
    }

    // Retail price ticket for the piece just sorted, in the Brands For Less
    // format: header, English description left / Arabic right, EAN-13 barcode,
    // barcode digits, then price + item codes + Arabic price.
    //
    // Browser-print rather than direct-to-printer: there is no print service or
    // ZPL pipeline anywhere in this app, so this uses what every workstation
    // already has. Swap for a label-printer integration when one exists.
    private async Task PrintLabelAsync()
    {
        if (_lastAlloc is not { } al || _lastItem is not { } it) return;
        if (al.AllocationIdNo is not int aid) { _globalErr = "No allocation row to price."; return; }

        _busy = true;
        try
        {
            var label = await Build.GetPriceLabelAsync(aid, it.ItemCode);
            var (ccy, ccyAr) = CurrencyFor(label.Country ?? al.Country);

            // Zebra first. The module renders the label to a canvas and ships it as
            // a ^GFA graphic through Zebra Browser Print on the station — ZPL text
            // cannot carry Arabic (no resident glyphs, no contextual shaping).
            // "NO_PRINTER" means Browser Print isn't installed/running here, which
            // is the one case worth falling through to the browser print window for.
            var zebra = await TryPrintZebraAsync(it, al, label, ccy, ccyAr);
            if (zebra is not null && zebra.StartsWith("OK:"))
            {
                _globalInfo = $"Label sent to {zebra[3..]}."
                            + (label.SalesPrice is null
                                ? $" No SalesPrice on allocation row {aid} — printed without a price."
                                : "");
                return;
            }

            // Anything else falls through to the on-page print, but SAYS WHY first.
            // The original version returned silently on several paths, which is what
            // "it's not printing" looked like from the floor.
            _fallbackReason = zebra switch
            {
                null              => "Label module failed to load — using the browser print dialog.",
                "NO_PRINTER"      => "Zebra Browser Print isn't running on this PC — using the browser print dialog.",
                _                 => $"Zebra print failed ({zebra}) — using the browser print dialog.",
            };

            // Bars are omitted rather than faked when the code is not EAN-13-able —
            // a ticket with a barcode that scans to the wrong thing is worse than
            // one the operator has to key in.
            var barsSvg = Wms.Core.Ean13Barcode.ToSvg(it.ItemCode);
            var digits  = Wms.Core.Ean13Barcode.Normalize(it.ItemCode) ?? it.ItemCode;

            var priceTxt   = label.SalesPrice is { } p ? p.ToString("0.##") : "";
            var priceAr    = priceTxt.Length == 0 ? "" : ToArabicDigits(priceTxt);
            var codesLine  = string.Join(" ", new[] { it.Season, it.Style, it.Size }
                                                 .Where(x => !string.IsNullOrWhiteSpace(x)));

            var html =
                "<html><head><meta charset='utf-8'><title>Label</title><style>" +
                "@page{size:100mm 50mm;margin:3mm}" +
                "body{font-family:Arial,Helvetica,sans-serif;margin:0;color:#000}" +
                ".hdr{font-size:30px;font-weight:900;letter-spacing:.02em;line-height:1;margin-bottom:6px}" +
                ".desc{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:6px}" +
                ".en{font-size:17px;font-weight:700;line-height:1.15;max-width:58%}" +
                ".ar{font-size:19px;font-weight:700;line-height:1.15;direction:rtl;text-align:right;max-width:40%}" +
                ".bars{margin:2px 0 1px 0}" +
                ".num{font-size:19px;font-weight:700;letter-spacing:.16em;margin-bottom:4px}" +
                ".foot{display:flex;justify-content:space-between;align-items:baseline;gap:10px}" +
                ".price{font-size:29px;font-weight:900;white-space:nowrap}" +
                ".codes{font-size:15px;font-weight:600;letter-spacing:.04em}" +
                ".pricear{font-size:23px;font-weight:800;direction:rtl;white-space:nowrap}" +
                ".nobc{font-size:11px;color:#444;margin:6px 0}" +
                "</style></head><body>" +
                "<div class='hdr'>BRANDS FOR LESS</div>" +
                "<div class='desc'>" +
                    $"<div class='en'>{Esc(it.ItemName)}</div>" +
                    $"<div class='ar'>{Esc(label.ArabicDesc)}</div>" +
                "</div>" +
                (barsSvg is null
                    ? "<div class='nobc'>No EAN-13 barcode — item code is not a 12/13-digit GTIN.</div>"
                    : $"<div class='bars'>{barsSvg}</div>") +
                $"<div class='num'>{Esc(digits)}</div>" +
                "<div class='foot'>" +
                    $"<div class='price'>{Esc(ccy)} {Esc(priceTxt)}</div>" +
                    $"<div class='codes'>{Esc(codesLine)}</div>" +
                    $"<div class='pricear'>{Esc(priceAr)} {Esc(ccyAr)}</div>" +
                "</div>" +
                "</body></html>";

            // Hidden iframe, not window.open — a popup blocker silently kills
            // window.open, and the old code's `if(!w) return;` meant the click did
            // absolutely nothing with no message. An iframe is never popup-blocked.
            await JS.InvokeVoidAsync("eval",
                "(function(){var id='__wmsLabelFrame';var old=document.getElementById(id);" +
                "if(old)old.remove();var f=document.createElement('iframe');f.id=id;" +
                "f.style.cssText='position:fixed;right:0;bottom:0;width:0;height:0;border:0';" +
                "document.body.appendChild(f);var d=f.contentWindow.document;d.open();" +
                "d.write(" + System.Text.Json.JsonSerializer.Serialize(html) + ");d.close();" +
                "setTimeout(function(){try{f.contentWindow.focus();f.contentWindow.print();}catch(e){}},300);})();");

            _globalInfo = _fallbackReason
                        + (label.SalesPrice is null
                            ? $" No SalesPrice on allocation row {aid} — printed without a price."
                            : "");
        }
        catch (Exception ex) { CaptureException(ex, "PrintLabel failed"); }
        finally { _busy = false; _fallbackReason = ""; }
    }

    private string _fallbackReason = "";

    /// <summary>
    /// Fires a complete sample label at the Zebra using the reference ticket's own
    /// values — no container, box or item scan needed. This is the commissioning
    /// tool: it proves Browser Print, the printer, the label stock and the DPI
    /// setting in one click, and it is the only way to check the layout without
    /// consuming a real allocation.
    ///
    /// Values are the sample ticket verbatim, so what comes out can be held against
    /// the printed original.
    /// </summary>
    private async Task TestPrintAsync()
    {
        ClearTransient(); _busy = true;
        try
        {
            var fields = new
            {
                descEn    = "DKNY Pyjama Top and Plaid",
                descAr    = "طقم قميص وشورت",
                codeLine  = "404-3-8-0065-00-00-T1-T81-0826",
                ean13     = "5056848418441",
                priceEn   = "QR 65",
                priceAr   = "٦٥ ر.ق",
                codesFoot = "P6 Q4-QD6006 D7",
            };
            var opts = new { dpi = _labelDpi, widthMm = _labelWidthMm, heightMm = _labelHeightMm };

            var js  = await LabelJsAsync();
            var res = await js.InvokeAsync<string>("printLabel", fields, opts);

            if (res.StartsWith("OK:"))
                ShowInfo($"Test label sent to {res[3..]} — {_labelWidthMm}×{_labelHeightMm}mm at {_labelDpi}dpi.");
            else if (res == "NO_PRINTER")
                ShowError("Zebra Browser Print did not answer on 127.0.0.1:9100 or :9101. " +
                          "Install it on this PC (free, from Zebra's support site) and set the ZD421 " +
                          "as its default device.");
            else
                ShowError($"Browser Print reached, but the job failed: {res}");
        }
        catch (Exception ex)
        {
            ShowError($"Could not load the label module (/js/robo-label.js): {ex.Message}");
        }
        finally { _busy = false; }
    }

    private void ShowError(string m) { _globalErr = m; _globalInfo = null; }
    private void ShowInfo(string m)  { _globalInfo = m; _globalErr = null; }

    // Label geometry — editable on the page. The first test print came out clipped
    // on the right and cut off below the barcode because the stock is smaller than
    // the 100x50mm these used to be hard-coded to, and finding the real size by
    // redeploying once per guess is not a workable loop.
    private int _labelWidthMm  = 50;
    private int _labelHeightMm = 20;
    private int _labelDpi      = 203;

    /// <summary>Asks the ZD421 what media it is configured for and fills the boxes.
    /// SGD reads are the flakiest part of Browser Print, so a blank answer means
    /// "measure it and type it in", not that anything is broken.</summary>
    private async Task ReadMediaAsync()
    {
        ClearTransient(); _busy = true;
        try
        {
            var js = await LabelJsAsync();
            var res = await js.InvokeAsync<string>("readMedia");
            var parts = (res ?? "").Split(',');
            if (parts.Length == 3
                && int.TryParse(parts[0], out var w) && w > 0
                && int.TryParse(parts[1], out var h) && h > 0
                && int.TryParse(parts[2], out var d) && d > 0)
            {
                _labelWidthMm = w; _labelHeightMm = h; _labelDpi = d;
                ShowInfo($"Printer reports {w}×{h}mm at {d}dpi — Test print will use that.");
            }
            else
            {
                ShowError("The printer didn't report a media size. Measure the label and " +
                          "type W/H in mm, then Test print.");
            }
        }
        catch (Exception ex) { ShowError($"Read from printer failed: {ex.Message}"); }
        finally { _busy = false; }
    }

    private IJSObjectReference? _labelJs;

    private async Task<IJSObjectReference> LabelJsAsync() =>
        _labelJs ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/robo-label.js");

    /// <summary>
    /// Returns the module's status string, or null when the module itself could
    /// not be reached. A print problem must never lose the scan that produced the
    /// label, so every failure path here is a message, not an exception.
    /// </summary>
    private async Task<string?> TryPrintZebraAsync(
        ItemDetails it, AllocationResult al, PriceLabelData label, string ccy, string ccyAr)
    {
        try
        {
            var priceTxt = label.SalesPrice is { } p ? p.ToString("0.##") : "";
            var fields = new
            {
                descEn    = it.ItemName ?? "",
                descAr    = label.ArabicDesc ?? "",
                codeLine  = it.ItemCode ?? "",
                ean13     = Wms.Core.Ean13Barcode.Normalize(it.ItemCode) ?? "",
                priceEn   = priceTxt.Length == 0 ? "" : $"{ccy} {priceTxt}",
                priceAr   = priceTxt.Length == 0 ? "" : $"{ToArabicDigits(priceTxt)} {ccyAr}",
                codesFoot = string.Join(" ", new[] { it.Season, it.Style, it.Size }
                                                 .Where(x => !string.IsNullOrWhiteSpace(x))),
            };
            var opts = new { dpi = _labelDpi, widthMm = _labelWidthMm, heightMm = _labelHeightMm };

            var js = await LabelJsAsync();
            return await js.InvokeAsync<string>("printLabel", fields, opts);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[WMS] Zebra print module failed: {ex}");
            return null;   // fall through to the browser print window
        }
    }

    // Ticket currency by country. Short forms match the printed sample ("QR 65"),
    // not ISO codes.
    private static (string En, string Ar) CurrencyFor(string? country) =>
        (country ?? "").Trim().ToUpperInvariant() switch
        {
            "QATAR"   => ("QR",  "ر.ق"),
            "KSA" or "SAUDI" or "SAUDI ARABIA" => ("SR", "ر.س"),
            "KUWAIT"  => ("KD",  "د.ك"),
            "BAHRAIN" => ("BD",  "د.ب"),
            "OMAN"    => ("OMR", "ر.ع"),
            _         => ("AED", "د.إ"),   // UAE + ECOM
        };

    // Western digits -> Arabic-Indic, so the price reads as ٦٥ on the RTL side.
    private static string ToArabicDigits(string s)
    {
        var sb = new System.Text.StringBuilder(s.Length);
        foreach (var ch in s)
            sb.Append(char.IsDigit(ch) ? (char)('٠' + (ch - '0')) : ch);
        return sb.ToString();
    }

    private static string Esc(string? s) =>
        System.Net.WebUtility.HtmlEncode(s ?? "");

    private async Task CloseLogisticsAsync()
    {
        if (!_boxOk || string.IsNullOrWhiteSpace(_boxLabel)) return;
        ClearTransient();
        int pcs = 0;
        try { pcs = await Build.GetLogisticsBoxScanCountAsync(_contno, _boxLabel); } catch { }
        var ok = await ConfirmAsync(
            $"Close logistics box {_boxLabel}?\n\n" +
            $"{pcs} piece(s) scanned into this logistics box so far. " +
            "This marks it Closed='Y' in WmsKNBBoxes.");
        if (!ok) return;
        _busy = true;
        try
        {
            var result = await Build.CloseLogisticsBoxAsync(_contno, _boxLabel);
            if (!result.Ok) { _globalErr = result.Error; await Beep(); return; }
            _globalInfo = $"Logistics box {_boxLabel} closed ({result.PcsScanned} pcs recorded).";
            await Audit.LogAsync("RoboSorting.CloseLogistics", $"{_contno}/{_boxLabel}", 'U',
                $"RoboSorting/{_contno}/{_boxLabel}", new { pcs = result.PcsScanned });
            _boxInput = ""; _boxLabel = ""; _poNumber = null; _boxOk = false;
            _itemInput = ""; _lastItem = null; _lastAlloc = null;
            _currentBoxNo = null; _stagedItems.Clear();
            await TryFocus(_boxRef);
        }
        catch (Exception ex) { CaptureException(ex, $"CloseLogistics failed (cont='{_contno}', box='{_boxLabel}')"); await Beep(); }
        finally { _busy = false; }
    }

    private async Task ResetAll()
    {
        _contInput = ""; _contno = ""; _contOk = false;
        _boxInput = ""; _boxLabel = ""; _poNumber = null; _boxOk = false;
        _itemInput = ""; _lastItem = null; _lastAlloc = null;
        _lastAppliedException = null; _exceptionSelected = "";
        _currentBoxNo = null; _stagedItems.Clear();
        ClearTransient();
        await TryFocus(_contRef);
    }

    private async Task<bool> ConfirmAsync(string msg)
    {
        try { return await JS.InvokeAsync<bool>("confirm", msg); }
        catch { return true; }
    }

    private void ClearTransient() { _globalErr = null; _globalInfo = null; }

    private void CaptureException(Exception ex, string context)
    {
        _lastException = ex; _exContext = context;
        _exDbOp = Wms.Data.Lpm.DbOpContext.CurrentOp;
        _exDbSql = Wms.Data.Lpm.DbOpContext.CurrentSql;
        _showStack = false;
        Console.Error.WriteLine($"[WMS] {context}\n  SQL op: {_exDbOp}\n{ex}");
        Wms.Data.Lpm.DbOpContext.Clear();
    }

    private async Task TryFocus(ElementReference r) { try { await r.FocusAsync(); } catch { } }

    private async Task Beep()
    {
        try { await JS.InvokeVoidAsync("eval", "var a=new AudioContext();var o=a.createOscillator();o.frequency.value=200;o.connect(a.destination);o.start();setTimeout(()=>o.stop(),120);"); }
        catch { }
    }

    private static string TierShort(AllocationTier t) => t switch
    {
        AllocationTier.Tier1_HasCapacity   => "matched",
        AllocationTier.Tier2_OtsOverflow   => "OTS overflow",
        AllocationTier.Tier3_ManualNewItem => "manual",
        _ => t.ToString(),
    };

    private static string TierTitle(AllocationTier t) => t switch
    {
        AllocationTier.Tier1_HasCapacity   => "Tier 1 — existing allocation row had capacity (QtyIssue<Qty); QtyIssue incremented.",
        AllocationTier.Tier2_OtsOverflow   => "Tier 2 — item is in this container but every allocation row is full. Best store picked by remaining OTS (division-scoped, recomputed on the fly).",
        AllocationTier.Tier3_ManualNewItem => "Tier 3 — item was not in this container. Item details pulled from usa.upcbarcodes; best store picked by remaining OTS.",
        _ => "",
    };
}
