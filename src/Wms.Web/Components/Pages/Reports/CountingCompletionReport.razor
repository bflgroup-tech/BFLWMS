@code {
    private string _view = "Summary";
    private List<string> _countries = new();
    private HashSet<string> _selectedCountries = new();
    private DateTime _from = DateTime.Today.AddDays(-7);
    private DateTime _to   = DateTime.Today;
    private string _contNoFilter = "";
    private bool _loading;
    private bool _exporting;
    private string _message = "";
    private bool _isError;
    private string _search = "";
    private List<CountingCompletionSummaryRow> _summaryRows = new();
    private List<CountingAllocationRow>        _allocRows   = new();
    private List<CountingCompletionDetailRow>  _detailRows  = new();

    private int CurrentRowCount => _view switch
    {
        "Summary" => _summaryRows.Count,
        "Allocation" => _allocRows.Count,
        _ => _detailRows.Count
    };

    private bool HasContNoFilter => !string.IsNullOrWhiteSpace(_contNoFilter);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var list = await Svc.GetCountriesAsync();
            var excluded = new[] { "Ex2Locations", "Ecom" };
            _countries = list.Where(c => !excluded.Contains(c, StringComparer.OrdinalIgnoreCase)).ToList();
        }
        catch { /* fall back to empty list if the lookup fails */ }
    }

    private void ToggleCountry(string country, bool isChecked)
    {
        if (isChecked) _selectedCountries.Add(country);
        else _selectedCountries.Remove(country);
    }

    private void SetView(string view) => _view = view;

    private async Task LoadAsync()
    {
        _loading = true; _message = ""; _isError = false;
        _summaryRows = new(); _allocRows = new(); _detailRows = new();
        try
        {
            if (_view == "Summary")
            {
                _summaryRows = await Svc.GetCountingCompletionSummaryAsync(_selectedCountries, _from, _to, _contNoFilter);
                if (_summaryRows.Count == 0) _message = "No rows for the selected filters.";
            }
            else if (_view == "Allocation")
            {
                _allocRows = await Svc.GetCountingAllocationAsync(_selectedCountries, _from, _to, _contNoFilter);
                if (_allocRows.Count == 0) _message = "No rows for the selected filters.";
            }
            else
            {
                _detailRows = await Svc.GetCountingDetailAsync(_selectedCountries, _from, _to, _contNoFilter);
                if (_detailRows.Count == 0) _message = "No rows for the selected filters.";
            }
        }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
        finally { _loading = false; }
    }

    private async Task ExportExcelAsync()
    {
        if (CurrentRowCount == 0) return;
        _exporting = true;
        try
        {
            using var wb = new XLWorkbook();
            string name;

            if (_view == "Summary")
            {
                var ws = wb.AddWorksheet("Counting Completion");
                string[] headers =
                {
                    "Country", "Cont No", "PO No", "Counting Start Date", "Counting Completion Date",
                    "Cont-Purchase Date", "Counted Qty", "LPM Months", "Divisions", "Brands"
                };
                for (int i = 0; i < headers.Length; i++) ws.Cell(1, i + 1).Value = headers[i];
                ws.Row(1).Style.Font.Bold = true;

                int row = 2;
                foreach (var r in FilteredSummaryRows())
                {
                    ws.Cell(row, 1).Value  = DisplayCountry(r.Country);
                    ws.Cell(row, 2).Value  = r.ContNo;
                    ws.Cell(row, 3).Value  = r.PONo;
                    ws.Cell(row, 4).Value  = FmtDate(r.CountingStartDate);
                    ws.Cell(row, 5).Value  = FmtDate(r.CountingCompletionDate);
                    ws.Cell(row, 6).Value  = FmtDate(r.PurchaseDate);
                    ws.Cell(row, 7).Value  = r.CountedQty;
                    ws.Cell(row, 8).Value  = r.LpmMonths;
                    ws.Cell(row, 9).Value  = r.Divisions;
                    ws.Cell(row, 10).Value = r.Brands;
                    row++;
                }
                ws.Columns().AdjustToContents();
                name = $"counting-completion-summary-{_from:yyyyMMdd}-{_to:yyyyMMdd}.xlsx";
            }
            else if (_view == "Allocation")
            {
                var ws = wb.AddWorksheet("Allocation-wise");
                string[] headers =
                {
                    "Country", "Cont No", "PO No", "Counting Start Date", "Counting Completion Date",
                    "Cont-Purchase Date", "Box Category", "Build Qty", "LPM Months", "Divisions", "Brands"
                };
                for (int i = 0; i < headers.Length; i++) ws.Cell(1, i + 1).Value = headers[i];
                ws.Row(1).Style.Font.Bold = true;

                int row = 2;
                foreach (var r in FilteredAllocRows())
                {
                    ws.Cell(row, 1).Value  = DisplayCountry(r.Country);
                    ws.Cell(row, 2).Value  = r.ContNo;
                    ws.Cell(row, 3).Value  = r.PONo;
                    ws.Cell(row, 4).Value  = FmtDate(r.CountingStartDate);
                    ws.Cell(row, 5).Value  = FmtDate(r.CountingCompletionDate);
                    ws.Cell(row, 6).Value  = FmtDate(r.PurchaseDate);
                    ws.Cell(row, 7).Value  = r.PalletType;
                    ws.Cell(row, 8).Value  = r.BuildQty;
                    ws.Cell(row, 9).Value  = r.LpmMonths;
                    ws.Cell(row, 10).Value = r.Divisions;
                    ws.Cell(row, 11).Value = r.Brands;
                    row++;
                }
                ws.Columns().AdjustToContents();
                name = $"counting-completion-allocation-wise-{_from:yyyyMMdd}-{_to:yyyyMMdd}.xlsx";
            }
            else
            {
                var ws = wb.AddWorksheet("Item-wise");
                string[] headers =
                {
                    "Country", "Cont No", "Cont-Purchase Date", "Box Category", "Item Code", "Item Name",
                    "Qty", "LPM Months", "Division", "Brand"
                };
                for (int i = 0; i < headers.Length; i++) ws.Cell(1, i + 1).Value = headers[i];
                ws.Row(1).Style.Font.Bold = true;

                int row = 2;
                foreach (var r in FilteredDetailRows())
                {
                    ws.Cell(row, 1).Value  = DisplayCountry(r.Country);
                    ws.Cell(row, 2).Value  = r.ContNo;
                    ws.Cell(row, 3).Value  = FmtDate(r.PurchaseDate);
                    ws.Cell(row, 4).Value  = r.PalletType;
                    ws.Cell(row, 5).Value  = r.ItemCode;
                    ws.Cell(row, 6).Value  = r.ItemName;
                    ws.Cell(row, 7).Value  = r.Qty;
                    ws.Cell(row, 8).Value  = r.LpmMonths;
                    ws.Cell(row, 9).Value  = r.Division;
                    ws.Cell(row, 10).Value = r.Brand;
                    row++;
                }
                ws.Columns().AdjustToContents();
                name = $"counting-completion-item-wise-{_from:yyyyMMdd}-{_to:yyyyMMdd}.xlsx";
            }

            using var ms = new MemoryStream();
            wb.SaveAs(ms);
            var b64 = Convert.ToBase64String(ms.ToArray());
            await JS.InvokeVoidAsync("downloadFileWithPicker", name, b64,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        finally { _exporting = false; }
    }

    private List<CountingCompletionSummaryRow> FilteredSummaryRows()
    {
        if (string.IsNullOrWhiteSpace(_search)) return _summaryRows;
        var term = _search.Trim();
        return _summaryRows.Where(r =>
            Matches(r.ContNo, term) ||
            Matches(r.PONo, term) ||
            Matches(r.Divisions, term) ||
            Matches(r.Brands, term)).ToList();
    }

    private List<CountingAllocationRow> FilteredAllocRows()
    {
        if (string.IsNullOrWhiteSpace(_search)) return _allocRows;
        var term = _search.Trim();
        return _allocRows.Where(r =>
            Matches(r.ContNo, term) ||
            Matches(r.PONo, term) ||
            Matches(r.PalletType, term) ||
            Matches(r.Divisions, term) ||
            Matches(r.Brands, term)).ToList();
    }

    private List<CountingCompletionDetailRow> FilteredDetailRows()
    {
        if (string.IsNullOrWhiteSpace(_search)) return _detailRows;
        var term = _search.Trim();
        return _detailRows.Where(r =>
            Matches(r.ContNo, term) ||
            Matches(r.PalletType, term) ||
            Matches(r.ItemCode, term) ||
            Matches(r.ItemName, term) ||
            Matches(r.Division, term) ||
            Matches(r.Brand, term)).ToList();
    }

    private static bool Matches(string? value, string term) =>
        !string.IsNullOrEmpty(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);

    private int TotalPoCount()
    {
        return FilteredSummaryRows()
            .SelectMany(r => (r.PONo ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();
    }

    private static string DisplayCountry(string c) =>
        string.IsNullOrEmpty(c) ? c : c.ToUpper();

    private static string FmtDate(DateTime? d) => d?.ToString("dd-MMM-yyyy") ?? "";
}
