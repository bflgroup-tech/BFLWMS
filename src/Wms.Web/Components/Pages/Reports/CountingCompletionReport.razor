@page "/reports/counting-completion"
@rendermode RenderMode.InteractiveServer
@using Wms.Core
@using Wms.Data.Lpm
@using ClosedXML.Excel
@using MudBlazor
@attribute [Authorize(Policy = MenuKeys.RPT_COUNTING_COMPLETION)]
@inject ReportsService Svc
@inject CountingCompletionTodayService TodaySvc
@inject ICurrentUser CurrentUser
@inject IJSRuntime JS

<PageTitle>WMS - Counting Completion Report</PageTitle>

<div class="aiwms-page-header">
    <h2>Counting Completion Report</h2>
    <p>One row per Country + Cont No. When a container has multiple LPM Months, Divisions, or Brands, they're shown as a comma-separated list.</p>
</div>

<div class="aiwms-section">
    <div style="display:flex; gap:14px; align-items:center; margin-bottom:8px; flex-wrap:wrap">
        <strong style="font-size:11px; text-transform:uppercase; letter-spacing:1px; color:var(--text-secondary)">Report:</strong>
        <label style="display:flex; align-items:center; gap:4px; cursor:pointer">
            <input type="radio" name="rpt" value="Summary" checked="@(_view == "Summary")" @onchange="@(() => SetView("Summary"))" /> Summary
        </label>
        <label style="display:flex; align-items:center; gap:4px; cursor:pointer">
            <input type="radio" name="rpt" value="Allocation" checked="@(_view == "Allocation")" @onchange="@(() => SetView("Allocation"))" /> Allocation-wise Summary
        </label>
        <label style="display:flex; align-items:center; gap:4px; cursor:pointer">
            <input type="radio" name="rpt" value="Detailed" checked="@(_view == "Detailed")" @onchange="@(() => SetView("Detailed"))" /> Detailed
        </label>
        <span style="width:1px; height:20px; background:var(--border-default)"></span>
        <label style="display:flex; align-items:center; gap:4px; cursor:pointer">
            <input type="checkbox" checked="@_isToday" @onchange="@(e => ToggleToday((bool)e.Value!))" /> <b>Today</b>&nbsp;<span style="font-weight:400; color:var(--text-secondary)">(live data from today's counting — ignores date range / Cont No)</span>
        </label>
    </div>

    <div style="display:grid; grid-template-columns: 1.2fr 1fr 1fr 1fr 1fr auto; gap:12px; align-items:end;">
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">COUNTRY (select any)</label>
            <MudSelect T="string" Dense="true" MultiSelection="true" SelectAll="true" Placeholder="All"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       SelectedValues="_selectedCountries" SelectedValuesChanged="@(v => _selectedCountries = v.ToHashSet())">
                @foreach (var c in _countries) { <MudSelectItem T="string" Value="@c">@DisplayCountry(c)</MudSelectItem> }
            </MudSelect>
        </div>
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">COMPLETION FROM @(HasContNoFilter || _isToday ? "" : "*")</label>
            <input type="date" @bind="_from" @bind:format="yyyy-MM-dd" max="@DateTime.Today.ToString("yyyy-MM-dd")" disabled="@(HasContNoFilter || _isToday)" style="width:100%; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
        </div>
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">COMPLETION TO @(HasContNoFilter || _isToday ? "" : "*")</label>
            <input type="date" @bind="_to" @bind:format="yyyy-MM-dd" max="@DateTime.Today.ToString("yyyy-MM-dd")" disabled="@(HasContNoFilter || _isToday)" style="width:100%; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
        </div>
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">CONTAINER NO (searches all dates)</label>
            <input @bind="_contNoFilter" @bind:event="oninput" placeholder="e.g. KWLOC7172" disabled="@_isToday" style="width:100%; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
        </div>
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">WAREHOUSE (UAE only)</label>
            <select @bind="_warehouseFilter" style="width:100%; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white">
                <option value="">All</option>
                <option value="JAFZA">JAFZA</option>
                <option value="TECHNO">TECHNO</option>
            </select>
        </div>
        <div style="display:flex; gap:8px">
            <button class="aiwms-btn aiwms-btn-primary" @onclick="LoadAsync" disabled="@(_loading || (!_isToday && !HasContNoFilter && _from > _to))">@(_loading ? "Loading..." : "Load")</button>
            <button class="aiwms-btn aiwms-btn-secondary" @onclick="ExportExcelAsync" disabled="@(_exporting || CurrentRowCount == 0)">@(_exporting ? "Exporting..." : "Export Excel")</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="aiwms-alert @(_isError ? "error" : "info")" style="margin-top:12px">@_message</div>
    }
</div>

