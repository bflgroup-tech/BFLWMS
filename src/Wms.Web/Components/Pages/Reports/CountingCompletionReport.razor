@code {
    private string _view = "Summary";
    private List<string> _countries = new();
    private HashSet<string> _selectedCountries = new();
    private DateTime _from = DateTime.Today.AddDays(-1);
    private DateTime _to   = DateTime.Today;
    private string _contNoFilter = "";
    private string _warehouseFilter = "";
    private bool _isToday;
    private bool _loading;
    private bool _exporting;
    private string _message = "";
    private bool _isError;
    private string _search = "";
    private List<CountingCompletionSummaryRow> _summaryRows = new();
    private List<CountingAllocationRow>        _allocRows   = new();
    private List<CountingCompletionDetailRow>  _detailRows  = new();
    private List<CountingCompletionTodaySummaryRow>    _todaySummaryRows = new();
    private List<CountingCompletionTodayAllocationRow> _todayAllocRows   = new();
    private List<CountingCompletionTodayDetailRow>     _todayDetailRows  = new();

    private int CurrentRowCount => (_isToday, _view) switch
    {
        (true,  "Summary")    => _todaySummaryRows.Count,
        (true,  "Allocation") => _todayAllocRows.Count,
        (true,  _)            => _todayDetailRows.Count,
        (false, "Summary")    => _summaryRows.Count,
        (false, "Allocation") => _allocRows.Count,
        _                     => _detailRows.Count
    };

    private bool HasContNoFilter => !string.IsNullOrWhiteSpace(_contNoFilter);

    private List<string> EffectiveCountries =>
        _selectedCountries.Count > 0 ? _selectedCountries.ToList() : _countries;

    // For the SQL-backed Summary/Allocation/Detail calls: those treat a null argument
    // as "genuinely unrestricted" and any non-null list (even empty) as "restrict to
    // exactly this". Only pass null when the user actually has all-countries access AND
    // hasn't manually narrowed the picker — otherwise always pass a concrete list, so a
    // zero-grant user's empty _countries correctly yields zero rows instead of every
    // country's data.
    private IEnumerable<string>? EffectiveCountriesOrNull =>
        _selectedCountries.Count > 0 ? _selectedCountries
        : CurrentUser.HasAllCountriesAccess ? null
        : _countries;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CurrentUser.EnsureLoadedAsync();
            var list = await Svc.GetCountriesAsync();
            var excluded = new[] { "Ex2Locations", "Ecom" };
            var allowed = list.Where(c => !excluded.Contains(c, StringComparer.OrdinalIgnoreCase));
            _countries = CurrentUser.FilterCountries(allowed).ToList();
        }
        catch { /* fall back to empty list if the lookup fails */ }
    }

    private void ToggleToday(bool isToday)
    {
        _isToday = isToday;
    }

    // Switching Report type re-runs the same search automatically — no need
    // to click Load again — but only once a report has already been loaded
    // via the Load button; before that, nothing should load on its own.
    private async Task SetView(string view)
    {
        _view = view;
        if (_hasLoadedOnce && (_isToday || HasContNoFilter || _from <= _to)) await LoadAsync();
    }

    private bool _hasLoadedOnce;

    private async Task LoadAsync()
    {
        _hasLoadedOnce = true;
        _loading = true; _message = ""; _isError = false;
        _summaryRows = new(); _allocRows = new(); _detailRows = new();
        _todaySummaryRows = new(); _todayAllocRows = new(); _todayDetailRows = new();
        try
        {
            if (_isToday)
            {
                var countries = EffectiveCountries;
                if (_view == "Summary")
                {
                    _todaySummaryRows = await TodaySvc.GetSummaryAsync(countries, _warehouseFilter);
                    if (_todaySummaryRows.Count == 0) _message = "No rows counted today for the selected countries.";
                }
                else if (_view == "Allocation")
                {
                    _todayAllocRows = await TodaySvc.GetAllocationAsync(countries, _warehouseFilter);
                    if (_todayAllocRows.Count == 0) _message = "No rows counted today for the selected countries.";
                }
                else
                {
                    _todayDetailRows = await TodaySvc.GetDetailAsync(countries, _warehouseFilter);
                    if (_todayDetailRows.Count == 0) _message = "No rows counted today for the selected countries.";
                }
            }
            else if (_view == "Summary")
            {
                _summaryRows = await Svc.GetCountingCompletionSummaryAsync(EffectiveCountriesOrNull, _from, _to, _contNoFilter, _warehouseFilter);
                if (_summaryRows.Count == 0) _message = "No rows for the selected filters.";
            }
            else if (_view == "Allocation")
            {
                _allocRows = await Svc.GetCountingAllocationAsync(EffectiveCountriesOrNull, _from, _to, _contNoFilter, _warehouseFilter);
                if (_allocRows.Count == 0) _message = "No rows for the selected filters.";
            }
            else
            {
                _detailRows = await Svc.GetCountingDetailAsync(EffectiveCountriesOrNull, _from, _to, _contNoFilter, _warehouseFilter);
                if (_detailRows.Count == 0) _message = "No rows for the selected filters.";
            }
        }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
        finally { _loading = false; }
    }

    private async Task ExportExcelAsync()
    {
        if (CurrentRowCount == 0) return;
        _exporting = true;
        try
        {
            using var wb = new XLWorkbook();
            string name;

            if (_isToday)
            {
                if (_view == "Summary")
                {
                    var ws = wb.AddWorksheet("Counting Completion (Today)");
                    string[] headers = { "Country", "Cont No", "Warehouse", "Counted Qty", "LPM Dates", "Divisions", "PO Numbers", "Brands", "PalletTypes", "Type Names" };
                    for (int i = 0; i < headers.Length; i++) ws.Cell(1, i + 1).Value = headers[i];
                    ws.Row(1).Style.Font.Bold = true;

                    int row = 2;
                    foreach (var r in FilteredTodaySummaryRows())
                    {
                        ws.Cell(row, 1).Value = DisplayCountry(r.Country);
                        ws.Cell(row, 2).Value = r.ContNo;
                        ws.Cell(row, 3).Value = r.Warehouse;
                        ws.Cell(row, 4).Value = r.CountedQty;
                        ws.Cell(row, 5).Value = r.LpmDates;
                        ws.Cell(row, 6).Value = r.Divisions;
                        ws.Cell(row, 7).Value = r.OraPoNos;
                        ws.Cell(row, 8).Value = r.Brands;
                        ws.Cell(row, 9).Value = r.PalletTypes;
                        ws.Cell(row, 10).Value = r.TypeNames;
                        row++;
                    }
                    ws.Columns().AdjustToContents();
                    name = $"counting-completion-today-summary-{DateTime.Today:yyyyMMdd}.xlsx";
                }
                else if (_view == "Allocation")
                {
                    var ws = wb.AddWorksheet("Allocation-wise (Today)");
                    string[] headers = { "Country", "Cont No", "Warehouse", "Box Category", "Type Name", "Build Qty", "LPM Dates", "Divisions", "PO Numbers", "Brands" };
                    for (int i = 0; i < headers.Length; i++) ws.Cell(1, i + 1).Value = headers[i];
                    ws.Row(1).Style.Font.Bold = true;

                    int row = 2;
                    foreach (var r in FilteredTodayAllocRows())
                    {
                        ws.Cell(row, 1).Value = DisplayCountry(r.Country);
                        ws.Cell(row, 2).Value = r.ContNo;
                        ws.Cell(row, 3).Value = r.Warehouse;
                        ws.Cell(row, 4).Value = r.ResultType;
                        ws.Cell(row, 5).Value = r.TypeName;
                        ws.Cell(row, 6).Value = r.BuildQty;
                        ws.Cell(row, 7).Value = r.LpmDates;
                        ws.Cell(row, 8).Value = r.Divisions;
                        ws.Cell(row, 9).Value = r.OraPoNos;
                        ws.Cell(row, 10).Value = r.Brands;
                        row++;
                    }
                    ws.Columns().AdjustToContents();
                    name = $"counting-completion-today-allocation-wise-{DateTime.Today:yyyyMMdd}.xlsx";
                }
                else
                {
                    var ws = wb.AddWorksheet("Item-wise (Today)");
                    string[] headers = { "Country", "Cont No", "Warehouse", "PalletType", "Type Name", "Item Code", "Item Name", "Qty", "LPM Date", "Division", "PO No", "Brand" };
                    for (int i = 0; i < headers.Length; i++) ws.Cell(1, i + 1).Value = headers[i];
                    ws.Row(1).Style.Font.Bold = true;

                    int row = 2;
                    foreach (var r in FilteredTodayDetailRows())
                    {
                        ws.Cell(row, 1).Value  = DisplayCountry(r.Country);
                        ws.Cell(row, 2).Value  = r.ContNo;
                        ws.Cell(row, 3).Value  = r.Warehouse;
                        ws.Cell(row, 4).Value  = r.PalletType;
                        ws.Cell(row, 5).Value  = r.TypeName;
                        ws.Cell(row, 6).Value  = r.ItemCode;
                        ws.Cell(row, 7).Value  = r.ItemName;
                        ws.Cell(row, 8).Value  = r.Qty;
                        ws.Cell(row, 9).Value  = FmtDate(r.LpmDt);
                        ws.Cell(row, 10).Value = r.Division;
                        ws.Cell(row, 11).Value = r.OraPoNo;
                        ws.Cell(row, 12).Value = r.Brand;
                        row++;
                    }
                    ws.Columns().AdjustToContents();
                    name = $"counting-completion-today-item-wise-{DateTime.Today:yyyyMMdd}.xlsx";
                }
            }
            else if (_view == "Summary")
            {
                var ws = wb.AddWorksheet("Counting Completion");
                string[] headers =
                {
                    "Country", "Cont No", "Warehouse", "PO No", "Counting Start Date", "Counting Completion Date",
                    "Cont-Purchase Date", "Counted Qty", "LPM Months", "Divisions", "Brands"
                };
                for (int i = 0; i < headers.Length; i++) ws.Cell(1, i + 1).Value = headers[i];
                ws.Row(1).Style.Font.Bold = true;

                int row = 2;
                foreach (var r in FilteredSummaryRows())
                {
                    ws.Cell(row, 1).Value  = DisplayCountry(r.Country);
                    ws.Cell(row, 2).Value  = r.ContNo;
                    ws.Cell(row, 3).Value  = r.Warehouse;
                    ws.Cell(row, 4).Value  = r.PONo;
                    ws.Cell(row, 5).Value  = FmtDate(r.CountingStartDate);
                    ws.Cell(row, 6).Value  = FmtDate(r.CountingCompletionDate);
                    ws.Cell(row, 7).Value  = FmtDate(r.PurchaseDate);
                    ws.Cell(row, 8).Value  = r.CountedQty;
                    ws.Cell(row, 9).Value  = r.LpmMonths;
                    ws.Cell(row, 10).Value = r.Divisions;
                    ws.Cell(row, 11).Value = r.Brands;
                    row++;
                }
                ws.Columns().AdjustToContents();
                name = $"counting-completion-summary-{_from:yyyyMMdd}-{_to:yyyyMMdd}.xlsx";
            }
            else if (_view == "Allocation")
            {
                var ws = wb.AddWorksheet("Allocation-wise");
                string[] headers =
                {
                    "Country", "Cont No", "Warehouse", "PO No", "Counting Start Date", "Counting Completion Date",
                    "Cont-Purchase Date", "Box Category", "Type Name", "Build Qty", "LPM Months", "Divisions", "Brands"
                };
                for (int i = 0; i < headers.Length; i++) ws.Cell(1, i + 1).Value = headers[i];
                ws.Row(1).Style.Font.Bold = true;

                int row = 2;
                foreach (var r in FilteredAllocRows())
                {
                    ws.Cell(row, 1).Value  = DisplayCountry(r.Country);
                    ws.Cell(row, 2).Value  = r.ContNo;
                    ws.Cell(row, 3).Value  = r.Warehouse;
                    ws.Cell(row, 4).Value  = r.PONo;
                    ws.Cell(row, 5).Value  = FmtDate(r.CountingStartDate);
                    ws.Cell(row, 6).Value  = FmtDate(r.CountingCompletionDate);
                    ws.Cell(row, 7).Value  = FmtDate(r.PurchaseDate);
                    ws.Cell(row, 8).Value  = r.PalletType;
                    ws.Cell(row, 9).Value  = r.TypeName;
                    ws.Cell(row, 10).Value = r.BuildQty;
