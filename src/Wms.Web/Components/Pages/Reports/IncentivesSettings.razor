    private void ShowError(string msg, List<string>? problems = null) { _message = msg; _isError = true;  _problems = problems ?? new(); }
    private void ShowInfo(string msg)                                  { _message = msg; _isError = false; _problems = new(); }
    private void StartIn(string area) { _msgArea = area; _message = ""; _problems = new(); }

    private RenderFragment Message(string area) => __builder =>
    {
        if (_msgArea == area && _busy && string.IsNullOrEmpty(_message))
        {
            <div class="aiwms-alert info" style="margin-top:10px;">Working…</div>
        }
        else if (_msgArea == area && !string.IsNullOrEmpty(_message))
        {
            <div class="aiwms-alert @(_isError ? "error" : "info")" style="margin-top:10px;">
                @_message
                @if (_problems.Count > 0)
                {
                    <ul style="margin:6px 0 0 18px; padding:0;">
                        @foreach (var p in _problems.Take(MaxProblemsShown)) { <li>@p</li> }
                    </ul>
                    @if (_problems.Count > MaxProblemsShown)
                    {
                        <div style="margin-top:4px;">…and @(_problems.Count - MaxProblemsShown) more.</div>
                    }
                }
            </div>
        }
    };

    private static void SetDate(ChangeEventArgs e, Action<DateTime> apply)
    {
        if (DateTime.TryParse(e.Value?.ToString(), CultureInfo.InvariantCulture, DateTimeStyles.None, out var d) && d.Year > 1900)
            apply(d.Date);
    }

    private RenderFragment Toggle(bool collapsed, Action toggle) => __builder =>
    {
        <button type="button" class="incset-toggle" title="@(collapsed ? "Expand" : "Minimize")" @onclick="toggle">
            <span class="mi sm">@(collapsed ? "add" : "remove")</span>
        </button>
    };

