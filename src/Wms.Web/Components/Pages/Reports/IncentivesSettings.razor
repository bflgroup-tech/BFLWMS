    private async Task SaveAttendanceAsync()
    {
        StartIn(AttArea);
        // Date From / To may have been changed after the file was read.
        var outside = _attUpload.Where(r => r.AttendanceDate < _attFrom.Date || r.AttendanceDate > _attTo.Date).ToList();
        if (outside.Count > 0)
        {
            ShowError($"{outside.Count} row(s) are outside {_attFrom:dd-MMM-yyyy} – {_attTo:dd-MMM-yyyy} — nothing was saved. Fix the dates or the file and choose it again.",
                      outside.Select(r => $"EmpCode {r.EmpCode} on {r.AttendanceDate:dd-MMM-yyyy}").ToList());
            return;
        }

        _busy = true; StateHasChanged();
        try
        {
            var r = await Svc.UploadAttendanceAsync(_attUpload, Uploader);
            if (r.Ok)
            {
                _attUpload = new(); _attFileKey++;
                await LoadAttendanceAsync();
                _msgArea = AttArea;
                ShowInfo($"Saved {r.RowsSaved:N0} attendance discrepancy row(s).");
            }
            else ShowError(r.Error ?? "Save failed.", r.Problems);
        }
        finally { _busy = false; }
    }

    private static List<IncAttendanceUploadRow> ParseAttendance(Stream stream, DateTime from, DateTime to, List<string> problems)
    {
        using var wb = new XLWorkbook(stream);
        var ws = wb.Worksheet(1);
        var cols = HeaderMap(ws);
        foreach (var required in new[] { "empcode", "attendancedate", "shifttimingfrom", "shifttimingto", "discrepancytype", "discrepancyduration" })
            if (!cols.ContainsKey(required))
                problems.Add($"Header row is missing column '{required}'. Expected: EmpCode, AttendanceDate, ShiftTimingFrom, ShiftTimingTo, DiscrepancyType, DiscrepancyDuration.");
        if (problems.Count > 0) return new();

        var rows = new List<IncAttendanceUploadRow>();
        var seen = new Dictionary<(string, DateTime), int>();
        var last = ws.LastRowUsed()?.RowNumber() ?? 1;
        for (var r = 2; r <= last; r++)
        {
            var code = ws.Cell(r, cols["empcode"]).GetFormattedString().Trim();
            var dateCell = ws.Cell(r, cols["attendancedate"]);
            var typeRaw = ws.Cell(r, cols["discrepancytype"]).GetFormattedString().Trim();
            if (code.Length == 0 && dateCell.IsEmpty() && typeRaw.Length == 0) continue;   // blank line

            var rowOk = true;
            void Bad(string msg) { problems.Add($"Row {r}: {msg}"); rowOk = false; }

            if (code.Length == 0) Bad("EmpCode is empty.");

            if (!TryReadDate(dateCell, out var date)) Bad($"AttendanceDate '{dateCell.GetFormattedString()}' is not a valid date.");
            else if (date < from.Date || date > to.Date) Bad($"AttendanceDate {date:dd-MMM-yyyy} is outside {from:dd-MMM-yyyy} – {to:dd-MMM-yyyy}.");

            var type = IncentivesSettingsService.DiscrepancyTypes
                .FirstOrDefault(t => string.Equals(t, typeRaw.Replace(" ", ""), StringComparison.OrdinalIgnoreCase));
            if (type is null)
                Bad(typeRaw.Length == 0
                    ? "DiscrepancyType is empty — must be Earlygoing, LateComing or Absent."
                    : $"DiscrepancyType '{typeRaw}' is not allowed — must be Earlygoing, LateComing or Absent.");

            var fromCell = ws.Cell(r, cols["shifttimingfrom"]);
            var toCell   = ws.Cell(r, cols["shifttimingto"]);
            if (!TryReadTime(fromCell, out var shiftFrom)) Bad($"ShiftTimingFrom '{fromCell.GetFormattedString()}' is not a time (use e.g. 6AM or 06:00).");
            if (!TryReadTime(toCell,   out var shiftTo))   Bad($"ShiftTimingTo '{toCell.GetFormattedString()}' is not a time (use e.g. 8PM or 20:00).");

            // Minutes: required (1..540) for Earlygoing / LateComing, blank for Absent.
            var durCell = ws.Cell(r, cols["discrepancyduration"]);
            int? duration = null;
            if (!TryReadWholeNumber(durCell, out var durValue))
                Bad($"DiscrepancyDuration '{durCell.GetFormattedString()}' is not a whole number of minutes.");
            else if (type == "Absent")
            {
                if (durValue is not null) Bad($"DiscrepancyDuration must be blank for Absent (found {durValue}).");
            }
            else if (type is not null)
            {
                if (durValue is null) Bad($"DiscrepancyDuration is required for {type} — enter the minutes (1 to {IncentivesSettingsService.MaxDiscrepancyMinutes}).");
                else if (durValue < 1 || durValue > IncentivesSettingsService.MaxDiscrepancyMinutes)
                    Bad($"DiscrepancyDuration {durValue} is out of range — must be 1 to {IncentivesSettingsService.MaxDiscrepancyMinutes} minutes.");
                else duration = durValue;
            }

            if (!rowOk) continue;

            var key = (code.ToUpperInvariant(), date);
            if (seen.TryGetValue(key, out var firstRow)) { Bad($"EmpCode {code} on {date:dd-MMM-yyyy} is repeated (also on row {firstRow})."); continue; }
            seen[key] = r;
            rows.Add(new IncAttendanceUploadRow(code, date, shiftFrom, shiftTo, type!, duration));
        }
        return rows;
    }


