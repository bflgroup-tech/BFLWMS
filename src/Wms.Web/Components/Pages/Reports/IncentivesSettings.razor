        DownloadTemplateAsync("Attendance_Discrepancies_Template.xlsx", "Attendance",
            ["EmpCode", "AttendanceDate", "ShiftTimingFrom", "ShiftTimingTo", "DiscrepancyType", "DiscrepancyDuration"],
            ["E1001", DateTime.Today.ToString("dd/MM/yyyy"), "6AM", "8PM", "LateComing", "30"]);

    private async Task DownloadTemplateAsync(string fileName, string sheet, string[] headers, string[] example)
    {
        using var wb = new XLWorkbook();
        var ws = wb.Worksheets.Add(sheet);
        for (var i = 0; i < headers.Length; i++)
        {
            ws.Cell(1, i + 1).Value = headers[i];
            ws.Cell(2, i + 1).SetValue(example[i]);   // text, so EmpCodes / dates / "6AM" stay as typed
        }
        ws.Range(1, 1, 1, headers.Length).Style.Font.Bold = true;
        ws.Columns().AdjustToContents();
        using var ms = new MemoryStream();
        wb.SaveAs(ms);
        await JS.InvokeVoidAsync("downloadFileWithPicker", fileName, Convert.ToBase64String(ms.ToArray()), XlsxMime);
    }
}
