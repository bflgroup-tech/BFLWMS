    private async Task OnEmployeeFileSelected(InputFileChangeEventArgs e)
    {
        StartIn(EmpArea);
        _empUpload = new();
        _busy = true; StateHasChanged();
        var ms = await ReadXlsxAsync(e.File);
        if (ms is null) { _busy = false; return; }
        try
        {
            var problems = new List<string>();
            var rows = ParseEmployees(ms, problems);
            if (problems.Count > 0) { ShowError($"'{e.File.Name}' has {problems.Count} problem(s) — nothing was loaded. Fix them and choose the file again.", problems); _empFileKey++; return; }
            if (rows.Count == 0)     { ShowError($"No data rows found in '{e.File.Name}'."); _empFileKey++; return; }
            _empUpload = rows;
            ShowInfo($"Read {rows.Count:N0} employee(s). Check the preview, then click Save.");
        }
        catch (Exception ex) { ShowError($"Couldn't read the Excel: {ex.Message}"); _empFileKey++; }
        finally { _busy = false; }
    }

    private async Task SaveEmployeesAsync()
    {
        StartIn(EmpArea);
        _busy = true; StateHasChanged();
        try
        {
            var r = await Svc.UploadEmployeesAsync(_empUpload, Uploader);
            if (r.Ok)
            {
                _empUpload = new(); _empFileKey++;
                await LoadEmployeesAsync();
                _msgArea = EmpArea;
                ShowInfo($"Saved {r.RowsSaved:N0} employee(s) to the Employee Master.");
