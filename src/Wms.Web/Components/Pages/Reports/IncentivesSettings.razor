    // ===================== shared Excel helpers =====================

    private async Task<MemoryStream?> ReadXlsxAsync(IBrowserFile? file)
    {
        if (file is null) return null;
        if (!file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase)) { ShowError("File must be an Excel .xlsx file."); return null; }
        var ms = new MemoryStream();
        await using (var s = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024)) await s.CopyToAsync(ms);
        ms.Position = 0;
        return ms;
    }

    // Header text -> column number, matched case/space/underscore-insensitively so column order doesn't matter.
    private static Dictionary<string, int> HeaderMap(IXLWorksheet ws)
    {
        var map = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        var header = ws.Row(1);
        var lastCol = header.LastCellUsed()?.Address.ColumnNumber ?? 0;
        for (var c = 1; c <= lastCol; c++)
        {
            var h = header.Cell(c).GetString().Trim().ToLowerInvariant().Replace(" ", "").Replace("_", "");
            if (h.Length > 0 && !map.ContainsKey(h)) map[h] = c;
        }
        return map;
    }

    private static readonly string[] DateFormats =
        ["dd/MM/yyyy", "d/M/yyyy", "dd-MM-yyyy", "d-M-yyyy", "yyyy-MM-dd", "dd-MMM-yyyy", "d-MMM-yyyy", "dd MMM yyyy", "d MMM yyyy", "dd.MM.yyyy"];

    private static bool TryReadDate(IXLCell cell, out DateTime date)
    {
        date = default;
        if (cell.IsEmpty()) return false;
        if (cell.DataType == XLDataType.DateTime) { date = cell.GetDateTime().Date; return true; }
        if (cell.DataType == XLDataType.Number)   { date = DateTime.FromOADate(cell.GetDouble()).Date; return true; }
        var s = cell.GetString().Trim();
        if (DateTime.TryParseExact(s, DateFormats, CultureInfo.InvariantCulture, DateTimeStyles.None, out date)) { date = date.Date; return true; }
        return false;
    }

    private static readonly string[] TimeFormats =
        ["htt", "h tt", "h:mmtt", "h:mm tt", "hh:mmtt", "hh:mm tt", "hhtt", "H:mm", "HH:mm", "HH:mm:ss", "H"];

    // Empty is allowed (column is NULL-able, e.g. Absent). Accepts 6AM / 8PM / 6:30 PM / 06:00 / 20:00 and Excel time cells.
    private static bool TryReadTime(IXLCell cell, out TimeSpan? time)
    {
        time = null;
        if (cell.IsEmpty()) return true;
        if (cell.DataType == XLDataType.DateTime) { time = cell.GetDateTime().TimeOfDay; return true; }
        if (cell.DataType == XLDataType.TimeSpan) { time = cell.GetTimeSpan(); return time.Value < TimeSpan.FromDays(1); }
        if (cell.DataType == XLDataType.Number)
        {
            var d = cell.GetDouble();
            if (d >= 0 && d < 1) { time = TimeSpan.FromDays(d); return true; }
            return false;
        }
        var s = cell.GetString().Trim().ToUpperInvariant().Replace(".", "");
        if (s.Length == 0) return true;
        if (DateTime.TryParseExact(s, TimeFormats, CultureInfo.InvariantCulture, DateTimeStyles.None, out var dt))
        {
            time = new TimeSpan(dt.Hour, dt.Minute, 0);
            return true;
        }
        return false;
    }

    private static string? NullIfEmpty(string s) => s.Length == 0 ? null : s;

    // Empty cell -> true with null. A number cell or text must be a whole number (e.g. 30, not 30.5 or "30 min").
    private static bool TryReadWholeNumber(IXLCell cell, out int? value)
    {
        value = null;
        if (cell.IsEmpty()) return true;
        if (cell.DataType == XLDataType.Number)
        {
            var d = cell.GetDouble();
            if (d != Math.Floor(d) || d < int.MinValue || d > int.MaxValue) return false;
            value = (int)d;
            return true;
        }
        var s = cell.GetString().Trim();
        if (s.Length == 0) return true;
        if (int.TryParse(s, NumberStyles.Integer, CultureInfo.InvariantCulture, out var i)) { value = i; return true; }
        return false;
    }

