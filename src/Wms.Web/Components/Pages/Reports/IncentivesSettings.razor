    private async Task OnAttendanceFileSelected(InputFileChangeEventArgs e)
    {
        StartIn(AttArea);
        _attUpload = new();
        _busy = true; StateHasChanged();
        var ms = await ReadXlsxAsync(e.File);
        if (ms is null) { _busy = false; return; }
        try
        {
            var problems = new List<string>();
            var rows = ParseAttendance(ms, _attFrom, _attTo, problems);
            if (problems.Count > 0) { ShowError($"'{e.File.Name}' has {problems.Count} problem(s) — nothing was loaded. Fix them and choose the file again.", problems); _attFileKey++; return; }
            if (rows.Count == 0)     { ShowError($"No data rows found in '{e.File.Name}'."); _attFileKey++; return; }

            var notInMaster = await Svc.GetEmpCodesNotInMasterAsync(rows.Select(r => r.EmpCode));
            if (notInMaster.Count > 0)
            {
                ShowError($"{notInMaster.Count} EmpCode(s) are not in the Employee Master — nothing was loaded. Upload them to the Employee Master first, or remove them from the file.",
                          notInMaster.Select(c => $"EmpCode {c} is not in the Employee Master").ToList());
                _attFileKey++;
                return;
            }
            _attUpload = rows;
            ShowInfo($"Read {rows.Count:N0} attendance row(s). Check the preview, then click Save.");
        }
        catch (Exception ex) { ShowError($"Couldn't read the Excel: {ex.Message}"); _attFileKey++; }
        finally { _busy = false; }
