                ShowInfo($"Saved {r.RowsSaved:N0} target row(s).");
                _tgtUpdateExisting = false;
            }
            else ShowError(r.Error ?? "Save failed.", r.Problems);
        }
        finally { _busy = false; }
    }

    private const decimal MaxDecimal10_2 = 99_999_999.99m;

    private static List<IncTargetUploadRow> ParseTargets(Stream stream, List<string> problems)
    {
        using var wb = new XLWorkbook(stream);
        var ws = wb.Worksheet(1);
        var cols = HeaderMap(ws);
        string[] numberCols = ["targetauto", "targetmanual", "incentivebase", "addincentivetgt", "addincentiverate"];
        string[] labels     = ["TargetAuto", "TargetManual", "IncentiveBase", "Add_IncentiveTgt", "Add_IncentiveRate"];
        bool[]   required   = [true, true, true, false, false];   // INC_Target: the two Add_ columns are NULL-able
        foreach (var col in numberCols.Prepend("category"))
            if (!cols.ContainsKey(col))
                problems.Add($"Header row is missing column '{col}'. Expected: Category, TargetAuto, TargetManual, IncentiveBase, Add_IncentiveTgt, Add_IncentiveRate.");
        if (problems.Count > 0) return new();

        var rows = new List<IncTargetUploadRow>();
        var seen = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        var last = ws.LastRowUsed()?.RowNumber() ?? 1;
        for (var r = 2; r <= last; r++)
        {
            var category = ws.Cell(r, cols["category"]).GetFormattedString().Trim();
            if (category.Length == 0 && numberCols.All(c => ws.Cell(r, cols[c]).IsEmpty())) continue;   // blank line

            var rowOk = true;
            void Bad(string msg) { problems.Add($"Row {r}: {msg}"); rowOk = false; }

            if (category.Length == 0) Bad("Category is empty.");
            var values = new decimal?[numberCols.Length];
            for (var i = 0; i < numberCols.Length; i++)
            {
                var cell = ws.Cell(r, cols[numberCols[i]]);
                if (!TryReadDecimal(cell, out var v)) { Bad($"{labels[i]} '{cell.GetFormattedString()}' is not a number."); continue; }
                if (v is null) { if (required[i]) Bad($"{labels[i]} is empty."); continue; }
                if (v < 0 || v > MaxDecimal10_2) { Bad($"{labels[i]} {v} is out of range (0 to {MaxDecimal10_2:N2})."); continue; }
                if (decimal.Round(v.Value, 2) != v.Value) { Bad($"{labels[i]} {v} has more than 2 decimals."); continue; }
                values[i] = v.Value;
            }
            if (!rowOk) continue;

            if (seen.TryGetValue(category, out var firstRow)) { Bad($"Category {category} is repeated (also on row {firstRow})."); continue; }
            seen[category] = r;
            rows.Add(new IncTargetUploadRow(category, values[0]!.Value, values[1]!.Value, values[2]!.Value, values[3], values[4]));
        }
        return rows;
    }

    // Empty cell -> true with null.
    private static bool TryReadDecimal(IXLCell cell, out decimal? value)
    {
        value = null;
        if (cell.IsEmpty()) return true;
        if (cell.DataType == XLDataType.Number)
        {
            var d = cell.GetDouble();
            if (Math.Abs(d) > (double)decimal.MaxValue) return false;
            value = decimal.Round((decimal)d, 6);   // strip binary-float noise (e.g. 12.3 stored as 12.2999999)
            return true;
        }
        var s = cell.GetString().Trim().Replace(",", "");
        if (s.Length == 0) return true;
        if (decimal.TryParse(s, NumberStyles.Number, CultureInfo.InvariantCulture, out var m)) { value = m; return true; }
        return false;
    }

