            else ShowError(r.Error ?? "Save failed.", r.Problems);
        }
        finally { _busy = false; }
    }

    private static List<IncEmployeeUploadRow> ParseEmployees(Stream stream, List<string> problems)
    {
        using var wb = new XLWorkbook(stream);
        var ws = wb.Worksheet(1);
        var cols = HeaderMap(ws);
        foreach (var required in new[] { "empcode", "empname", "country", "warehouse", "category" })
            if (!cols.ContainsKey(required))
                problems.Add($"Header row is missing column '{required}'. Expected: EmpCode, EmpName, Country, Warehouse, Category.");
        if (problems.Count > 0) return new();

        var rows = new List<IncEmployeeUploadRow>();
        var seen = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        var last = ws.LastRowUsed()?.RowNumber() ?? 1;
        for (var r = 2; r <= last; r++)
        {
            string Text(string col) => ws.Cell(r, cols[col]).GetFormattedString().Trim();
            var code = Text("empcode");
            if (code.Length == 0 && Text("empname").Length == 0) continue;   // blank line
            if (code.Length == 0) { problems.Add($"Row {r}: EmpCode is empty."); continue; }
            if (seen.TryGetValue(code, out var firstRow)) { problems.Add($"Row {r}: EmpCode {code} is repeated (also on row {firstRow})."); continue; }
            seen[code] = r;
            rows.Add(new IncEmployeeUploadRow(code, NullIfEmpty(Text("empname")), NullIfEmpty(Text("country")),
                                              NullIfEmpty(Text("warehouse")), NullIfEmpty(Text("category"))));
        }
        return rows;
    }

