    private async Task OnTargetFileSelected(InputFileChangeEventArgs e)
    {
        StartIn(TgtArea);
        _tgtUpload = new();
        _busy = true; StateHasChanged();
        var ms = await ReadXlsxAsync(e.File);
        if (ms is null) { _busy = false; return; }
        try
        {
            var problems = new List<string>();
            var rows = ParseTargets(ms, problems);
            if (problems.Count > 0) { ShowError($"'{e.File.Name}' has {problems.Count} problem(s) — nothing was loaded. Fix them and choose the file again.", problems); _tgtFileKey++; return; }
            if (rows.Count == 0)     { ShowError($"No data rows found in '{e.File.Name}'."); _tgtFileKey++; return; }

            // Tell them about existing categories now, not only at Save.
            var stored = _targets.Select(t => t.Category.Trim()).ToHashSet(StringComparer.OrdinalIgnoreCase);
            var clashes = rows.Where(r => stored.Contains(r.Category)).Select(r => r.Category).ToList();
            if (clashes.Count > 0 && !_tgtUpdateExisting)
            {
                ShowError($"{clashes.Count} category(ies) already have a target — nothing was loaded. Remove them from the file, or tick \"Update existing categories\" and choose the file again.",
                          clashes.Select(c => $"Category {c} already exists").ToList());
                _tgtFileKey++;
                return;
            }
            _tgtUpload = rows;
            ShowInfo(clashes.Count > 0
                ? $"Read {rows.Count:N0} target row(s) — {clashes.Count} existing category(ies) will be updated. Check the preview, then click Save."
                : $"Read {rows.Count:N0} target row(s). Check the preview, then click Save.");
        }
        catch (Exception ex) { ShowError($"Couldn't read the Excel: {ex.Message}"); _tgtFileKey++; }
        finally { _busy = false; }
    }

