@page "/reports/transfer-gin-grn"
@rendermode RenderMode.InteractiveServer
@using System.Text
@using Wms.Core
@using Wms.Data.Lpm
@attribute [Authorize(Policy = MenuKeys.RPT_TRANSFER_GIN_GRN)]
@inject TransferGinGrnService Svc
@inject ICurrentUser CurrentUser
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>WMS — Transfer / GIN / GRN History</PageTitle>

<div class="aiwms-page-header">
    <h2>Transfer / GIN / GRN History</h2>
    <p>Transfer records with Pallet (GI), GIN and GRN linkage per store and date range.</p>
</div>

@if (_breakdownOpen)
{
    <div style="position:fixed; inset:0; background:rgba(0,0,0,0.45); z-index:100; display:flex; align-items:center; justify-content:center;" @onclick="CloseBreakdown">
        <div style="background:white; border-radius:8px; max-width:90vw; max-height:85vh; overflow:auto; padding:20px; box-shadow:0 8px 32px rgba(0,0,0,0.3);" @onclick:stopPropagation="true">
            <div style="display:flex; justify-content:space-between; align-items:center; gap:20px; margin-bottom:14px;">
                <h3 style="margin:0; font-size:15px;">@_breakdownTitle</h3>
                <button class="aiwms-btn aiwms-btn-secondary" @onclick="CloseBreakdown">Close</button>
            </div>

            @if (_breakdownLoading)
            {
                <div style="padding:20px; text-align:center; color:var(--text-secondary);">Loading…</div>
            }
            else if (_breakdownError is not null)
            {
                <div class="aiwms-alert error">@_breakdownError</div>
            }
            else if (_breakdownResult is { Rows.Count: 0 })
            {
                <div style="padding:20px; text-align:center; color:var(--text-secondary);">No data.</div>
            }
            else if (_breakdownResult is not null)
            {
                @if (_breakdownResult.Warnings.Count > 0)
                {
                    <div class="aiwms-alert error" style="margin-bottom:10px;">Some countries failed: @string.Join("; ", _breakdownResult.Warnings)</div>
                }
                <div style="overflow:auto; max-width:90vw;">
                <table class="aiwms-table aiwms-table-dense" style="border-collapse:separate; border-spacing:0;">
                    <thead style="position:sticky; top:0; z-index:5; background:var(--bfl-black);">
                        <tr>
                            <th>Division</th>
                            <th>Department</th>
                            <th>Group Code</th>
                            <th>Brand</th>
                            <th style="text-align:right;">Qty</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _breakdownResult.Rows)
                        {
                            <tr>
                                <td>@row.Division</td>
                                <td>@row.Department</td>
                                <td>@row.GroupCode</td>
                                <td>@row.Brand</td>
                                <td style="text-align:right;">@row.Qty.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr style="font-weight:600; border-top:2px solid var(--border-default);">
                            <td colspan="4">Grand Total</td>
                            <td style="text-align:right;">@_breakdownResult.GrandQty.ToString("N0")</td>
                        </tr>
                    </tfoot>
                </table>
                </div>
            }
        </div>
    </div>
}

<div class="aiwms-section" style="padding:10px 16px;">
    <div style="display:flex; flex-wrap:wrap; gap:8px; align-items:flex-end;">
        <div style="flex:0 0 150px;">
            <label class="aiwms-filter-label">COUNTRY</label>
            @if (_canSelectMultiple)
            {
                <select @bind="_country" @bind:after="OnCountryChangedAsync" style="width:100%; padding:5px 7px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:12px; background:white">
                    <option value="@BflGroupValue">BFL Group</option>
                    @foreach (var c in _countries) { <option value="@c">@c.ToUpperInvariant()</option> }
                </select>
            }
            else
            {
                <input value="@(_lockedCountry.ToUpperInvariant())" disabled
                       style="width:100%; padding:5px 7px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:12px; background:var(--bg-disabled, #f2f2f2);" />
            }
        </div>
        @if (_country != BflGroupValue)
        {
            <div style="flex:1; min-width:160px; max-width:240px;">
                <label class="aiwms-filter-label">STORE</label>
                <select @bind="_store" style="width:100%; padding:5px 7px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:12px; background:white">
                    <option value="">(All stores)</option>
                    @foreach (var s in _stores) { <option value="@s">@s</option> }
                </select>
            </div>
        }
        <div style="flex:0 0 130px;">
            <label class="aiwms-filter-label">DATE FROM</label>
            <input type="date" @bind="_dateFrom" @bind:format="yyyy-MM-dd" style="width:100%; padding:5px 7px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:12px; background:white" />
        </div>
        <div style="flex:0 0 130px;">
            <label class="aiwms-filter-label">DATE TO</label>
            <input type="date" @bind="_dateTo" @bind:format="yyyy-MM-dd" style="width:100%; padding:5px 7px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:12px; background:white" />
        </div>
        <div style="flex:0 0 200px;">
            <label class="aiwms-filter-label">VIEW</label>
            <div style="display:flex; gap:12px; padding:6px 0;">
                <label style="display:flex; align-items:center; gap:4px; font-size:12px; cursor:pointer; white-space:nowrap;">
                    <input type="radio" name="viewMode" checked="@(_viewMode == "Detailed")" @onchange='() => _viewMode = "Detailed"' /> Detailed
                </label>
                <label style="display:flex; align-items:center; gap:4px; font-size:12px; cursor:pointer; white-space:nowrap;">
                    <input type="radio" name="viewMode" checked="@(_viewMode == "Summary")" @onchange='() => _viewMode = "Summary"' /> Summary
                </label>
            </div>
        </div>
        @if (_viewMode == "Detailed")
        {
            <div style="display:flex; gap:10px; align-self:flex-end; padding-bottom:3px; border-left:2px solid var(--border-default); padding-left:10px;">
                <label style="display:flex; align-items:center; gap:4px; font-size:11px; cursor:pointer; white-space:nowrap;"><input type="checkbox" @bind="_withoutPallet" /> No Pallet</label>
                <label style="display:flex; align-items:center; gap:4px; font-size:11px; cursor:pointer; white-space:nowrap;"><input type="checkbox" @bind="_withoutGin" /> No GIN</label>
                <label style="display:flex; align-items:center; gap:4px; font-size:11px; cursor:pointer; white-space:nowrap;"><input type="checkbox" @bind="_withoutGrn" /> No GRN</label>
            </div>
            <div style="border-left:2px solid var(--border-default); padding-left:10px; display:flex; gap:8px; align-items:flex-end;">
                <div style="flex:0 0 130px;">
                    <label class="aiwms-filter-label">SEARCH BY</label>
                    <select @bind="_searchBy" style="width:100%; padding:5px 7px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:12px; background:white">
                        <option value="TrfNo">Transfer No</option>
                        <option value="PalletNo">Pallet No</option>
                        <option value="GIN">GIN</option>
                        <option value="GRN">GRN</option>
                    </select>
                </div>
                <div style="flex:0 0 160px;">
                    <label class="aiwms-filter-label">VALUE <span style="font-weight:normal;opacity:.6;">(ignores dates)</span></label>
                    <input @bind="_searchValue" placeholder="contains…" style="width:100%; padding:5px 7px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:12px; background:white;" />
                </div>
            </div>
        }
    </div>

    <div style="display:flex; gap:10px; margin-top:10px">
        <button class="aiwms-btn aiwms-btn-primary" @onclick="LoadAsync" disabled="@_loading">
            @(_loading ? "Loading…" : "Load")
        </button>
        <button class="aiwms-btn aiwms-btn-secondary" @onclick="ExportCsvAsync" disabled="@(_loading || _rows.Count == 0 || _viewMode != "Detailed")">
            Export to Excel
        </button>
        @if (_rows.Count > 0)
        {
            <span style="font-size:12px; color:var(--text-secondary); align-self:center">@_rows.Count rows</span>
        }
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="aiwms-alert @(_isError ? "error" : "info")" style="margin-top:12px">@_message</div>
    }
</div>

@{ var total = _total; }
@if (total is not null)
{
    <div style="display:flex; gap:14px; flex-wrap:wrap; margin-bottom:16px;">
        @StatCard("TRANSFER COUNT", total.TransferCount, "#fbe4ec", "#b3195c", OpenTransferBreakdownAsync)
        @StatCard("TRANSFER QTY",   total.TransferQty,   "#d9f7ea", "#0f9d67", OpenTransferBreakdownAsync)
        @StatCard("GIN COUNT",      total.GinCount,      "#e8f0fe", "#1a56db", OpenGinBreakdownAsync)
        @StatCard("GIN QTY",        total.GinQty,        "#fdecd9", "#c2650a", OpenGinBreakdownAsync)
    </div>
}

@{ var breakdownRows = _country == BflGroupValue ? _countrySummaries : _storeSummaries; }
@if (breakdownRows.Count > 0)
{
    var breakdownLabel = _country == BflGroupValue ? "Country" : "Store";
    <div class="aiwms-section" style="padding:0; overflow:hidden; margin-bottom:16px;">
        <div style="padding:10px 16px; background:var(--bg-subtle, #f7f7f5); font-weight:700; font-size:13px; letter-spacing:0.02em;">
            BY @breakdownLabel.ToUpperInvariant()
        </div>
        <div style="padding:14px 16px; overflow:auto;">
        <table class="aiwms-table aiwms-table-dense" style="width:auto; min-width:480px;">
            <thead>
                <tr>
                    <th>@breakdownLabel</th>
                    <th style="text-align:right;">Transfer Count</th>
                    <th style="text-align:right;">Transfer Qty</th>
                    <th style="text-align:right;">GIN Count</th>
                    <th style="text-align:right;">GIN Qty</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in breakdownRows)
                {
                    <tr>
                        <td>@s.Country.ToUpperInvariant()</td>
                        <td style="text-align:right;">@s.TransferCount.ToString("N0")</td>
                        <td style="text-align:right;">@s.TransferQty.ToString("N0")</td>
                        <td style="text-align:right;">@s.GinCount.ToString("N0")</td>
                        <td style="text-align:right;">@s.GinQty.ToString("N0")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr style="font-weight:600; border-top:2px solid var(--border-default);">
                    <td>Total</td>
                    <td style="text-align:right;">@breakdownRows.Sum(s => s.TransferCount).ToString("N0")</td>
                    <td style="text-align:right;">@breakdownRows.Sum(s => s.TransferQty).ToString("N0")</td>
                    <td style="text-align:right;">@breakdownRows.Sum(s => s.GinCount).ToString("N0")</td>
                    <td style="text-align:right;">@breakdownRows.Sum(s => s.GinQty).ToString("N0")</td>
                </tr>
            </tfoot>
        </table>
        </div>
    </div>
}

@code {
    private RenderFragment StatCard(string label, int value, string bg, string color, Func<Task>? onClick = null)
    {
        var handler = onClick ?? (() => Task.CompletedTask);
        return @<div style="background:@bg; border-radius:8px; padding:12px 20px; flex:1; min-width:150px; text-align:center; @(onClick is not null ? "cursor:pointer;" : "")"
                      @onclick="handler" title="@(onClick is not null ? "Click for Division / Department / Group Code / Brand breakdown" : null)">
            <div style="font-size:11px; font-weight:700; color:@color; text-transform:uppercase; letter-spacing:0.03em;">@label</div>
            <div style="font-size:20px; font-weight:700; color:#222222; margin-top:6px;">@value.ToString("N0")</div>
        </div>;
    }
}

@if (_viewMode == "Detailed" && _rows.Count > 0)
{
    <div class="aiwms-section">
        <table class="aiwms-table aiwms-table-dense">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Store</th>
                    <th>Transfer No</th>
                    <th>Trf Date</th>
                    <th>Quantity</th>
                    <th>Pallet No</th>
                    <th>Build Date</th>
                    <th>GIN No</th>
                    <th>GIN Date</th>
                    <th>GRN No</th>
                    <th>GRN Date</th>
                    <th>Remarks</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr>
                        <td>@r.SrNo</td>
                        <td>@r.ShopName</td>
                        <td>@r.TrfNo</td>
                        <td>@r.TrfDate.ToString("dd/MM/yyyy")</td>
                        <td>@r.Quantity.ToString("N0")</td>
                        <td>@r.PalletNo</td>
                        <td>@(r.BuildDate.HasValue ? r.BuildDate.Value.ToString("dd/MM/yyyy") : "")</td>
                        <td>@r.GINNo</td>
                        <td>@(r.GINDate.HasValue ? r.GINDate.Value.ToString("dd/MM/yyyy") : "")</td>
                        <td>@r.GRNNo</td>
                        <td>@(r.GRNDate.HasValue ? r.GRNDate.Value.ToString("dd/MM/yyyy") : "")</td>
                        <td>@r.Remarks</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<string> _countries = new();
    private List<string> _stores    = new();
    private List<TransferHistoryRow> _rows = new();
    private TransferSummary? _total;
    private List<TransferSummary> _storeSummaries = new();
    private List<TransferSummary> _countrySummaries = new();
    private readonly List<string> _totalWarnings = new();

    // Regular country-scoped users only ever see their own country (locked,
    // matching the Shipment Status report). UAE-based staff and Admins get a
    // country dropdown plus "BFL Group" (every country combined).
    private const string BflGroupValue = "__BFLGROUP__";
    private bool   _canSelectMultiple;
    private string _lockedCountry = "";
    private string _country       = "";

    private string   _store         = "";
    // Default to yesterday, not today — today's data needs the slower regional
    // server round trip (see TransferGinGrnService's historical/today split),
    // so defaulting here keeps the common case on the fast OnPremBackup path.
    private DateTime _dateFrom       = DateTime.Today.AddDays(-1);
    private DateTime _dateTo         = DateTime.Today.AddDays(-1);
    private string   _viewMode      = "Summary"; // "Detailed" | "Summary"
    private bool     _withoutPallet;
    private bool     _withoutGin;
    private bool     _withoutGrn;
    private string   _searchBy      = "TrfNo";
    private string   _searchValue   = "";

    private bool   _loading;
    private string _message = "";
    private bool   _isError;

    // ===================== Division/Department/GroupCode/Brand drill-down popup =====================
    // The scope (countries/store/dates) that produced the on-screen totals — set
    // in LoadAsync alongside _total, so a card click re-scopes the breakdown to
    // exactly what's on screen rather than the raw filter inputs (which may have
    // changed since the last Load).
    private List<string>? _lastCountries;
    private string?        _lastStore;
    private DateTime       _lastDateFrom;
    private DateTime       _lastDateTo;

    private bool    _breakdownOpen;
    private bool    _breakdownLoading;
    private string  _breakdownTitle = "";
    private string? _breakdownError;
    private TransferGinBreakdownResult? _breakdownResult;

    private Task OpenTransferBreakdownAsync()
    {
        _breakdownTitle = "Transfer — Division / Department / Group Code / Brand";
        return LoadBreakdownAsync(() => Svc.GetTransferBreakdownAsync(_lastCountries, _lastStore, _lastDateFrom, _lastDateTo));
    }

    private Task OpenGinBreakdownAsync()
    {
        _breakdownTitle = "GIN — Division / Department / Group Code / Brand";
        return LoadBreakdownAsync(() => Svc.GetGinBreakdownAsync(_lastCountries, _lastStore, _lastDateFrom, _lastDateTo));
    }

    private async Task LoadBreakdownAsync(Func<Task<TransferGinBreakdownResult>> fetch)
    {
        _breakdownOpen = true; _breakdownLoading = true; _breakdownError = null; _breakdownResult = null;
        StateHasChanged();
        try { _breakdownResult = await fetch(); }
        catch (Exception ex) { _breakdownError = ex.Message; }
        finally { _breakdownLoading = false; StateHasChanged(); }
    }

    private void CloseBreakdown() => _breakdownOpen = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CurrentUser.EnsureLoadedAsync();
            // Restrict to the user's granted WmsUserCountryAccess countries (Admin sees
            // all) — replaces the old "UAE home country picks any country, everyone
            // else is locked to their own home country" rule, which ignored the actual
            // per-user country grants entirely.
            _countries = CurrentUser.FilterCountries(await Svc.GetCountriesAsync()).ToList();

            _canSelectMultiple = CurrentUser.HasAllCountriesAccess || _countries.Count > 1;

            if (!_canSelectMultiple)
            {
                _lockedCountry = _countries.FirstOrDefault() ?? "";
                _country = _lockedCountry;
            }
            else if (!string.IsNullOrWhiteSpace(CurrentUser.Country) && _countries.Contains(CurrentUser.Country!))
            {
                _country = CurrentUser.Country!;
            }
            else if (_countries.Count > 0)
            {
                _country = _countries[0];
            }

            if (_country != BflGroupValue) await LoadStoresAsync();
        }
        catch (Exception ex) { ShowError($"Init failed: {ex.Message}"); }
    }

    private async Task OnCountryChangedAsync()
    {
        _store = "";
        if (_country != BflGroupValue) await LoadStoresAsync();
        else _stores = new();
    }

    private async Task LoadStoresAsync()
    {
        try { _stores = await Svc.GetStoresAsync(_country); }
        catch (Exception ex) { ShowError($"Failed to load stores for {_country}: {ex.Message}"); }
    }

    // Every country's totals summed into one grand total (also used for a
    // single country selection — the list just has one entry then). Also
    // stashes the per-country breakdown into _countrySummaries — shown as a
    // BY COUNTRY table, but only rendered when BFL Group is actually selected
    // (a single country's own 1-item list isn't worth showing as a table).
    // Warnings are stashed into _totalWarnings for LoadAsync to merge in.
    private async Task<TransferSummary?> GetAggregateTotalAsync(List<string>? countries)
    {
        var result = await Svc.GetTransferSummaryAsync(countries, _dateFrom, _dateTo);
        if (result.Warnings.Count > 0) _totalWarnings.AddRange(result.Warnings);
        _countrySummaries = result.Summaries;
        if (result.Summaries.Count == 0) return null;
        return new TransferSummary(
            "Total",
            result.Summaries.Sum(s => s.TransferCount),
            result.Summaries.Sum(s => s.TransferQty),
            result.Summaries.Sum(s => s.GinCount),
            result.Summaries.Sum(s => s.GinQty));
    }

    private async Task LoadAsync()
    {
        _loading = true; _message = ""; _rows.Clear(); _total = null; _storeSummaries.Clear(); _countrySummaries.Clear(); _totalWarnings.Clear();
        await InvokeAsync(StateHasChanged);
        try
        {
            List<string>? countries;
            if (!_canSelectMultiple)
            {
                if (string.IsNullOrWhiteSpace(_lockedCountry))
                {
                    ShowError("Your account has no assigned country — contact an admin.");
                    return;
                }
                countries = [_lockedCountry];
            }
            else if (_country == BflGroupValue)
            {
                // null = no filter, only valid for a genuine all-countries (Admin) user —
                // a non-Admin multi-country user's "BFL Group" means everything THEY can
                // see, i.e. their already-filtered _countries list, not literally every country.
                countries = CurrentUser.HasAllCountriesAccess ? null : _countries.ToList();
            }
            else
            {
                countries = [_country];
            }

            var singleCountry = countries?.Count == 1 ? countries[0] : null;
            var storeFilter   = singleCountry is not null && !string.IsNullOrWhiteSpace(_store) ? _store : null;

            _lastCountries = countries;
            _lastStore     = storeFilter;
            _lastDateFrom  = _dateFrom;
            _lastDateTo    = _dateTo;

            var filter = new TransferHistoryFilter(
                Countries:     countries,
                Store:         storeFilter,
                DateFrom:      _dateFrom,
                DateTo:        _dateTo,
                WithoutPallet: _withoutPallet,
                WithoutGin:    _withoutGin,
                WithoutGrn:    _withoutGrn,
                SearchBy:      _searchBy,
                SearchValue:   string.IsNullOrWhiteSpace(_searchValue) ? null : _searchValue.Trim());

            // Summary view never shows the detail table — skip the expensive
            // per-shop, per-transfer query entirely rather than fetching rows
            // nothing displays.
            var resultTask = _viewMode == "Detailed"
                ? Svc.GetTransferHistoryAsync(filter)
                : Task.FromResult(new TransferHistoryResult(new List<TransferHistoryRow>(), new List<string>()));

            // One specific store picked -> its own scoped total. Otherwise
            // (BFL Group, or a country with "(All stores)") -> every country's
            // total summed into one grand total.
            var totalTask = storeFilter is not null && singleCountry is not null
                ? Svc.GetStoreSummaryAsync(singleCountry, storeFilter, _dateFrom, _dateTo)
                : GetAggregateTotalAsync(countries);

            // Per-store breakdown table, only when a single country is picked
            // with "(All stores)" — not meaningful for BFL Group or a specific store.
            var singleCountryAllStores = storeFilter is null && singleCountry is not null;
            var storeSummariesTask = singleCountryAllStores
                ? Svc.GetStoreSummariesAsync(singleCountry!, _dateFrom, _dateTo)
                : Task.FromResult(new List<TransferSummary>());

            await Task.WhenAll(resultTask, totalTask, storeSummariesTask);

            var result = resultTask.Result;
            _rows            = result.Rows;
            _total           = totalTask.Result;
            _storeSummaries  = storeSummariesTask.Result;

            var allWarnings = result.Warnings.Concat(_totalWarnings).ToList();
            var loadedMsg   = _viewMode == "Detailed" ? $"Loaded {_rows.Count} rows." : "Summary loaded.";
            if (allWarnings.Count > 0)
                ShowError($"{loadedMsg} Some countries failed: {string.Join("; ", allWarnings)}");
            else
                ShowInfo(loadedMsg);
        }
        catch (Exception ex) { ShowError($"Load failed: {ex.Message}"); }
        finally { _loading = false; }
    }

    private async Task ExportCsvAsync()
    {
        var sb = new StringBuilder();
        sb.AppendLine("#,Store,TrfNo,TrfDate,Quantity,PalletNo,BuildDate,GINNo,GINDate,GRNNo,GRNDate,Remarks");
        foreach (var r in _rows)
            sb.AppendLine($"{r.SrNo},{Csv(r.ShopName)},{Csv(r.TrfNo)},{r.TrfDate:yyyy-MM-dd},{r.Quantity},{Csv(r.PalletNo)}" +
                          $",{(r.BuildDate.HasValue ? r.BuildDate.Value.ToString("yyyy-MM-dd") : "")}" +
                          $",{Csv(r.GINNo)},{(r.GINDate.HasValue ? r.GINDate.Value.ToString("yyyy-MM-dd") : "")}" +
                          $",{Csv(r.GRNNo)},{(r.GRNDate.HasValue ? r.GRNDate.Value.ToString("yyyy-MM-dd") : "")}" +
                          $",{Csv(r.Remarks)}");

        var b64      = Convert.ToBase64String(Encoding.UTF8.GetBytes(sb.ToString()));
        var country  = _country == BflGroupValue ? "BFLGroup" : (_canSelectMultiple ? _country : _lockedCountry);
        var filename = $"TransferGinGrn_{country}_{_dateFrom:yyyyMMdd}_{_dateTo:yyyyMMdd}.csv";
        await JS.InvokeVoidAsync("eval",
            $"(function(){{var a=document.createElement('a');a.href='data:text/csv;base64,{b64}';" +
            $"a.download='{filename}';document.body.appendChild(a);a.click();document.body.removeChild(a);}})();");
    }

    private static string Csv(string? s)
    {
        if (s is null) return "";
        return (s.Contains(',') || s.Contains('"') || s.Contains('\n'))
            ? "\"" + s.Replace("\"", "\"\"") + "\""
            : s;
    }

    private void ShowError(string msg) { _message = msg; _isError = true; }
    private void ShowInfo(string msg)  { _message = msg; _isError = false; }
}
