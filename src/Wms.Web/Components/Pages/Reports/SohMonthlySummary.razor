@page "/reports/soh-monthly-summary"
@rendermode RenderMode.InteractiveServer
@using Wms.Core
@using Wms.Data.Lpm
@using ClosedXML.Excel
@attribute [Authorize(Policy = MenuKeys.RPT_SOH_MONTHLY_SUMMARY)]
@inject WarehouseSohSummaryService Svc
@inject IJSRuntime JS
@inject IDialogService DialogService

<style>
    .smsum-header { background: var(--bfl-black); color: var(--bfl-yellow); font-family: var(--font-display); font-weight: 800; font-size: 13px; text-transform: uppercase; letter-spacing: .5px; padding: 10px 14px; text-align: center; }
    .aiwms-icon-btn { background: none; border: none; color: inherit; cursor: pointer; padding: 2px 6px; line-height: 1; border-radius: var(--r-sm); }
    .aiwms-icon-btn:hover:not(:disabled) { background: rgba(255,255,255,0.15); }
    .aiwms-icon-btn:disabled { opacity: 0.4; cursor: default; }

    .smsum-country-select summary { list-style: none; }
    .smsum-country-select summary::-webkit-details-marker { display: none; }
    .smsum-country-select summary { transition: border-color .15s ease, box-shadow .15s ease; }
    .smsum-country-select summary:hover { border-color: var(--border-strong); }
    .smsum-country-select details[open] summary { border-color: var(--bfl-yellow); box-shadow: 0 0 0 3px rgba(255, 209, 0, .18); }
    .smsum-country-select .smsum-arrow { display: inline-block; transition: transform .15s ease; }
    .smsum-country-select details[open] .smsum-arrow { transform: rotate(180deg); }
    .smsum-country-select .smsum-option { border-radius: 4px; padding: 6px 8px; margin: 0 -2px; transition: background-color .1s ease; }
    .smsum-country-select .smsum-option:hover { background: var(--bfl-yellow-lite); }
    .smsum-country-select .smsum-option input[type="checkbox"] { width: 15px; height: 15px; accent-color: var(--bfl-yellow-hov); cursor: pointer; }
</style>

<div class="aiwms-page-header">
    <h2>SOH Monthly Summary</h2>
    <p>Month-end stock-on-hand from the monthly BigQuery snapshot (dbo.WMS_WHSTOCK_LASTDAY). Monthly Summary below covers UAE by warehouse plus every export country; Season / Pallet Category breakdowns are per-country via the filter below.</p>
</div>

<div class="aiwms-section">
    <div style="display:flex; gap:12px; align-items:end; flex-wrap:wrap;">
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">YEAR (Monthly Summary below)</label>
            <select @bind="_selectedYear" style="width:170px; height:36px; box-sizing:border-box; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;">
                @foreach (var y in _years)
                {
                    <option value="@y">@y</option>
                }
            </select>
        </div>
        <div class="smsum-country-select">
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">COUNTRY (select any) — Season / Pallet Category below</label>
            <details id="smsum-country-dropdown" style="position:relative;">
                <summary style="display:flex; align-items:center; justify-content:space-between; gap:8px; width:220px; height:36px; box-sizing:border-box; padding:8px 12px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; font-weight:600; background:white; cursor:pointer; user-select:none;">
                    <span style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@CountrySelectionLabel</span>
                    <span class="smsum-arrow" style="color:var(--text-secondary); font-size:10px; flex-shrink:0;">&#9660;</span>
                </summary>
                <div style="position:absolute; top:100%; left:0; right:0; z-index:20; margin-top:6px; display:flex; flex-direction:column; gap:2px; max-height:220px; overflow-y:auto; border:1px solid var(--border-default); border-radius:8px; padding:8px; background:white; box-shadow:0 8px 20px rgba(0,0,0,0.14);">
                    <label class="smsum-option" style="display:flex; align-items:center; gap:8px; cursor:pointer; font-size:13px; font-weight:700; border-bottom:1px solid var(--border-default); padding-bottom:8px; margin-bottom:2px">
                        <input type="checkbox" checked="@Countries.All(c => _selectedCountries.Contains(c.Value))" @onchange="@(e => ToggleAllCountriesAsync((bool)e.Value!))" />
                        Select all
                    </label>
                    @foreach (var c in Countries)
                    {
                        <label class="smsum-option" style="display:flex; align-items:center; gap:8px; cursor:pointer; font-size:13px">
                            <input type="checkbox" checked="@_selectedCountries.Contains(c.Value)" @onchange="@(e => ToggleCountryAsync(c.Value, (bool)e.Value!))" />
                            @c.Label
                        </label>
                    }
                </div>
            </details>
        </div>
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">MONTH (Season / Pallet Category below)</label>
            <select @bind="_selectedMonthKey" style="width:170px; height:36px; box-sizing:border-box; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" disabled="@(_availableMonths.Count == 0)">
                @if (_availableMonths.Count == 0)
                {
                    <option value="">No data yet</option>
                }
                @foreach (var d in _availableMonths)
                {
                    <option value="@MonthKey(d)">@d.ToString("MMM yyyy")</option>
                }
            </select>
        </div>
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">WAREHOUSE (Season / Pallet Category below)</label>
            <select @bind="_selectedWarehouse" style="width:170px; height:36px; box-sizing:border-box; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" disabled="@(AllWarehousesAcrossSelected.Count == 0)">
                <option value="">All Warehouses</option>
                @foreach (var wh in AllWarehousesAcrossSelected)
                {
                    <option value="@wh">@wh</option>
                }
            </select>
        </div>
        <button class="aiwms-btn aiwms-btn-primary" style="height:36px; box-sizing:border-box" @onclick="LoadAsync" disabled="@(_loading || _selectedCountries.Count == 0)">@(_loading ? "Loading…" : "Load")</button>
    </div>
</div>

@if (_loadedOnce)
{
    <div class="aiwms-section" style="padding:0; overflow:hidden">
        <div class="smsum-header" style="display:flex; align-items:center; justify-content:space-between;">
            <span>SOH Monthly Summary for the year @_selectedYear</span>
            <span>
                <button class="aiwms-icon-btn" title="View chart" @onclick="ShowMonthlySummaryChartAsync">
                    <span class="mi sm" style="color:inherit">bar_chart</span>
                </button>
                <button class="aiwms-icon-btn" title="Export to Excel" disabled="@_exporting" @onclick="ExportMonthlySummaryAsync">
                    <span class="mi sm" style="color:inherit">download</span>
                </button>
            </span>
        </div>
        <div style="overflow-x:auto">
            <table class="aiwms-table aiwms-table-dense" style="text-align:center">
                <thead>
                    <tr>
                        <th></th>
                        @foreach (var grp in MonthlyGroups)
                        {
                            var idx = Array.IndexOf(MonthlyGroups, grp);
                            var (bg, fg) = GroupColor(idx);
                            <th colspan="3" style="text-align:center; background:@bg; color:@fg; @GroupSep(idx)">@grp</th>
                        }
                    </tr>
                    <tr>
                        <th></th>
                        @foreach (var grp in MonthlyGroups)
                        {
                            var idx = Array.IndexOf(MonthlyGroups, grp);
                            <th style="text-align:right; @GroupSep(idx)">Qty</th>
                            <th style="text-align:right">No. of Box</th>
                            <th style="text-align:right">No. of Pallets</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (var m = 1; m <= 12; m++)
                    {
                        var month = m;
                        <tr>
                            <td style="text-align:left; font-weight:700">@MonthLabel(month)</td>
                            @foreach (var grp in MonthlyGroups)
                            {
                                var idx = Array.IndexOf(MonthlyGroups, grp);
                                var row = _byGroupMonth.GetValueOrDefault((grp, month));
                                <td style="text-align:right; @GroupSep(idx)">@(row is null ? "—" : row.Qty.ToString("N0"))</td>
                                <td style="text-align:right">@(row is null ? "—" : row.BoxCount.ToString("N0"))</td>
                                <td style="text-align:right">@(row is null ? "—" : row.PalletCount.ToString("N0"))</td>
                            }
                        </tr>
                    }
                    <tr style="font-weight:700; background:#e6f4ea">
                        <td style="text-align:left">Monthly Avg.</td>
                        @foreach (var grp in MonthlyGroups)
                        {
                            var idx = Array.IndexOf(MonthlyGroups, grp);
                            var avg = MonthlyAverage(grp);
                            <td style="text-align:right; @GroupSep(idx)">@(avg is null ? "—" : avg.Value.Qty.ToString("N0"))</td>
                            <td style="text-align:right">@(avg is null ? "—" : avg.Value.BoxCount.ToString("N0"))</td>
                            <td style="text-align:right">@(avg is null ? "—" : avg.Value.PalletCount.ToString("N0"))</td>
                        }
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <p style="font-size:11px; color:var(--text-secondary); margin-top:8px">
        "Monthly Avg." averages only the months that have data — months with no snapshot yet ("—") aren't counted as zero.
    </p>

    @foreach (var country in Countries.Where(c => _selectedCountries.Contains(c.Value)))
    {
        var warehouses = DisplayWarehousesFor(country.Value);
        var palletCategories = _palletCategoriesByCountry.GetValueOrDefault(country.Value) ?? new List<string>();

        <div class="aiwms-section" style="padding:0; overflow:hidden">
            <div class="smsum-header" style="display:flex; align-items:center; justify-content:space-between;">
                <span>SOH by Season — @country.Label Warehouses (@SelectedMonthLabel)</span>
                <span>
                    <button class="aiwms-icon-btn" title="View chart" @onclick="() => ShowSeasonChartAsync(country.Value, country.Label)">
                        <span class="mi sm" style="color:inherit">bar_chart</span>
                    </button>
                    <button class="aiwms-icon-btn" title="Export to Excel" disabled="@_exporting" @onclick="() => ExportSeasonAsync(country.Value, country.Label)">
                        <span class="mi sm" style="color:inherit">download</span>
                    </button>
                </span>
            </div>
            <div style="overflow-x:auto">
                <table class="aiwms-table aiwms-table-dense" style="text-align:center">
                    <thead>
                        <tr>
                            <th></th>
                            @foreach (var season in SeasonGroups)
                            {
                                var idx = Array.IndexOf(SeasonGroups, season);
                                var (bg, fg) = GroupColor(idx);
                                <th colspan="3" style="text-align:center; background:@bg; color:@fg; @GroupSep(idx)">@season</th>
                            }
                        </tr>
                        <tr>
                            <th></th>
                            @foreach (var season in SeasonGroups)
                            {
                                var idx = Array.IndexOf(SeasonGroups, season);
                                <th style="text-align:right; @GroupSep(idx)">Qty</th>
                                <th style="text-align:right">Box</th>
                                <th style="text-align:right">Pallets</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (warehouses.Count == 0)
                        {
                            <tr><td colspan="7" style="font-style:italic; color:var(--text-secondary)">No data for @country.Label / @SelectedMonthLabel yet.</td></tr>
                        }
                        @foreach (var wh in warehouses)
                        {
                            <tr>
                                <td style="text-align:left; font-weight:700">@wh</td>
                                @foreach (var season in SeasonGroups)
                                {
                                    var idx = Array.IndexOf(SeasonGroups, season);
                                    var row = _seasonByCountry.GetValueOrDefault(country.Value)?.GetValueOrDefault((wh, season));
                                    <td style="text-align:right; @GroupSep(idx)">@(row is null ? "—" : row.Qty.ToString("N0"))</td>
                                    <td style="text-align:right">@(row is null ? "—" : row.BoxCount.ToString("N0"))</td>
                                    <td style="text-align:right">@(row is null ? "—" : row.PalletCount.ToString("N0"))</td>
                                }
                            </tr>
                        }
                        @if (warehouses.Count > 1)
                        {
                            <tr style="font-weight:700; background:#e6f4ea">
                                <td style="text-align:left">Total</td>
                                @foreach (var season in SeasonGroups)
                                {
                                    var idx = Array.IndexOf(SeasonGroups, season);
                                    var (qty, box, pallets) = SeasonTotal(country.Value, season);
                                    <td style="text-align:right; @GroupSep(idx)">@qty.ToString("N0")</td>
                                    <td style="text-align:right">@box.ToString("N0")</td>
                                    <td style="text-align:right">@pallets.ToString("N0")</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="aiwms-section" style="padding:0; overflow:hidden">
            <div class="smsum-header" style="display:flex; align-items:center; justify-content:space-between;">
                <span>SOH by Pallet Category — @country.Label Warehouses (@SelectedMonthLabel)</span>
                <span>
                    <button class="aiwms-icon-btn" title="View chart" @onclick="() => ShowPalletCategoryChartAsync(country.Value, country.Label)">
                        <span class="mi sm" style="color:inherit">bar_chart</span>
                    </button>
                    <button class="aiwms-icon-btn" title="Export to Excel" disabled="@_exporting" @onclick="() => ExportPalletCategoryAsync(country.Value, country.Label)">
                        <span class="mi sm" style="color:inherit">download</span>
                    </button>
                </span>
            </div>
            <div style="overflow-x:auto">
                <table class="aiwms-table aiwms-table-dense" style="text-align:center">
                    <thead>
                        <tr>
                            <th></th>
                            @foreach (var cat in palletCategories)
                            {
                                var idx = palletCategories.IndexOf(cat);
                                var (bg, fg) = GroupColor(idx);
                                <th colspan="3" style="text-align:center; background:@bg; color:@fg; @GroupSep(idx)">@cat</th>
                            }
                        </tr>
                        <tr>
                            <th></th>
                            @foreach (var cat in palletCategories)
                            {
                                var idx = palletCategories.IndexOf(cat);
                                <th style="text-align:right; @GroupSep(idx)">Qty</th>
                                <th style="text-align:right">Box</th>
                                <th style="text-align:right">Pallets</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (warehouses.Count == 0 || palletCategories.Count == 0)
                        {
                            <tr><td style="font-style:italic; color:var(--text-secondary)">No data for @country.Label / @SelectedMonthLabel yet.</td></tr>
                        }
                        @foreach (var wh in warehouses)
                        {
                            <tr>
                                <td style="text-align:left; font-weight:700">@wh</td>
                                @foreach (var cat in palletCategories)
                                {
                                    var idx = palletCategories.IndexOf(cat);
                                    var row = _palletByCountry.GetValueOrDefault(country.Value)?.GetValueOrDefault((wh, cat));
                                    <td style="text-align:right; @GroupSep(idx)">@(row is null ? "—" : row.Qty.ToString("N0"))</td>
                                    <td style="text-align:right">@(row is null ? "—" : row.BoxCount.ToString("N0"))</td>
                                    <td style="text-align:right">@(row is null ? "—" : row.PalletCount.ToString("N0"))</td>
                                }
                            </tr>
                        }
                        @if (warehouses.Count > 1 && palletCategories.Count > 0)
                        {
                            <tr style="font-weight:700; background:#e6f4ea">
                                <td style="text-align:left">Total</td>
                                @foreach (var cat in palletCategories)
                                {
                                    var idx = palletCategories.IndexOf(cat);
                                    var (qty, box, pallets) = PalletCategoryTotal(country.Value, cat);
                                    <td style="text-align:right; @GroupSep(idx)">@qty.ToString("N0")</td>
                                    <td style="text-align:right">@box.ToString("N0")</td>
                                    <td style="text-align:right">@pallets.ToString("N0")</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    // Report 1 (Monthly Summary): UAE's 3 main warehouses plus every export country as
    // its own single-facility group, matching the report's own mockup exactly. Always
    // shows all 8 -- not affected by the Country filter below (that filter is for
    // reports 2/3 only).
    private static readonly string[] MonthlyGroups = { "TECHNO", "YOTO", "JAFZA", "KSA", "QATAR", "KUWAIT", "MYS", "BAHRAIN" };
    private static readonly string[] SeasonGroups = { "Summer", "Winter" };

    // Display label -> actual Country value stored in dbo.WMS_WHSTOCK_LASTDAY
    // (only Malaysia's display label differs from its DB value, matching the
    // "MYS" column header already used in report 1).
    public sealed record CountryOption(string Label, string Value);
    private static readonly CountryOption[] Countries =
    {
        new("UAE", "UAE"),
        new("KSA", "KSA"),
        new("QATAR", "QATAR"),
        new("KUWAIT", "KUWAIT"),
        new("MYS", "MALAYSIA"),
        new("BAHRAIN", "BAHRAIN"),
    };

    // A fixed pastel palette cycled by column index -- works for any group count
    // (2 seasons, 3 warehouses, 5 pallet categories, ...) without a per-name map.
    private static readonly (string Bg, string Fg)[] _palette =
    {
        ("#dbeafe", "#1e3a5f"), // blue
        ("#dcfce7", "#14532d"), // green
        ("#fef3c7", "#78350f"), // amber
        ("#ede9fe", "#4c1d95"), // purple
        ("#fce7f3", "#831843"), // pink
        ("#ccfbf1", "#134e4a"), // teal
    };

    private static (string Bg, string Fg) GroupColor(int index) =>
        _palette[((index % _palette.Length) + _palette.Length) % _palette.Length];

    // A light vertical rule before every column group, including the first (marks the
    // boundary against the row-label column too), so multi-group tables read as
    // distinct blocks instead of one continuous strip.
    private static string GroupSep(int index) => "border-left:2px solid #b8c2cc;";

    private int _selectedYear = DateTime.Now.Year;
    // Multiselect (matching Production Summary Report's COUNTRY picker) -- Season /
    // Pallet Category sections repeat once per selected country instead of showing
    // just one at a time.
    private HashSet<string> _selectedCountries = new(StringComparer.OrdinalIgnoreCase) { "UAE" };
    private string _selectedMonthKey = "";
    private string _selectedWarehouse = "";
    private List<int> _years = new();
    private List<DateTime> _availableMonths = new();
    private bool _loading;
    private bool _loadedOnce;
    private bool _exporting;
    private Dictionary<(string Group, int Month), SohMonthlyRow> _byGroupMonth = new();

    // Per selected country.
    private Dictionary<string, Dictionary<(string Warehouse, string Season), SohSeasonByWarehouseRow>> _seasonByCountry = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, Dictionary<(string Warehouse, string PalletCategory), SohPalletCategoryByWarehouseRow>> _palletByCountry = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, List<string>> _palletCategoriesByCountry = new(StringComparer.OrdinalIgnoreCase);
    // Every distinct warehouse-group actually returned for each country -- different
    // countries have different physical warehouses (UAE has 7 groups including
    // sub-facilities; KSA/KUWAIT have their own single facility plus "No WH Info";
    // MALAYSIA/QATAR currently have only "No WH Info"; BAHRAIN currently has no data
    // at all), so this can't be a fixed list shared across countries.
    private Dictionary<string, List<string>> _warehousesByCountry = new(StringComparer.OrdinalIgnoreCase);

    private string CountrySelectionLabel
    {
        get
        {
            var picked = Countries.Where(c => _selectedCountries.Contains(c.Value)).Select(c => c.Label).ToList();
            return picked.Count switch
            {
                0 => "Select countries...",
                <= 2 => string.Join(", ", picked),
                _ => $"{picked.Count} countries selected"
            };
        }
    }

    // The warehouse rows actually shown/exported for one country's Season / Pallet
    // Category tables -- all of that country's warehouses, unless the WAREHOUSE
    // filter narrows it to just one (matched by name across every selected country).
    private List<string> DisplayWarehousesFor(string country)
    {
        var all = _warehousesByCountry.GetValueOrDefault(country) ?? new List<string>();
        return string.IsNullOrEmpty(_selectedWarehouse)
            ? all
            : all.Where(w => string.Equals(w, _selectedWarehouse, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    // WAREHOUSE dropdown options -- the union of every selected country's warehouses,
    // since one dropdown now has to serve every country-table on the page at once.
    private List<string> AllWarehousesAcrossSelected =>
        _selectedCountries
            .SelectMany(c => _warehousesByCountry.GetValueOrDefault(c) ?? new List<string>())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
            .ToList();

    // @bind on a <select> with a DateTime-typed field risks a format mismatch between
    // Blazor's own round-trip formatting and a custom <option value> string -- keying
    // by a plain "yyyy-MM-dd" string instead sidesteps that entirely.
    private static string MonthKey(DateTime d) => d.ToString("yyyy-MM-dd");

    private DateTime SelectedMonth =>
        DateTime.TryParse(_selectedMonthKey, out var d) ? d : (_availableMonths.FirstOrDefault());

    private string SelectedMonthLabel => _availableMonths.Count == 0 ? "no data" : SelectedMonth.ToString("MMM yyyy");

    private (long Qty, long BoxCount, long PalletCount) SeasonTotal(string country, string season)
    {
        var byWh = _seasonByCountry.GetValueOrDefault(country);
        var rows = DisplayWarehousesFor(country).Select(wh => byWh?.GetValueOrDefault((wh, season))).Where(r => r is not null).Select(r => r!).ToList();
        return (rows.Sum(r => r.Qty), rows.Sum(r => r.BoxCount), rows.Sum(r => r.PalletCount));
    }

    private (long Qty, long BoxCount, long PalletCount) PalletCategoryTotal(string country, string category)
    {
        var byWh = _palletByCountry.GetValueOrDefault(country);
        var rows = DisplayWarehousesFor(country).Select(wh => byWh?.GetValueOrDefault((wh, category))).Where(r => r is not null).Select(r => r!).ToList();
        return (rows.Sum(r => r.Qty), rows.Sum(r => r.BoxCount), rows.Sum(r => r.PalletCount));
    }

    protected override async Task OnInitializedAsync()
    {
        var thisYear = DateTime.Now.Year;
        _years = Enumerable.Range(thisYear - 2, 4).Reverse().ToList(); // thisYear+1 .. thisYear-2
        _selectedYear = thisYear;

        await RefreshAvailableMonthsAsync();
    }

    // Available snapshot dates can differ per country (e.g. BAHRAIN currently has
    // none at all) -- with multiple countries selected, the MONTH dropdown offers
    // the union of every selected country's dates rather than just one country's.
    private async Task RefreshAvailableMonthsAsync()
    {
        var all = new List<DateTime>();
        foreach (var country in _selectedCountries)
            all.AddRange(await Svc.GetAvailableSnapshotDatesAsync(country));
        _availableMonths = all.Distinct().OrderByDescending(d => d).ToList();
        _selectedMonthKey = _availableMonths.Count > 0 ? MonthKey(_availableMonths[0]) : "";
    }

    private async Task ToggleCountryAsync(string country, bool isChecked)
    {
        if (isChecked) _selectedCountries.Add(country);
        else _selectedCountries.Remove(country);
        _selectedWarehouse = ""; // the selected set's warehouses changed, so a stale pick would just filter everything out
        await RefreshAvailableMonthsAsync();
    }

    private async Task ToggleAllCountriesAsync(bool isChecked)
    {
        if (isChecked) foreach (var c in Countries) _selectedCountries.Add(c.Value);
        else _selectedCountries.Clear();
        _selectedWarehouse = "";
        await RefreshAvailableMonthsAsync();
    }

    private static string MonthLabel(int month) =>
        new DateTime(2000, month, 1).ToString("MMM");

    private (long Qty, long BoxCount, long PalletCount)? MonthlyAverage(string group)
    {
        var rows = Enumerable.Range(1, 12)
            .Select(m => _byGroupMonth.GetValueOrDefault((group, m)))
            .Where(r => r is not null)
            .Select(r => r!)
            .ToList();
        if (rows.Count == 0) return null;
        return (
            (long)Math.Round(rows.Average(r => r.Qty)),
            (long)Math.Round(rows.Average(r => r.BoxCount)),
            (long)Math.Round(rows.Average(r => r.PalletCount)));
    }

    private async Task LoadAsync()
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var monthly = await Svc.GetSohMonthlySummaryAsync(_selectedYear);
            _byGroupMonth = monthly.ToDictionary(r => (r.Warehouse, r.MonthEnd.Month), r => r);

            _seasonByCountry.Clear();
            _palletByCountry.Clear();
            _palletCategoriesByCountry.Clear();
            _warehousesByCountry.Clear();

            foreach (var country in _selectedCountries)
            {
                var season = await Svc.GetSohSeasonByWarehouseAsync(country, SelectedMonth);
                var pallet = await Svc.GetSohPalletCategoryByWarehouseAsync(country, SelectedMonth);

                _seasonByCountry[country] = season.ToDictionary(r => (r.Warehouse, r.SeasonGroup), r => r);
                _palletByCountry[country] = pallet.ToDictionary(r => (r.Warehouse, r.PalletCategory), r => r);
                _palletCategoriesByCountry[country] = pallet.Select(r => r.PalletCategory).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToList();
                _warehousesByCountry[country] = season.Select(r => r.Warehouse)
                    .Union(pallet.Select(r => r.Warehouse), StringComparer.OrdinalIgnoreCase)
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }

            if (!AllWarehousesAcrossSelected.Contains(_selectedWarehouse, StringComparer.OrdinalIgnoreCase))
                _selectedWarehouse = "";
        }
        finally
        {
            _loadedOnce = true;
            _loading = false;
        }
    }

    // ====================== Charts (one popup dialog per report) ======================

    private async Task ShowMonthlySummaryChartAsync()
    {
        // Skip months with no snapshot at all (e.g. before the feed started or after the
        // latest run) instead of plotting them as a false zero.
        var monthsWithData = Enumerable.Range(1, 12)
            .Where(m => MonthlyGroups.Any(grp => _byGroupMonth.ContainsKey((grp, m))))
            .ToList();
        var series = MonthlyGroups.Select(grp => new ChartSeries
        {
            Name = grp,
            Data = monthsWithData.Select(m => (double)(_byGroupMonth.GetValueOrDefault((grp, m))?.Qty ?? 0)).ToArray()
        }).ToList();
        var labels = monthsWithData.Select(MonthLabel).ToArray();
        await ShowChartAsync($"SOH Monthly Summary — Qty by Group ({_selectedYear})", ChartType.Line, series, labels);
    }

    private async Task ShowSeasonChartAsync(string country, string countryLabel)
    {
        var warehouses = DisplayWarehousesFor(country);
        var byWh = _seasonByCountry.GetValueOrDefault(country);
        var series = SeasonGroups.Select(season => new ChartSeries
        {
            Name = season,
            Data = warehouses.Select(wh => (double)(byWh?.GetValueOrDefault((wh, season))?.Qty ?? 0)).ToArray()
        }).ToList();
        await ShowChartAsync($"SOH by Season — {countryLabel} ({SelectedMonthLabel})", ChartType.Bar, series, warehouses.ToArray());
    }

    private async Task ShowPalletCategoryChartAsync(string country, string countryLabel)
    {
        var warehouses = DisplayWarehousesFor(country);
        var byWh = _palletByCountry.GetValueOrDefault(country);
        var palletCategories = _palletCategoriesByCountry.GetValueOrDefault(country) ?? new List<string>();
        var series = palletCategories.Select(cat => new ChartSeries
        {
            Name = cat,
            Data = warehouses.Select(wh => (double)(byWh?.GetValueOrDefault((wh, cat))?.Qty ?? 0)).ToArray()
        }).ToList();
        await ShowChartAsync($"SOH by Pallet Category — {countryLabel} ({SelectedMonthLabel})", ChartType.Bar, series, warehouses.ToArray());
    }

    private async Task ShowChartAsync(string title, ChartType chartType, List<ChartSeries> series, string[] labels)
    {
        var parameters = new DialogParameters<ChartDialog>
        {
            { x => x.Title, title },
            { x => x.ChartTypeValue, chartType },
            { x => x.Series, series },
            { x => x.Labels, labels },
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true };
        await DialogService.ShowAsync<ChartDialog>(title, parameters, options);
    }

    // ====================== Excel export (one sheet per report) ======================

    private async Task ExportMonthlySummaryAsync() =>
        await ExportSingleSheetAsync($"soh-monthly-summary-{_selectedYear}", AddMonthlySummarySheet);

    private async Task ExportSeasonAsync(string country, string countryLabel) =>
        await ExportSingleSheetAsync($"soh-by-season-{countryLabel}", wb => AddSeasonSheet(wb, country, countryLabel));

    private async Task ExportPalletCategoryAsync(string country, string countryLabel) =>
        await ExportSingleSheetAsync($"soh-by-pallet-category-{countryLabel}", wb => AddPalletCategorySheet(wb, country, countryLabel));

    private async Task ExportSingleSheetAsync(string fileNamePrefix, Action<XLWorkbook> addSheet)
    {
        _exporting = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            using var wb = new XLWorkbook();
            addSheet(wb);

            using var ms = new MemoryStream();
            wb.SaveAs(ms);
            var b64 = Convert.ToBase64String(ms.ToArray());
            var name = $"{fileNamePrefix}-{DateTime.UtcNow.AddHours(4):yyyyMMdd-HHmm}.xlsx";
            await JS.InvokeVoidAsync("downloadFileWithPicker", name, b64,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        finally { _exporting = false; }
    }

    private void AddMonthlySummarySheet(XLWorkbook wb)
    {
        var ws = wb.AddWorksheet($"Monthly Summary {_selectedYear}");
        var col = 2;
        foreach (var grp in MonthlyGroups)
        {
            ws.Cell(1, col).Value = grp;
            ws.Range(1, col, 1, col + 2).Merge();
            ws.Cell(2, col).Value = "Qty";
            ws.Cell(2, col + 1).Value = "No. of Box";
            ws.Cell(2, col + 2).Value = "No. of Pallets";
            col += 3;
        }
        ws.Row(1).Style.Font.Bold = true;
        ws.Row(2).Style.Font.Bold = true;

        for (var m = 1; m <= 12; m++)
        {
            var r = m + 2;
            ws.Cell(r, 1).Value = MonthLabel(m);
            col = 2;
            foreach (var grp in MonthlyGroups)
            {
                var row = _byGroupMonth.GetValueOrDefault((grp, m));
                ws.Cell(r, col).Value = row?.Qty;
                ws.Cell(r, col + 1).Value = row?.BoxCount;
                ws.Cell(r, col + 2).Value = row?.PalletCount;
                col += 3;
            }
        }

        var avgRow = 15;
        ws.Cell(avgRow, 1).Value = "Monthly Avg.";
        ws.Row(avgRow).Style.Font.Bold = true;
        col = 2;
        foreach (var grp in MonthlyGroups)
        {
            var avg = MonthlyAverage(grp);
            ws.Cell(avgRow, col).Value = avg?.Qty;
            ws.Cell(avgRow, col + 1).Value = avg?.BoxCount;
            ws.Cell(avgRow, col + 2).Value = avg?.PalletCount;
            col += 3;
        }
        ws.Columns().AdjustToContents();
    }

    private void AddSeasonSheet(XLWorkbook wb, string country, string countryLabel)
    {
        var warehouses = DisplayWarehousesFor(country);
        var byWh = _seasonByCountry.GetValueOrDefault(country);

        var ws = wb.AddWorksheet($"Season - {countryLabel}");
        var col = 2;
        foreach (var season in SeasonGroups)
        {
            ws.Cell(1, col).Value = season;
            ws.Range(1, col, 1, col + 2).Merge();
            ws.Cell(2, col).Value = "Qty";
            ws.Cell(2, col + 1).Value = "Box";
            ws.Cell(2, col + 2).Value = "Pallets";
            col += 3;
        }
        ws.Row(1).Style.Font.Bold = true;
        ws.Row(2).Style.Font.Bold = true;

        var r = 3;
        foreach (var wh in warehouses)
        {
            ws.Cell(r, 1).Value = wh;
            col = 2;
            foreach (var season in SeasonGroups)
            {
                var row = byWh?.GetValueOrDefault((wh, season));
                ws.Cell(r, col).Value = row?.Qty;
                ws.Cell(r, col + 1).Value = row?.BoxCount;
                ws.Cell(r, col + 2).Value = row?.PalletCount;
                col += 3;
            }
            r++;
        }
        if (warehouses.Count > 0)
        {
            ws.Cell(r, 1).Value = "Total";
            ws.Row(r).Style.Font.Bold = true;
            col = 2;
            foreach (var season in SeasonGroups)
            {
                var (qty, box, pallets) = SeasonTotal(country, season);
                ws.Cell(r, col).Value = qty;
                ws.Cell(r, col + 1).Value = box;
                ws.Cell(r, col + 2).Value = pallets;
                col += 3;
            }
        }
        ws.Columns().AdjustToContents();
    }

