@page "/reports/shipment-status"
@rendermode RenderMode.InteractiveServer
@using System.Text
@using Wms.Core
@using Wms.Data.Lpm
@attribute [Authorize(Policy = MenuKeys.RPT_SHIPMENT_STATUS)]
@inject ShipmentStatusService Svc
@inject ICurrentUser CurrentUser
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>WMS — Shipment Status</PageTitle>

<div class="aiwms-page-header">
    <h2>Shipment Status</h2>
    <p>Containers received between the selected dates, plus any shipment still in transit as of Receipt Date To — released from UAE or local/international, received directly at destination. Sorted by Receipt Date (then Released Date while in transit).</p>
</div>

<div class="aiwms-section" style="padding:10px 16px;">
    <div style="display:flex; flex-wrap:wrap; gap:8px; align-items:flex-end;">
        @if (_canSelectMultiple)
        {
            <div style="flex:0 0 220px; position:relative;">
                <label class="aiwms-filter-label">COUNTRY</label>
                <details class="aiwms-dropdown" @key="_dropdownResetKey" style="position:relative;">
                    <summary style="cursor:pointer; padding:5px 7px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:12px; background:white; list-style:none; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                        @CountrySummaryText
                    </summary>
                    <div style="position:absolute; top:100%; left:0; z-index:20; background:white; border:1px solid var(--border-default); border-radius:var(--r-sm); padding:6px 10px; margin-top:2px; min-width:200px; box-shadow:0 2px 8px rgba(0,0,0,0.15);">
                        <label style="display:block; font-size:12px; font-weight:700; white-space:nowrap; padding:2px 0;">
                            <input type="checkbox" checked="@_selectedCountriesArray.Contains(BflGroupValue)"
                                   @onchange="e => ToggleCountryCheckbox(BflGroupValue, (bool)e.Value!)" />
                            BFL Group
                        </label>
                        @foreach (var c in _countries)
                        {
                            <label style="display:block; font-size:12px; white-space:nowrap; padding:2px 0;">
                                <input type="checkbox" checked="@_selectedCountriesArray.Contains(c)"
                                       @onchange="e => ToggleCountryCheckbox(c, (bool)e.Value!)" />
                                @c.ToUpperInvariant()
                            </label>
                        }
                    </div>
                </details>
            </div>
        }
        else
        {
            <div style="flex:0 0 160px;">
                <label class="aiwms-filter-label">COUNTRY</label>
                <input value="@(_lockedCountry.ToUpperInvariant())" disabled
                       style="width:100%; padding:5px 7px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:12px; background:var(--bg-disabled, #f2f2f2);" />
            </div>
        }
        <div style="flex:0 0 170px;">
            <label class="aiwms-filter-label" style="white-space:nowrap;">RECEIPT DATE FROM</label>
            <input type="date" @bind:get="EffectiveDateFromDisplay" @bind:set="v => SetIfPlausible(v, d => _dateFrom = d)" @bind:format="yyyy-MM-dd"
                   disabled="@(_selectedWeekValues.Length > 0)"
                   style="width:100%; padding:5px 7px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:12px; background:@(_selectedWeekValues.Length > 0 ? "var(--bg-disabled, #f2f2f2)" : "white")" />
        </div>
        <div style="flex:0 0 170px;">
            <label class="aiwms-filter-label" style="white-space:nowrap;">RECEIPT DATE TO</label>
            <input type="date" @bind:get="EffectiveDateToDisplay" @bind:set="v => SetIfPlausible(v, d => _dateTo = d)" @bind:format="yyyy-MM-dd"
                   disabled="@(_selectedWeekValues.Length > 0)"
                   style="width:100%; padding:5px 7px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:12px; background:@(_selectedWeekValues.Length > 0 ? "var(--bg-disabled, #f2f2f2)" : "white")" />
        </div>
        <div style="flex:0 0 130px;">
            <label class="aiwms-filter-label">STATUS</label>
            <select @bind="_statusFilter" style="width:100%; padding:5px 7px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:12px; background:white">
                <option value="">All</option>
                <option value="InTransit">InTransit</option>
                <option value="Delivered">Delivered</option>
            </select>
        </div>
        <div style="flex:0 0 150px;">
            <label class="aiwms-filter-label" style="white-space:nowrap;">SOURCE LOCATION</label>
            <select @bind="_typeFilter" style="width:100%; padding:5px 7px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:12px; background:white">
                <option value="">All</option>
                <option value="JAFZA">JAFZA</option>
                <option value="LOCAL">LOCAL</option>
                <option value="International">International</option>
            </select>
        </div>
        <div style="flex:0 0 200px;">
            <label class="aiwms-filter-label" style="white-space:nowrap;">WEEK — overrides dates</label>
            <details class="aiwms-dropdown" @key="_dropdownResetKey" style="position:relative;">
                <summary style="cursor:pointer; padding:5px 7px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:12px; background:white; list-style:none; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                    @WeekSummaryText
                </summary>
                <div style="position:absolute; top:100%; left:0; z-index:20; background:white; border:1px solid var(--border-default); border-radius:var(--r-sm); padding:6px 10px; margin-top:2px; min-width:160px; max-height:220px; overflow-y:auto; box-shadow:0 2px 8px rgba(0,0,0,0.15);">
                    <label style="display:block; font-size:12px; font-weight:700; white-space:nowrap; padding:2px 0;">
                        <input type="checkbox" checked="@AllWeeksSelected"
                               @onchange="e => ToggleAllWeeks((bool)e.Value!)" />
                        ALL
                    </label>
                    @foreach (var w in AvailableWeeks)
                    {
                        <label style="display:block; font-size:12px; white-space:nowrap; padding:2px 0;">
                            <input type="checkbox" checked="@_selectedWeekValues.Contains(w.Key)"
                                   @onchange="e => ToggleWeekCheckbox(w.Key, (bool)e.Value!)" />
                            @w.Label
                        </label>
                    }
                </div>
            </details>
        </div>
        <div style="display:flex; gap:10px;">
            <button class="aiwms-btn aiwms-btn-primary" @onclick="LoadAsync" disabled="@_loading">
                @(_loading ? "Loading…" : "Load")
            </button>
            <button class="aiwms-btn aiwms-btn-secondary" @onclick="ExportCsvAsync" disabled="@(_loading || _rows.Count == 0)">
                Export to Excel
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="aiwms-alert @(_isError ? "error" : "info")" style="margin-top:12px">@_message</div>
    }
</div>

@if (_rows.Count > 0)
{
    <div class="aiwms-section" style="padding:0; overflow:hidden;">
        <div style="padding:10px 16px; background:var(--bg-subtle, #f7f7f5); font-weight:700; font-size:13px; letter-spacing:0.02em;">
            BY COUNTRY
        </div>
        <div style="padding:14px 16px; display:flex; gap:24px; align-items:flex-start;">
            <div style="flex:1 1 auto; min-width:0; display:flex; flex-direction:column; gap:16px;">
                @foreach (var cts in CountryTypeSummaries)
                {
                    <div>
                        <div style="font-size:11px; font-weight:700; color:var(--text-secondary); text-transform:uppercase; margin-bottom:6px;">
                            @cts.Country.ToUpperInvariant()
                        </div>
                        <div style="display:flex; gap:8px;">
                            @foreach (var t in cts.Types)
                            {
                                var (bg, text) = TypeColor(t.Type);
                                <div style="background:@bg; border-radius:8px; padding:10px 12px; flex:1 1 0; min-width:0;">
                                    <div style="text-align:center; font-size:13px; font-weight:700; color:@text; text-transform:uppercase; letter-spacing:0.02em; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                        @t.Title
                                    </div>
                                    <div style="display:flex; align-items:stretch; margin-top:8px;">
                                        <div style="flex:1; text-align:center; min-width:0;">
                                            <div style="font-size:12px; color:var(--text-secondary);">Delivered</div>
                                            <div style="display:flex; justify-content:center; gap:8px; margin-top:5px;">
                                                <div>
                                                    <div style="font-size:11px; color:var(--text-secondary); white-space:nowrap;">Ship Count</div>
                                                    <div style="font-size:16px; font-weight:700; color:#222222; margin-top:2px; white-space:nowrap;">@t.DeliveredCount.ToString("N0")</div>
                                                </div>
                                                <div>
                                                    <div style="font-size:11px; color:var(--text-secondary); white-space:nowrap;">Quantity</div>
                                                    <div style="font-size:16px; font-weight:700; color:#222222; margin-top:2px; white-space:nowrap;">@t.DeliveredQty.ToString("N0")</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div style="flex:1; text-align:center; min-width:0; border-left:1px solid rgba(0,0,0,0.18); margin-left:6px; padding-left:6px;">
                                            <div style="font-size:12px; color:var(--text-secondary);">Intransit</div>
                                            <div style="display:flex; justify-content:center; gap:8px; margin-top:5px;">
                                                <div>
                                                    <div style="font-size:11px; color:var(--text-secondary); white-space:nowrap;">Ship Count</div>
                                                    <div style="font-size:16px; font-weight:700; color:#222222; margin-top:2px; white-space:nowrap;">@t.IntransitCount.ToString("N0")</div>
                                                </div>
                                                <div>
                                                    <div style="font-size:11px; color:var(--text-secondary); white-space:nowrap;">Quantity</div>
                                                    <div style="font-size:16px; font-weight:700; color:#222222; margin-top:2px; white-space:nowrap;">@t.IntransitQty.ToString("N0")</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
            @if (_isBflGroupView && CountryPieSlices.Count > 0)
            {
                <div style="flex:0 0 260px; text-align:center;">
                    <div style="font-size:11px; font-weight:700; color:var(--text-secondary); text-transform:uppercase; margin-bottom:6px;">
                        Quantity by Country (Delivered / Intransit)
                    </div>
                    <svg viewBox="0 0 200 200" width="220" height="220">
                        @if (CountryPieSlices.Count == 1)
                        {
                            <circle cx="100" cy="100" r="90" fill="@CountryPieSlices[0].Color" />
                        }
                        else
                        {
                            @foreach (var slice in CountryPieSlices)
                            {
                                <path d="@slice.Path" fill="@slice.Color" />
                            }
                        }
                    </svg>
                    <div style="display:flex; flex-direction:column; gap:4px; margin-top:8px; text-align:left;">
                        @foreach (var slice in CountryPieSlices)
                        {
                            <div style="display:flex; align-items:center; gap:6px; font-size:11px;">
                                <span style="width:10px; height:10px; border-radius:2px; background:@slice.Color; flex:0 0 auto;"></span>
                                <span style="flex:1;">@slice.Country.ToUpperInvariant() (@slice.Status)</span>
                                <span style="font-weight:700;">@slice.Qty.ToString("N0")</span>
                                <span style="color:var(--text-secondary); width:42px; text-align:right;">@slice.Percent.ToString("F1")%</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

