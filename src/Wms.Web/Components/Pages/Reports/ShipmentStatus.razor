                        <td style="text-align:right;">@s.Quantity.ToString("N0")</td>
                        <td style="text-align:right;">@(s.BoxCount?.ToString("N0") ?? "")</td>
                        <td style="text-align:right;">@(s.ReceivedBoxes?.ToString("N0") ?? "")</td>
                        <td style="text-align:right;">@(s.BoxCountDiff?.ToString("N0") ?? "")</td>
                    </tr>
