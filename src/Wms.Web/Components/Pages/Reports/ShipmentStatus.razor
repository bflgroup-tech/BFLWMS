@code {
    private List<ShipmentStatusRow> _rows = new();
    private List<string> _countries = new();

    // Bumped on every Load — the Country/Week <details> dropdowns key off this, so
    // changing it forces Blazor to discard and recreate those elements, which resets
    // their native open/closed state back to closed (there's no supported way to
    // force-collapse an already-open <details> other than replacing the element).
    private int _dropdownResetKey;

    // Regular country-scoped users only ever see their own country. UAE-based staff
    // (HQ, shipping to everyone) and Admins get a true multi-select plus "BFL Group",
    // modeled as a magic option inside the same <select multiple> — picking it clears
    // any other selection, and vice versa (see OnCountriesChanged).
    private const string BflGroupValue = "__BFLGROUP__";
    private bool _canSelectMultiple;
    private string _lockedCountry = "";
    private string[] _selectedCountriesArray = [BflGroupValue];

    private string _statusFilter = ""; // "" = All
    private string _typeFilter   = ""; // "" = All

    // ISO calendar week (Mon-Sun, ISOWeek handles year-boundary weeks correctly) of
    // ReceiptDt. Once any week is checked, it REPLACES the Receipt Date range for the
    // server query (LoadAsync computes a from/to spanning the selected week(s) and
    // ignores _dateFrom/_dateTo — the date inputs are disabled to make that obvious);
    // exact-week narrowing (including non-contiguous selections) still happens
    // client-side in FilteredRows. InTransit rows (no ReceiptDt) always pass through
    // regardless of week selection.
    private string[] _selectedWeekValues = [];

    private DateTime _dateFrom = DateTime.Today;
    private DateTime _dateTo   = DateTime.Today;

    // What the (disabled) date inputs actually display once week(s) are selected —
    // the span those weeks cover — so it's obvious what date range is really being
    // queried, instead of just showing whatever _dateFrom/_dateTo were left at.
    private DateTime EffectiveDateFromDisplay =>
        _selectedWeekValues.Length > 0 ? _selectedWeekValues.Select(ParseWeekRange).Min(r => r.Start) : _dateFrom;

    private DateTime EffectiveDateToDisplay =>
        _selectedWeekValues.Length > 0 ? _selectedWeekValues.Select(ParseWeekRange).Max(r => r.End) : _dateTo;

    private bool   _loading;
    private string _message = "";
    private bool   _isError;

    // Set by LoadAsync to whether that load used "BFL Group" (all countries) — the
    // per-shipment detail table only makes sense scoped to one or a few countries, so
    // a BFL Group load shows a Country x Type x Status rollup instead.
    private bool _isBflGroupView;

    private record SummaryRow(
        string Country, string Type, string Status, int ShipmentCount,
        int Quantity, int? BoxCount, int? ReceivedBoxes, int? BoxCountDiff);

    // Four cards per country — one per Source Location (Type), plus a Total —
    // shown above the country x type x status breakdown for a quick per-country
    // read. Rendered for any country selection (not just "BFL Group"), scoped to
    // whichever country(ies) are actually in FilteredRows.
    private record TypeSummary(
        string Type, string Title, int DeliveredCount, int DeliveredQty, int IntransitCount, int IntransitQty);

    private static readonly (string Type, string Title)[] TypeCardOrder =
    [
        ("JAFZA", "JAFZA Shipment"),
        ("International", "Int'l Shipment"),
        ("LOCAL", "Local Shipment"),
    ];

    private List<(string Country, List<TypeSummary> Types)> CountryTypeSummaries =>
        FilteredRows.Select(r => r.Country).Distinct().OrderBy(c => c)
            .Select(country =>
            {
                var types = TypeCardOrder.Select(tc =>
                {
                    var rows      = FilteredRows.Where(r => r.Country == country && r.Type == tc.Type).ToList();
                    var delivered = rows.Where(r => r.Status == "Delivered").ToList();
                    var intransit = rows.Where(r => r.Status == "InTransit").ToList();
                    return new TypeSummary(
                        tc.Type, tc.Title,
                        delivered.Count, delivered.Sum(r => r.TotalQty),
                        intransit.Count, intransit.Sum(r => r.TotalQty));
                }).ToList();

                types.Add(new TypeSummary(
                    "TOTAL", "Total",
                    types.Sum(t => t.DeliveredCount), types.Sum(t => t.DeliveredQty),
                    types.Sum(t => t.IntransitCount),  types.Sum(t => t.IntransitQty)));

                return (country, types);
            })
            .ToList();

    // Consistent color per Source Location across every country's card row.
    private static (string Bg, string Text) TypeColor(string type) => type switch
    {
        "JAFZA"         => ("#fde8f0", "#b3195c"),
        "International" => ("#e3f9ef", "#0f9d67"),
        "LOCAL"         => ("#e8f0fe", "#1a56db"),
        "TOTAL"         => ("#f0f0f0", "#333333"),
        _               => ("#f2f2f2", "#333333"),
    };

    // Two slices per country — Delivered and Intransit quantity from that
    // country's TOTAL card, kept separate — rendered as a pie to the right of
    // the cards, BFL Group view only. Each country gets its own base color;
    // its Intransit slice uses a lightened variant of the same color so the
    // two slices for one country are visually grouped but still distinct.
    private record PieSlice(string Country, string Status, decimal Qty, double Percent, string Color, string Path);

    private static readonly string[] PieColors =
    [
        "#4C6EF5", "#F59F00", "#37B24D", "#E64980", "#15AABF", "#F76707", "#7048E8", "#2F9E44", "#E8590C", "#1098AD",
    ];

    private List<PieSlice> CountryPieSlices
    {
        get
        {
            var entries = CountryTypeSummaries
                .SelectMany((cts, i) =>
                {
                    var total = cts.Types.First(t => t.Type == "TOTAL");
                    var color = PieColors[i % PieColors.Length];
                    return new[]
                    {
                        (cts.Country, Status: "Delivered", Qty: (decimal)total.DeliveredQty, Color: color),
                        (cts.Country, Status: "Intransit", Qty: (decimal)total.IntransitQty, Color: Lighten(color, 0.5)),
                    };
                })
                .Where(x => x.Qty > 0)
                .ToList();

            var grandTotal = entries.Sum(x => x.Qty);
            if (grandTotal <= 0) return [];

            const double cx = 100, cy = 100, r = 90;
            var slices = new List<PieSlice>();
            var cumulativeAngle = 0.0;

            foreach (var entry in entries)
            {
                var percent    = (double)(entry.Qty / grandTotal) * 100;
                var startAngle = cumulativeAngle;
                var endAngle   = cumulativeAngle + percent / 100 * 360;
                cumulativeAngle = endAngle;

                var (x1, y1) = PointOnCircle(cx, cy, r, startAngle);
                var (x2, y2) = PointOnCircle(cx, cy, r, endAngle);
                var largeArc = endAngle - startAngle > 180 ? 1 : 0;
                var path = $"M{cx},{cy} L{x1:F2},{y1:F2} A{r},{r} 0 {largeArc} 1 {x2:F2},{y2:F2} Z";

                slices.Add(new PieSlice(entry.Country, entry.Status, entry.Qty, percent, entry.Color, path));
            }
            return slices;
        }
    }

    // Blends a hex color toward white by `amount` (0 = unchanged, 1 = white).
    private static string Lighten(string hex, double amount)
    {
        var r = Convert.ToInt32(hex.Substring(1, 2), 16);
        var g = Convert.ToInt32(hex.Substring(3, 2), 16);
        var b = Convert.ToInt32(hex.Substring(5, 2), 16);
        r += (int)((255 - r) * amount);
        g += (int)((255 - g) * amount);
        b += (int)((255 - b) * amount);
        return $"#{r:X2}{g:X2}{b:X2}";
    }

    // angleDeg measured clockwise from the top (12 o'clock), matching typical pie-chart convention.
    private static (double X, double Y) PointOnCircle(double cx, double cy, double r, double angleDeg)
    {
        var rad = (angleDeg - 90) * Math.PI / 180;
        return (cx + r * Math.Cos(rad), cy + r * Math.Sin(rad));
    }

    private List<SummaryRow> SummaryRows =>
        FilteredRows
            .GroupBy(r => (r.Country, r.Type, r.Status))
            .Select(g => new SummaryRow(
                g.Key.Country, g.Key.Type, g.Key.Status,
                g.Count(),
                g.Sum(r => r.TotalQty),
                g.Any(r => r.BoxCount.HasValue)      ? g.Sum(r => r.BoxCount ?? 0)      : null,
                g.Any(r => r.ReceivedBoxes.HasValue)  ? g.Sum(r => r.ReceivedBoxes ?? 0) : null,
                g.Any(r => r.BoxCountDiff.HasValue)    ? g.Sum(r => r.BoxCountDiff ?? 0)  : null))
            .OrderBy(s => s.Type).ThenBy(s => s.Country).ThenBy(s => s.Status)
            .ToList();

    // Business "week of year" (not ISO — there's no standard for this). Weeks stay
    // Monday-Sunday and numbering is continuous for the whole year — it does NOT
    // reset at month boundaries, so a week can span across two months (e.g. 2026:
    // Jan 1 is a Thursday, so Week 1 = Jan 1-4, Week 2 = Jan 5-11, ... Week 5 =
    // Jan 26-Feb 1, Week 6 = Feb 2-8, ...). Only Week 1 is short (whenever Jan 1
    // isn't a Monday); every week after that is a full 7 days until the year ends.
    private static int DaysInFirstWeek(int year)
    {
        // ISO day-of-week position of Jan 1 (Monday=1 .. Sunday=7); days remaining
        // through that week's Sunday = 8 - position (Jan 1 on a Monday = full week).
        var jan1 = new DateTime(year, 1, 1);
        var isoDow = jan1.DayOfWeek == DayOfWeek.Sunday ? 7 : (int)jan1.DayOfWeek;
        return 8 - isoDow;
    }

    private static int WeekOfYear(DateTime d)
    {
        var daysInFirstWeek = DaysInFirstWeek(d.Year);
        return d.DayOfYear <= daysInFirstWeek ? 1 : 1 + ((d.DayOfYear - daysInFirstWeek - 1) / 7) + 1;
    }

    private static (DateTime Start, DateTime End) WeekRangeFor(int year, int week)
    {
        var daysInFirstWeek = DaysInFirstWeek(year);
        var lastDayOfYear   = new DateTime(year, 12, 31).DayOfYear;
        var startDoy = week == 1 ? 1 : daysInFirstWeek + (week - 2) * 7 + 1;
        startDoy = Math.Min(startDoy, lastDayOfYear);
        var endDoy = week == 1 ? Math.Min(daysInFirstWeek, lastDayOfYear) : Math.Min(startDoy + 6, lastDayOfYear);
        var jan1 = new DateTime(year, 1, 1);
        return (jan1.AddDays(startDoy - 1), jan1.AddDays(endDoy - 1));
    }

    private List<(string Key, string Label)> AvailableWeeks
    {
        get
        {
            var today   = DateTime.Today;
            var maxWeek = WeekOfYear(today);
            var list = new List<(string Key, string Label)>();
            for (var w = 1; w <= maxWeek; w++)
            {
                var (start, end) = WeekRangeFor(today.Year, w);
                list.Add(($"{today.Year}-{w}", $"Week {w} ({start:dd/MM} - {end:dd/MM})"));
            }
            return list;
        }
    }

    private static (string Key, string Label) WeekKeyAndLabel(DateTime d)
    {
        var week = WeekOfYear(d);
        var (start, end) = WeekRangeFor(d.Year, week);
        return ($"{d.Year}-{week}", $"Week {week} ({start:dd/MM} - {end:dd/MM})");
    }

    // "{year}-{week}" -> the start..end day span of that week-of-year.
    private static (DateTime Start, DateTime End) ParseWeekRange(string key)
    {
        var parts = key.Split('-');
        return WeekRangeFor(int.Parse(parts[0]), int.Parse(parts[1]));
    }

    private void ToggleWeekCheckbox(string key, bool isChecked)
    {
        var current = _selectedWeekValues.ToList();
        if (isChecked) { if (!current.Contains(key)) current.Add(key); }
        else current.Remove(key);
        _selectedWeekValues = current.ToArray();
    }

    // Checking "ALL" selects every available week (so the effective date range shown
    // in Receipt Date From/To spans Week 1's start through today, same as "all weeks
    // to date"). Unchecking it clears back to no selection (falls back to the manual
    // Receipt Date range instead).
    private void ToggleAllWeeks(bool isChecked)
    {
        _selectedWeekValues = isChecked ? AvailableWeeks.Select(w => w.Key).ToArray() : [];
    }

    private bool AllWeeksSelected =>
        _selectedWeekValues.Length > 0 && AvailableWeeks.All(w => _selectedWeekValues.Contains(w.Key));

    private string WeekSummaryText =>
        _selectedWeekValues.Length switch
        {
            0 => "None (use date range)",
            _ when AllWeeksSelected => "All weeks",
            1 => AvailableWeeks.FirstOrDefault(w => w.Key == _selectedWeekValues[0]).Label ?? _selectedWeekValues[0],
            _ => $"{_selectedWeekValues.Length} weeks selected"
        };

    private IEnumerable<ShipmentStatusRow> FilteredRows =>
        _rows.Where(r => (_statusFilter == "" || r.Status == _statusFilter)
                       && (_typeFilter   == "" || r.Type   == _typeFilter)
                       && (_selectedWeekValues.Length == 0
                           || !r.ReceiptDt.HasValue
                           || _selectedWeekValues.Contains(WeekKeyAndLabel(r.ReceiptDt.Value).Key)));

    // <input type="date"> fires intermediate change events while the user is still
    // typing a segment (day/month/year) — Blazor parses those partial values as
    // DateTime.MinValue (0001-01-01) and would otherwise overwrite the field before
    // typing finishes. Ignore anything implausible rather than committing it.
    private static void SetIfPlausible(DateTime v, Action<DateTime> apply)
    {
        if (v.Year > 1900) apply(v);
    }

    // Total transit time (SLA Ship. Load + SLA Ship Rec.) — blank until both legs
    // are known, i.e. until the shipment has actually been received.
    private static string IntransitSla(ShipmentStatusRow r) =>
        r.SlaShippingDays.HasValue && r.SlaReceiptDays.HasValue
            ? (r.SlaShippingDays.Value + r.SlaReceiptDays.Value).ToString()
            : "";

    // Enforce BFL Group vs. specific-countries mutual exclusivity based on which side
    // was already selected before this change (whichever wasn't picked before is the
    // new pick, so that side wins and the other is cleared).
    private void OnCountriesChanged(string[] newSelection)
    {
        var bflNow = newSelection.Contains(BflGroupValue);
        var others = newSelection.Where(v => v != BflGroupValue).ToArray();

        if (bflNow && others.Length > 0)
        {
            var bflWasSelected = _selectedCountriesArray.Contains(BflGroupValue);
            _selectedCountriesArray = bflWasSelected ? others : [BflGroupValue];
        }
        else
        {
            _selectedCountriesArray = newSelection;
        }
    }

    private void ToggleCountryCheckbox(string value, bool isChecked)
    {
        var current = _selectedCountriesArray.ToList();
        if (isChecked) { if (!current.Contains(value)) current.Add(value); }
        else current.Remove(value);
        OnCountriesChanged(current.ToArray());
    }

    private string CountrySummaryText =>
        _selectedCountriesArray.Contains(BflGroupValue) ? "BFL Group"
        : _selectedCountriesArray.Length == 0 ? "Select country…"
        : string.Join(", ", _selectedCountriesArray.Select(c => c.ToUpperInvariant()));

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.EnsureLoadedAsync();
        // Restrict to the user's granted WmsUserCountryAccess countries (Admin sees
        // all) — replaces the old "UAE home country picks any country, everyone
        // else is locked to their own home country" rule, which ignored the actual
        // per-user country grants entirely.
        _countries = CurrentUser.FilterCountries(await Svc.GetCountriesAsync()).ToList();

        _canSelectMultiple = CurrentUser.HasAllCountriesAccess || _countries.Count > 1;

        if (!_canSelectMultiple)
            _lockedCountry = _countries.FirstOrDefault() ?? "";
    }

    // <details> has no native "close when focus/click moves elsewhere" behavior —
    // attach a single document-level click listener (idempotent via the window
    // flag, since this only needs binding once per page load) that closes any open
    // .aiwms-dropdown whose click target falls outside it.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await JS.InvokeVoidAsync("eval", @"
            if (!window.__aiwmsDropdownOutsideClick) {
                window.__aiwmsDropdownOutsideClick = true;
                document.addEventListener('click', function (e) {
                    document.querySelectorAll('details.aiwms-dropdown[open]').forEach(function (d) {
                        if (!d.contains(e.target)) d.removeAttribute('open');
                    });
                });
            }");
    }

    private async Task LoadAsync()
    {
        _loading = true; _message = ""; _rows.Clear();
        _dropdownResetKey++; // collapse the Country/Week dropdowns back to closed
        await InvokeAsync(StateHasChanged);
        try
        {
            List<string>? countries;
            if (!_canSelectMultiple)
            {
                _isBflGroupView = false;
                if (string.IsNullOrWhiteSpace(_lockedCountry))
                {
                    ShowError("Your account has no assigned country — contact an admin.");
                    return;
                }
                countries = [_lockedCountry];
            }
            else if (_selectedCountriesArray.Contains(BflGroupValue))
            {
                // null = no filter, only valid for a genuine all-countries (Admin) user —
                // a non-Admin multi-country user's "BFL Group" means everything THEY can
                // see, i.e. their already-filtered _countries list, not literally every country.
                countries = CurrentUser.HasAllCountriesAccess ? null : _countries.ToList();
                _isBflGroupView = true;
            }
            else if (_selectedCountriesArray.Length == 0)
            {
                ShowError("Select at least one country, or BFL Group.");
                return;
            }
            else
            {
                countries = _selectedCountriesArray.ToList();
                _isBflGroupView = false;
            }

            // Once week(s) are selected, they replace the Receipt Date range entirely:
            // query the superset span covering every selected week, then let
            // FilteredRows narrow to the exact week(s) client-side (handles
            // non-contiguous selections correctly).
            DateTime effectiveFrom, effectiveTo;
            if (_selectedWeekValues.Length > 0)
            {
                var ranges = _selectedWeekValues.Select(ParseWeekRange).ToList();
                effectiveFrom = ranges.Min(r => r.Start);
                effectiveTo   = ranges.Max(r => r.End);
            }
            else
            {
                effectiveFrom = _dateFrom;
                effectiveTo   = _dateTo;
            }

            var filter = new ShipmentStatusFilter(
                Countries: countries,
                DateFrom:  effectiveFrom,
                DateTo:    effectiveTo);

            var result = await Svc.GetShipmentStatusAsync(filter);
            _rows = result.Rows;

            if (result.Warnings.Count > 0)
                ShowError($"Loaded {_rows.Count} rows. Some countries failed: {string.Join("; ", result.Warnings)}");
            else
                ShowInfo($"Loaded {_rows.Count} rows.");
        }
        catch (Exception ex) { ShowError($"Load failed: {ex.Message}"); }
        finally { _loading = false; }
    }

    private async Task ExportCsvAsync()
    {
        var sb = new StringBuilder();
        if (_isBflGroupView)
        {
            var summary = SummaryRows;
            sb.AppendLine("Source Location,Target Location,Status,Shipments,Quantity,Box Count,Received Boxes,Box Variance");
            foreach (var s in summary)
                sb.AppendLine($"{Csv(s.Type)},{Csv(s.Country)},{Csv(s.Status)},{s.ShipmentCount},{s.Quantity},{s.BoxCount},{s.ReceivedBoxes},{s.BoxCountDiff}");
            sb.AppendLine($"Total,,,{summary.Sum(s => s.ShipmentCount)},{summary.Sum(s => s.Quantity)},{summary.Sum(s => s.BoxCount)},{summary.Sum(s => s.ReceivedBoxes)},{summary.Sum(s => s.BoxCountDiff)}");
        }
        else
        {
            var rows = FilteredRows.ToList();
            sb.AppendLine("Source Location,Target Location,Ship No.,Status,GINNO,GINDate,Released On,SLA (Ship. Load),ETA,Quantity,Box Count,ReceiptDt,SLA (Ship Rec.),Intransit SLA,ReceivedBoxes,Box Variance,Remarks,Division,Department,Brand");
            foreach (var r in rows)
                sb.AppendLine($"{Csv(r.Type)},{Csv(r.Country)},{Csv(r.ShipNo)},{Csv(r.Status)},{Csv(r.GinNo)}," +
                              $"{(r.GinDate.HasValue ? r.GinDate.Value.ToString("yyyy-MM-dd") : "")}," +
                              $"{(r.ReleasedOn.HasValue ? r.ReleasedOn.Value.ToString("yyyy-MM-dd") : "")}," +
                              $"{r.SlaShippingDays}," +
                              $"{(r.Eta.HasValue ? r.Eta.Value.ToString("yyyy-MM-dd") : "")}," +
                              $"{r.TotalQty},{r.BoxCount}," +
                              $"{(r.ReceiptDt.HasValue ? r.ReceiptDt.Value.ToString("yyyy-MM-dd") : "")}," +
                              $"{r.SlaReceiptDays},{IntransitSla(r)},{r.ReceivedBoxes},{r.BoxCountDiff}," +
                              $"{Csv(r.Remarks)},{Csv(r.Division)},{Csv(r.Department)},{Csv(r.Brand)}");
            sb.AppendLine($"Total,,,,,,,,,{rows.Sum(r => r.TotalQty)},{rows.Sum(r => r.BoxCount)},,,,{rows.Sum(r => r.ReceivedBoxes)},{rows.Sum(r => r.BoxCountDiff)},,,,");
        }

        var b64      = Convert.ToBase64String(Encoding.UTF8.GetBytes(sb.ToString()));
        var country  = _selectedCountriesArray.Contains(BflGroupValue) ? "BFLGroup"
                     : _canSelectMultiple ? string.Join("-", _selectedCountriesArray)
                     : _lockedCountry;
        var filename = $"ShipmentStatus_{country}_{_dateFrom:yyyyMMdd}_{_dateTo:yyyyMMdd}.csv";
        await JS.InvokeVoidAsync("eval",
            $"(function(){{var a=document.createElement('a');a.href='data:text/csv;base64,{b64}';" +
            $"a.download='{filename}';document.body.appendChild(a);a.click();document.body.removeChild(a);}})();");
    }

    private static string Csv(string? s)
    {
        if (s is null) return "";
        return (s.Contains(',') || s.Contains('"') || s.Contains('\n'))
            ? "\"" + s.Replace("\"", "\"\"") + "\""
            : s;
    }

    private void ShowError(string msg) { _message = msg; _isError = true; }
    private void ShowInfo(string msg)  { _message = msg; _isError = false; }
}
