@page "/reports/ecom-stock-variance"
@rendermode RenderMode.InteractiveServer
@using Wms.Core
@using Wms.Data.Lpm
@using ClosedXML.Excel
@using MudBlazor
@attribute [Authorize(Policy = MenuKeys.RPT_ECOM_STOCK_VARIANCE)]
@inject EcomStockVarianceReportService Svc
@inject ICurrentUser CurrentUser
@inject IJSRuntime JS

<PageTitle>WMS - ECOM Stock Variance Report</PageTitle>

<div class="aiwms-page-header">
    <h2>ECOM Stock Variance Report</h2>
    <p style="color:var(--text-secondary)">Compares dbo.LPM_ECOM_SOH_COMPARISON (IncreffSOH vs MFCS_SOH) against DATAREPORTING.dbo.vUPC_SUBCLASS for the item's Division/Department/Class/Subclass/Family. Run IncreffSohFromGCP then IncreffMfcsSohCompare on the Nightly Batches admin page first for fresh data.</p>
</div>

<div class="aiwms-section">
    <div style="display:grid; grid-template-columns: 1fr 1fr auto; gap:12px; align-items:end;">
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">COUNTRY (select any)</label>
            <MudSelect T="string" Dense="true" MultiSelection="true" SelectAll="true" Placeholder="All"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       SelectedValues="_selectedCountries" SelectedValuesChanged="@(v => _selectedCountries = v.ToHashSet())">
                @foreach (var c in _countries) { <MudSelectItem T="string" Value="@c">@c</MudSelectItem> }
            </MudSelect>
        </div>
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">DIVISION (select any)</label>
            <MudSelect T="string" Dense="true" MultiSelection="true" SelectAll="true" Placeholder="All"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       SelectedValues="_selectedDivisions" SelectedValuesChanged="@(v => _selectedDivisions = v.ToHashSet())">
                @foreach (var d in _divisions) { <MudSelectItem T="string" Value="@d">@d</MudSelectItem> }
            </MudSelect>
        </div>
        <div style="display:flex; gap:8px">
            <button class="aiwms-btn aiwms-btn-primary" @onclick="@(() => LoadAsync(1))" disabled="@_loading">@(_loading ? "Loading..." : "Load")</button>
            <button class="aiwms-btn aiwms-btn-secondary" @onclick="ClearFilters" disabled="@_loading">Clear Filters</button>
            <button class="aiwms-btn aiwms-btn-secondary" @onclick="ExportExcelAsync" disabled="@(_exporting || _totals is null || _totals.RowCount == 0)">@(_exporting ? "Exporting..." : "Export Excel")</button>
        </div>
    </div>

    <div style="margin-top:12px">
        <label style="display:flex; align-items:center; gap:6px; cursor:pointer; font-size:13px">
            <input type="checkbox" checked="@_varianceOnly" @onchange="VarianceOnlyChangedAsync" /> Variance only (Variance &gt; 0)
        </label>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="aiwms-alert @(_isError ? "error" : "info")" style="margin-top:12px">@_message</div>
    }
</div>

@if (_loaded)
{
    <div class="aiwms-section">
        <div class="aiwms-card-header">ECOM Stock Variance - @_totals!.RowCount.ToString("N0") row(s)</div>
        <div style="overflow-x:auto">
        <table class="aiwms-table aiwms-table-dense">
            <thead>
                <tr>
                    <th>Country</th>
                    <th>Itemcode</th>
                    <th style="text-align:right">IncreffSOH</th>
                    <th style="text-align:right">MFCS_SOH</th>
                    <th style="text-align:right">Variance</th>
                    <th>Division</th>
                    <th>Department</th>
                    <th>Class</th>
                    <th>Subclass</th>
                    <th>Family</th>
                    <th style="white-space:nowrap">Last Refreshed</th>
                </tr>
            </thead>
            <tbody>
                <tr style="font-weight:700; background:var(--surface-1, #f7f7f5);">
                    <td colspan="2">Total (all @_totals!.RowCount.ToString("N0") rows, not just this page)</td>
                    <td style="text-align:right">@_totals!.IncreffSOH.ToString("N0")</td>
                    <td style="text-align:right">@_totals!.MFCS_SOH.ToString("N0")</td>
                    <td style="text-align:right">@_totals!.Variance.ToString("N0")</td>
                    <td colspan="6"></td>
                </tr>
                @foreach (var r in _rows)
                {
                    <tr>
                        <td>@r.Country</td>
                        <td style="font-family:var(--font-mono)">@r.Itemcode</td>
                        <td style="text-align:right">@r.IncreffSOH.ToString("N0")</td>
                        <td style="text-align:right">@r.MFCS_SOH.ToString("N0")</td>
                        <td style="text-align:right; font-weight:@(r.Variance == 0 ? "400" : "700")">@r.Variance.ToString("N0")</td>
                        <td style="word-break:break-word">@r.Division</td>
                        <td style="word-break:break-word">@r.Department</td>
                        <td style="word-break:break-word">@r.Class</td>
                        <td style="word-break:break-word">@r.Subclass</td>
                        <td style="word-break:break-word">@r.Family</td>
                        <td style="white-space:nowrap">@r.CreateTS.ToString("dd-MMM-yyyy HH:mm")</td>
                    </tr>
                }
                @if (_rows.Count == 0)
                {
                    <tr><td colspan="11" style="color:var(--text-secondary)">No rows for the selected filters.</td></tr>
                }
            </tbody>
        </table>
        </div>

        @if (TotalPages > 1)
        {
            <div style="display:flex; align-items:center; gap:10px; margin-top:12px">
                <button class="aiwms-btn aiwms-btn-secondary" @onclick="@(() => LoadAsync(_pageNumber - 1))" disabled="@(_loading || _pageNumber <= 1)">&laquo; Prev</button>
                <span style="font-size:13px">Page @_pageNumber of @TotalPages</span>
                <button class="aiwms-btn aiwms-btn-secondary" @onclick="@(() => LoadAsync(_pageNumber + 1))" disabled="@(_loading || _pageNumber >= TotalPages)">Next &raquo;</button>
            </div>
        }
    </div>
}

@code {
    private List<string> _countries = new();
    private HashSet<string> _selectedCountries = new();
    private List<string> _divisions = new();
    private HashSet<string> _selectedDivisions = new();
    private bool _loading;
    private bool _loaded;
    private string _message = "";
    private bool _isError;
    private List<EcomStockVarianceRow> _rows = new();
    private EcomStockVarianceTotals? _totals;
    private bool _varianceOnly = true;
    private bool _exporting;
    private int _pageNumber = 1;

    private int TotalPages => _totals is null || _totals.RowCount == 0
        ? 1 : (int)Math.Ceiling(_totals.RowCount / (double)EcomStockVarianceReportService.PageSize);

    // null (no argument at all) means "genuinely unrestricted"; a user with zero
    // country grants gets the deny-by-default empty (non-null) list instead of
    // silently falling back to "show everything" — same convention as PoCountingReport.
    private IEnumerable<string>? EffectiveCountriesOrNull =>
        _selectedCountries.Count > 0 ? _selectedCountries
        : CurrentUser.HasAllCountriesAccess ? null
        : _countries;

    private IEnumerable<string>? EffectiveDivisionsOrNull =>
        _selectedDivisions.Count > 0 ? _selectedDivisions : null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CurrentUser.EnsureLoadedAsync();
            var list = await Svc.GetCountriesAsync();
            _countries = CurrentUser.FilterCountries(list).ToList();
            _divisions = await Svc.GetDivisionsAsync();
        }
        catch { /* fall back to empty lists if the lookup fails */ }
    }

    private async Task LoadAsync(int pageNumber)
    {
        _loading = true; _message = ""; _isError = false; await InvokeAsync(StateHasChanged);
        try
        {
            var totals = await Svc.GetTotalsAsync(EffectiveCountriesOrNull, EffectiveDivisionsOrNull, _varianceOnly);
            _totals = totals;
            _pageNumber = Math.Clamp(pageNumber, 1, Math.Max(1, TotalPages));
            _rows = totals.RowCount == 0
                ? new()
                : await Svc.GetReportPageAsync(EffectiveCountriesOrNull, EffectiveDivisionsOrNull, _varianceOnly, _pageNumber);
            _loaded = true;
            if (totals.RowCount == 0) _message = "No rows for the selected filters.";
        }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
        finally { _loading = false; }
    }

    // "Variance only" is applied server-side (it changes the filtered row count,
    // hence the page count) — re-load from page 1 once a report has already been
    // shown; before that, just record the state for the next Load click.
    private async Task VarianceOnlyChangedAsync(ChangeEventArgs e)
    {
        _varianceOnly = (bool)e.Value!;
        if (_loaded) await LoadAsync(1);
    }

    private void ClearFilters()
    {
        _selectedCountries = new();
        _selectedDivisions = new();
        _rows = new();
        _totals = null;
        _pageNumber = 1;
        _loaded = false;
        _message = "";
        _isError = false;
    }

    private async Task ExportExcelAsync()
    {
        if (_totals is null || _totals.RowCount == 0) return;
        _exporting = true;
        try
        {
            var all = await Svc.GetReportAsync(EffectiveCountriesOrNull, EffectiveDivisionsOrNull, _varianceOnly);

            using var wb = new XLWorkbook();
            var ws = wb.AddWorksheet("ECOM Stock Variance");
            string[] headers =
            {
                "Country", "Itemcode", "IncreffSOH", "MFCS_SOH", "Variance",
                "Division", "Department", "Class", "Subclass", "Family", "Last Refreshed"
            };
            for (int i = 0; i < headers.Length; i++) ws.Cell(1, i + 1).Value = headers[i];
            ws.Row(1).Style.Font.Bold = true;

            int row = 2;
            foreach (var r in all)
            {
                ws.Cell(row, 1).Value  = r.Country;
                ws.Cell(row, 2).Value  = r.Itemcode;
                ws.Cell(row, 3).Value  = r.IncreffSOH;
                ws.Cell(row, 4).Value  = r.MFCS_SOH;
                ws.Cell(row, 5).Value  = r.Variance;
                ws.Cell(row, 6).Value  = r.Division;
                ws.Cell(row, 7).Value  = r.Department;
                ws.Cell(row, 8).Value  = r.Class;
                ws.Cell(row, 9).Value  = r.Subclass;
                ws.Cell(row, 10).Value = r.Family;
                ws.Cell(row, 11).Value = r.CreateTS.ToString("dd-MMM-yyyy HH:mm");
                row++;
            }
            ws.Columns().AdjustToContents();

            using var ms = new MemoryStream();
            wb.SaveAs(ms);
            var b64 = Convert.ToBase64String(ms.ToArray());
            var name = $"ecom-stock-variance-{DateTime.UtcNow.AddHours(4):yyyyMMdd-HHmm}.xlsx";
            await JS.InvokeVoidAsync("downloadFileWithPicker", name, b64,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        finally { _exporting = false; }
    }
}
