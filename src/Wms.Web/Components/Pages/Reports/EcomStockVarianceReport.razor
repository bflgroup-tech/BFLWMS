@page "/reports/ecom-stock-variance"
@rendermode RenderMode.InteractiveServer
@using Wms.Core
@using Wms.Data.Lpm
@using ClosedXML.Excel
@using MudBlazor
@attribute [Authorize(Policy = MenuKeys.RPT_ECOM_STOCK_VARIANCE)]
@inject EcomStockVarianceReportService Svc
@inject ICurrentUser CurrentUser
@inject IJSRuntime JS

<PageTitle>WMS - ECOM Stock Variance Report</PageTitle>

<div class="aiwms-page-header" style="display:flex; align-items:flex-start; justify-content:space-between; gap:16px; flex-wrap:wrap;">
    <div>
        <h2>ECOM Stock Variance Report</h2>
        <p style="color:var(--text-secondary)">Compares dbo.LPM_ECOM_SOH_COMPARISON (IncreffSOH vs MFCS_SOH) against DATAREPORTING.dbo.vUPC_SUBCLASS for the item's Division/Department/Class/Subclass/Family. Run IncreffSohFromGCP then IncreffMfcsSohCompare on the Nightly Batches admin page first for fresh data.</p>
    </div>
    <span style="font-size:12px; color:var(--text-secondary); white-space:nowrap">
        Last refreshed: @(_lastRefreshed is null ? "—" : _lastRefreshed.Value.ToString("dd-MMM-yyyy HH:mm"))
    </span>
</div>

<div style="display:flex; gap:4px; border-bottom:2px solid var(--border-default); margin:0 0 16px 0; flex-wrap:wrap;">
    @foreach (var t in Views)
    {
        var isActive = _activeView == t;
        <button @onclick="@(() => _activeView = t)"
                style="@($"padding:10px 18px; border:none; background:none; cursor:pointer; font-size:13px; font-weight:{(isActive ? "700" : "500")}; color:{(isActive ? "var(--bfl-black)" : "var(--text-secondary)")}; border-bottom:3px solid {(isActive ? "var(--bfl-yellow)" : "transparent")}; margin-bottom:-2px;")">
            @t
        </button>
    }
</div>

@if (_activeView == Dashboard)
{
    <div class="aiwms-section">
        @if (_dashboardLoading)
        {
            <p style="color:var(--text-secondary)">Loading...</p>
        }
        else if (!string.IsNullOrEmpty(_dashboardMessage))
        {
            <div class="aiwms-alert error">@_dashboardMessage</div>
        }
        else if (_dashboard is not null)
        {
            <p style="color:var(--text-secondary); margin:0">Whole-table KPI snapshot — always unfiltered, independent of the Item Level / Division Summary filters.</p>
        }
    </div>

    @if (!_dashboardLoading && string.IsNullOrEmpty(_dashboardMessage))
    {
        <EcomDashboardCountryPanel Title="" Summary="_dashboard" Buckets="_reconciliationBuckets" />
        <EcomDashboardCountryPanel Title="UAE" Summary="_dashboardUae" Buckets="_bucketsUae" />
        <EcomDashboardCountryPanel Title="KSA" Summary="_dashboardKsa" Buckets="_bucketsKsa" />
    }
}
else
{
<div class="aiwms-section">
    <div style="display:grid; grid-template-columns: 1fr 1fr 1fr 1fr 1fr auto; gap:12px; align-items:end;">
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">COUNTRY (select any)</label>
            <MudSelect T="string" Dense="true" MultiSelection="true" SelectAll="true" Placeholder="All"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       SelectedValues="_selectedCountries" SelectedValuesChanged="@(v => _selectedCountries = v.ToHashSet())">
                @foreach (var c in _countries) { <MudSelectItem T="string" Value="@c">@c</MudSelectItem> }
            </MudSelect>
        </div>
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">DIVISION (select any)</label>
            <MudSelect T="string" Dense="true" MultiSelection="true" SelectAll="true" Placeholder="All"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       SelectedValues="_selectedDivisions" SelectedValuesChanged="@(v => _selectedDivisions = v.ToHashSet())">
                @foreach (var d in _divisions) { <MudSelectItem T="string" Value="@d">@d</MudSelectItem> }
            </MudSelect>
        </div>
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">DEPARTMENT (select any)</label>
            <MudSelect T="string" Dense="true" MultiSelection="true" SelectAll="true" Placeholder="All"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       SelectedValues="_selectedDepartments" SelectedValuesChanged="@(v => _selectedDepartments = v.ToHashSet())">
                @foreach (var d in _departments) { <MudSelectItem T="string" Value="@d">@d</MudSelectItem> }
            </MudSelect>
        </div>
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">BRAND</label>
            <input @bind="_brandSearch" @bind:event="oninput" placeholder="e.g. Nike" style="width:100%; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
        </div>
        @if (_activeView == ItemLevel)
        {
            <div>
                <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">ITEMCODE</label>
                <input @bind="_itemcodeSearch" @bind:event="oninput" placeholder="e.g. 1000030288026" style="width:100%; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
            </div>
        }
        else
        {
            <div></div>
        }
        <div style="display:flex; gap:8px">
            <button class="aiwms-btn" style="background:var(--s-live); color:#fff; border-radius:10px;"
                    @onclick="LoadActiveViewAsync" disabled="@(_loading || _summaryLoading)">
                <span class="mi" style="font-size:16px;">play_arrow</span> @((_loading || _summaryLoading) ? "Loading..." : "Load")
            </button>
            <button class="aiwms-btn" style="background:#fff; color:var(--text-primary); border:1.5px solid var(--border-strong); border-radius:10px;"
                    @onclick="ClearFilters" disabled="@(_loading || _summaryLoading)">
                <span class="mi" style="font-size:16px;">refresh</span> Clear Filters
            </button>
            <button class="aiwms-btn" style="background:#fff; color:var(--s-active); border:1.5px solid var(--s-active); border-radius:10px;"
                    @onclick="ExportActiveViewExcelAsync" disabled="@IsExportDisabled">
                <span class="mi" style="font-size:16px;">download</span> @((_exporting || _summaryExporting) ? "Exporting..." : "Export Excel")
            </button>
        </div>
    </div>

    <div style="margin-top:12px">
        <label style="display:flex; align-items:center; gap:6px; cursor:pointer; font-size:13px">
            <input type="checkbox" checked="@_varianceOnly" @onchange="VarianceOnlyChangedAsync" /> Variance only (Variance &lt;&gt; 0)
        </label>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="aiwms-alert @(_isError ? "error" : "info")" style="margin-top:12px">@_message</div>
    }
</div>
}

@if (_activeView == ItemLevel && _loaded)
{
    <div class="aiwms-section">
        <div class="aiwms-card-header" style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px">
            <span>ECOM Stock Variance - @_totals!.RowCount.ToString("N0") row(s)</span>
            @if (TotalPages > 1)
            {
                <div style="display:flex; align-items:center; gap:8px">
                    <button class="aiwms-btn aiwms-btn-secondary" style="font-size:11px; padding:4px 8px" @onclick="@(() => LoadAsync(_pageNumber - 1))" disabled="@(_loading || _pageNumber <= 1)">&laquo; Prev</button>
                    <span style="font-size:13px; white-space:nowrap">Page @_pageNumber of @TotalPages</span>
                    <button class="aiwms-btn aiwms-btn-secondary" style="font-size:11px; padding:4px 8px" @onclick="@(() => LoadAsync(_pageNumber + 1))" disabled="@(_loading || _pageNumber >= TotalPages)">Next &raquo;</button>
                    <input type="number" min="1" max="@TotalPages" @bind="_pageJumpInput" @bind:event="oninput"
                           @onkeyup="@(async e => { if (e.Key == "Enter") await LoadAsync(_pageJumpInput); })"
                           style="width:64px; padding:4px 6px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:12px;" placeholder="Page #" />
                    <button class="aiwms-btn aiwms-btn-secondary" style="font-size:11px; padding:4px 8px" @onclick="@(() => LoadAsync(_pageJumpInput))" disabled="@_loading">Go</button>
                </div>
            }
        </div>
        <div style="overflow-x:auto">
        <table class="aiwms-table aiwms-table-dense">
            <thead>
                <tr>
                    <th>Country</th>
                    <th>Itemcode</th>
                    <th style="text-align:right">MFCS_SOH</th>
                    <th style="text-align:right">INCREFF_SOH</th>
                    <th style="text-align:right">GS Summer Pallet</th>
                    <th style="text-align:right">GW Winter Pallet</th>
                    <th style="text-align:right">Variance (MFCS_SOH - (INCREFF_SOH + GS + GW + InTransit UAE + InTransit KSA))</th>
                    <th style="text-align:right">InTransit UAE</th>
                    <th style="text-align:right">InTransit KSA</th>
                    <th>Division</th>
                    <th>Department</th>
                    <th>Class</th>
                    <th>Subclass</th>
                    <th>Family</th>
                    <th>Brand</th>
                </tr>
            </thead>
            <tbody>
                <tr style="font-weight:700; background:var(--surface-1, #f7f7f5);">
                    <td colspan="2">Total (all @_totals!.RowCount.ToString("N0") rows, not just this page)</td>
                    <td style="text-align:right">@_totals!.MFCS_SOH.ToString("N0")</td>
                    <td style="text-align:right">@_totals!.IncreffSOH.ToString("N0")</td>
                    <td style="text-align:right">@_totals!.GateKeeperRejectedSummer.ToString("N0")</td>
                    <td style="text-align:right">@_totals!.GateKeeperRejectedWinter.ToString("N0")</td>
                    <td style="text-align:right">@_totals!.Variance.ToString("N0")</td>
                    <td style="text-align:right">@_totals!.InTransitUAE.ToString("N0")</td>
                    <td style="text-align:right">@_totals!.InTransitKSA.ToString("N0")</td>
                    <td colspan="6"></td>
                </tr>
                @foreach (var r in _rows)
                {
                    <tr>
                        <td>@r.Country</td>
                        <td style="font-family:var(--font-mono)">@r.Itemcode</td>
                        <td style="text-align:right">@r.MFCS_SOH.ToString("N0")</td>
                        <td style="text-align:right">@r.IncreffSOH.ToString("N0")</td>
                        <td style="text-align:right">@r.GateKeeperRejectedSummer.ToString("N0")</td>
                        <td style="text-align:right">@r.GateKeeperRejectedWinter.ToString("N0")</td>
                        <td style="text-align:right; font-weight:@(r.Variance == 0 ? "400" : "700")">@r.Variance.ToString("N0")</td>
                        <td style="text-align:right">@r.InTransitUAE.ToString("N0")</td>
                        <td style="text-align:right">@r.InTransitKSA.ToString("N0")</td>
                        <td style="word-break:break-word">@r.Division</td>
                        <td style="word-break:break-word">@r.Department</td>
                        <td style="word-break:break-word">@r.Class</td>
                        <td style="word-break:break-word">@r.Subclass</td>
                        <td style="word-break:break-word">@r.Family</td>
                        <td style="word-break:break-word">@r.Brand</td>
                    </tr>
                }
                @if (_rows.Count == 0)
                {
                    <tr><td colspan="15" style="color:var(--text-secondary)">No rows for the selected filters.</td></tr>
                }
            </tbody>
        </table>
        </div>
    </div>
}

@if (_activeView == DivisionSummary && _summaryLoaded)
{
    <div class="aiwms-section">
        <div class="aiwms-card-header">Division Summary - @_summaryRows.Count.ToString("N0") row(s)</div>
        <div style="overflow-x:auto">
        <table class="aiwms-table aiwms-table-dense">
            <thead>
                <tr>
                    <th>Country</th>
                    <th>Division</th>
                    <th style="text-align:right">Items</th>
                    <th style="text-align:right">MFCS_SOH</th>
                    <th style="text-align:right">INCREFF_SOH</th>
                    <th style="text-align:right">GS Summer Pallet</th>
                    <th style="text-align:right">GW Winter Pallet</th>
                    <th style="text-align:right">Variance (MFCS_SOH - (INCREFF_SOH + GS + GW + InTransit UAE + InTransit KSA))</th>
                    <th style="text-align:right">InTransit UAE</th>
                    <th style="text-align:right">InTransit KSA</th>
                </tr>
            </thead>
            <tbody>
                <tr style="font-weight:700; background:var(--surface-1, #f7f7f5);">
                    <td colspan="2">Total</td>
                    <td style="text-align:right">@_summaryRows.Sum(r => r.ItemCount).ToString("N0")</td>
                    <td style="text-align:right">@_summaryRows.Sum(r => r.MFCS_SOH).ToString("N0")</td>
                    <td style="text-align:right">@_summaryRows.Sum(r => r.IncreffSOH).ToString("N0")</td>
                    <td style="text-align:right">@_summaryRows.Sum(r => r.GateKeeperRejectedSummer).ToString("N0")</td>
                    <td style="text-align:right">@_summaryRows.Sum(r => r.GateKeeperRejectedWinter).ToString("N0")</td>
                    <td style="text-align:right">@_summaryRows.Sum(r => r.Variance).ToString("N0")</td>
                    <td style="text-align:right">@_summaryRows.Sum(r => r.InTransitUAE).ToString("N0")</td>
                    <td style="text-align:right">@_summaryRows.Sum(r => r.InTransitKSA).ToString("N0")</td>
                </tr>
                @foreach (var r in _summaryRows)
                {
                    <tr>
                        <td>@r.Country</td>
                        <td style="word-break:break-word">@r.Division</td>
                        <td style="text-align:right">@r.ItemCount.ToString("N0")</td>
                        <td style="text-align:right">@r.MFCS_SOH.ToString("N0")</td>
                        <td style="text-align:right">@r.IncreffSOH.ToString("N0")</td>
                        <td style="text-align:right">@r.GateKeeperRejectedSummer.ToString("N0")</td>
                        <td style="text-align:right">@r.GateKeeperRejectedWinter.ToString("N0")</td>
                        <td style="text-align:right; font-weight:@(r.Variance == 0 ? "400" : "700")">@r.Variance.ToString("N0")</td>
                        <td style="text-align:right">@r.InTransitUAE.ToString("N0")</td>
                        <td style="text-align:right">@r.InTransitKSA.ToString("N0")</td>
                    </tr>
                }
                @if (_summaryRows.Count == 0)
                {
                    <tr><td colspan="10" style="color:var(--text-secondary)">No rows for the selected filters.</td></tr>
                }
            </tbody>
        </table>
        </div>
    </div>
}

@code {
    private const string Dashboard = "Dashboard";
    private const string ItemLevel = "Item Level";
    private const string DivisionSummary = "Division Summary";
    private static readonly string[] Views = [Dashboard, ItemLevel, DivisionSummary];
    private string _activeView = Dashboard;

    private EcomStockVarianceDashboardSummary? _dashboard;
    private List<EcomStockVarianceReconciliationBucket> _reconciliationBuckets = new();
    private EcomStockVarianceDashboardSummary? _dashboardUae;
    private List<EcomStockVarianceReconciliationBucket> _bucketsUae = new();
    private EcomStockVarianceDashboardSummary? _dashboardKsa;
    private List<EcomStockVarianceReconciliationBucket> _bucketsKsa = new();
    private bool _dashboardLoading;
    private string _dashboardMessage = "";

    private List<string> _countries = new();
    private HashSet<string> _selectedCountries = new();
    private List<string> _divisions = new();
    private HashSet<string> _selectedDivisions = new();
    private List<string> _departments = new();
    private HashSet<string> _selectedDepartments = new();
    private string _brandSearch = "";
    private string _itemcodeSearch = "";
    private bool _loading;
    private bool _loaded;
    private string _message = "";
    private bool _isError;
    private List<EcomStockVarianceRow> _rows = new();
    private EcomStockVarianceTotals? _totals;
    private bool _varianceOnly = true;
    private bool _exporting;
    private int _pageNumber = 1;
    private int _pageJumpInput = 1;
    private DateTime? _lastRefreshed;

    private bool _summaryLoading;
    private bool _summaryLoaded;
    private bool _summaryExporting;
    private List<EcomStockVarianceDivisionSummaryRow> _summaryRows = new();

    private int TotalPages => _totals is null || _totals.RowCount == 0
        ? 1 : (int)Math.Ceiling(_totals.RowCount / (double)EcomStockVarianceReportService.PageSize);

    private bool IsExportDisabled => _activeView == ItemLevel
        ? _exporting || _totals is null || _totals.RowCount == 0
        : _summaryExporting || _summaryRows.Count == 0;

    private Task LoadActiveViewAsync() =>
        _activeView == ItemLevel ? LoadAsync(1) : LoadDivisionSummaryAsync();

    private Task ExportActiveViewExcelAsync() =>
        _activeView == ItemLevel ? ExportExcelAsync() : ExportDivisionSummaryExcelAsync();

    // null (no argument at all) means "genuinely unrestricted"; a user with zero
    // country grants gets the deny-by-default empty (non-null) list instead of
    // silently falling back to "show everything" — same convention as PoCountingReport.
    private IEnumerable<string>? EffectiveCountriesOrNull =>
        _selectedCountries.Count > 0 ? _selectedCountries
        : CurrentUser.HasAllCountriesAccess ? null
        : _countries;

    private IEnumerable<string>? EffectiveDivisionsOrNull =>
        _selectedDivisions.Count > 0 ? _selectedDivisions : null;

    private IEnumerable<string>? EffectiveDepartmentsOrNull =>
        _selectedDepartments.Count > 0 ? _selectedDepartments : null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CurrentUser.EnsureLoadedAsync();
            var list = await Svc.GetCountriesAsync();
            _countries = CurrentUser.FilterCountries(list).ToList();
            _divisions = await Svc.GetDivisionsAsync();
            _departments = await Svc.GetDepartmentsAsync();
            _lastRefreshed = await Svc.GetLastRefreshedAsync();
        }
        catch { /* fall back to empty lists if the lookup fails */ }

        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        _dashboardLoading = true; _dashboardMessage = ""; await InvokeAsync(StateHasChanged);
        try
        {
            _dashboard = await Svc.GetDashboardSummaryAsync();
            _reconciliationBuckets = await Svc.GetReconciliationBucketsAsync();
            _dashboardUae = await Svc.GetDashboardSummaryAsync("UAE");
            _bucketsUae = await Svc.GetReconciliationBucketsAsync("UAE");
            _dashboardKsa = await Svc.GetDashboardSummaryAsync("KSA");
            _bucketsKsa = await Svc.GetReconciliationBucketsAsync("KSA");
        }
        catch (Exception ex) { _dashboardMessage = ex.Message; }
        finally { _dashboardLoading = false; }
    }

    private async Task LoadAsync(int pageNumber)
    {
        _loading = true; _message = ""; _isError = false; await InvokeAsync(StateHasChanged);
        try
        {
            var totals = await Svc.GetTotalsAsync(
                EffectiveCountriesOrNull, EffectiveDivisionsOrNull, EffectiveDepartmentsOrNull,
                _brandSearch, _itemcodeSearch, _varianceOnly);
            _totals = totals;
            _pageNumber = Math.Clamp(pageNumber, 1, Math.Max(1, TotalPages));
            _pageJumpInput = _pageNumber;
            _rows = totals.RowCount == 0
                ? new()
                : await Svc.GetReportPageAsync(
                    EffectiveCountriesOrNull, EffectiveDivisionsOrNull, EffectiveDepartmentsOrNull,
                    _brandSearch, _itemcodeSearch, _varianceOnly, _pageNumber);
            _loaded = true;
            if (totals.RowCount == 0) _message = "No rows for the selected filters.";
        }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
        finally { _loading = false; }
    }

    private async Task LoadDivisionSummaryAsync()
    {
        _summaryLoading = true; _message = ""; _isError = false; await InvokeAsync(StateHasChanged);
        try
        {
            _summaryRows = await Svc.GetDivisionSummaryAsync(
                EffectiveCountriesOrNull, EffectiveDivisionsOrNull, EffectiveDepartmentsOrNull, _brandSearch, _varianceOnly);
            _summaryLoaded = true;
            if (_summaryRows.Count == 0) _message = "No rows for the selected filters.";
        }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
        finally { _summaryLoading = false; }
    }

    // "Variance only" is applied server-side (it changes the filtered row count,
    // hence the page count) — re-load from page 1 once a report has already been
    // shown; before that, just record the state for the next Load click.
    private async Task VarianceOnlyChangedAsync(ChangeEventArgs e)
    {
        _varianceOnly = (bool)e.Value!;
        if (_activeView == ItemLevel && _loaded) await LoadAsync(1);
        else if (_activeView == DivisionSummary && _summaryLoaded) await LoadDivisionSummaryAsync();
    }

    private void ClearFilters()
    {
        _selectedCountries = new();
        _selectedDivisions = new();
        _selectedDepartments = new();
        _brandSearch = "";
        _itemcodeSearch = "";
        _rows = new();
        _totals = null;
        _pageNumber = 1;
        _loaded = false;
        _summaryRows = new();
        _summaryLoaded = false;
        _message = "";
        _isError = false;
    }

    private async Task ExportExcelAsync()
    {
        if (_totals is null || _totals.RowCount == 0) return;
        _exporting = true;
        try
        {
            var all = await Svc.GetReportAsync(
                EffectiveCountriesOrNull, EffectiveDivisionsOrNull, EffectiveDepartmentsOrNull,
                _brandSearch, _itemcodeSearch, _varianceOnly);

            using var wb = new XLWorkbook();
            var ws = wb.AddWorksheet("ECOM Stock Variance");
            string[] headers =
            {
                "Country", "Itemcode", "MFCS_SOH", "INCREFF_SOH", "GS Summer Pallet", "GW Winter Pallet",
                "Variance (MFCS_SOH - (INCREFF_SOH + GS + GW + InTransit UAE + InTransit KSA))",
                "InTransit UAE", "InTransit KSA", "Division", "Department", "Class", "Subclass", "Family", "Brand", "Last Refreshed"
            };
            for (int i = 0; i < headers.Length; i++) ws.Cell(1, i + 1).Value = headers[i];
            ws.Row(1).Style.Font.Bold = true;

            int row = 2;
            foreach (var r in all)
            {
                ws.Cell(row, 1).Value  = r.Country;
                ws.Cell(row, 2).Value  = r.Itemcode;
                ws.Cell(row, 3).Value  = r.MFCS_SOH;
                ws.Cell(row, 4).Value  = r.IncreffSOH;
                ws.Cell(row, 5).Value  = r.GateKeeperRejectedSummer;
                ws.Cell(row, 6).Value  = r.GateKeeperRejectedWinter;
                ws.Cell(row, 7).Value  = r.Variance;
                ws.Cell(row, 8).Value  = r.InTransitUAE;
                ws.Cell(row, 9).Value  = r.InTransitKSA;
                ws.Cell(row, 10).Value = r.Division;
                ws.Cell(row, 11).Value = r.Department;
                ws.Cell(row, 12).Value = r.Class;
                ws.Cell(row, 13).Value = r.Subclass;
                ws.Cell(row, 14).Value = r.Family;
                ws.Cell(row, 15).Value = r.Brand;
                ws.Cell(row, 16).Value = r.CreateTS.ToString("dd-MMM-yyyy HH:mm");
                row++;
            }
            ws.Columns().AdjustToContents();

            using var ms = new MemoryStream();
            wb.SaveAs(ms);
            var b64 = Convert.ToBase64String(ms.ToArray());
            var name = $"ecom-stock-variance-{DateTime.UtcNow.AddHours(4):yyyyMMdd-HHmm}.xlsx";
            await JS.InvokeVoidAsync("downloadFileWithPicker", name, b64,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        finally { _exporting = false; }
    }

    private async Task ExportDivisionSummaryExcelAsync()
    {
        if (_summaryRows.Count == 0) return;
        _summaryExporting = true;
        try
        {
            using var wb = new XLWorkbook();
            var ws = wb.AddWorksheet("Division Summary");
            string[] headers =
            {
                "Country", "Division", "Items", "MFCS_SOH", "INCREFF_SOH", "GS Summer Pallet", "GW Winter Pallet",
                "Variance (MFCS_SOH - (INCREFF_SOH + GS + GW + InTransit UAE + InTransit KSA))", "InTransit UAE", "InTransit KSA"
            };
            for (int i = 0; i < headers.Length; i++) ws.Cell(1, i + 1).Value = headers[i];
            ws.Row(1).Style.Font.Bold = true;

            int row = 2;
            foreach (var r in _summaryRows)
            {
                ws.Cell(row, 1).Value = r.Country;
                ws.Cell(row, 2).Value = r.Division;
                ws.Cell(row, 3).Value = r.ItemCount;
                ws.Cell(row, 4).Value = r.MFCS_SOH;
                ws.Cell(row, 5).Value = r.IncreffSOH;
                ws.Cell(row, 6).Value = r.GateKeeperRejectedSummer;
                ws.Cell(row, 7).Value = r.GateKeeperRejectedWinter;
                ws.Cell(row, 8).Value = r.Variance;
                ws.Cell(row, 9).Value = r.InTransitUAE;
                ws.Cell(row, 10).Value = r.InTransitKSA;
                row++;
            }
            ws.Columns().AdjustToContents();

            using var ms = new MemoryStream();
            wb.SaveAs(ms);
            var b64 = Convert.ToBase64String(ms.ToArray());
            var name = $"ecom-division-summary-{DateTime.UtcNow.AddHours(4):yyyyMMdd-HHmm}.xlsx";
            await JS.InvokeVoidAsync("downloadFileWithPicker", name, b64,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        finally { _summaryExporting = false; }
    }
}
