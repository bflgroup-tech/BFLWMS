@page "/reports/jafza-division-production"
@rendermode RenderMode.InteractiveServer
@using Wms.Core
@using Wms.Data.Lpm
@using ClosedXML.Excel
@attribute [Authorize(Policy = MenuKeys.RPT_JAFZA_DIVISION_PROD)]
@inject JafzaDivisionProductionService Svc
@inject JafzaRoboProductionService RoboSvc
@inject IJSRuntime JS

<PageTitle>WMS - Jafza Manual/Robo Production</PageTitle>

<div class="aiwms-page-header">
    <h2>Jafza Manual/Robo Production</h2>
    @if (_source == "Manual")
    {
        <p>Photo-checking production from Online.dbo.PhotoChecking (Warehouse = JAFZA). Scans before 05:00 count toward the previous day's shift. Date range is limited to 7 days.</p>
    }
    else
    {
        <p>Robo pairing production from ROBOTICS.dbo.PairingConformationDetail (JafazaRoboDb). Scans before 05:00 count toward the previous day's shift. Date range is limited to 7 days.</p>
    }
</div>

<div class="aiwms-section">
    <div style="display:flex; gap:14px; align-items:center; margin-bottom:8px; flex-wrap:wrap">
        <strong style="font-size:11px; text-transform:uppercase; letter-spacing:1px; color:var(--text-secondary)">Source:</strong>
        <label style="display:flex; align-items:center; gap:4px; cursor:pointer">
            <input type="radio" name="src" value="Manual" checked="@(_source == "Manual")" @onchange="@(() => SetSource("Manual"))" /> Manual
        </label>
        <label style="display:flex; align-items:center; gap:4px; cursor:pointer">
            <input type="radio" name="src" value="Robo" checked="@(_source == "Robo")" @onchange="@(() => SetSource("Robo"))" /> Robo
        </label>
    </div>

    <div style="display:flex; gap:14px; align-items:center; margin-bottom:14px; flex-wrap:wrap">
        <strong style="font-size:11px; text-transform:uppercase; letter-spacing:1px; color:var(--text-secondary)">Report:</strong>
        <label style="display:flex; align-items:center; gap:4px; cursor:pointer">
            <input type="radio" name="rpt" value="Summary" checked="@(_view == "Summary")" @onchange="@(() => SetView("Summary"))" /> Summary (Division-wise)
        </label>
        <label style="display:flex; align-items:center; gap:4px; cursor:pointer">
            <input type="radio" name="rpt" value="Detailed" checked="@(_view == "Detailed")" @onchange="@(() => SetView("Detailed"))" /> Detailed (Item-wise)
        </label>
    </div>

    <div style="display:grid; grid-template-columns: 1fr 1fr 1fr auto; gap:12px; align-items:end;">
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">FROM *</label>
            <input type="date" @bind="_from" @bind:format="yyyy-MM-dd" max="@DateTime.Today.ToString("yyyy-MM-dd")" style="width:100%; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
        </div>
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">TO *</label>
            <input type="date" @bind="_to" @bind:format="yyyy-MM-dd" max="@DateTime.Today.ToString("yyyy-MM-dd")" style="width:100%; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
        </div>
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">USERNAME (optional)</label>
            <input @bind="_username" @bind:event="oninput" placeholder="e.g. 5475" style="width:100%; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
        </div>
        <div style="display:flex; gap:8px">
            <button class="aiwms-btn aiwms-btn-primary" @onclick="LoadAsync" disabled="@(_loading || !IsRangeValid)">@(_loading ? "Loading..." : "Load")</button>
            <button class="aiwms-btn aiwms-btn-secondary" @onclick="ExportExcelAsync" disabled="@(_exporting || CurrentRowCount == 0)">@(_exporting ? "Exporting..." : "Export Excel")</button>
        </div>
    </div>

    @if (!IsRangeValid)
    {
        <div class="aiwms-alert error" style="margin-top:12px">Date range cannot exceed 7 days.</div>
    }
    else if (!string.IsNullOrEmpty(_message))
    {
        <div class="aiwms-alert @(_isError ? "error" : "info")" style="margin-top:12px">@_message</div>
    }
</div>

@if (_source == "Manual")
