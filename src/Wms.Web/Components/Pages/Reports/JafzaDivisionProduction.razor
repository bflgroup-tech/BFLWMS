            </div>

            <div class="aiwms-card-header">Summary (Robo) - @FilteredRoboSummaryRows().Count row(s)</div>
            <div style="overflow-x:auto">
            <table class="aiwms-table aiwms-table-dense" style="table-layout:fixed; width:100%">
                <colgroup>
                    <col style="width:140px" />
                    <col style="width:260px" />
                    <col style="width:150px" />
                    <col style="width:140px" />
                </colgroup>
                <thead>
                    <tr>
                        <th>Trn Date</th>
                        <th>Division</th>
                        <th>Username</th>
                        <th style="text-align:center">Qty</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in FilteredRoboSummaryRows())
                    {
                        <tr>
                            <td>@FmtDate(r.TrnDate)</td>
                            <td style="word-break:break-word">@r.Division</td>
                            <td>@r.Username</td>
                            <td style="text-align:center">@r.Qty.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    }
    else if (_view == "Detailed" && _roboDetailRows.Count > 0)
    {
        <div class="aiwms-section">
            <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:12px;">
                <div style="background:#E6F7F0; border-radius:var(--r-sm); padding:12px 16px;">
                    <div style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:#1F6E4C">Total Items</div>
                    <div style="font-size:1.4rem; font-weight:800; color:#1F6E4C">@FilteredRoboDetailRows().Count.ToString("N0")</div>
                </div>
                <div style="background:#E0F7FA; border-radius:var(--r-sm); padding:12px 16px;">
                    <div style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:#0E6E7A">Total Users</div>
                    <div style="font-size:1.4rem; font-weight:800; color:#0E6E7A">@FilteredRoboDetailRows().Select(r => r.Username).Distinct(StringComparer.OrdinalIgnoreCase).Count().ToString("N0")</div>
                </div>
                <div style="background:#E4EEFC; border-radius:var(--r-sm); padding:12px 16px;">
                    <div style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:#1E4E8C">Total Qty</div>
                    <div style="font-size:1.4rem; font-weight:800; color:#1E4E8C">@FilteredRoboDetailRows().Sum(r => r.Qty).ToString("N0")</div>
                </div>
            </div>
        </div>

        <div class="aiwms-section">
            <div style="display:flex; gap:12px; align-items:end; margin-bottom:14px; flex-wrap:wrap">
                <div style="flex:1; min-width:240px">
                    <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">SEARCH (ITEM CODE / USERNAME / GROUP CODE / GROUP NAME / DIVISION)</label>
                    <input @bind="_search" @bind:event="oninput" placeholder="Type to filter..." style="width:100%; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
                </div>
            </div>

            <div class="aiwms-card-header">Detailed (Robo) - @FilteredRoboDetailRows().Count row(s)</div>
            <div style="overflow-x:auto">
            <table class="aiwms-table aiwms-table-dense" style="table-layout:fixed; width:100%">
                <colgroup>
                    <col style="width:110px" />
                    <col style="width:150px" />
                    <col style="width:150px" />
                    <col style="width:100px" />
                    <col style="width:180px" />
                    <col style="width:200px" />
                    <col style="width:110px" />
                </colgroup>
                <thead>
                    <tr>
                        <th>Trn Date</th>
                        <th>Item Code</th>
                        <th>Username</th>
                        <th>Group Code</th>
                        <th>Group Name</th>
                        <th>Division</th>
                        <th style="text-align:center">Qty</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in FilteredRoboDetailRows())
                    {
                        <tr>
                            <td>@FmtDate(r.TrnDate)</td>
                            <td style="font-family:var(--font-mono)">@r.ItemCode</td>
                            <td>@r.Username</td>
                            <td>@r.GroupCode</td>
                            <td style="word-break:break-word">@r.GroupName</td>
                            <td style="word-break:break-word">@r.Division</td>
                            <td style="text-align:center">@r.Qty.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
