@page "/reports/jafza-division-production"
@rendermode RenderMode.InteractiveServer
@using Wms.Core
@using Wms.Data.Lpm
@using ClosedXML.Excel
@using MudBlazor
@attribute [Authorize(Policy = MenuKeys.RPT_JAFZA_DIVISION_PROD)]
@inject JafzaDivisionProductionService Svc
@inject JafzaRoboProductionService RoboSvc
@inject JafzaExportProductionService ExportSvc
@inject JafzaBoxGrnProductionService BoxGrnSvc
@inject IJSRuntime JS
@inject ILogger<JafzaDivisionProduction> Logger

<PageTitle>WMS - JAFZA Production Report</PageTitle>

<div class="aiwms-page-header">
    <h2>JAFZA Production Report</h2>
    @if (_source == "Manual")
    {
        <p>Photo-checking production from Online.dbo.PhotoChecking (Warehouse = JAFZA). Scans before 03:00 count toward the previous day's shift. Date range is limited to 7 days.</p>
    }
    else if (_source == "Robo")
    {
        <p>Robo pairing production from ROBOTICS.dbo.PairingConformationDetail (JafazaRoboDb). Scans before 03:00 count toward the previous day's shift. Date range is limited to 7 days.</p>
    }
    else if (_source == "Export")
    {
        <p>Export production from BFLDATA.dbo.DailyCountCategoryTrf (Warehouse = JAFZA) — Qty is the sum of all hour buckets for that Division/Shop. Summary only (no item-level detail available from this source).</p>
    }
    else
    {
        <p>Box GRN production for JAFZA. Date range is limited to 7 days.</p>
    }
</div>

<div class="aiwms-section">
    <div style="display:flex; gap:14px; align-items:center; margin-bottom:8px; flex-wrap:wrap">
        <strong style="font-size:11px; text-transform:uppercase; letter-spacing:1px; color:var(--text-secondary)">Source:</strong>
        <label style="display:flex; align-items:center; gap:4px; cursor:pointer">
            <input type="radio" name="src" value="Manual" checked="@(_source == "Manual")" @onchange="@(() => SetSource("Manual"))" /> Manual
        </label>
        <label style="display:flex; align-items:center; gap:4px; cursor:pointer">
            <input type="radio" name="src" value="Robo" checked="@(_source == "Robo")" @onchange="@(() => SetSource("Robo"))" /> Robo
        </label>
        <label style="display:flex; align-items:center; gap:4px; cursor:pointer">
            <input type="radio" name="src" value="Export" checked="@(_source == "Export")" @onchange="@(() => SetSource("Export"))" /> Export
        </label>
        <label style="display:flex; align-items:center; gap:4px; cursor:pointer">
            <input type="radio" name="src" value="BoxGrn" checked="@(_source == "BoxGrn")" @onchange="@(() => SetSource("BoxGrn"))" /> Box GRN
        </label>
    </div>

    @if (_source != "Export")
    {
        <div style="display:flex; gap:14px; align-items:center; margin-bottom:14px; flex-wrap:wrap">
            <strong style="font-size:11px; text-transform:uppercase; letter-spacing:1px; color:var(--text-secondary)">Report:</strong>
            <label style="display:flex; align-items:center; gap:4px; cursor:pointer">
                <input type="radio" name="rpt" value="Summary" checked="@(_view == "Summary")" @onchange="@(() => SetView("Summary"))" /> Summary (Division-wise)
            </label>
            <label style="display:flex; align-items:center; gap:4px; cursor:pointer">
                <input type="radio" name="rpt" value="Detailed" checked="@(_view == "Detailed")" @onchange="@(() => SetView("Detailed"))" /> Detailed (Item-wise)
            </label>
        </div>
    }

    <div style="display:grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap:12px; align-items:end; margin-bottom:12px;">
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">WEEK (supersedes date range)</label>
            <select value="@_selectedWeek" @onchange="@(async (ChangeEventArgs e) => await SetWeek(e.Value?.ToString() ?? ""))" style="width:100%; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white">
                <option value="">-- Use date range below --</option>
                @foreach (var w in _weeks)
                {
                    <option value="@w.Wk">Wk @w.Wk (@w.WeekStart.ToString("dd-MMM") - @w.WeekEnd.ToString("dd-MMM-yyyy"))</option>
                }
            </select>
        </div>
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">FROM *</label>
            <input type="date" @bind="_from" @bind:format="yyyy-MM-dd" max="@DateTime.Today.ToString("yyyy-MM-dd")" disabled="@(_selectedWeek.HasValue)" style="width:100%; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
        </div>
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">TO *</label>
            <input type="date" @bind="_to" @bind:format="yyyy-MM-dd" max="@DateTime.Today.ToString("yyyy-MM-dd")" disabled="@(_selectedWeek.HasValue)" style="width:100%; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
        </div>
        @if (_source != "Export" && _source != "BoxGrn")
        {
            <div>
                <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">USERNAME (optional)</label>
                <input @bind="_username" @bind:event="oninput" placeholder="e.g. 5475" style="width:100%; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
            </div>
        }
        else
        {
            <div></div>
        }
    </div>

    <div style="display:grid; grid-template-columns: 1fr auto; gap:12px; align-items:end;">
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">DIVISIONS (select any)</label>
            <MudSelect T="string" Dense="true" MultiSelection="true" SelectAll="true" Placeholder="All"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       SelectedValues="_selectedDivisions" SelectedValuesChanged="@OnDivisionsChanged">
                @foreach (var d in AvailableDivisions()) { <MudSelectItem T="string" Value="@d" @key="@d">@d</MudSelectItem> }
            </MudSelect>
        </div>
        <div style="display:flex; gap:8px">
            <button class="aiwms-btn aiwms-btn-primary" @onclick="LoadAsync" disabled="@(_loading || !IsRangeValid)">@(_loading ? "Loading..." : "Load")</button>
            <button class="aiwms-btn aiwms-btn-secondary" @onclick="ExportExcelAsync" disabled="@(_exporting || CurrentRowCount == 0)">@(_exporting ? "Exporting..." : "Export Excel")</button>
        </div>
    </div>

    @if (!IsRangeValid)
    {
        <div class="aiwms-alert error" style="margin-top:12px">Date range cannot exceed 7 days.</div>
    }
    else if (!string.IsNullOrEmpty(_message))
    {
        <div class="aiwms-alert @(_isError ? "error" : "info")" style="margin-top:12px">@_message</div>
    }
</div>

<div class="aiwms-section">
    <div style="display:grid; grid-template-columns: repeat(5, 1fr); gap:12px;">
        <div style="background:#FCE7EB; border-radius:var(--r-sm); padding:12px 16px;">
            <div style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:#8A3A48">Manual Prod</div>
            <div style="font-size:1.4rem; font-weight:800; color:#8A3A48">@(_totalsLoading ? "..." : _manualTotal.ToString("N0"))</div>
        </div>
        <div style="background:#E6F7F0; border-radius:var(--r-sm); padding:12px 16px;">
            <div style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:#1F6E4C">RoboProd</div>
            <div style="font-size:1.4rem; font-weight:800; color:#1F6E4C">@(_totalsLoading ? "..." : _roboTotal.ToString("N0"))</div>
        </div>
        <div style="background:#E4EEFC; border-radius:var(--r-sm); padding:12px 16px;">
            <div style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:#1E4E8C">Export Prod</div>
            <div style="font-size:1.4rem; font-weight:800; color:#1E4E8C">@(_totalsLoading ? "..." : _exportTotal.ToString("N0"))</div>
        </div>
        <div style="background:#FFF4E0; border-radius:var(--r-sm); padding:12px 16px;">
            <div style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:#8A5A12">Box GRN Prod</div>
            <div style="font-size:1.4rem; font-weight:800; color:#8A5A12">@(_totalsLoading ? "..." : _boxGrnTotal.ToString("N0"))</div>
        </div>
        <div style="background:#EFEAFB; border-radius:var(--r-sm); padding:12px 16px;">
            <div style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:#4E3B96">Total Prod</div>
            <div style="font-size:1.4rem; font-weight:800; color:#4E3B96">@(_totalsLoading ? "..." : (_manualTotal + _roboTotal + _exportTotal + _boxGrnTotal).ToString("N0"))</div>
        </div>
    </div>
</div>

@if (_source == "Manual")
{
    @if (_view == "Summary" && _summaryRows.Count > 0)
    {
        <div class="aiwms-section">
            <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:12px;">
                <div style="background:#FCE7EB; border-radius:var(--r-sm); padding:12px 16px;">
                    <div style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:#8A3A48">Total Divisions</div>
                    <div style="font-size:1.4rem; font-weight:800; color:#8A3A48">@FilteredSummaryRows().Select(r => r.Division).Distinct(StringComparer.OrdinalIgnoreCase).Count().ToString("N0")</div>
                </div>
                <div style="background:#EFEAFB; border-radius:var(--r-sm); padding:12px 16px;">
                    <div style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:#4E3B96">Total Users</div>
                    <div style="font-size:1.4rem; font-weight:800; color:#4E3B96">@FilteredSummaryRows().Select(r => r.Username).Distinct(StringComparer.OrdinalIgnoreCase).Count().ToString("N0")</div>
                </div>
                <div style="background:#FFF4E0; border-radius:var(--r-sm); padding:12px 16px;">
                    <div style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:#8A5A12">Total Checked Qty</div>
                    <div style="font-size:1.4rem; font-weight:800; color:#8A5A12">@FilteredSummaryRows().Sum(r => r.CheckedQty).ToString("N0")</div>
                </div>
            </div>
        </div>

        <div class="aiwms-section">
            <div style="display:flex; gap:12px; align-items:end; margin-bottom:14px; flex-wrap:wrap">
                <div style="flex:1; min-width:240px">
                    <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">SEARCH (DIVISION / USERNAME)</label>
                    <input @bind="_search" @bind:event="oninput" placeholder="Type to filter..." style="width:100%; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
                </div>
            </div>

            <div class="aiwms-card-header">Summary - @FilteredSummaryRows().Count row(s)</div>
            <div style="overflow-x:auto">
            <table class="aiwms-table aiwms-table-dense" style="table-layout:fixed; width:100%">
                <colgroup>
                    <col style="width:140px" />
                    <col style="width:260px" />
                    <col style="width:150px" />
                    <col style="width:140px" />
                </colgroup>
                <thead>
                    <tr>
                        <th>Trn Date</th>
                        <th>Division</th>
                        <th>Username</th>
                        <th style="text-align:center">Checked Qty</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in FilteredSummaryRows())
                    {
                        <tr>
                            <td>@FmtDate(r.TrnDate)</td>
                            <td style="word-break:break-word">@r.Division</td>
                            <td>@r.Username</td>
                            <td style="text-align:center">@r.CheckedQty.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    }
    else if (_view == "Detailed" && _detailRows.Count > 0)
    {
        <div class="aiwms-section">
            <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:12px;">
                <div style="background:#FCE7EB; border-radius:var(--r-sm); padding:12px 16px;">
                    <div style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:#8A3A48">Total Items</div>
                    <div style="font-size:1.4rem; font-weight:800; color:#8A3A48">@FilteredDetailRows().Count.ToString("N0")</div>
                </div>
                <div style="background:#EFEAFB; border-radius:var(--r-sm); padding:12px 16px;">
                    <div style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:#4E3B96">Total Users</div>
                    <div style="font-size:1.4rem; font-weight:800; color:#4E3B96">@FilteredDetailRows().Select(r => r.Username).Distinct(StringComparer.OrdinalIgnoreCase).Count().ToString("N0")</div>
                </div>
                <div style="background:#FFF4E0; border-radius:var(--r-sm); padding:12px 16px;">
                    <div style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:#8A5A12">Total Checked Qty</div>
                    <div style="font-size:1.4rem; font-weight:800; color:#8A5A12">@FilteredDetailRows().Sum(r => r.CheckedQty).ToString("N0")</div>
                </div>
            </div>
        </div>

        <div class="aiwms-section">
            <div style="display:flex; gap:12px; align-items:end; margin-bottom:14px; flex-wrap:wrap">
                <div style="flex:1; min-width:240px">
                    <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">SEARCH (UPC / USERNAME / GROUP CODE / DIVISION / PO NO)</label>
                    <input @bind="_search" @bind:event="oninput" placeholder="Type to filter..." style="width:100%; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
                </div>
            </div>

            <div class="aiwms-card-header">Detailed - @FilteredDetailRows().Count row(s)</div>
            <div style="overflow-x:auto">
            <table class="aiwms-table aiwms-table-dense" style="table-layout:fixed; width:100%">
                <colgroup>
                    <col style="width:110px" />
                    <col style="width:100px" />
                    <col style="width:150px" />
                    <col style="width:100px" />
                    <col style="width:200px" />
                    <col style="width:110px" />
                    <col style="width:110px" />
                    <col style="width:120px" />
                </colgroup>
                <thead>
                    <tr>
                        <th>Trn Date</th>
                        <th>Username</th>
                        <th>UPC</th>
                        <th>Group Code</th>
                        <th>Division</th>
                        <th style="text-align:center">Checked Qty</th>
                        <th>LPMDT</th>
                        <th>ORAPONO</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in FilteredDetailRows())
                    {
                        <tr>
                            <td>@FmtDate(r.TrnDate)</td>
                            <td>@r.Username</td>
                            <td style="font-family:var(--font-mono)">@r.UPC</td>
                            <td>@r.GroupCode</td>
                            <td style="word-break:break-word">@r.Division</td>
                            <td style="text-align:center">@r.CheckedQty.ToString("N0")</td>
                            <td>@FmtNullableDate(r.Lpmdt)</td>
                            <td>@r.OraPoNo</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    }
}
else if (_source == "Robo")
{
    @if (_view == "Summary" && _roboSummaryRows.Count > 0)
    {
        <div class="aiwms-section">
            <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:12px;">
                <div style="background:#E6F7F0; border-radius:var(--r-sm); padding:12px 16px;">
                    <div style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:#1F6E4C">Total Divisions</div>
                    <div style="font-size:1.4rem; font-weight:800; color:#1F6E4C">@FilteredRoboSummaryRows().Select(r => r.Division).Distinct(StringComparer.OrdinalIgnoreCase).Count().ToString("N0")</div>
                </div>
                <div style="background:#E0F7FA; border-radius:var(--r-sm); padding:12px 16px;">
                    <div style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:#0E6E7A">Total Users</div>
                    <div style="font-size:1.4rem; font-weight:800; color:#0E6E7A">@FilteredRoboSummaryRows().Select(r => r.Username).Distinct(StringComparer.OrdinalIgnoreCase).Count().ToString("N0")</div>
                </div>
                <div style="background:#E4EEFC; border-radius:var(--r-sm); padding:12px 16px;">
                    <div style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:#1E4E8C">Total Qty</div>
                    <div style="font-size:1.4rem; font-weight:800; color:#1E4E8C">@FilteredRoboSummaryRows().Sum(r => r.Qty).ToString("N0")</div>
                </div>
            </div>
        </div>

        <div class="aiwms-section">
            <div style="display:flex; gap:12px; align-items:end; margin-bottom:14px; flex-wrap:wrap">
                <div style="flex:1; min-width:240px">
                    <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">SEARCH (DIVISION / USERNAME)</label>
                    <input @bind="_search" @bind:event="oninput" placeholder="Type to filter..." style="width:100%; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
