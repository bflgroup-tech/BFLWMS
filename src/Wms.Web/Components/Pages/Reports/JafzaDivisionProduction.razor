                    ws.Cell(row, 1).Value = FmtDate(r.TrnDate);
                    ws.Cell(row, 2).Value = r.Division;
                    ws.Cell(row, 3).Value = r.ShopName;
                    ws.Cell(row, 4).Value = r.Qty;
                    row++;
                }
                ws.Columns().AdjustToContents();
                name = $"jafza-export-production-summary-{_from:yyyyMMdd}-{_to:yyyyMMdd}.xlsx";
            }

            using var ms = new MemoryStream();
            wb.SaveAs(ms);
            var b64 = Convert.ToBase64String(ms.ToArray());
            await JS.InvokeVoidAsync("downloadFileWithPicker", name, b64,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        finally { _exporting = false; }
    }

    // Every row type here carries a Division field — the multiselect filter
    // applies the same way to all 7 lists, ANDed with the existing free-text
    // search. Empty selection means "All" (no filtering by division).
    private bool DivisionMatches(string? division) =>
        _selectedDivisions.Count == 0 || (division is not null && _selectedDivisions.Contains(division));

    // The top Manual/Robo/Export total cards are fetched via SQL (not derived from
    // the currently-loaded source's rows), so changing the Divisions filter has to
    // explicitly re-fetch them to stay in sync with what the tables show. This
    // handler must stay synchronous (not "async Task") and fire the refresh in the
    // background rather than awaiting it — MudSelect withholds the checkbox's
    // checked/unchecked visual update until SelectedValuesChanged's returned Task
    // completes, so awaiting a multi-second SQL round trip here made every click
    // look unresponsive (both checking and unchecking) until a second click landed.
    private void OnDivisionsChanged(IEnumerable<string> values)
    {
        _selectedDivisions = values.ToHashSet(StringComparer.OrdinalIgnoreCase);
        _ = LoadTotalsAsync();
    }

    private List<string> AvailableDivisions() => (_source switch
    {
        "Manual" => _view == "Summary" ? _summaryRows.Select(r => r.Division) : _detailRows.Select(r => r.Division),
        "Robo"   => _view == "Summary" ? _roboSummaryRows.Select(r => r.Division) : _roboDetailRows.Select(r => r.Division),
        "BoxGrn" => _view == "Summary" ? _boxGrnSummaryRows.Select(r => r.Division) : _boxGrnDetailRows.Select(r => r.Division),
        _        => _exportRows.Select(r => r.Division)
    })
        .Where(d => !string.IsNullOrWhiteSpace(d))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(d => d, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private List<JafzaProductionSummaryRow> FilteredSummaryRows()
    {
        var term = _search.Trim();
        return _summaryRows.Where(r =>
            DivisionMatches(r.Division) &&
            (term.Length == 0 || Matches(r.Division, term) || Matches(r.Username, term))).ToList();
    }

    private List<JafzaProductionDetailRow> FilteredDetailRows()
    {
        var term = _search.Trim();
        return _detailRows.Where(r =>
            DivisionMatches(r.Division) &&
            (term.Length == 0 ||
             Matches(r.UPC, term) ||
             Matches(r.Username, term) ||
             Matches(r.GroupCode, term) ||
             Matches(r.Division, term) ||
             Matches(r.OraPoNo, term))).ToList();
    }

    private List<JafzaRoboProductionSummaryRow> FilteredRoboSummaryRows()
    {
        var term = _search.Trim();
        return _roboSummaryRows.Where(r =>
            DivisionMatches(r.Division) &&
            (term.Length == 0 || Matches(r.Division, term) || Matches(r.Username, term))).ToList();
    }

    private List<JafzaRoboProductionDetailRow> FilteredRoboDetailRows()
    {
        var term = _search.Trim();
        return _roboDetailRows.Where(r =>
            DivisionMatches(r.Division) &&
            (term.Length == 0 ||
             Matches(r.ItemCode, term) ||
             Matches(r.Username, term) ||
             Matches(r.GroupCode, term) ||
             Matches(r.GroupName, term) ||
             Matches(r.Division, term))).ToList();
    }

    private List<JafzaExportProductionRow> FilteredExportRows()
    {
        var term = _search.Trim();
        return _exportRows.Where(r =>
            DivisionMatches(r.Division) &&
            (term.Length == 0 || Matches(r.Division, term) || Matches(r.ShopName, term))).ToList();
    }

    private List<JafzaBoxGrnSummaryRow> FilteredBoxGrnSummaryRows()
    {
        var term = _search.Trim();
        return _boxGrnSummaryRows.Where(r =>
            DivisionMatches(r.Division) &&
            (term.Length == 0 || Matches(r.Division, term))).ToList();
    }

    private List<JafzaBoxGrnDetailRow> FilteredBoxGrnDetailRows()
    {
        var term = _search.Trim();
        return _boxGrnDetailRows.Where(r =>
            DivisionMatches(r.Division) &&
            (term.Length == 0 ||
             Matches(r.ItemCode, term) ||
             Matches(r.GroupCode, term) ||
             Matches(r.Division, term))).ToList();
    }

    private List<(string ShopName, int Qty)> ShopTotals() =>
        FilteredExportRows()
            .GroupBy(r => r.ShopName, StringComparer.OrdinalIgnoreCase)
            .Select(g => (ShopName: g.Key, Qty: g.Sum(r => r.Qty)))
            .OrderByDescending(x => x.Qty)
            .ToList();

    private static readonly (string Bg, string Fg)[] ShopCardColors =
    {
        ("#FCE7EB", "#8A3A48"), // pink
        ("#E6F7F0", "#1F6E4C"), // green
        ("#E4EEFC", "#1E4E8C"), // blue
        ("#FFF4E0", "#8A5A12"), // amber
        ("#EFEAFB", "#4E3B96"), // purple
        ("#FBE9ED", "#8C2E45"), // rose
        ("#E0F7FA", "#0E6E7A"), // teal
        ("#F2EEDC", "#6B5B1E"), // sand
    };

    private static bool Matches(string? value, string term) =>
        !string.IsNullOrEmpty(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);

    private static string FmtDate(DateTime d) => d.ToString("dd-MMM-yyyy");
    private static string FmtNullableDate(DateTime? d) => d.HasValue ? d.Value.ToString("dd-MMM-yyyy") : "";
}
