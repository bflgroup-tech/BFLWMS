}
else if (_source == "BoxGrn")
{
    @if (_view == "Summary" && _boxGrnSummaryRows.Count > 0)
    {
        <div class="aiwms-section">
            <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:12px;">
                <div style="background:#FFF4E0; border-radius:var(--r-sm); padding:12px 16px;">
                    <div style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:#8A5A12">Total Divisions</div>
