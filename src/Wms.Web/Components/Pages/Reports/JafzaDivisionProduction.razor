@code {
    private string _source = "Manual";
    private string _view = "Summary";
    private DateTime _from = DateTime.Today;
    private DateTime _to   = DateTime.Today;
    private string _username = "";
    private bool _loading;
    private bool _exporting;
    private string _message = "";
    private bool _isError;
    private string _search = "";
    private List<JafzaProductionSummaryRow> _summaryRows = new();
    private List<JafzaProductionDetailRow>  _detailRows  = new();
    private List<JafzaRoboProductionSummaryRow> _roboSummaryRows = new();
    private List<JafzaRoboProductionDetailRow>  _roboDetailRows  = new();

    private bool IsRangeValid => _from <= _to && (_to - _from).TotalDays <= 6;

    private int CurrentRowCount => (_source, _view) switch
    {
        ("Manual", "Summary") => _summaryRows.Count,
        ("Manual", _)         => _detailRows.Count,
        (_, "Summary")        => _roboSummaryRows.Count,
        _                     => _roboDetailRows.Count
    };

    // Switching Source or Report type re-runs the same From/To/Username search
    // automatically — no need to click Load again, same as the Production
    // Summary Report's Summary/Detailed toggle. The 7-day cap already keeps
    // Detailed's result size bounded, so unlike Counting Completion Report
    // this doesn't need a narrower-filter guard before auto-reloading.
    private async Task SetSource(string source)
    {
        _source = source;
        if (IsRangeValid) await LoadAsync();
    }

    private async Task SetView(string view)
    {
        _view = view;
        if (IsRangeValid) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!IsRangeValid) return;
        _loading = true; _message = ""; _isError = false;
        _summaryRows = new(); _detailRows = new();
        _roboSummaryRows = new(); _roboDetailRows = new();
        try
        {
            if (_source == "Manual")
            {
                if (_view == "Summary")
                {
                    _summaryRows = await Svc.GetSummaryAsync(_from, _to, _username);
                    if (_summaryRows.Count == 0) _message = "No rows for the selected filters.";
                }
                else
                {
                    _detailRows = await Svc.GetDetailAsync(_from, _to, _username);
                    if (_detailRows.Count == 0) _message = "No rows for the selected filters.";
                }
            }
            else
            {
                if (_view == "Summary")
                {
                    _roboSummaryRows = await RoboSvc.GetSummaryAsync(_from, _to, _username);
                    if (_roboSummaryRows.Count == 0) _message = "No rows for the selected filters.";
                }
                else
                {
                    _roboDetailRows = await RoboSvc.GetDetailAsync(_from, _to, _username);
                    if (_roboDetailRows.Count == 0) _message = "No rows for the selected filters.";
                }
            }
        }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
        finally { _loading = false; }
    }

    private async Task ExportExcelAsync()
    {
        if (CurrentRowCount == 0) return;
        _exporting = true;
        try
        {
            using var wb = new XLWorkbook();
            string name;

            if (_source == "Manual" && _view == "Summary")
            {
                var ws = wb.AddWorksheet("Summary");
                string[] headers = { "Trn Date", "Division", "Username", "Checked Qty" };
                for (int i = 0; i < headers.Length; i++) ws.Cell(1, i + 1).Value = headers[i];
                ws.Row(1).Style.Font.Bold = true;

                int row = 2;
                foreach (var r in FilteredSummaryRows())
                {
                    ws.Cell(row, 1).Value = FmtDate(r.TrnDate);
                    ws.Cell(row, 2).Value = r.Division;
                    ws.Cell(row, 3).Value = r.Username;
                    ws.Cell(row, 4).Value = r.CheckedQty;
                    row++;
                }
                ws.Columns().AdjustToContents();
                name = $"jafza-manual-production-summary-{_from:yyyyMMdd}-{_to:yyyyMMdd}.xlsx";
            }
            else if (_source == "Manual")
            {
                var ws = wb.AddWorksheet("Detailed");
                string[] headers = { "Trn Date", "Username", "UPC", "Group Code", "Division", "Checked Qty", "LPMDT", "ORAPONO" };
                for (int i = 0; i < headers.Length; i++) ws.Cell(1, i + 1).Value = headers[i];
                ws.Row(1).Style.Font.Bold = true;

                int row = 2;
                foreach (var r in FilteredDetailRows())
                {
                    ws.Cell(row, 1).Value = FmtDate(r.TrnDate);
                    ws.Cell(row, 2).Value = r.Username;
                    ws.Cell(row, 3).Value = r.UPC;
                    ws.Cell(row, 4).Value = r.GroupCode;
                    ws.Cell(row, 5).Value = r.Division;
                    ws.Cell(row, 6).Value = r.CheckedQty;
                    ws.Cell(row, 7).Value = FmtNullableDate(r.Lpmdt);
                    ws.Cell(row, 8).Value = r.OraPoNo;
                    row++;
                }
                ws.Columns().AdjustToContents();
                name = $"jafza-manual-production-detailed-{_from:yyyyMMdd}-{_to:yyyyMMdd}.xlsx";
            }
            else if (_view == "Summary")
            {
                var ws = wb.AddWorksheet("Summary (Robo)");
                string[] headers = { "Trn Date", "Division", "Username", "Qty" };
                for (int i = 0; i < headers.Length; i++) ws.Cell(1, i + 1).Value = headers[i];
                ws.Row(1).Style.Font.Bold = true;

                int row = 2;
                foreach (var r in FilteredRoboSummaryRows())
                {
                    ws.Cell(row, 1).Value = FmtDate(r.TrnDate);
                    ws.Cell(row, 2).Value = r.Division;
                    ws.Cell(row, 3).Value = r.Username;
                    ws.Cell(row, 4).Value = r.Qty;
                    row++;
                }
                ws.Columns().AdjustToContents();
                name = $"jafza-robo-production-summary-{_from:yyyyMMdd}-{_to:yyyyMMdd}.xlsx";
            }
            else
            {
                var ws = wb.AddWorksheet("Detailed (Robo)");
                string[] headers = { "Trn Date", "Item Code", "Username", "Group Code", "Group Name", "Division", "Qty" };
                for (int i = 0; i < headers.Length; i++) ws.Cell(1, i + 1).Value = headers[i];
                ws.Row(1).Style.Font.Bold = true;

                int row = 2;
                foreach (var r in FilteredRoboDetailRows())
                {
                    ws.Cell(row, 1).Value = FmtDate(r.TrnDate);
                    ws.Cell(row, 2).Value = r.ItemCode;
                    ws.Cell(row, 3).Value = r.Username;
                    ws.Cell(row, 4).Value = r.GroupCode;
                    ws.Cell(row, 5).Value = r.GroupName;
                    ws.Cell(row, 6).Value = r.Division;
                    ws.Cell(row, 7).Value = r.Qty;
                    row++;
                }
                ws.Columns().AdjustToContents();
                name = $"jafza-robo-production-detailed-{_from:yyyyMMdd}-{_to:yyyyMMdd}.xlsx";
            }

            using var ms = new MemoryStream();
            wb.SaveAs(ms);
            var b64 = Convert.ToBase64String(ms.ToArray());
            await JS.InvokeVoidAsync("downloadFileWithPicker", name, b64,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        finally { _exporting = false; }
    }

    private List<JafzaProductionSummaryRow> FilteredSummaryRows()
    {
        if (string.IsNullOrWhiteSpace(_search)) return _summaryRows;
        var term = _search.Trim();
        return _summaryRows.Where(r => Matches(r.Division, term) || Matches(r.Username, term)).ToList();
    }

    private List<JafzaProductionDetailRow> FilteredDetailRows()
    {
        if (string.IsNullOrWhiteSpace(_search)) return _detailRows;
        var term = _search.Trim();
        return _detailRows.Where(r =>
            Matches(r.UPC, term) ||
            Matches(r.Username, term) ||
            Matches(r.GroupCode, term) ||
            Matches(r.Division, term) ||
            Matches(r.OraPoNo, term)).ToList();
    }

    private List<JafzaRoboProductionSummaryRow> FilteredRoboSummaryRows()
    {
        if (string.IsNullOrWhiteSpace(_search)) return _roboSummaryRows;
        var term = _search.Trim();
        return _roboSummaryRows.Where(r => Matches(r.Division, term) || Matches(r.Username, term)).ToList();
    }

    private List<JafzaRoboProductionDetailRow> FilteredRoboDetailRows()
    {
        if (string.IsNullOrWhiteSpace(_search)) return _roboDetailRows;
        var term = _search.Trim();
        return _roboDetailRows.Where(r =>
            Matches(r.ItemCode, term) ||
            Matches(r.Username, term) ||
            Matches(r.GroupCode, term) ||
            Matches(r.GroupName, term) ||
            Matches(r.Division, term)).ToList();
    }

    private static bool Matches(string? value, string term) =>
        !string.IsNullOrEmpty(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);

    private static string FmtDate(DateTime d) => d.ToString("dd-MMM-yyyy");
    private static string FmtNullableDate(DateTime? d) => d.HasValue ? d.Value.ToString("dd-MMM-yyyy") : "";
}
