@code {
    protected override async Task OnInitializedAsync()
    {
        await LoadTotalsAsync();
        try { _weeks = await Svc.GetAvailableWeeksAsync(); }
        catch (Exception ex) { Logger.LogWarning(ex, "JafzaDivisionProduction: failed to load available weeks"); }
    }

    private string _source = "Manual";
    private string _view = "Summary";
    private DateTime _from = DateTime.Today;
    private DateTime _to   = DateTime.Today;
    private string _username = "";
    private bool _loading;
    private bool _exporting;
    private string _message = "";
    private bool _isError;
    private string _search = "";
    private HashSet<string> _selectedDivisions = new(StringComparer.OrdinalIgnoreCase);
    private List<JafzaWeekOption> _weeks = new();
    private int? _selectedWeek;
    private List<JafzaProductionSummaryRow> _summaryRows = new();
    private List<JafzaProductionDetailRow>  _detailRows  = new();
    private List<JafzaRoboProductionSummaryRow> _roboSummaryRows = new();
    private List<JafzaRoboProductionDetailRow>  _roboDetailRows  = new();
    private List<JafzaExportProductionRow>  _exportRows  = new();
    private List<JafzaBoxGrnSummaryRow> _boxGrnSummaryRows = new();
    private List<JafzaBoxGrnDetailRow>  _boxGrnDetailRows  = new();

    // Manual/Robo/Export/Box GRN total-qty summary cards — shown regardless of
    // which Source is currently selected, refreshed alongside every Load so
    // they always reflect the current From/To (Username only affects Manual/Robo).
    private bool _totalsLoading;
    private int _manualTotal, _roboTotal, _exportTotal, _boxGrnTotal, _boxGrnBoxCountTotal;

    private bool IsRangeValid => _from <= _to && (_to - _from).TotalDays <= 6;

    private int CurrentRowCount => (_source, _view) switch
    {
        ("Manual", "Summary") => _summaryRows.Count,
        ("Manual", _)         => _detailRows.Count,
        ("Robo", "Summary")   => _roboSummaryRows.Count,
        ("Robo", _)           => _roboDetailRows.Count,
        ("BoxGrn", "Summary") => _boxGrnSummaryRows.Count,
        ("BoxGrn", _)         => _boxGrnDetailRows.Count,
        _                     => _exportRows.Count
    };

    // Switching Source or Report type re-runs the same From/To/Username search
    // automatically — no need to click Load again, same as the Production
    // Summary Report's Summary/Detailed toggle. The 7-day cap already keeps
    // Detailed's result size bounded, so unlike Counting Completion Report
    // this doesn't need a narrower-filter guard before auto-reloading.
    private async Task SetSource(string source)
    {
        _source = source;
        if (IsRangeValid) await LoadAsync();
    }

    private async Task SetView(string view)
    {
        _view = view;
        if (IsRangeValid) await LoadAsync();
    }

    // A selected Week supersedes manual From/To — sets them to that week's
    // OTSDate..OTSDate+6 range (disabling the date inputs in the UI) and
    // reloads. Clearing the Week selection re-enables manual date entry.
    private async Task SetWeek(string weekValue)
    {
        if (string.IsNullOrEmpty(weekValue) || !int.TryParse(weekValue, out var wk))
        {
            _selectedWeek = null;
            return;
        }
        var week = _weeks.FirstOrDefault(w => w.Wk == wk);
        if (week is null) return;

        _selectedWeek = wk;
        _from = week.WeekStart;
        _to   = week.WeekEnd;
        if (IsRangeValid) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!IsRangeValid) return;
        _loading = true; _message = ""; _isError = false;
        _summaryRows = new(); _detailRows = new();
        _roboSummaryRows = new(); _roboDetailRows = new();
        _exportRows = new();
        _boxGrnSummaryRows = new(); _boxGrnDetailRows = new();
        try
        {
            if (_source == "Manual")
            {
                if (_view == "Summary")
                {
                    _summaryRows = await Svc.GetSummaryAsync(_from, _to, _username);
                    if (_summaryRows.Count == 0) _message = "No rows for the selected filters.";
                }
                else
                {
                    _detailRows = await Svc.GetDetailAsync(_from, _to, _username);
                    if (_detailRows.Count == 0) _message = "No rows for the selected filters.";
                }
            }
            else if (_source == "Robo")
            {
                if (_view == "Summary")
                {
                    _roboSummaryRows = await RoboSvc.GetSummaryAsync(_from, _to, _username);
                    if (_roboSummaryRows.Count == 0) _message = "No rows for the selected filters.";
                }
                else
                {
                    _roboDetailRows = await RoboSvc.GetDetailAsync(_from, _to, _username);
                    if (_roboDetailRows.Count == 0) _message = "No rows for the selected filters.";
                }
            }
            else if (_source == "BoxGrn")
            {
                if (_view == "Summary")
                {
                    _boxGrnSummaryRows = await BoxGrnSvc.GetSummaryAsync(_from, _to);
                    if (_boxGrnSummaryRows.Count == 0) _message = "No rows for the selected filters.";
                }
                else
                {
                    _boxGrnDetailRows = await BoxGrnSvc.GetDetailAsync(_from, _to);
                    if (_boxGrnDetailRows.Count == 0) _message = "No rows for the selected filters.";
                }
            }
            else
            {
                _exportRows = await ExportSvc.GetSummaryAsync(_from, _to);
                if (_exportRows.Count == 0) _message = "No rows for the selected filters.";
            }

            // Sequential, not concurrent, with the main fetch above — running both at
            // once fires two simultaneous connections at the narrow-scope JafazaRoboDb
            // server, which has been seen to trip a transient "network path not found"
            // error on one of them under that contention.
            await LoadTotalsAsync();
        }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
        finally { _loading = false; }
    }

    // Each total is fetched and caught independently — a failure in one source
    // (e.g. Robo's connection not configured in this environment) must not zero
    // out the other two, which is what a single try/catch around Task.WhenAll
    // would do.
    private async Task LoadTotalsAsync()
    {
        // No forced StateHasChanged here — an immediate re-render while a
        // MudSelect popup click is still being processed regenerates
        // AvailableDivisions() (a brand-new list every call) and was found to
        // reset the popup's just-applied checkbox toggle, making single clicks
        // appear to not register. The natural render after the click handler
        // returns is enough; only the finally-block StateHasChanged below
        // (after the fetch settles) is needed to flip the cards out of "...".
        _totalsLoading = true;
        try
        {
            await Task.WhenAll(
                LoadOneTotalAsync("Manual", () => Svc.GetTotalQtyAsync(_from, _to, _username, _selectedDivisions), v => _manualTotal = v),
                LoadOneTotalAsync("Robo",   () => RoboSvc.GetTotalQtyAsync(_from, _to, _username, _selectedDivisions), v => _roboTotal = v),
                LoadOneTotalAsync("Export", () => ExportSvc.GetTotalQtyAsync(_from, _to, _selectedDivisions), v => _exportTotal = v),
                LoadOneTotalAsync("BoxGrn", () => BoxGrnSvc.GetTotalQtyAsync(_from, _to, _selectedDivisions), v => _boxGrnTotal = v),
                LoadOneTotalAsync("BoxGrnBoxes", () => BoxGrnSvc.GetTotalBoxCountAsync(_from, _to, _selectedDivisions), v => _boxGrnBoxCountTotal = v));
        }
        finally
        {
            _totalsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadOneTotalAsync(string label, Func<Task<int>> fetch, Action<int> assign)
    {
        try { assign(await fetch()); }
        catch (Exception ex)
        {
            // Summary cards are best-effort — a failure in one shouldn't block the
            // other two or the main report, but it must be visible somewhere rather
            // than silently leaving that card at 0.
            Logger.LogWarning(ex, "JafzaDivisionProduction: failed to load {Label} total", label);
        }
    }

