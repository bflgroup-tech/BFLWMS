@* Renders one Dashboard KPI-tile + reconciliation-bucket block (used by
   EcomStockVarianceReport.razor for the combined view, and again for each of
   UAE/KSA below it — same layout, just a different pre-filtered dataset). *@
@using Wms.Data.Lpm

@if (Summary is not null)
{
    <div class="aiwms-section">
        @if (!string.IsNullOrEmpty(Title))
        {
            <div class="aiwms-card-header">@Title</div>
        }
        <div style="display:grid; grid-template-columns: repeat(4, 1fr); gap:12px;">
            <div style="background:#fbe4e6; border-radius:var(--r-sm); padding:14px;">
                <div style="font-size:11px; font-weight:700; color:#8a3b42; text-transform:uppercase;">MFCS SOH</div>
                <div style="font-size:24px; font-weight:700; color:var(--bfl-black); margin:4px 0;">@Summary.MfcsSoh.ToString("N0")</div>
                <div style="font-size:11px; color:var(--text-secondary);">Units recorded in MFCS</div>
            </div>
            <div style="background:#dcefe0; border-radius:var(--r-sm); padding:14px;">
                <div style="font-size:11px; font-weight:700; color:#2f6b3a; text-transform:uppercase;">INCREFF SOH</div>
                <div style="font-size:24px; font-weight:700; color:var(--bfl-black); margin:4px 0;">@Summary.IncreffSoh.ToString("N0")</div>
                <div style="font-size:11px; color:var(--text-secondary);">Units recorded in Increff</div>
            </div>
            <div style="background:#dbe7f7; border-radius:var(--r-sm); padding:14px;">
                <div style="font-size:11px; font-weight:700; color:#2c4f80; text-transform:uppercase;">Net Variance</div>
                <div style="font-size:24px; font-weight:700; color:var(--bfl-black); margin:4px 0;">@Summary.NetVariance.ToString("N0")</div>
                <div style="font-size:11px; color:var(--text-secondary);">Positive = MFCS higher</div>
            </div>
            <div style="background:#fdf1d3; border-radius:var(--r-sm); padding:14px;">
                <div style="font-size:11px; font-weight:700; color:#8a6d1f; text-transform:uppercase;">Net Variance %</div>
                <div style="font-size:24px; font-weight:700; color:var(--bfl-black); margin:4px 0;">@Summary.NetVariancePercent.ToString("N1")%</div>
                <div style="font-size:11px; color:var(--text-secondary);">Net gap as % of Increff</div>
            </div>
            <div style="background:#fbe6d4; border-radius:var(--r-sm); padding:14px;">
                <div style="font-size:11px; font-weight:700; color:#8a4f1f; text-transform:uppercase;">Gross Gap</div>
                <div style="font-size:24px; font-weight:700; color:var(--bfl-black); margin:4px 0;">@Summary.GrossGap.ToString("N0")</div>
                <div style="font-size:11px; color:var(--text-secondary);">Absolute bucket variance</div>
            </div>
            <div style="background:#e9dcf5; border-radius:var(--r-sm); padding:14px;">
                <div style="font-size:11px; font-weight:700; color:#5b3b82; text-transform:uppercase;">Variance SKU Count</div>
                <div style="font-size:24px; font-weight:700; color:var(--bfl-black); margin:4px 0;">@Summary.VarianceSkuCount.ToString("N0")</div>
                <div style="font-size:11px; color:var(--text-secondary);">SKUs requiring reconciliation</div>
            </div>
            <div style="background:#dcefe0; border-radius:var(--r-sm); padding:14px;">
                <div style="font-size:11px; font-weight:700; color:#2f6b3a; text-transform:uppercase;">Exact-Match SKU %</div>
                <div style="font-size:24px; font-weight:700; color:var(--bfl-black); margin:4px 0;">@Summary.ExactMatchSkuPercent.ToString("N1")%</div>
                <div style="font-size:11px; color:var(--text-secondary);">Positive-stock exact matches</div>
            </div>
            <div style="background:#dbe7f7; border-radius:var(--r-sm); padding:14px;">
                <div style="font-size:11px; font-weight:700; color:#2c4f80; text-transform:uppercase;">Rows Reviewed</div>
                <div style="font-size:24px; font-weight:700; color:var(--bfl-black); margin:4px 0;">@Summary.RowsReviewed.ToString("N0")</div>
                <div style="font-size:11px; color:var(--text-secondary);">Complete detail population</div>
            </div>
        </div>
    </div>

    @if (Buckets is { Count: > 0 })
    {
        <div class="aiwms-section">
            <div class="aiwms-card-header">Net Variance by Reconciliation Bucket@(string.IsNullOrEmpty(Title) ? "" : $" — {Title}")</div>
            <div style="overflow-x:auto">
            <table class="aiwms-table aiwms-table-dense">
                <thead>
                    <tr>
                        <th>Bucket</th>
                        <th style="text-align:right">SKU Count</th>
                        <th style="text-align:right">MFCS SOH</th>
                        <th style="text-align:right">Increff SOH</th>
                        <th style="text-align:right">Net Variance</th>
                        <th style="text-align:right">Gross Gap Share</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Buckets)
                    {
                        <tr>
                            <td>@b.Bucket</td>
                            <td style="text-align:right">@b.SkuCount.ToString("N0")</td>
                            <td style="text-align:right">@b.MfcsSoh.ToString("N0")</td>
                            <td style="text-align:right">@b.IncreffSoh.ToString("N0")</td>
                            <td style="text-align:right; color:@(b.NetVariance > 0 ? "var(--s-active)" : b.NetVariance < 0 ? "#b3261e" : "inherit")">@b.NetVariance.ToString("N0")</td>
                            <td style="text-align:right">@b.GrossGapSharePercent.ToString("N1")%</td>
                        </tr>
                    }
                    <tr style="font-weight:700; background:var(--surface-1, #f7f7f5);">
                        <td>TOTAL / RECONCILED</td>
                        <td style="text-align:right">@Buckets.Sum(b => b.SkuCount).ToString("N0")</td>
                        <td style="text-align:right">@Buckets.Sum(b => b.MfcsSoh).ToString("N0")</td>
                        <td style="text-align:right">@Buckets.Sum(b => b.IncreffSoh).ToString("N0")</td>
                        <td style="text-align:right">@Buckets.Sum(b => b.NetVariance).ToString("N0")</td>
                        <td style="text-align:right">@Buckets.Sum(b => b.GrossGapSharePercent).ToString("N1")%</td>
                    </tr>
                </tbody>
            </table>
            </div>
        </div>
    }
}

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public EcomStockVarianceDashboardSummary? Summary { get; set; }
    [Parameter] public List<EcomStockVarianceReconciliationBucket>? Buckets { get; set; }
}
