@page "/reports/sync-data-count"
@rendermode RenderMode.InteractiveServer
@using Wms.Data.Lpm
@using Wms.Core
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = MenuKeys.RPT_SYNC_DATA_COUNT)]
@inject SyncDataCountService Svc

<PageTitle>Sync Data Count</PageTitle>

<div class="aiwms-page-header">
    <h1 class="aiwms-page-title">Sync Data Count</h1>
</div>

<div class="aiwms-filter-bar" style="display:flex; flex-wrap:wrap; gap:16px; align-items:flex-end; margin-bottom:20px;">
    <div>
        <label class="aiwms-filter-label">DATE</label>
        <input type="date" @bind="_date" @bind:format="yyyy-MM-dd"
               style="width:160px; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
    </div>
    <button class="aiwms-btn aiwms-btn-primary" @onclick="LoadAsync" disabled="@_loading">
        @(_loading ? "Loading…" : "Load")
    </button>
    <span style="font-size:12px; color:gray;">clicks: @_clicks</span>
</div>

<p style="font-size:14px; white-space:pre-wrap; margin-top:8px;">@_message</p>

@code {
    private DateTime _date    = DateTime.Today.AddDays(-1);
    private bool     _loading = false;
    private string   _message = "Select a date and click Load.";
    private int      _clicks  = 0;

    private async Task LoadAsync()
    {
        _clicks++;
        _loading = true;
        _message = $"Querying… (click #{_clicks})";
        await Task.Yield(); // let Blazor render "Loading…" before the query starts

        try
        {
            var count = await Svc.GetUpcBoxKsaCountAsync(_date);
            _message = $"KSA upcboxhead on {_date:yyyy-MM-dd}: {count:N0}";
        }
        catch (Exception ex)
        {
            _message = $"Error: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }
}
