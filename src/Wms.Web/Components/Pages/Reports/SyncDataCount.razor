@page "/reports/sync-data-count"
@rendermode RenderMode.InteractiveServer
@using Wms.Data.Lpm
@using Wms.Core
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = MenuKeys.RPT_SYNC_DATA_COUNT)]
@inject SyncDataCountService Svc

<PageTitle>Sync Data Count</PageTitle>

<div class="aiwms-page-header">
    <h1 class="aiwms-page-title">Sync Data Count</h1>
    <p class="aiwms-page-subtitle">HO vs Regional record counts per country</p>
</div>

<div class="aiwms-filter-bar" style="display:flex; flex-wrap:wrap; gap:16px; align-items:flex-end; margin-bottom:20px;">
    <div>
        <label class="aiwms-filter-label">DATE</label>
        <input type="date" @bind="_date" @bind:format="yyyy-MM-dd"
               style="width:160px; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
    </div>
    <button class="aiwms-btn aiwms-btn-primary" @onclick="LoadAsync" disabled="@_loading">
        @(_loading ? "Loading…" : "Load")
    </button>
</div>

@if (_error is not null)
{
    <div class="aiwms-alert aiwms-alert-error" style="margin-bottom:16px;">@_error</div>
}

@if (_rows is not null)
{
    <div style="overflow-x:auto;">
        <table class="aiwms-table" style="min-width:700px; font-size:12px;">
            <thead>
                <tr>
                    <th rowspan="2" style="width:160px; vertical-align:bottom;">Description</th>
                    @foreach (var country in SyncDataCountService.AllCountries)
                    {
                        <th colspan="2" style="text-align:center; border-left:2px solid var(--border-default);">@country</th>
                    }
                </tr>
                <tr>
                    @foreach (var country in SyncDataCountService.AllCountries)
                    {
                        <th style="text-align:right; border-left:2px solid var(--border-default); font-weight:normal;">Regional</th>
                        <th style="text-align:right; font-weight:normal;">HO</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr>
                        <td style="font-size:11px;">@row.Description</td>
                        @foreach (var country in SyncDataCountService.AllCountries)
                        {
                            var c = row.Countries.GetValueOrDefault(country);
                            var mismatch = c?.Regional.HasValue == true && c?.HO.HasValue == true && c.Regional != c.HO;
                            <td style="text-align:right; font-variant-numeric:tabular-nums; border-left:2px solid var(--border-default); @(c?.RegionalError is not null ? "color:orange;" : mismatch ? "color:var(--color-error,#c00); background:#fff0f0; font-weight:600;" : "")">
                                @if (c?.RegionalError is not null) { <span title="@c.RegionalError">⚠</span> }
                                else if (c?.Regional is not null) { @c.Regional.Value.ToString("N0") }
                                else { <span style="color:gray;">–</span> }
                            </td>
                            <td style="text-align:right; font-variant-numeric:tabular-nums; @(c?.HoError is not null ? "color:orange;" : mismatch ? "color:var(--color-error,#c00); background:#fff0f0; font-weight:600;" : "")">
                                @if (c?.HoError is not null) { <span title="@c.HoError">⚠</span> }
                                else if (c?.HO is not null) { @c.HO.Value.ToString("N0") }
                                else { <span style="color:gray;">–</span> }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private DateTime           _date    = DateTime.Today.AddDays(-1);
    private bool               _loading = false;
    private string?            _error;
    private List<SyncRowMulti>? _rows;

    private async Task LoadAsync()
    {
        _loading = true;
        _error   = null;
        _rows    = null;
        await Task.Yield();
        try
        {
            _rows = await Svc.GetMultiCountryAsync(_date);
        }
        catch (Exception ex)
        {
            _error = $"Load failed: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }
}
