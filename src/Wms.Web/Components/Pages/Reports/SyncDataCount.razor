@page "/reports/sync-data-count"
@rendermode RenderMode.InteractiveServer
@using Wms.Data.Lpm
@using Wms.Core
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = MenuKeys.RPT_SYNC_DATA_COUNT)]
@inject SyncDataCountService Svc

<PageTitle>Sync Data Count</PageTitle>

<div class="aiwms-page-header">
    <div style="display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:16px;">
        <div style="display:flex; flex-wrap:wrap; align-items:center; gap:12px;">
            <h1 class="aiwms-page-title" style="margin:0;">Sync Data Count</h1>
            <span style="background:var(--surface-muted); border:1px solid var(--border-default); border-radius:var(--r-sm); padding:4px 10px; font-size:12px; color:var(--text-secondary);">HO vs Regional record counts per country</span>
        </div>
        <div style="display:flex; align-items:center; gap:8px;">
            <label class="aiwms-filter-label" style="margin:0;">DATE</label>
            <input type="date" @bind="_date" @bind:format="yyyy-MM-dd"
                   style="width:150px; padding:6px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
            <button class="aiwms-btn aiwms-btn-primary" @onclick="LoadAsync" disabled="@_loading">
                @(_loading ? "Loading…" : "Load")
            </button>
        </div>
    </div>
</div>

@if (_error is not null)
{
    <div class="aiwms-alert aiwms-alert-error" style="margin-bottom:16px;">@_error</div>
}

@if (_rows is not null)
{
    <div style="overflow-x:auto; margin-top:12px;">
        <table class="aiwms-table" style="min-width:700px; font-size:13px;">
            <thead>
                <tr>
                    <th rowspan="2" style="width:160px; vertical-align:bottom;">Tables</th>
                    @foreach (var country in SyncDataCountService.AllCountries)
                    {
                        <th colspan="2" style="text-align:center; border-left:2px solid var(--border-default); font-size:10px; padding:5px 8px;">@country</th>
                    }
                </tr>
                <tr>
                    @foreach (var country in SyncDataCountService.AllCountries)
                    {
                        <th style="text-align:right; border-left:2px solid var(--border-default); font-weight:normal; font-size:9px; padding:5px 8px;">Regional</th>
                        <th style="text-align:right; font-weight:normal; font-size:9px; padding:5px 8px;">HO</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr>
                        <td style="font-size:12px;">@row.Description</td>
                        @foreach (var country in SyncDataCountService.AllCountries)
                        {
                            var c = row.Countries.GetValueOrDefault(country);
                            var mismatch = c?.Regional.HasValue == true && c?.HO.HasValue == true && c.Regional != c.HO;
                            <td style="text-align:right; font-variant-numeric:tabular-nums; border-left:2px solid var(--border-default); @(c?.RegionalError is not null ? "color:orange;" : mismatch ? "color:#b00; background:#ffd5d5; font-weight:600;" : "")">
                                @if (c?.RegionalError is not null) { <span title="@c.RegionalError">⚠</span> }
                                else if (c?.Regional is not null) { @c.Regional.Value.ToString("N0") }
                                else { <span style="color:gray;">–</span> }
                            </td>
                            <td style="text-align:right; font-variant-numeric:tabular-nums; @(c?.HoError is not null ? "color:orange;" : mismatch ? "color:#b00; background:#ffd5d5; font-weight:600;" : "")">
                                @if (c?.HoError is not null) { <span title="@c.HoError">⚠</span> }
                                else if (c?.HO is not null) { @c.HO.Value.ToString("N0") }
                                else { <span style="color:gray;">–</span> }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private DateTime           _date    = DateTime.Today.AddDays(-1);
    private bool               _loading = false;
    private string?            _error;
    private List<SyncRowMulti>? _rows;

    private async Task LoadAsync()
    {
        _loading = true;
        _error   = null;
        _rows    = null;
        await Task.Yield();
        try
        {
            _rows = await Svc.GetMultiCountryAsync(_date);
        }
        catch (Exception ex)
        {
            _error = $"Load failed: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }
}
