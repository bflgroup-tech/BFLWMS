@page "/reports/sync-data-count"
@using Wms.Data.Lpm
@using Wms.Core
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = MenuKeys.RPT_SYNC_DATA_COUNT)]
@inject SyncDataCountService Svc

<PageTitle>Sync Data Count</PageTitle>

<div class="aiwms-page-header">
    <h1 class="aiwms-page-title">Sync Data Count</h1>
    <p class="aiwms-page-subtitle">Compare record counts between HO (UAE) and Regional servers</p>
</div>

<div class="aiwms-filter-bar" style="display:flex; flex-wrap:wrap; gap:16px; align-items:flex-end; margin-bottom:20px;">
    <div>
        <label class="aiwms-filter-label">COUNTRY</label>
        <select @bind="_country" style="width:160px; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;">
            @foreach (var c in _countries) { <option value="@c">@c</option> }
        </select>
    </div>
    <div>
        <label class="aiwms-filter-label">DATE FROM</label>
        <input type="date" @bind="_dateFrom" @bind:format="yyyy-MM-dd"
               style="width:150px; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
    </div>
    <div>
        <label class="aiwms-filter-label">DATE TO</label>
        <input type="date" @bind="_dateTo" @bind:format="yyyy-MM-dd"
               style="width:150px; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
    </div>
    <button class="aiwms-btn aiwms-btn-primary" @onclick="LoadAsync"
            disabled="@(_loading || string.IsNullOrEmpty(_country))">
        @(_loading ? "Loading…" : "Load")
    </button>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="aiwms-alert aiwms-alert-error" style="margin-bottom:16px;">@_error</div>
}

@if (_rows is not null || _loaded)
{
    <div style="overflow-x:auto;">
        <table class="aiwms-table" style="min-width:420px;">
            <thead>
                <tr>
                    <th style="width:220px;">Description</th>
                    <th style="text-align:right; width:100px;">Regional</th>
                    <th style="text-align:right; width:100px;">HO</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in (_rows ?? new()))
                {
                    var mismatch = r.Regional.HasValue && r.HO.HasValue && r.Regional != r.HO;
                    <tr style="@(mismatch ? "background:var(--color-error-subtle, #fff0f0);" : "")">
                        <td>@r.Description</td>
                        <td style="text-align:right; font-variant-numeric:tabular-nums; @(mismatch ? "color:var(--color-error,#c00);" : "") @(r.RegionalError is not null ? "color:orange;" : "")">
                            @if (r.RegionalError is not null)
                            {
                                <span title="@r.RegionalError">⚠ ERR</span>
                            }
                            else
                            {
                                @(r.Regional?.ToString("N0") ?? "–")
                            }
                        </td>
                        <td style="text-align:right; font-variant-numeric:tabular-nums; @(mismatch ? "color:var(--color-error,#c00);" : "") @(r.HoError is not null ? "color:orange;" : "")">
                            @if (r.HoError is not null)
                            {
                                <span title="@r.HoError">⚠ ERR</span>
                            }
                            else
                            {
                                @(r.HO?.ToString("N0") ?? "–")
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<string> _countries = new();
    private List<SyncRow>? _rows;
    private string  _country  = "";
    private DateTime _dateFrom = DateTime.Today.AddDays(-1);
    private DateTime _dateTo   = DateTime.Today.AddDays(-1);
    private bool    _loading;
    private bool    _loaded;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _countries = await Svc.GetCountriesAsync();
            if (_countries.Count > 0) _country = _countries[0];
        }
        catch (Exception ex) { _error = $"Could not load countries: {ex.Message}"; }
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrEmpty(_country)) return;
        _loading = true;
        _loaded  = false;
        _error   = null;
        _rows    = null;
        StateHasChanged();
        try
        {
            _rows = await Svc.GetCountsAsync(new SyncFilter(_country, _dateFrom, _dateTo));
        }
        catch (Exception ex)
        {
            _error = $"Load failed: {ex.Message}";
        }
        finally
        {
            _loading = false;
            _loaded  = true;
            StateHasChanged();
        }
    }
}
