@page "/reports/sync-data-count"
@using Wms.Data.Lpm
@using Wms.Core
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = MenuKeys.RPT_SYNC_DATA_COUNT)]
@inject SyncDataCountService Svc

<PageTitle>Sync Data Count</PageTitle>

<div class="aiwms-page-header">
    <h1 class="aiwms-page-title">Sync Data Count</h1>
</div>

<div class="aiwms-filter-bar" style="display:flex; flex-wrap:wrap; gap:16px; align-items:flex-end; margin-bottom:20px;">
    <div>
        <label class="aiwms-filter-label">DATE</label>
        <input type="date" @bind="_date" @bind:format="yyyy-MM-dd"
               style="width:160px; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
    </div>
    <button class="aiwms-btn aiwms-btn-primary" @onclick="LoadAsync" disabled="@_loading">
        @(_loading ? "Loading…" : "Load")
    </button>
</div>

@if (_loaded)
{
    <table class="aiwms-table" style="max-width:500px;">
        <thead>
            <tr>
                <th>Table</th>
                <th style="text-align:right;">HO (OnPremBackup)</th>
                <th style="text-align:right;">Regional (KSA)</th>
            </tr>
        </thead>
        <tbody>
            <tr style="@(_hoCount.HasValue && _regCount.HasValue && _hoCount != _regCount ? "background:#fff0f0;" : "")">
                <td>UPC Box</td>
                <td style="text-align:right; @(_hoError is not null ? "color:orange;" : "")">
                    @if (_hoError is not null)
                    { <span title="@_hoError">⚠ @_hoError</span> }
                    else
                    { @(_hoCount?.ToString("N0") ?? "–") }
                </td>
                <td style="text-align:right; @(_regError is not null ? "color:orange;" : "")">
                    @if (_regError is not null)
                    { <span title="@_regError">⚠ @_regError</span> }
                    else
                    { @(_regCount?.ToString("N0") ?? "–") }
                </td>
            </tr>
        </tbody>
    </table>
}

@code {
    private DateTime _date     = DateTime.Today.AddDays(-1);
    private bool     _loading  = false;
    private bool     _loaded   = false;
    private int?     _hoCount;
    private int?     _regCount;
    private string?  _hoError;
    private string?  _regError;

    private async Task LoadAsync()
    {
        _loading = true;
        _loaded  = false;
        StateHasChanged();
        try
        {
            var result = await Svc.GetUpcBoxCountAsync(_date);
            _hoCount  = result.Ho;
            _hoError  = result.HoError;
            _regCount = result.Regional;
            _regError = result.RegionalError;
            _loaded   = true;
        }
        catch (Exception ex)
        {
            _hoError  = ex.Message;
            _regError = ex.Message;
            _loaded   = true;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }
}
