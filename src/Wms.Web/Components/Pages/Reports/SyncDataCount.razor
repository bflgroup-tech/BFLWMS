@page "/reports/sync-data-count"
@rendermode RenderMode.InteractiveServer
@using Wms.Data.Lpm
@using Wms.Core
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = MenuKeys.RPT_SYNC_DATA_COUNT)]
@inject SyncDataCountService Svc

<PageTitle>Sync Data Count</PageTitle>

<div class="aiwms-page-header">
    <h1 class="aiwms-page-title">Sync Data Count</h1>
    <p class="aiwms-page-subtitle">Compare record counts between HO (OnPremBackup) and Regional servers</p>
</div>

<div class="aiwms-filter-bar" style="display:flex; flex-wrap:wrap; gap:16px; align-items:flex-end; margin-bottom:20px;">
    <div>
        <label class="aiwms-filter-label">DATE FROM</label>
        <input type="date" @bind="_dateFrom" @bind:format="yyyy-MM-dd"
               style="width:160px; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
    </div>
    <div>
        <label class="aiwms-filter-label">DATE TO</label>
        <input type="date" @bind="_dateTo" @bind:format="yyyy-MM-dd"
               style="width:160px; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
    </div>
    <div>
        <label class="aiwms-filter-label">COUNTRY</label>
        <select @bind="_country" style="width:140px; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;">
            @foreach (var c in _countries) { <option value="@c">@c</option> }
        </select>
    </div>
    <button class="aiwms-btn aiwms-btn-primary" @onclick="LoadAsync"
            disabled="@(_loading || string.IsNullOrEmpty(_country))">
        @(_loading ? "Loading…" : "Load")
    </button>
</div>

@if (_rows is not null)
{
    <div style="overflow-x:auto;">
        <table class="aiwms-table" style="min-width:480px;">
            <thead>
                <tr>
                    <th style="width:200px;">Table</th>
                    <th style="text-align:right; width:140px;">HO (OnPremBackup)</th>
                    <th style="text-align:right; width:140px;">Regional (@_country)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    var mismatch = r.HO.HasValue && r.Regional.HasValue && r.HO != r.Regional;
                    <tr style="@(mismatch ? "background:var(--color-error-subtle,#fff0f0);" : "")">
                        <td>@r.Description</td>
                        <td style="text-align:right; font-variant-numeric:tabular-nums; @(r.HoError is not null ? "color:orange;" : mismatch ? "color:var(--color-error,#c00);" : "")">
                            @if (r.HoError is not null) { <span title="@r.HoError">⚠ ERR</span> }
                            else { @(r.HO?.ToString("N0") ?? "–") }
                        </td>
                        <td style="text-align:right; font-variant-numeric:tabular-nums; @(r.RegionalError is not null ? "color:orange;" : mismatch ? "color:var(--color-error,#c00);" : "")">
                            @if (r.RegionalError is not null) { <span title="@r.RegionalError">⚠ ERR</span> }
                            else { @(r.Regional?.ToString("N0") ?? "–") }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<string>   _countries = new();
    private string         _country   = "";
    private DateTime       _dateFrom  = DateTime.Today.AddDays(-1);
    private DateTime       _dateTo    = DateTime.Today.AddDays(-1);
    private bool           _loading   = false;
    private List<SyncRow>? _rows;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _countries = await Svc.GetCountriesAsync();
            if (_countries.Count > 0) _country = _countries[0];
        }
        catch { }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _rows    = null;
        await Task.Yield();
        try
        {
            _rows = await Svc.GetCountsAsync(new SyncFilter(_country, _dateFrom, _dateTo));
        }
        catch (Exception ex)
        {
            _rows = SyncDataCountService.AllErrorRows(ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }
}
