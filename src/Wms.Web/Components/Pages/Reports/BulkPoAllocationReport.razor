@page "/reports/bulk-po-allocation"
@rendermode RenderMode.InteractiveServer
@using System.IO
@using ClosedXML.Excel
@using Wms.Core
@using Wms.Data.Lpm
@attribute [Authorize(Policy = MenuKeys.RPT_BULK_PO_ALLOCATION)]
@inject BulkPoAllocationService Svc
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>WMS — Bulk PO Allocation Report</PageTitle>

<div class="aiwms-page-header">
    <h2>Bulk PO Allocation Report</h2>
    <p>
        Allocated quantity, share of the PO, and the configured ceiling — per country, for each
        (Container, PO, Division). <b>Alloc %</b> is against the <b>PO qty</b> from
        <code>usa..usaorgfile_LPM</code>, not against what was allocated, so blocked and undistributed
        units still count against the share. <b>Ceiling %</b> comes from
        <code>LPM_POAllocationMaxPct</code>, resolved per (Country, DivCode) and falling back to the
        country-wide row (DivCode 0); blank means no cap is configured, which is not the same as a cap of zero.
        A share above its ceiling is highlighted.
    </p>
</div>

<div class="aiwms-section" style="padding:10px 16px;">
    <div style="display:flex; flex-wrap:wrap; gap:12px; align-items:flex-end;">
        <div style="flex:0 0 230px;">
            <label class="aiwms-filter-label">BATCH</label>
            @* No @bind:after — changing the batch arms the Load button, it does not
               run the report. Picking through batches should not fire a query each time. *@
            <select @bind="_batch" disabled="@_loading"
                    style="width:100%; padding:5px 7px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:12px; background:white">
                <option value="">-- Select a batch --</option>
                @foreach (var b in _batches)
                {
                    <option value="@b.BatchNo">#@b.BatchNo — @b.Containers cont (@b.Succeeded ok)</option>
                }
            </select>
        </div>
        <div style="flex:0 0 200px;">
            <label class="aiwms-filter-label">CONTAINER</label>
            <input type="text" @bind="_contno" placeholder="contains…"
                   style="width:100%; padding:5px 7px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:12px; background:white" />
        </div>
        <div style="display:flex; gap:10px;">
            <button class="aiwms-btn aiwms-btn-primary" @onclick="LoadAsync" disabled="@(_loading || BatchNo is null)"
                    title="@(BatchNo is null ? "Pick a batch first" : $"Load the allocation report for batch #{BatchNo}")">
                @(_loading ? "Loading…" : "Load")
            </button>
            <button class="aiwms-btn aiwms-btn-secondary" @onclick="ExportAsync" disabled="@(_loading || _rows.Count == 0)">
                Export to Excel
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="aiwms-alert @(_isError ? "error" : "info")" style="margin-top:12px">@_message</div>
    }
</div>

@if (_rows.Count > 0)
{
    <div class="aiwms-section">
        <div style="overflow:auto; max-height:calc(100vh - 300px);">
            <table class="aiwms-table aiwms-table-dense" style="border-collapse:separate; border-spacing:0;">
                <thead style="position:sticky; top:0; z-index:5; background:var(--bfl-black);">
                    @* Two header rows, matching the sheet: country group over its three measures. *@
                    <tr>
                        <th rowspan="2">Container</th>
                        <th rowspan="2">PO No</th>
                        <th rowspan="2">Division</th>
                        <th rowspan="2" style="text-align:right">PO Qty</th>
                        @foreach (var c in _countries)
                        {
                            <th colspan="3" style="text-align:center; border-left:2px solid var(--bfl-yellow)">@c</th>
                        }
                    </tr>
                    <tr>
                        @foreach (var c in _countries)
                        {
                            <th style="text-align:right; border-left:2px solid var(--bfl-yellow)">Qty</th>
                            <th style="text-align:right">Alloc %</th>
                            <th style="text-align:right">Ceiling %</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _rows)
                    {
                        <tr>
                            <td style="font-family:var(--font-mono)">@r.Container</td>
                            <td>@r.PONo</td>
                            <td style="white-space:normal">@r.Division</td>
                            <td style="text-align:right">@r.PoQty.ToString("N0")</td>
                            @foreach (var c in _countries)
                            {
                                var cell = r.ByCountry.GetValueOrDefault(c);
                                <td style="text-align:right; border-left:2px solid var(--border-default)">@(cell is null ? "" : cell.Qty.ToString("N0"))</td>
                                <td style="text-align:right; @(cell?.OverCeiling == true ? "background:#fee2e2; color:#991b1b; font-weight:700" : "")"
                                    title="@(cell?.OverCeiling == true ? $"{cell.AllocPct:N2}% is above the {cell.CeilingPct:N2}% ceiling for this country/division." : "")">
                                    @(cell is null ? "" : cell.AllocPct.ToString("N2"))
                                </td>
                                <td style="text-align:right; color:var(--text-secondary)">@(cell?.CeilingPct?.ToString("N2") ?? "")</td>
                            }
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr style="font-weight:700; border-top:2px solid var(--border-default)">
                        <td>Total</td>
                        <td></td>
                        <td></td>
                        <td style="text-align:right">@_rows.Sum(r => r.PoQty).ToString("N0")</td>
                        @foreach (var c in _countries)
                        {
                            <td style="text-align:right; border-left:2px solid var(--border-default)">
                                @_rows.Sum(r => r.ByCountry.GetValueOrDefault(c)?.Qty ?? 0).ToString("N0")
                            </td>
                            <td></td>
                            <td></td>
                        }
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

@code {
    private List<BulkPoAllocationReportRow> _rows = new();
    private List<BulkAllocationBatchRow> _batches = new();
    private List<string> _countries = new();

    private string _batch = "";
    private string _contno = "";
    private bool   _loading;
    private string _message = "";
    private bool   _isError;

    private int? BatchNo => int.TryParse(_batch, out var n) ? n : null;

    // Batches only on arrival — the report itself joins the allocation table to
    // usaorgfile_LPM across every container in scope, which is not something to run
    // just because somebody opened the page.
    protected override async Task OnInitializedAsync()
    {
        try { _batches = await Svc.GetBatchesAsync(); }
        catch { _batches = new(); }
        _message = "Pick a batch and press Load.";
        _isError = false;
    }

    private async Task LoadAsync()
    {
        if (BatchNo is null)
        {
            _message = "Pick a batch first."; _isError = true;
            return;
        }
        _loading = true; _message = ""; _isError = false;
        await InvokeAsync(StateHasChanged);
        try
        {
            _rows = await Svc.GetReportAsync(BatchNo, _contno);

            // Columns are whatever the scoped allocations actually reached, in a
            // stable order — a fixed list would go quietly wrong the day a country
            // is added, and ordering by volume would move the columns between runs.
            _countries = _rows.SelectMany(r => r.ByCountry.Keys)
                              .Distinct(StringComparer.OrdinalIgnoreCase)
                              .OrderBy(c => c, StringComparer.OrdinalIgnoreCase)
                              .ToList();

            var over = _rows.Sum(r => r.ByCountry.Values.Count(v => v.OverCeiling));
            _message = _rows.Count == 0
                ? "No allocations for this selection."
                : $"{_rows.Count:N0} row(s) across {_countries.Count} country(ies)." +
                  (over > 0 ? $" {over:N0} country share(s) above ceiling — highlighted." : "");
            _isError = false;
        }
        catch (Exception ex) { _message = $"Load failed: {ex.Message}"; _isError = true; _rows = new(); }
        finally { _loading = false; }
    }

    private async Task ExportAsync()
    {
        using var wb = new XLWorkbook();
        var ws = wb.AddWorksheet("Bulk PO Allocation");

        // Row 1 = country group headers over merged triples; row 2 = the measures.
        ws.Cell(1, 1).Value = "Container"; ws.Range(1, 1, 2, 1).Merge();
        ws.Cell(1, 2).Value = "PO No";     ws.Range(1, 2, 2, 2).Merge();
        ws.Cell(1, 3).Value = "Division";  ws.Range(1, 3, 2, 3).Merge();
        ws.Cell(1, 4).Value = "PO Qty";    ws.Range(1, 4, 2, 4).Merge();

        var col = 5;
        foreach (var c in _countries)
        {
            ws.Cell(1, col).Value = c;
            ws.Range(1, col, 1, col + 2).Merge().Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            ws.Cell(2, col).Value     = "Qty";
            ws.Cell(2, col + 1).Value = "Alloc %";
            ws.Cell(2, col + 2).Value = "Ceiling %";
            col += 3;
        }
        ws.Range(1, 1, 2, col - 1).Style.Font.Bold = true;

        var row = 3;
        foreach (var r in _rows)
        {
            ws.Cell(row, 1).Value = r.Container;
            ws.Cell(row, 2).Value = r.PONo;
            ws.Cell(row, 3).Value = r.Division ?? "";
            ws.Cell(row, 4).Value = r.PoQty;

            col = 5;
            foreach (var c in _countries)
            {
                var cell = r.ByCountry.GetValueOrDefault(c);
                if (cell is not null)
                {
                    ws.Cell(row, col).Value     = cell.Qty;
                    ws.Cell(row, col + 1).Value = cell.AllocPct;
                    if (cell.CeilingPct is not null) ws.Cell(row, col + 2).Value = cell.CeilingPct.Value;
                    if (cell.OverCeiling) ws.Cell(row, col + 1).Style.Fill.BackgroundColor = XLColor.LightPink;
                }
                col += 3;
            }
            row++;
        }

        ws.SheetView.FreezeRows(2);
        ws.Columns().AdjustToContents();

        using var ms = new MemoryStream();
        wb.SaveAs(ms);
        var b64 = Convert.ToBase64String(ms.ToArray());
        var name = $"bulk-po-allocation{(BatchNo is null ? "" : $"-batch{BatchNo}")}-{DateTime.UtcNow.AddHours(4):yyyyMMdd_HHmm}.xlsx";
        await JS.InvokeVoidAsync("eval",
            $"var link=document.createElement('a');link.href='data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{b64}';link.download='{name}';link.click();");
    }
}
