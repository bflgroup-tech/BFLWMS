@page "/reports/cont-counting-production"
@rendermode RenderMode.InteractiveServer
@using Wms.Core
@using Wms.Data.Lpm
@attribute [Authorize(Policy = MenuKeys.RPT_CONT_COUNTING_PROD)]
@inject CountingReportsService Svc
@inject ICurrentUser Me

<PageTitle>WMS â€” Cont Counting Production Report</PageTitle>

<div class="aiwms-page-header">
    <h2>Cont Counting Production Report</h2>
    <p>Non-reversed scans from <code>dbo.WMSContBuildScanData</code> grouped by <b>ContNo Ã— TrnDate Ã— User</b>. Defaults to today.</p>
</div>

<div class="aiwms-section">
    <div style="display:grid; grid-template-columns: 1fr 1fr auto; gap:12px; align-items:end">
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">FROM</label>
            <input type="date" @bind="_from" @bind:format="yyyy-MM-dd" max="@DateTime.Today.ToString("yyyy-MM-dd")"
                   style="width:100%; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
        </div>
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">TO</label>
            <input type="date" @bind="_to" @bind:format="yyyy-MM-dd" max="@DateTime.Today.ToString("yyyy-MM-dd")"
                   style="width:100%; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
        </div>
        <button class="aiwms-btn aiwms-btn-primary" @onclick="LoadAsync" disabled="@(_loading || _to < _from)">@(_loading ? "Loadingâ€¦" : "Load")</button>
    </div>
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="aiwms-alert @(_isError ? "error" : "info")" style="margin-top:12px">@_message</div>
    }
</div>

@if (_rows.Count > 0)
{
    <div class="aiwms-section">
        <div class="aiwms-card-header">@_rows.Count row(s) â€” @_rows.Sum(r => r.Qty).ToString("N0") total scan(s)</div>
        <table class="aiwms-table aiwms-table-dense">
            <thead>
                <tr>
                    <th>ContNo</th>
                    <th>TrnDate</th>
                    <th>User</th>
                    <th style="text-align:right">Qty</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr>
                        <td style="font-family:var(--font-mono)"><b>@r.ContNo</b></td>
                        <td>@r.TrnDate.ToString("dd/MM/yyyy")</td>
                        <td>@r.UserName</td>
                        <td style="text-align:right"><b>@r.Qty.ToString("N0")</b></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private DateTime _from = DateTime.Today;
    private DateTime _to   = DateTime.Today;
    private bool _loading;
    private string _message = "";
    private bool _isError;
    private List<CountingProductionRow> _rows = new();

    private async Task LoadAsync()
    {
        _loading = true; _message = ""; _isError = false;
        try
        {
            await Me.EnsureLoadedAsync();
            _rows = await Svc.GetProductionAsync(_from, _to, Me.Country);
            if (_rows.Count == 0) _message = "No scans in the selected range.";
        }
        catch (Exception ex) { _message = ex.Message; _isError = true; }
        finally { _loading = false; }
    }
}

