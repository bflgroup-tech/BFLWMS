@page "/reports/container-receipt"
@rendermode RenderMode.InteractiveServer
@using System.Text
@using Wms.Core
@using Wms.Data.Lpm
@attribute [Authorize(Policy = MenuKeys.RPT_CONTAINER_RECEIPT)]
@inject ContainerReceiptService Svc
@inject ICurrentUser CurrentUser
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>WMS — Container Receipt Report</PageTitle>

<div class="aiwms-page-header">
    <h2>Container Receipt Report</h2>
    <p>Inbound container receipt history — GIN creation, release, and receipt timing, per country and date range. Sorted by Receipt Date.</p>
</div>

<div class="aiwms-section" style="padding:10px 16px;">
    <div style="display:flex; flex-wrap:wrap; gap:8px; align-items:flex-end;">
        <div style="flex:0 0 160px;">
            <label class="aiwms-filter-label">COUNTRY</label>
            <select @bind="_country" style="width:100%; padding:5px 7px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:12px; background:white">
                <option value="">BFL Group</option>
                @foreach (var c in _countries) { <option value="@c">@c.ToUpperInvariant()</option> }
            </select>
        </div>
        <div style="flex:0 0 170px;">
            <label class="aiwms-filter-label" style="white-space:nowrap;">RECEIPT DATE FROM</label>
            <input type="date" @bind="_dateFrom" @bind:format="yyyy-MM-dd" style="width:100%; padding:5px 7px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:12px; background:white" />
        </div>
        <div style="flex:0 0 170px;">
            <label class="aiwms-filter-label" style="white-space:nowrap;">RECEIPT DATE TO</label>
            <input type="date" @bind="_dateTo" @bind:format="yyyy-MM-dd" style="width:100%; padding:5px 7px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:12px; background:white" />
        </div>
        <div style="display:flex; gap:10px;">
            <button class="aiwms-btn aiwms-btn-primary" @onclick="LoadAsync" disabled="@_loading">
                @(_loading ? "Loading…" : "Load")
            </button>
            <button class="aiwms-btn aiwms-btn-secondary" @onclick="ExportCsvAsync" disabled="@(_loading || _rows.Count == 0)">
                Export to Excel
            </button>
        </div>
        @if (_rows.Count > 0)
        {
            <span style="font-size:12px; color:var(--text-secondary); align-self:center">@_rows.Count rows</span>
        }
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="aiwms-alert @(_isError ? "error" : "info")" style="margin-top:12px">@_message</div>
    }
</div>

@if (_rows.Count > 0)
{
    <div class="aiwms-section">
        <table class="aiwms-table aiwms-table-dense" style="table-layout:fixed; width:100%;">
            <colgroup>
                <col style="width:90px;" />
                <col style="width:80px;" />
                <col style="width:100px;" />
                <col style="width:100px;" />
                <col style="width:130px;" />
                <col style="width:80px;" />
                <col style="width:90px;" />
                <col style="width:110px;" />
                <col style="width:100px;" />
                <col style="width:160px;" />
                <col style="width:110px;" />
                <col style="width:110px;" />
            </colgroup>
            <thead>
                <tr>
                    <th>Country</th>
                    <th>Ginno</th>
                    <th>GINDate</th>
                    <th>ReleasedOn</th>
                    <th style="text-align:right;">GIN to Export Pass</th>
                    <th style="text-align:right;">ShipNo</th>
                    <th style="text-align:right;">TotalQty</th>
                    <th style="text-align:right;">TransferCount</th>
                    <th>ReceiptDt</th>
                    <th style="text-align:right;">ReleasedOn to ReceiptDt</th>
                    <th style="text-align:right;">ReceivedBoxes</th>
                    <th style="text-align:right;">Box Count Diff</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr>
                        <td>@r.Country</td>
                        <td>@r.GinNo</td>
                        <td>@(r.GinDate?.ToString("dd/MM/yyyy") ?? "")</td>
                        <td>@(r.ReleasedOn?.ToString("dd/MM/yyyy") ?? "")</td>
                        <td style="text-align:right;">@r.GinToExportPassDays</td>
                        <td style="text-align:right;">@r.ShipNo</td>
                        <td style="text-align:right;">@r.TotalQty.ToString("N0")</td>
                        <td style="text-align:right;">@r.TransferCount.ToString("N0")</td>
                        <td>@r.ReceiptDt.ToString("dd/MM/yyyy")</td>
                        <td style="text-align:right;">@r.ReleasedOnToReceiptDtDays</td>
                        <td style="text-align:right;">@r.ReceivedBoxes.ToString("N0")</td>
                        <td style="text-align:right;">@r.BoxCountDiff.ToString("N0")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr style="font-weight:600; border-top:2px solid var(--border-default);">
                    <td colspan="6" style="text-align:right;">Total</td>
                    <td style="text-align:right;">@_rows.Sum(r => r.TotalQty).ToString("N0")</td>
                    <td style="text-align:right;">@_rows.Sum(r => r.TransferCount).ToString("N0")</td>
                    <td></td>
                    <td></td>
                    <td style="text-align:right;">@_rows.Sum(r => r.ReceivedBoxes).ToString("N0")</td>
                    <td style="text-align:right;">@_rows.Sum(r => r.BoxCountDiff).ToString("N0")</td>
                </tr>
            </tfoot>
        </table>
    </div>
}

@code {
    private List<ContainerReceiptRow> _rows = new();
    private List<string> _countries = new();

    private string   _country  = "";
    private DateTime _dateFrom = DateTime.Today;
    private DateTime _dateTo   = DateTime.Today;

    private bool   _loading;
    private string _message = "";
    private bool   _isError;

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.EnsureLoadedAsync();
        _countries = await Svc.GetCountriesAsync();

        // Default to the signed-in user's own country when it's one of the report's
        // destinations. UAE (excluded from _countries) and any user with no country
        // fall through to "BFL Group" (_country stays "").
        if (!string.IsNullOrWhiteSpace(CurrentUser.Country) &&
            _countries.Contains(CurrentUser.Country, StringComparer.OrdinalIgnoreCase))
        {
            _country = CurrentUser.Country!;
        }
    }

    private async Task LoadAsync()
    {
        _loading = true; _message = ""; _rows.Clear();
        await InvokeAsync(StateHasChanged);
        try
        {
            var filter = new ContainerReceiptFilter(
                Country:  string.IsNullOrWhiteSpace(_country) ? null : _country,
                DateFrom: _dateFrom,
                DateTo:   _dateTo);

            var result = await Svc.GetContainerReceiptsAsync(filter);
            _rows = result.Rows;

            if (result.Warnings.Count > 0)
                ShowError($"Loaded {_rows.Count} rows. Some countries failed: {string.Join("; ", result.Warnings)}");
            else
                ShowInfo($"Loaded {_rows.Count} rows.");
        }
        catch (Exception ex) { ShowError($"Load failed: {ex.Message}"); }
        finally { _loading = false; }
    }

    private async Task ExportCsvAsync()
    {
        var sb = new StringBuilder();
        sb.AppendLine("Country,Ginno,GINDate,ReleasedOn,GIN to Export Pass,ShipNo,TotalQty,TransferCount,ReceiptDt,ReleasedOn to ReceiptDt,ReceivedBoxes,Box Count Diff");
        foreach (var r in _rows)
            sb.AppendLine($"{Csv(r.Country)},{Csv(r.GinNo)}," +
                          $"{(r.GinDate.HasValue ? r.GinDate.Value.ToString("yyyy-MM-dd") : "")}," +
                          $"{(r.ReleasedOn.HasValue ? r.ReleasedOn.Value.ToString("yyyy-MM-dd") : "")}," +
                          $"{r.GinToExportPassDays},{Csv(r.ShipNo)},{r.TotalQty},{r.TransferCount}," +
                          $"{r.ReceiptDt:yyyy-MM-dd},{r.ReleasedOnToReceiptDtDays},{r.ReceivedBoxes},{r.BoxCountDiff}");
        sb.AppendLine($",,,,,Total,{_rows.Sum(r => r.TotalQty)},{_rows.Sum(r => r.TransferCount)},,,{_rows.Sum(r => r.ReceivedBoxes)},{_rows.Sum(r => r.BoxCountDiff)}");

        var b64      = Convert.ToBase64String(Encoding.UTF8.GetBytes(sb.ToString()));
        var country  = string.IsNullOrWhiteSpace(_country) ? "BFLGroup" : _country;
        var filename = $"ContainerReceipt_{country}_{_dateFrom:yyyyMMdd}_{_dateTo:yyyyMMdd}.csv";
        await JS.InvokeVoidAsync("eval",
            $"(function(){{var a=document.createElement('a');a.href='data:text/csv;base64,{b64}';" +
            $"a.download='{filename}';document.body.appendChild(a);a.click();document.body.removeChild(a);}})();");
    }

    private static string Csv(string? s)
    {
        if (s is null) return "";
        return (s.Contains(',') || s.Contains('"') || s.Contains('\n'))
            ? "\"" + s.Replace("\"", "\"\"") + "\""
            : s;
    }

    private void ShowError(string msg) { _message = msg; _isError = true; }
    private void ShowInfo(string msg)  { _message = msg; _isError = false; }
}
