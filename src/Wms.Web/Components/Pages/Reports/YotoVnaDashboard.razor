@page "/reports/yoto-vna-dashboard"
@rendermode RenderMode.InteractiveServer
@using Wms.Core
@using Wms.Data.Lpm
@using ClosedXML.Excel
@attribute [Authorize(Policy = MenuKeys.RPT_YOTO_VNA_DASHBOARD)]
@inject YotoVnaDashboardService Svc
@inject ICurrentUser CurrentUser
@inject IJSRuntime JS

<style>
    .yvd-header { position: relative; background: var(--bfl-black); color: var(--bfl-yellow); font-family: var(--font-display); font-weight: 800; font-size: 13px; text-transform: uppercase; letter-spacing: .5px; padding: 10px 40px; text-align: center; }
    .yvd-header .aiwms-icon-btn { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); }
    .yvd-total-row td { font-weight: 700; background: #e6f4ea; }
    .yvd-section-banner { text-align: center; background: #dcfce7; color: #14532d; font-family: var(--font-display); font-weight: 800; font-size: 15px; text-transform: uppercase; letter-spacing: .5px; padding: 10px 14px; border-radius: var(--r-sm); margin: 24px 0 8px 0; }
    .yvd-warehouse-badge { display: inline-block; background: var(--bfl-yellow); color: #4a2e00; font-weight: 800; padding: 2px 10px; border-radius: 999px; margin: 0 4px; }
    .aiwms-icon-btn { background: none; border: none; color: inherit; cursor: pointer; padding: 2px 6px; line-height: 1; border-radius: var(--r-sm); }
    .aiwms-icon-btn:hover:not(:disabled) { background: rgba(255,255,255,0.15); }
    .aiwms-icon-btn:disabled { opacity: 0.4; cursor: default; }
    .yvd-export-btn { background: #dcfce7; color: #14532d; border: 1px solid #14532d40; }
    .yvd-export-btn:hover:not(:disabled) { background: #bbf7d0; }
    .yvd-export-btn:disabled { opacity: 0.5; cursor: default; }
</style>

<div class="aiwms-page-header">
    <h2>YOTO VNA Dashboard</h2>
    <p>Inbound offloading progress at YOTO — Total Imports (AEINT) vs. Local Purchased (AELOC), sourced live from usa..UsaPallets/KNBBoxes (completed) and bfldata..ContReceipt (pending).</p>
</div>

<div class="aiwms-section">
    <div style="display:flex; gap:12px; align-items:end; flex-wrap:wrap;">
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">VIEW / WEEK</label>
            <select @bind="_selectedPeriod" style="width:230px; height:36px; box-sizing:border-box; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;">
                <option value="Monthly">Monthly</option>
                <option value="WeeklyAgg">Weekly (all weeks of selected month)</option>
                <option value="Range">Custom date range (max 31 days)</option>
                <optgroup label="Or pick a specific week">
                    @foreach (var w in Weeks)
                    {
                        <option value="W@(w.Num)">W@(w.Num) &middot; @w.Start.ToString("dd-MMM") &rarr; @w.End.ToString("dd-MMM")</option>
                    }
                </optgroup>
            </select>
        </div>
        @if (!IsRange)
        {
            <div>
                <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">YEAR</label>
                <select @bind="_selectedYear" style="width:130px; height:36px; box-sizing:border-box; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;">
                    @foreach (var y in _years)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
            </div>
        }
        @if (IsMonthly || IsWeeklyAgg)
        {
            <div>
                <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">MONTH</label>
                <select @bind="_selectedMonth" style="width:150px; height:36px; box-sizing:border-box; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;">
                    @for (var m = 1; m <= 12; m++)
                    {
                        <option value="@m">@(new DateTime(2000, m, 1).ToString("MMMM"))</option>
                    }
                </select>
            </div>
        }
        @if (IsRange)
        {
            <div>
                <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">FROM</label>
                <input type="date" @bind="_rangeFrom" style="width:150px; height:36px; box-sizing:border-box; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px;" />
            </div>
            <div>
                <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">TO</label>
                <input type="date" @bind="_rangeTo" style="width:150px; height:36px; box-sizing:border-box; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px;" />
            </div>
        }
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">OFFLOADING VIEW</label>
            <div style="display:flex; gap:10px; align-items:center; height:36px;">
                <label style="display:flex; align-items:center; gap:4px; cursor:pointer; font-size:13px;">
                    <input type="radio" name="offloadingView" value="Summary" checked="@(_offloadingView == "Summary")" @onchange="@(() => SetOffloadingViewAsync("Summary"))" /> Summary
                </label>
                <label style="display:flex; align-items:center; gap:4px; cursor:pointer; font-size:13px;">
                    <input type="radio" name="offloadingView" value="Detailed" checked="@(_offloadingView == "Detailed")" @onchange="@(() => SetOffloadingViewAsync("Detailed"))" /> Detailed
                </label>
            </div>
        </div>
        <button class="aiwms-btn aiwms-btn-primary" style="height:36px; box-sizing:border-box" @onclick="LoadAsync" disabled="@(_loading || !IsRangeValid)">@(_loading ? "Loading…" : "Load")</button>
        <button class="aiwms-btn yvd-export-btn" style="height:36px; width:36px; box-sizing:border-box; display:flex; align-items:center; justify-content:center; padding:0;" title="Download all data (one sheet)" @onclick="ExportAllAsync" disabled="@(!_loadedOnce || _exporting)">
            <span class="mi sm">download</span>
        </button>
    </div>
    @if (IsRange && !IsRangeValid)
    {
        <div class="aiwms-alert error" style="margin-top:12px">Date range cannot exceed 31 days.</div>
    }
</div>

@if (_loadedOnce)
{
    <div class="aiwms-section" style="padding:0; overflow:hidden">
        <div class="yvd-header">
            <span>Offloading Shipment Summary — @SelectedPeriodLabel</span>
            @MinimizeToggle(_offloadingCollapsed, () => _offloadingCollapsed = !_offloadingCollapsed)
        </div>
        @if (!_offloadingCollapsed)
        {
        <div style="display:flex; flex-wrap:wrap; gap:0;">
            <div style="flex:1; min-width:340px; overflow-x:auto; border-right:1px solid var(--border-default);">
                @if (IsOffloadingSummary)
                {
                <table class="aiwms-table aiwms-table-dense" style="text-align:center; width:100%;">
                    <thead>
                        <tr><th colspan="4" style="text-align:center">Inbound Shipment Details — Completed offloading@AdminQueryToggle(_showCompletedSummaryQuery, () => _showCompletedSummaryQuery = !_showCompletedSummaryQuery)</th></tr>
                        @QueryRow(_showCompletedSummaryQuery, "Offloading Shipment Summary — Completed offloading", 4)
                        <tr>
                            <th style="text-align:left">Type</th>
                            <th style="text-align:right">Containers</th>
                            <th style="text-align:right">Pallets</th>
                            <th style="text-align:right">Boxes</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="text-align:left">Total Imports AEINT</td>
                            <td style="text-align:right">@CompletedFor("AEINT").Containers.ToString("N0")</td>
                            <td style="text-align:right">@CompletedFor("AEINT").Pallets.ToString("N0")</td>
                            <td style="text-align:right">@CompletedFor("AEINT").Boxes.ToString("N0")</td>
                        </tr>
                        <tr>
                            <td style="text-align:left">Local Purchased AELOC</td>
                            <td style="text-align:right">@CompletedFor("AELOC").Containers.ToString("N0")</td>
                            <td style="text-align:right">@CompletedFor("AELOC").Pallets.ToString("N0")</td>
                            <td style="text-align:right">@CompletedFor("AELOC").Boxes.ToString("N0")</td>
                        </tr>
                        <tr class="yvd-total-row">
                            <td style="text-align:left">Total</td>
                            <td style="text-align:right">@_completed.Sum(r => r.Containers).ToString("N0")</td>
                            <td style="text-align:right">@_completed.Sum(r => r.Pallets).ToString("N0")</td>
                            <td style="text-align:right">@_completed.Sum(r => r.Boxes).ToString("N0")</td>
                        </tr>
                    </tbody>
                </table>
                }
                else
                {
                <table class="aiwms-table aiwms-table-dense" style="text-align:center; width:100%;">
                    <thead>
                        <tr><th colspan="6" style="text-align:center">Inbound Shipment Details — Completed offloading (Detailed, by container)@AdminQueryToggle(_showCompletedDetailQuery, () => _showCompletedDetailQuery = !_showCompletedDetailQuery)</th></tr>
                        @QueryRow(_showCompletedDetailQuery, "Offloading Shipment Summary — Completed offloading (Detailed, by container)", 6)
                        <tr>
                            <th style="text-align:left">Container ID</th>
                            <th style="text-align:right">Sticker Printing Date</th>
                            <th style="text-align:right">No of Pallets</th>
                            <th style="text-align:right">No of BoxNo</th>
                            <th style="text-align:right">Order Qty</th>
                            <th style="text-align:left">PO Number</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _containerDetails)
                        {
                            <tr>
                                <td style="text-align:left">@r.Contno</td>
                                <td style="text-align:right">@r.TrnDate.ToString("dd-MMM-yyyy")</td>
                                <td style="text-align:right">@r.Pallets.ToString("N0")</td>
                                <td style="text-align:right">@r.Boxes.ToString("N0")</td>
                                <td style="text-align:right">@r.Qty.ToString("N0")</td>
                                <td style="text-align:left">@r.PoNumbers</td>
                            </tr>
                        }
                        <tr class="yvd-total-row">
                            <td style="text-align:left" colspan="2">Total</td>
                            <td style="text-align:right">@_containerDetails.Sum(r => r.Pallets).ToString("N0")</td>
                            <td style="text-align:right">@_containerDetails.Sum(r => r.Boxes).ToString("N0")</td>
                            <td style="text-align:right">@_containerDetails.Sum(r => r.Qty).ToString("N0")</td>
                            <td></td>
                        </tr>
                    </tbody>
                </table>
                }
            </div>
            <div style="flex:1; min-width:280px; overflow-x:auto;">
                @if (IsOffloadingSummary)
                {
                <table class="aiwms-table aiwms-table-dense" style="text-align:center; width:100%;">
                    <thead>
                        <tr><th colspan="3" style="text-align:center">Inbound Shipment Details — Pending for offloading (as of today, since @PendingFloorLabel)@AdminQueryToggle(_showPendingSummaryQuery, () => _showPendingSummaryQuery = !_showPendingSummaryQuery)</th></tr>
                        @QueryRow(_showPendingSummaryQuery, "Offloading Shipment Summary — Pending for offloading", 3)
                        <tr>
                            <th style="text-align:left">Type</th>
                            <th style="text-align:right">Containers</th>
                            <th style="text-align:right">Qty</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="text-align:left">Total Imports AEINT</td>
                            <td style="text-align:right">@PendingFor("AEINT").Containers.ToString("N0")</td>
                            <td style="text-align:right">@PendingFor("AEINT").Qty.ToString("N0")</td>
                        </tr>
                        <tr>
                            <td style="text-align:left">Local Purchased AELOC</td>
                            <td style="text-align:right">@PendingFor("AELOC").Containers.ToString("N0")</td>
                            <td style="text-align:right">@PendingFor("AELOC").Qty.ToString("N0")</td>
                        </tr>
                        <tr class="yvd-total-row">
                            <td style="text-align:left">Total</td>
                            <td style="text-align:right">@_pending.Sum(r => r.Containers).ToString("N0")</td>
                            <td style="text-align:right">@_pending.Sum(r => r.Qty).ToString("N0")</td>
                        </tr>
                    </tbody>
                </table>
                }
                else
                {
                <table class="aiwms-table aiwms-table-dense" style="text-align:center; width:100%;">
                    <thead>
                        <tr><th colspan="4" style="text-align:center">Inbound Shipment Details — Pending for offloading (Detailed, since @PendingFloorLabel)@AdminQueryToggle(_showPendingDetailQuery, () => _showPendingDetailQuery = !_showPendingDetailQuery)</th></tr>
                        @QueryRow(_showPendingDetailQuery, "Offloading Shipment Summary — Pending for offloading (Detailed, by container)", 4)
                        <tr>
                            <th style="text-align:left">Container ID</th>
                            <th style="text-align:right">Receipt Date</th>
                            <th style="text-align:right">Order Qty</th>
                            <th style="text-align:left">PO Number</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _pendingDetails)
                        {
                            <tr>
                                <td style="text-align:left">@r.Contno</td>
                                <td style="text-align:right">@r.ReceiptDt.ToString("dd-MMM-yyyy")</td>
                                <td style="text-align:right">@r.Qty.ToString("N0")</td>
                                <td style="text-align:left">@r.PoNumbers</td>
                            </tr>
                        }
                        <tr class="yvd-total-row">
                            <td style="text-align:left" colspan="2">Total</td>
                            <td style="text-align:right">@_pendingDetails.Sum(r => r.Qty).ToString("N0")</td>
                            <td></td>
                        </tr>
                    </tbody>
                </table>
                }
            </div>
        </div>
        }
    </div>
    @if (CurrentUser.HasAllCountriesAccess)
    {
    <p style="font-size:11px; color:var(--text-secondary); margin-top:4px">
        "Pending for offloading" is a live snapshot as of today (not scoped to the filter above), floored to @PendingFloorLabel to exclude years-old abandoned backlog.
    </p>
    }

    <div class="aiwms-section" style="padding:0; overflow:hidden">
        <div class="yvd-header">
            <span>
                Total Inbound Summary — Offload Containers
                (@PeriodSuffixLabel)
            </span>
            @MinimizeToggle(_totalInboundCollapsed, () => _totalInboundCollapsed = !_totalInboundCollapsed)
        </div>
        @if (!_totalInboundCollapsed)
        {
        <div style="overflow-x:auto">
            <table class="aiwms-table aiwms-table-dense" style="text-align:center">
                <thead>
                    <tr>
                        <th style="text-align:left">Inbound Details</th>
                        @foreach (var p in _periodRows)
                        {
                            <th style="text-align:right">@p.PeriodLabel</th>
                        }
                        <th style="text-align:right">Total</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td style="text-align:left">No. of Trailers Inbound</td>
                        @foreach (var p in _periodRows)
                        {
                            <td style="text-align:right">@p.Containers.ToString("N0")</td>
                        }
                        <td style="text-align:right; font-weight:700">@_periodRows.Sum(p => p.Containers).ToString("N0")</td>
                    </tr>
                    <tr>
                        <td style="text-align:left">No of Pallets</td>
                        @foreach (var p in _periodRows)
                        {
                            <td style="text-align:right">@p.Pallets.ToString("N0")</td>
                        }
                        <td style="text-align:right; font-weight:700">@_periodRows.Sum(p => p.Pallets).ToString("N0")</td>
                    </tr>
                    <tr>
                        <td style="text-align:left">No of Boxes</td>
                        @foreach (var p in _periodRows)
                        {
                            <td style="text-align:right">@p.Boxes.ToString("N0")</td>
                        }
                        <td style="text-align:right; font-weight:700">@_periodRows.Sum(p => p.Boxes).ToString("N0")</td>
                    </tr>
                    <tr>
                        <td style="text-align:left">No of Pcs</td>
                        @foreach (var p in _periodRows)
                        {
                            <td style="text-align:right">@p.Pcs.ToString("N0")</td>
                        }
                        <td style="text-align:right; font-weight:700">@_periodRows.Sum(p => p.Pcs).ToString("N0")</td>
                    </tr>
                </tbody>
            </table>
        </div>
        }
    </div>
    @if (CurrentUser.HasAllCountriesAccess)
    {
    <p style="font-size:11px; color:var(--text-secondary); margin-top:4px">
        "No of Pcs" is the order quantity (hodata..vUSAOrder.Qty, summed per container) for the containers offloaded in each period — there is no per-box piece count in the source tables.
    </p>
    }

    <div class="yvd-section-banner">Internal Transfer Summary</div>
    @foreach (var box in _internalTransfers)
    {
        var boxCollapsed = _internalTransferCollapsed.Contains(box.Label);
        <div class="aiwms-section" style="padding:0; overflow:hidden">
            <div class="yvd-header">
                <span>
                    @if (box.Warehouse is not null)
                    {
                        <span class="yvd-warehouse-badge">@box.Warehouse</span>
                    }
                    @box.Label
                    (@PeriodSuffixLabel)
                </span>
                @MinimizeToggle(boxCollapsed, () => { if (!_internalTransferCollapsed.Add(box.Label)) _internalTransferCollapsed.Remove(box.Label); })
            </div>
            @if (!boxCollapsed)
            {
            <div style="overflow-x:auto">
                <table class="aiwms-table aiwms-table-dense" style="text-align:center">
                    <thead>
                        <tr>
                            <th style="text-align:left">Inbound Details</th>
                            @foreach (var p in box.Periods)
                            {
                                <th style="text-align:right">@p.PeriodLabel</th>
                            }
                            <th style="text-align:right">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="text-align:left">@box.CountLabel</td>
                            @foreach (var p in box.Periods)
                            {
                                <td style="text-align:right">@p.Trips.ToString("N0")</td>
                            }
                            <td style="text-align:right; font-weight:700">@box.Periods.Sum(p => p.Trips).ToString("N0")</td>
                        </tr>
                        <tr>
                            <td style="text-align:left">No Of Pallets</td>
                            @foreach (var p in box.Periods)
                            {
                                <td style="text-align:right">@p.Pallets.ToString("N0")</td>
                            }
                            <td style="text-align:right; font-weight:700">@box.Periods.Sum(p => p.Pallets).ToString("N0")</td>
                        </tr>
                        <tr>
                            <td style="text-align:left">No of Tote/Box</td>
                            @foreach (var p in box.Periods)
                            {
                                <td style="text-align:right">@p.Boxes.ToString("N0")</td>
                            }
                            <td style="text-align:right; font-weight:700">@box.Periods.Sum(p => p.Boxes).ToString("N0")</td>
                        </tr>
                        <tr>
                            <td style="text-align:left">QUANTITY</td>
                            @foreach (var p in box.Periods)
                            {
                                <td style="text-align:right">@p.Quantity.ToString("N0")</td>
                            }
                            <td style="text-align:right; font-weight:700">@box.Periods.Sum(p => p.Quantity).ToString("N0")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            }
        </div>
    }
    @if (CurrentUser.HasAllCountriesAccess)
    {
    <p style="font-size:11px; color:var(--text-secondary); margin-top:4px">
        Sourced from bfldata..vPLTDeliveryDetails. "Total Inbound"/"Total Outbound" are independent live totals, not a sum of the per-warehouse boxes below them — a single trailer can serve more than one route in a day.
    </p>
    }
}

@code {
    // "Monthly" | "WeeklyAgg" (all weeks of the selected month, as columns) | "Range" (one
    // explicit From/To date range, max 31 days) | "W{n}" (one specific week only) -- one
    // unified dropdown instead of a separate VIEW + WEEK pair.
    private string _selectedPeriod = "Monthly";
    private int _selectedYear = DateTime.Now.Year;
    private int _selectedMonth = DateTime.Now.Month;
    private DateTime _rangeFrom = DateTime.Today.AddDays(-6);
    private DateTime _rangeTo = DateTime.Today;
    private List<int> _years = new();
    private bool _loading;
    private bool _loadedOnce;
    private bool _exporting;

    private bool _offloadingCollapsed;
    private bool _totalInboundCollapsed;
    private HashSet<string> _internalTransferCollapsed = new();

    // "Summary" (AEINT/AELOC rollup, unchanged default) | "Detailed" (one row per container,
    // matching the legacy "Online Containers Offloaded" desktop screen) -- Completed offloading
    // side of Offloading Shipment Summary only; Pending for offloading is unaffected.
    private string _offloadingView = "Summary";
    private bool IsOffloadingSummary => _offloadingView == "Summary";

    private List<YotoOffloadGroupRow> _completed = new();
    private List<YotoOffloadContainerRow> _containerDetails = new();
    private List<YotoPendingGroupRow> _pending = new();
    private List<YotoPendingContainerRow> _pendingDetails = new();
    private List<YotoInboundPeriodRow> _periodRows = new();
    private List<YotoInternalTransferBox> _internalTransfers = new();

    private bool IsMonthly => _selectedPeriod == "Monthly";
    private bool IsWeeklyAgg => _selectedPeriod == "WeeklyAgg";
    private bool IsRange => _selectedPeriod == "Range";
    private bool IsSpecificWeek => !IsMonthly && !IsWeeklyAgg && !IsRange;

    // Only the custom-range mode has a range to validate -- every other mode picks from
    // fixed weeks/months that are always valid by construction.
    private bool IsRangeValid => !IsRange || (_rangeFrom <= _rangeTo && (_rangeTo - _rangeFrom).TotalDays <= 30);

    private int SelectedWeekNum =>
        IsSpecificWeek && _selectedPeriod.Length > 1 && int.TryParse(_selectedPeriod[1..], out var n) ? n : 1;

    private string SelectedPeriodLabel =>
        IsSpecificWeek ? $"W{SelectedWeekNum} ({SelectedWeekRange.Start:dd-MMM} → {SelectedWeekRange.End:dd-MMM} {_selectedYear})"
        : IsRange       ? $"{_rangeFrom:dd-MMM-yyyy} → {_rangeTo:dd-MMM-yyyy}"
        : IsWeeklyAgg   ? $"{new DateTime(2000, _selectedMonth, 1):MMMM} {_selectedYear}, by week"
        : $"{new DateTime(2000, _selectedMonth, 1):MMMM} {_selectedYear}";

    // Same "(...)" suffix used in the Total Inbound Summary / Internal Transfer box headers
    // and their matching Excel export titles -- Monthly's own text is unchanged from before.
    private string PeriodSuffixLabel =>
        IsSpecificWeek ? SelectedPeriodLabel
        : IsRange       ? SelectedPeriodLabel
        : IsWeeklyAgg   ? $"{new DateTime(2000, _selectedMonth, 1):MMMM} {_selectedYear}, by week"
        : $"{_selectedYear}, by month";

    // "@DateTime.Today.Year-01-01" previously here was NOT a date string -- Razor parsed
    // it as integer subtraction (Year - 1 - 1), silently showing the wrong value. This is
    // the actual Jan-1-of-current-year floor GetPendingOffloadingAsync applies server-side.
    private static string PendingFloorLabel => new DateTime(DateTime.Today.Year, 1, 1).ToString("dd-MMM-yyyy");

    private YotoOffloadGroupRow CompletedFor(string group) =>
        _completed.FirstOrDefault(r => r.Group == group) ?? new YotoOffloadGroupRow(group, 0, 0, 0);

    private YotoPendingGroupRow PendingFor(string group) =>
        _pending.FirstOrDefault(r => r.Group == group) ?? new YotoPendingGroupRow(group, 0, 0);

    // Same week definition as Production Summary Report: Week 1 starts on the first
    // Sunday on/after Jan 1 of the selected year, 7-day blocks, last week truncated to
    // Dec 31 -- reused here (scoped to _selectedYear instead of always "this year") so
    // the WEEK dropdown and the actual data filter agree on the exact same date ranges.
    private IEnumerable<(int Num, DateTime Start, DateTime End)> Weeks
    {
        get
        {
            var week1Start = FirstWeekStart(_selectedYear);
            var dec31 = new DateTime(_selectedYear, 12, 31);
            var weekCount = (int)Math.Ceiling(((dec31 - week1Start).Days + 1) / 7.0);
            for (var i = 0; i < weekCount; i++)
            {
                var start = week1Start.AddDays(i * 7);
                var end = start.AddDays(6);
                if (end > dec31) end = dec31;
                yield return (i + 1, start, end);
            }
        }
    }

    private (DateTime Start, DateTime End) SelectedWeekRange
    {
        get
        {
            var range = Weeks.FirstOrDefault(w => w.Num == SelectedWeekNum);
            return range == default ? (Weeks.First().Start, Weeks.First().End) : (range.Start, range.End);
        }
    }

    private static DateTime FirstWeekStart(int year)
    {
        var jan1 = new DateTime(year, 1, 1);
        var daysUntilSunday = ((int)DayOfWeek.Sunday - (int)jan1.DayOfWeek + 7) % 7;
        return jan1.AddDays(daysUntilSunday);
    }

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.EnsureLoadedAsync();
        var thisYear = DateTime.Now.Year;
        _years = Enumerable.Range(thisYear - 2, 4).Reverse().ToList(); // thisYear+1 .. thisYear-2
    }

    // Switching Summary/Detailed re-fetches immediately if data's already on screen, instead
    // of leaving the user to notice nothing changed until they click Load again.
    private async Task SetOffloadingViewAsync(string view)
    {
        if (_offloadingView == view) return;
        _offloadingView = view;
        if (_loadedOnce) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!IsRangeValid) return;
        _loading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var monthStart = new DateTime(_selectedYear, _selectedMonth, 1);
            var monthEnd = monthStart.AddMonths(1);

            if (IsMonthly)
            {
                // Unchanged from before -- Jan-Dec columns for the whole year.
                _completed = await Svc.GetCompletedOffloadingAsync(monthStart, monthEnd);
                _containerDetails = IsOffloadingSummary ? new() : await Svc.GetCompletedOffloadingDetailAsync(monthStart, monthEnd);
                _pending = await Svc.GetPendingOffloadingAsync();
                _pendingDetails = IsOffloadingSummary ? new() : await Svc.GetPendingOffloadingDetailAsync();
                _periodRows = await Svc.GetMonthlyInboundSummaryAsync(_selectedYear);
                _internalTransfers = await Svc.GetInternalTransferMonthlyAsync(_selectedYear);
            }
            else if (IsWeeklyAgg)
            {
                // Every calendar week (Sun-Sat) that overlaps the selected month, as columns --
                // reuses the same single-range service calls the specific-week branch below
                // uses, once per overlapping week, then stitches the results together.
                _completed = await Svc.GetCompletedOffloadingAsync(monthStart, monthEnd);
                _containerDetails = IsOffloadingSummary ? new() : await Svc.GetCompletedOffloadingDetailAsync(monthStart, monthEnd);
                _pending = await Svc.GetPendingOffloadingAsync();
                _pendingDetails = IsOffloadingSummary ? new() : await Svc.GetPendingOffloadingDetailAsync();

                var weeksInMonth = Weeks.Where(w => w.Start < monthEnd && w.End >= monthStart).ToList();

                var periodRows = new List<YotoInboundPeriodRow>();
                var perWeekTransfers = new List<List<YotoInternalTransferBox>>();
                foreach (var w in weeksInMonth)
                {
                    var wFrom = w.Start;
                    var wTo = w.End.AddDays(1);
                    var label = $"W{w.Num}";
                    periodRows.Add(await Svc.GetInboundSummaryForRangeAsync(wFrom, wTo, label, w.Num));
                    perWeekTransfers.Add(await Svc.GetInternalTransferForRangeAsync(wFrom, wTo, label, w.Num));
                }
                _periodRows = periodRows;

                // Each week's call returns all 8 boxes with one period each, in the same
                // (Total Inbound, Total Outbound, JAFZA in/out, ...) order every time --
                // grouping by Label across weeks stitches each box's periods back together
                // in week order without needing to re-sort afterward.
                _internalTransfers = perWeekTransfers
                    .SelectMany(list => list)
                    .GroupBy(b => b.Label)
                    .Select(g => new YotoInternalTransferBox(g.First().Label, g.First().CountLabel, g.First().Warehouse, g.SelectMany(b => b.Periods).ToList()))
                    .ToList();
            }
            else if (IsRange)
            {
                // Same single-range service calls the specific-week branch below uses --
                // one period column spanning the whole explicit From/To selection.
                var rangeStart = _rangeFrom.Date;
                var rangeEnd = _rangeTo.Date.AddDays(1);
                _completed = await Svc.GetCompletedOffloadingAsync(rangeStart, rangeEnd);
                _containerDetails = IsOffloadingSummary ? new() : await Svc.GetCompletedOffloadingDetailAsync(rangeStart, rangeEnd);
                _pending = await Svc.GetPendingOffloadingAsync();
                _pendingDetails = IsOffloadingSummary ? new() : await Svc.GetPendingOffloadingDetailAsync();
                _periodRows = new List<YotoInboundPeriodRow> { await Svc.GetInboundSummaryForRangeAsync(rangeStart, rangeEnd, SelectedPeriodLabel, 1) };
                _internalTransfers = await Svc.GetInternalTransferForRangeAsync(rangeStart, rangeEnd, SelectedPeriodLabel, 1);
            }
            else // specific week
            {
                var (weekStart, weekEndInclusive) = SelectedWeekRange;
                var weekEnd = weekEndInclusive.AddDays(1);
                _completed = await Svc.GetCompletedOffloadingAsync(weekStart, weekEnd);
                _containerDetails = IsOffloadingSummary ? new() : await Svc.GetCompletedOffloadingDetailAsync(weekStart, weekEnd);
                _pending = await Svc.GetPendingOffloadingAsync();
                _pendingDetails = IsOffloadingSummary ? new() : await Svc.GetPendingOffloadingDetailAsync();
                _periodRows = new List<YotoInboundPeriodRow> { await Svc.GetInboundSummaryForRangeAsync(weekStart, weekEnd, SelectedPeriodLabel, SelectedWeekNum) };
                _internalTransfers = await Svc.GetInternalTransferForRangeAsync(weekStart, weekEnd, SelectedPeriodLabel, SelectedWeekNum);
            }
        }
        finally
        {
            _loadedOnce = true;
            _loading = false;
        }
    }

    // Small icon button for section headers — glyph reflects the action the click
