    // ====================== Excel export (everything on the page, one sheet) ======================

    private async Task ExportAllAsync()
    {
        _exporting = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            using var wb = new XLWorkbook();
            var ws = wb.AddWorksheet("YOTO VNA Dashboard");
            var row = 1;

            row = WriteOffloadingBlock(ws, row);
            row = WriteTotalInboundBlock(ws, row);
            foreach (var box in _internalTransfers)
                row = WriteInternalTransferBlock(ws, row, box);

            ws.Columns().AdjustToContents();

            using var ms = new MemoryStream();
            wb.SaveAs(ms);
            var b64 = Convert.ToBase64String(ms.ToArray());
            var name = $"yoto-vna-dashboard-{DateTime.UtcNow.AddHours(4):yyyyMMdd-HHmm}.xlsx";
            await JS.InvokeVoidAsync("downloadFileWithPicker", name, b64,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        finally { _exporting = false; }
    }

    private static int WriteSectionTitle(IXLWorksheet ws, int row, string title)
    {
        ws.Cell(row, 1).Value = title;
        ws.Cell(row, 1).Style.Font.Bold = true;
        ws.Cell(row, 1).Style.Font.FontSize = 13;
        return row + 1;
    }

    private int WriteOffloadingBlock(IXLWorksheet ws, int row)
    {
        row = WriteSectionTitle(ws, row, $"Offloading Shipment Summary — {SelectedPeriodLabel}");

        if (IsOffloadingSummary)
        {
            row = WriteSectionTitle(ws, row, "Completed offloading");
            ws.Cell(row, 1).Value = "Type"; ws.Cell(row, 2).Value = "Containers"; ws.Cell(row, 3).Value = "Pallets"; ws.Cell(row, 4).Value = "Boxes";
            ws.Row(row).Style.Font.Bold = true; row++;
            foreach (var (group, label) in new[] { ("AEINT", "Total Imports AEINT"), ("AELOC", "Local Purchased AELOC") })
            {
                var r = CompletedFor(group);
                ws.Cell(row, 1).Value = label; ws.Cell(row, 2).Value = r.Containers; ws.Cell(row, 3).Value = r.Pallets; ws.Cell(row, 4).Value = r.Boxes;
                row++;
            }
            ws.Cell(row, 1).Value = "Total"; ws.Cell(row, 2).Value = _completed.Sum(r => r.Containers); ws.Cell(row, 3).Value = _completed.Sum(r => r.Pallets); ws.Cell(row, 4).Value = _completed.Sum(r => r.Boxes);
            ws.Row(row).Style.Font.Bold = true; row += 2;
        }
        else
        {
            row = WriteSectionTitle(ws, row, "Completed offloading (Detailed, by container)");
            ws.Cell(row, 1).Value = "Container ID"; ws.Cell(row, 2).Value = "Sticker Printing Date"; ws.Cell(row, 3).Value = "No of Pallets";
            ws.Cell(row, 4).Value = "No of BoxNo"; ws.Cell(row, 5).Value = "Order Qty"; ws.Cell(row, 6).Value = "PO Number";
            ws.Row(row).Style.Font.Bold = true; row++;
            foreach (var r in _containerDetails)
            {
                ws.Cell(row, 1).Value = r.Contno; ws.Cell(row, 2).Value = r.TrnDate; ws.Cell(row, 2).Style.DateFormat.Format = "dd-MMM-yyyy";
                ws.Cell(row, 3).Value = r.Pallets; ws.Cell(row, 4).Value = r.Boxes; ws.Cell(row, 5).Value = r.Qty; ws.Cell(row, 6).Value = r.PoNumbers;
                row++;
            }
            ws.Cell(row, 1).Value = "Total";
            ws.Cell(row, 3).Value = _containerDetails.Sum(r => r.Pallets); ws.Cell(row, 4).Value = _containerDetails.Sum(r => r.Boxes); ws.Cell(row, 5).Value = _containerDetails.Sum(r => r.Qty);
            ws.Row(row).Style.Font.Bold = true; row += 2;
        }

        if (IsOffloadingSummary)
        {
            row = WriteSectionTitle(ws, row, $"Pending for offloading (as of today, since {PendingFloorLabel})");
            ws.Cell(row, 1).Value = "Type"; ws.Cell(row, 2).Value = "Containers"; ws.Cell(row, 3).Value = "Qty";
            ws.Row(row).Style.Font.Bold = true; row++;
            foreach (var (group, label) in new[] { ("AEINT", "Total Imports AEINT"), ("AELOC", "Local Purchased AELOC") })
            {
                var r = PendingFor(group);
                ws.Cell(row, 1).Value = label; ws.Cell(row, 2).Value = r.Containers; ws.Cell(row, 3).Value = r.Qty;
                row++;
            }
            ws.Cell(row, 1).Value = "Total"; ws.Cell(row, 2).Value = _pending.Sum(r => r.Containers); ws.Cell(row, 3).Value = _pending.Sum(r => r.Qty);
            ws.Row(row).Style.Font.Bold = true; row += 2;
        }
        else
        {
            row = WriteSectionTitle(ws, row, $"Pending for offloading (Detailed, since {PendingFloorLabel})");
            ws.Cell(row, 1).Value = "Container ID"; ws.Cell(row, 2).Value = "Receipt Date"; ws.Cell(row, 3).Value = "Order Qty"; ws.Cell(row, 4).Value = "PO Number";
            ws.Row(row).Style.Font.Bold = true; row++;
            foreach (var r in _pendingDetails)
            {
                ws.Cell(row, 1).Value = r.Contno; ws.Cell(row, 2).Value = r.ReceiptDt; ws.Cell(row, 2).Style.DateFormat.Format = "dd-MMM-yyyy";
                ws.Cell(row, 3).Value = r.Qty; ws.Cell(row, 4).Value = r.PoNumbers;
                row++;
            }
            ws.Cell(row, 1).Value = "Total"; ws.Cell(row, 3).Value = _pendingDetails.Sum(r => r.Qty);
            ws.Row(row).Style.Font.Bold = true; row += 2;
        }

        return row;
    }

    private int WriteTotalInboundBlock(IXLWorksheet ws, int row)
    {
        row = WriteSectionTitle(ws, row,
            $"Total Inbound Summary — Offload Containers ({PeriodSuffixLabel})");

        ws.Cell(row, 1).Value = "Inbound Details";
        var col = 2;
        foreach (var p in _periodRows) { ws.Cell(row, col).Value = p.PeriodLabel; col++; }
        ws.Cell(row, col).Value = "Total";
        ws.Row(row).Style.Font.Bold = true; row++;

        row = WritePeriodMetricRow(ws, row, "No. of Trailers Inbound", _periodRows, p => p.Containers);
        row = WritePeriodMetricRow(ws, row, "No of Pallets", _periodRows, p => p.Pallets);
        row = WritePeriodMetricRow(ws, row, "No of Boxes", _periodRows, p => p.Boxes);
        row = WritePeriodMetricRow(ws, row, "No of Pcs", _periodRows, p => p.Pcs);
        row++;

        return row;
    }

    private int WriteInternalTransferBlock(IXLWorksheet ws, int row, YotoInternalTransferBox box)
    {
        var title = box.Warehouse is not null ? $"{box.Warehouse} — {box.Label}" : box.Label;
        row = WriteSectionTitle(ws, row,
            $"{title} ({PeriodSuffixLabel})");

        ws.Cell(row, 1).Value = "Inbound Details";
        var col = 2;
        foreach (var p in box.Periods) { ws.Cell(row, col).Value = p.PeriodLabel; col++; }
        ws.Cell(row, col).Value = "Total";
        ws.Row(row).Style.Font.Bold = true; row++;

        row = WritePeriodMetricRow(ws, row, box.CountLabel, box.Periods, p => p.Trips);
        row = WritePeriodMetricRow(ws, row, "No Of Pallets", box.Periods, p => p.Pallets);
        row = WritePeriodMetricRow(ws, row, "No of Tote/Box", box.Periods, p => p.Boxes);
        row = WritePeriodMetricRow(ws, row, "QUANTITY", box.Periods, p => p.Quantity);
        row++;

        return row;
    }

    private static int WritePeriodMetricRow<T>(IXLWorksheet ws, int row, string label, List<T> periods, Func<T, int> value)
    {
        ws.Cell(row, 1).Value = label;
        var col = 2;
        foreach (var p in periods) { ws.Cell(row, col).Value = value(p); col++; }
        ws.Cell(row, col).Value = periods.Sum(value);
        ws.Cell(row, col).Style.Font.Bold = true;
        return row + 1;
    }
}
