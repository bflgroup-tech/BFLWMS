@page "/reports/production-summary"
@rendermode RenderMode.InteractiveServer
@using System.Text
@using Wms.Core
@using Wms.Data.Configuration
@using Wms.Data.Lpm
@attribute [Authorize(Policy = MenuKeys.RPT_PRODUCTION_SUMMARY)]
@inject ReportsService Svc
@inject IOnPremConnectionResolver Resolver
@inject ICurrentUser CurrentUser
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>WMS — Production Summary Report</PageTitle>

<style>
    .psr-country-select summary { list-style: none; }
    .psr-country-select summary::-webkit-details-marker { display: none; }
    .psr-country-select summary {
        transition: border-color .15s ease, box-shadow .15s ease;
    }
    .psr-country-select summary:hover {
        border-color: var(--border-strong);
    }
    .psr-country-select details[open] summary {
        border-color: var(--bfl-yellow);
        box-shadow: 0 0 0 3px rgba(255, 209, 0, .18);
    }
    .psr-country-select .psr-arrow {
        display: inline-block;
        transition: transform .15s ease;
    }
    .psr-country-select details[open] .psr-arrow {
        transform: rotate(180deg);
    }
    .psr-country-select .psr-option {
        border-radius: 4px;
        padding: 6px 8px;
        margin: 0 -2px;
        transition: background-color .1s ease;
    }
    .psr-country-select .psr-option:hover {
        background: var(--bfl-yellow-lite);
    }
    .psr-country-select .psr-option input[type="checkbox"] {
        width: 15px;
        height: 15px;
        accent-color: var(--bfl-yellow-hov);
        cursor: pointer;
    }
</style>

<div class="aiwms-page-header">
    <h2>Production Summary Report</h2>
    <p>Per-batch view of items scanned through QC (<code>usa.dbo.amechecking</code>), split by LPM vs Non-LPM via <code>LPMSIM_Batch.Sources</code>. Each picked date is one WH production day: <strong>06:00 GST → 06:00 GST next day</strong>.</p>
</div>

<div class="aiwms-section">
    <div style="display:grid; grid-template-columns: 1fr 1fr 1fr 1fr auto auto; gap:12px; align-items:end;">
        <div class="psr-country-select">
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">COUNTRY (select any) *</label>
            <details id="psr-country-dropdown" style="position:relative;">
                <summary style="display:flex; align-items:center; justify-content:space-between; gap:8px; width:100%; height:36px; box-sizing:border-box; padding:8px 12px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; font-weight:600; background:white; cursor:pointer; user-select:none;">
                    <span style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@CountrySelectionLabel</span>
                    <span class="psr-arrow" style="color:var(--text-secondary); font-size:10px; flex-shrink:0;">&#9660;</span>
                </summary>
                <div style="position:absolute; top:100%; left:0; right:0; z-index:20; margin-top:6px; display:flex; flex-direction:column; gap:2px; max-height:220px; overflow-y:auto; border:1px solid var(--border-default); border-radius:8px; padding:8px; background:white; box-shadow:0 8px 20px rgba(0,0,0,0.14);">
                    <label class="psr-option" style="display:flex; align-items:center; gap:8px; cursor:pointer; font-size:13px; font-weight:700; border-bottom:1px solid var(--border-default); padding-bottom:8px; margin-bottom:2px">
                        <input type="checkbox" checked="@_countries.All(c => _selectedCountries.Contains(c))" @onchange="@(e => ToggleAllCountries((bool)e.Value!))" />
                        Select all
                    </label>
                    @foreach (var c in _countries)
                    {
                        <label class="psr-option" style="display:flex; align-items:center; gap:8px; cursor:pointer; font-size:13px">
                            <input type="checkbox" checked="@_selectedCountries.Contains(c)" @onchange="@(e => ToggleCountry(c, (bool)e.Value!))" />
                            @c
                            @if (!_configuredCountries.Contains(c))
                            {
                                <span style="color:var(--s-pending, #C98512); font-size:11px; font-style:italic;">(not connected)</span>
                            }
                        </label>
                    }
                </div>
            </details>
        </div>
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">WEEK</label>
            <select @bind="_selectedWeek" @bind:after="OnWeekChanged" style="width:100%; height:36px; box-sizing:border-box; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;">
                @foreach (var w in Weeks)
                {
                    <option value="@w.Num">W@(w.Num) &middot; @w.Start.ToString("dd-MMM") &rarr; @w.End.ToString("dd-MMM")</option>
                }
            </select>
        </div>
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">FROM</label>
            <input type="date" @bind="_from" @bind:format="yyyy-MM-dd" max="@DateTime.Today.ToString("yyyy-MM-dd")" style="width:100%; height:36px; box-sizing:border-box; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
        </div>
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">TO</label>
            <input type="date" @bind="_to" @bind:format="yyyy-MM-dd" max="@DateTime.Today.ToString("yyyy-MM-dd")" style="width:100%; height:36px; box-sizing:border-box; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
        </div>
        <button class="aiwms-btn aiwms-btn-primary" style="height:36px; box-sizing:border-box" @onclick="LoadAsync" disabled="@(_loading || !CanLoad)">@(_loading ? "Loading…" : "Load")</button>
        <button class="aiwms-btn aiwms-btn-secondary" style="height:36px; box-sizing:border-box" @onclick="ExportCsvAsync" disabled="@(!HasAnyVisibleRows || _loading)">Export to Excel</button>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="aiwms-alert @(_isError ? "error" : "info")" style="margin-top:12px">@_message</div>
    }
</div>

@if (_loading)
{
    <div class="aiwms-section" style="padding:0; overflow:hidden">
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
        <div style="padding:14px; font-style:italic; color:var(--text-secondary)">@(_loadingMsg ?? "Loading…")</div>
    </div>
}
else if (VisibleRows().Count > 0)
{
    var visibleRows    = VisibleRows();
    var visibleSummary = VisibleSummary();
    var totScanned = visibleRows.Sum(r => r.TotalScanned);
    var mixedQty   = visibleRows.Where(r => r.Kind == "Mixed").Sum(r => r.TotalScanned);
    var unkQty     = visibleRows.Where(r => r.Kind == "Unknown").Sum(r => r.TotalScanned);
    var visibleStoreQty    = visibleRows.Sum(r => r.StoreQty);
    var visibleTransferQty = _transferQtyByCountry.Where(kv => _selectedCountries.Contains(kv.Key)).Sum(kv => kv.Value);
    var visibleMerchNeed   = _merchNeedByCountry.Where(kv => _selectedCountries.Contains(kv.Key)).Select(kv => kv.Value).ToList();
    var merchNeedMonth     = visibleMerchNeed.Sum(m => m.MerchNeedMonth);
    var merchNeedWeek      = visibleMerchNeed.Sum(m => m.MerchNeedWeek);
    var merchNeedDay       = visibleMerchNeed.Sum(m => m.MerchNeedDay);
    var isUaeVisible       = _selectedCountries.Contains("UAE");
    var visibleEx2Qty      = visibleSummary.Sum(s => s.Ex2StoreQty);

    <div class="aiwms-section">
        <div style="display:grid; grid-template-columns: repeat(@(isUaeVisible ? 8 : 7), 1fr); gap:12px;">
            @MetricCard("Store Qty",      visibleStoreQty.ToString("N0"), "#fdf2f8", "#9d174d", false)
            @if (visibleTransferQty > 0)
            {
                @MetricCard("Transfer Qty",   visibleTransferQty.ToString("N0"),     "#ccfbf1", "#0f766e", false)
            }
            @MetricCard("Total Scanned", totScanned.ToString("N0"),       "#dbeafe", "#1e40af", false)
            @MetricCard("Unknown",       unkQty.ToString("N0"),           "#fef3c7", "#92400e", false)
            @if (isUaeVisible)
            {
                @MetricCard("EX2LOCATIONS", visibleEx2Qty.ToString("N0"), "#ede9fe", "#5b21b6", false)
            }
            @MetricCard("Merch Need (Month)", merchNeedMonth.ToString("N0"), "#ffedd5", "#9a3412", false)
            @MetricCard("Merch Need (Week)",  merchNeedWeek.ToString("N0"),  "#ffedd5", "#9a3412", false)
            @MetricCard("Merch Need (Day)",   merchNeedDay.ToString("N0"),   "#ffedd5", "#9a3412", false)
        </div>
    </div>

    @if (_selectedCountries.Count > 0)
    {
        <div class="aiwms-section">
            <div class="aiwms-card-header">By Country</div>
            @foreach (var cs in CountrySummaries(visibleRows))
            {
                <div style="margin-bottom:14px;">
                    <div style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:var(--text-secondary); margin-bottom:6px;">@cs.Country</div>
                    <div style="display:grid; grid-template-columns: repeat(7, 1fr); gap:12px;">
                        @MetricCard("Store Qty",      cs.StoreQty.ToString("N0"),     "#fdf2f8", "#9d174d", false)
                        @MetricCard("Transfer Qty",   cs.TransferQty.ToString("N0"),  "#ccfbf1", "#0f766e", false)
                        @MetricCard("Total Scanned",  cs.TotalScanned.ToString("N0"), "#dbeafe", "#1e40af", false)
                        @MetricCard("Unknown",        cs.Unknown.ToString("N0"),      "#fef3c7", "#92400e", false)
                        @MetricCard("Merch Need (Month)", cs.MerchNeedMonth.ToString("N0"), "#ffedd5", "#9a3412", false)
                        @MetricCard("Merch Need (Week)",  cs.MerchNeedWeek.ToString("N0"),  "#ffedd5", "#9a3412", false)
                        @MetricCard("Merch Need (Day)",   cs.MerchNeedDay.ToString("N0"),   "#ffedd5", "#9a3412", false)
                    </div>
                    @if (string.Equals(cs.Country, "UAE", StringComparison.OrdinalIgnoreCase))
                    {
                        <div style="margin:10px 0 0 12px; padding-top:10px; border-top:1px dashed var(--border-default);">
                            <div style="font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:var(--text-secondary); margin-bottom:6px;">By Shop</div>
                            <div style="display:grid; grid-template-columns: repeat(7, 1fr); gap:12px;">
                                @ShopCard("UAE Shops",   visibleSummary.Sum(s => s.UaeStoreQty).ToString("N0"),  "#3730a3")
                                @ShopCard("Oman Shops",  visibleSummary.Sum(s => s.OmanStoreQty).ToString("N0"), "#166534")
                                @ShopCard("EX2KSA",      VisibleEx2ShopQty("KSA").ToString("N0"),      "#6d28d9")
                                @ShopCard("EX2QATAR",    VisibleEx2ShopQty("QATAR").ToString("N0"),    "#6d28d9")
                                @ShopCard("EX2BAHRAIN",  VisibleEx2ShopQty("BAHRAIN").ToString("N0"),   "#6d28d9")
                                @ShopCard("EX2KUWAIT",   VisibleEx2ShopQty("KUWAIT").ToString("N0"),    "#6d28d9")
                                @ShopCard("EX2MALAYSIA", VisibleEx2ShopQty("MALAYSIA").ToString("N0"),  "#6d28d9")
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <div class="aiwms-section">
        <div style="display:flex; gap:14px; align-items:center; margin-bottom:10px">
            <strong style="font-size:11px; text-transform:uppercase; letter-spacing:1px; color:var(--text-secondary)">View:</strong>
            <label style="display:flex; align-items:center; gap:4px; cursor:pointer"><input type="radio" name="vw" value="Summary"  checked="@(_view == "Summary")"  @onchange="@(_ => _view = "Summary")" /> Summary</label>
            <label style="display:flex; align-items:center; gap:4px; cursor:pointer"><input type="radio" name="vw" value="Detailed" checked="@(_view == "Detailed")" @onchange="@(_ => _view = "Detailed")" /> Detailed</label>
        </div>

        @if (_view == "Summary")
        {
            var multiCountry = _selectedCountries.Count > 1;
            var pivot = visibleSummary
                .GroupBy(s => new { s.Country, s.ProductionDay, s.Division })
                .Select(g =>
                {
                    var mn = MerchNeedFor(g.Key.Country, g.Key.Division);
                    return new DivisionPivotRow(
                        g.Key.Country,
                        g.Key.ProductionDay,
                        g.Key.Division,
                        g.Where(x => x.Kind == "LPM").Sum(x => x.TotalScanned),
                        g.Where(x => x.Kind == "Non-LPM").Sum(x => x.TotalScanned),
                        g.Where(x => x.Kind == "Mixed").Sum(x => x.TotalScanned),
                        g.Where(x => x.Kind == "Unknown").Sum(x => x.TotalScanned),
                        g.Sum(x => x.TotalScanned),
                        g.Sum(x => x.StoreQty),
                        g.Sum(x => x.UaeStoreQty),
                        g.Sum(x => x.OmanStoreQty),
                        g.Sum(x => x.Ex2StoreQty),
                        mn.Month, mn.Week, mn.Day);
                })
                .OrderByDescending(x => x.ProductionDay)
                .ThenBy(x => x.Country)
                .ThenBy(x => x.Division)
                .ToList();
            pivot = WithMissingMerchNeedDivisions(pivot);
            var hasMixed = pivot.Sum(x => x.Mixed) > 0;
            var isUae = _selectedCountries.Contains("UAE");
            // Merch Need is a per-(Country, Division) constant, but a division can span
            // multiple rows here (one per ProductionDay it has scans on) — summing every
            // row would count that same Merch Need value once per day instead of once
            // overall, so total each division's value exactly once first. Key is
            // case-insensitive: real scan rows use Datareporting.subclassmaster's Title
            // Case division names, but WithMissingMerchNeedDivisions' synthetic rows use
            // tmpPlanningTarget's ALL CAPS names — same division, different casing.
            var distinctDivisionMerchNeed = pivot
                .GroupBy(x => (x.Country.ToUpperInvariant(), x.Division.ToUpperInvariant()))
                .Select(g => g.First())
                .ToList();
            var totalMerchNeedMonth = distinctDivisionMerchNeed.Sum(x => x.MerchNeedMonth);
            var totalMerchNeedWeek  = distinctDivisionMerchNeed.Sum(x => x.MerchNeedWeek);
            var totalMerchNeedDay   = distinctDivisionMerchNeed.Sum(x => x.MerchNeedDay);

            <table class="aiwms-table aiwms-table-dense">
                <thead>
                    <tr>
                        <th rowspan="2">Date</th>
                        @if (multiCountry) { <th rowspan="2">Country</th> }
                        <th rowspan="2">Division</th>
                        @if (hasMixed) { <th rowspan="2" style="text-align:right">Mixed</th> }
                        <th rowspan="2" style="text-align:right">Unknown</th>
                        <th rowspan="2" style="text-align:right">Scanned Qty</th>
                        <th rowspan="2" style="text-align:right">Stores Qty</th>
                        @if (isUae)
                        {
                            <th rowspan="2" style="text-align:right">UAE Qty</th>
                            <th rowspan="2" style="text-align:right">Oman Qty</th>
                            <th rowspan="2" style="text-align:right">Ex2 Qty</th>
                        }
                        <th colspan="3" style="text-align:center">Merch Need</th>
                    </tr>
                    <tr>
                        <th style="text-align:right">Month</th>
                        <th style="text-align:right">Week</th>
                        <th style="text-align:right">Day</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in pivot)
                    {
                        <tr>
                            <td>@p.ProductionDay.ToString("dd-MMM-yyyy")</td>
                            @if (multiCountry) { <td>@p.Country</td> }
                            <td>@p.Division</td>
                            @if (hasMixed) { <td style="text-align:right">@p.Mixed.ToString("N0")</td> }
                            <td style="text-align:right">@p.Unknown.ToString("N0")</td>
                            <td style="text-align:right; font-weight:600">@p.ScannedQty.ToString("N0")</td>
                            <td style="text-align:right; font-weight:600">@p.StoresQty.ToString("N0")</td>
                            @if (isUae)
                            {
                                <td style="text-align:right">@p.UaeQty.ToString("N0")</td>
                                <td style="text-align:right">@p.OmanQty.ToString("N0")</td>
                                <td style="text-align:right">@p.Ex2Qty.ToString("N0")</td>
                            }
                            <td style="text-align:right">@p.MerchNeedMonth.ToString("N0")</td>
                            <td style="text-align:right">@p.MerchNeedWeek.ToString("N0")</td>
                            <td style="text-align:right">@p.MerchNeedDay.ToString("N0")</td>
                        </tr>
                    }
                    <tr style="font-weight:700; background:#fff7e0">
                        <td colspan="@(multiCountry ? 3 : 2)">TOTAL</td>
                        @if (hasMixed) { <td style="text-align:right">@pivot.Sum(x => x.Mixed).ToString("N0")</td> }
                        <td style="text-align:right">@pivot.Sum(x => x.Unknown).ToString("N0")</td>
                        <td style="text-align:right">@pivot.Sum(x => x.ScannedQty).ToString("N0")</td>
                        <td style="text-align:right">@pivot.Sum(x => x.StoresQty).ToString("N0")</td>
                        @if (isUae)
                        {
                            <td style="text-align:right">@pivot.Sum(x => x.UaeQty).ToString("N0")</td>
                            <td style="text-align:right">@pivot.Sum(x => x.OmanQty).ToString("N0")</td>
                            <td style="text-align:right">@pivot.Sum(x => x.Ex2Qty).ToString("N0")</td>
                        }
                        <td style="text-align:right">@totalMerchNeedMonth.ToString("N0")</td>
                        <td style="text-align:right">@totalMerchNeedWeek.ToString("N0")</td>
                        <td style="text-align:right">@totalMerchNeedDay.ToString("N0")</td>
                    </tr>
                </tbody>
            </table>
        }
        else
        {
            var multiCountryDetail = _selectedCountries.Count > 1;
            <table class="aiwms-table aiwms-table-dense">
                <thead>
                    <tr>
                        <th>Date</th>
                        @if (multiCountryDetail) { <th>Country</th> }
                        <th>BatchNo</th>
                        <th>Kind</th>
                        <th>Division</th>
                        <th style="text-align:right">Total Scanned</th>
                        <th style="text-align:right">Store Qty</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in visibleRows)
                    {
                        <tr>
                            <td>@r.ProductionDay.ToString("dd-MMM-yyyy")</td>
                            @if (multiCountryDetail) { <td>@r.Country</td> }
                            <td>@(r.BatchNo?.ToString() ?? "Unknown")</td>
                            <td>@r.Kind</td>
                            <td>@r.Division</td>
                            <td style="text-align:right">@r.TotalScanned.ToString("N0")</td>
                            <td style="text-align:right">@r.StoreQty.ToString("N0")</td>
                        </tr>
                    }
                    <tr style="font-weight:700; background:#fff7e0">
                        <td colspan="@(multiCountryDetail ? 5 : 4)">TOTAL</td>
                        <td style="text-align:right">@visibleRows.Sum(r => r.TotalScanned).ToString("N0")</td>
                        <td style="text-align:right">@visibleRows.Sum(r => r.StoreQty).ToString("N0")</td>
                    </tr>
                </tbody>
            </table>
        }
    </div>
}
else if (_loadedOnce && VisibleRows().Count == 0)
{
    <div class="aiwms-section"><div class="aiwms-alert info">No scans found for the selected range.</div></div>
}

@code {
    private List<string> _countries = new() { "UAE" };
    private HashSet<string> _selectedCountries = new(StringComparer.OrdinalIgnoreCase) { "UAE" };
    // UAE always reads via OnPremBackup (no per-country connection string needed), so it's
    // implicitly "configured" regardless of UAE_DB_ConnectionString. Every other country needs
    // a configured {Country}_DB_ConnectionString or GetProductionCheckingAsync silently returns 0 rows.
    private HashSet<string> _configuredCountries = new(StringComparer.OrdinalIgnoreCase) { "UAE" };
    private string _selectedWeek = ComputeCurrentWeekNumber();
    private DateTime _from = ComputeCurrentWeekRange().Start;
    private DateTime _to   = ComputeCurrentWeekRange().End;
    private string _view = "Summary";
    private bool _loading;
    private string? _loadingMsg;
    private bool _loadedOnce;
    private string _message = "";
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CurrentUser.EnsureLoadedAsync();
            var list = await Svc.GetCountriesAsync();
            var excluded = new[] { "ECOM", "Ex2Locations", "Oman" };
            list = list.Where(c => !excluded.Contains(c, StringComparer.OrdinalIgnoreCase)).ToList();
            // Only fall back to the hard-coded UAE seed when the lookup itself came back
            // empty (fetch problem) — a legitimately empty *filtered* result (user has no
            // country grants) must stay empty, not silently re-widen to "UAE".
            if (list.Count > 0) _countries = CurrentUser.FilterCountries(list).ToList();
        }
        catch { /* fall back to the hard-coded UAE seed if the lookup fails */ }

        try
        {
            foreach (var c in Resolver.GetConfiguredCountries()) _configuredCountries.Add(c);
        }
        catch { /* if this fails, checkboxes just won't show the "(not connected)" hint */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await JS.InvokeVoidAsync("eval", @"
            (function(){
                if (window.__psrCountryDropdownBound) return;
                window.__psrCountryDropdownBound = true;
                document.addEventListener('click', function (e) {
                    var d = document.getElementById('psr-country-dropdown');
                    if (d && d.open && !d.contains(e.target)) d.removeAttribute('open');
                });
            })();");
    }

    private void ToggleCountry(string country, bool isChecked)
    {
        if (isChecked) _selectedCountries.Add(country);
        else _selectedCountries.Remove(country);
    }

    private void ToggleAllCountries(bool isChecked)
    {
        if (isChecked) foreach (var c in _countries) _selectedCountries.Add(c);
        else _selectedCountries.Clear();
    }

    private string CountrySelectionLabel
    {
        get
        {
            var picked = _countries.Where(c => _selectedCountries.Contains(c)).ToList();
            return picked.Count switch
            {
                0 => "Select countries...",
                <= 2 => string.Join(", ", picked),
                _ => $"{picked.Count} countries selected"
            };
        }
    }

    private sealed record CountryRow(
        string Country, DateTime ProductionDay, long? BatchNo, string Kind, string Division,
        long TotalScanned, int StoreQty);

    private sealed record CountrySummaryRow(
        string Country, DateTime ProductionDay, string Kind, string Division,
        long TotalScanned, int StoreQty, int UaeStoreQty, int OmanStoreQty, int Ex2StoreQty, long Ex2TotalScanned);

    private List<CountryRow>        _rows = new();
    private List<CountrySummaryRow> _summary = new();
    private int  _overallStoreQty;
    private long _transferQty;
    private Dictionary<string, long> _transferQtyByCountry = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, MerchNeedRow> _merchNeedByCountry = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, List<MerchNeedDivisionRow>> _merchNeedByCountryDivision = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, List<Ex2ShopRow>> _ex2ShopsByCountry = new(StringComparer.OrdinalIgnoreCase);

    // Sum of Ex2Shops StoreQty across every visible country's data, for one actual
    // Ex2Locations country (e.g. "KSA", "QATAR") -- see Ex2ShopRow.Country.
    private int VisibleEx2ShopQty(string shopCountry) =>
        _ex2ShopsByCountry
            .Where(kv => _selectedCountries.Contains(kv.Key))
            .SelectMany(kv => kv.Value)
            .Where(s => string.Equals(s.Country, shopCountry, StringComparison.OrdinalIgnoreCase))
            .Sum(s => s.StoreQty);

    private (long Month, long Week, long Day) MerchNeedFor(string country, string division)
    {
        if (_merchNeedByCountryDivision.TryGetValue(country, out var list))
        {
            var match = list.FirstOrDefault(d => string.Equals(d.Division, division, StringComparison.OrdinalIgnoreCase));
            if (match is not null) return (match.MerchNeedMonth, match.MerchNeedWeek, match.MerchNeedDay);
        }
        return (0, 0, 0);
    }

    // Divisions with Merch Need data but zero scans that day are otherwise invisible in the
    // Summary pivot (it's grouped from scan rows), so add a zero-production row for each one
    // per (Country, ProductionDay) already present in the report.
    private List<DivisionPivotRow> WithMissingMerchNeedDivisions(List<DivisionPivotRow> pivot)
    {
        var missing = pivot
            .Select(p => (p.Country, p.ProductionDay))
            .Distinct()
            .SelectMany(cd => _merchNeedByCountryDivision.GetValueOrDefault(cd.Country, new())
                .Where(mn => !pivot.Any(p =>
                    string.Equals(p.Country, cd.Country, StringComparison.OrdinalIgnoreCase) &&
                    p.ProductionDay == cd.ProductionDay &&
                    string.Equals(p.Division, mn.Division, StringComparison.OrdinalIgnoreCase)))
                .Select(mn => new DivisionPivotRow(
                    cd.Country, cd.ProductionDay, mn.Division,
                    0, 0, 0, 0, 0, 0, 0, 0, 0,
                    mn.MerchNeedMonth, mn.MerchNeedWeek, mn.MerchNeedDay)));
        return pivot.Concat(missing)
            .OrderByDescending(x => x.ProductionDay)
            .ThenBy(x => x.Country)
            .ThenBy(x => x.Division)
            .ToList();
    }

    private bool CanLoad => _selectedCountries.Count > 0 && _from <= _to;

    // The report caches every country ever loaded this session (so re-checking a country you
    // unchecked doesn't need a re-query), but the display must always reflect only what's
    // currently ticked in the country picker.
    private List<CountryRow>        VisibleRows()    => _rows.Where(r => _selectedCountries.Contains(r.Country)).ToList();
    private List<CountrySummaryRow> VisibleSummary() => _summary.Where(s => _selectedCountries.Contains(s.Country)).ToList();
    private bool HasAnyVisibleRows => _rows.Any(r => _selectedCountries.Contains(r.Country));

    private sealed record CountrySummaryTotals(
        string Country, long StoreQty, long TransferQty, long TotalScanned, long Lpm, long NonLpm, long Unknown,
        long MerchNeedMonth, long MerchNeedWeek, long MerchNeedDay,
        long Ex2StoreQty, long Ex2TotalScanned, long Ex2Unknown);

    private List<CountrySummaryTotals> CountrySummaries(List<CountryRow> rows)
    {
        var summaryByCountry = VisibleSummary()
            .GroupBy(s => s.Country, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.ToList(), StringComparer.OrdinalIgnoreCase);

        return rows.GroupBy(r => r.Country)
            .Select(g =>
            {
                var sRows = summaryByCountry.GetValueOrDefault(g.Key) ?? new();
                return new CountrySummaryTotals(
                    g.Key,
                    g.Sum(r => r.StoreQty),
                    _transferQtyByCountry.GetValueOrDefault(g.Key),
                    g.Sum(r => r.TotalScanned),
                    g.Where(r => r.Kind == "LPM").Sum(r => r.TotalScanned),
                    g.Where(r => r.Kind == "Non-LPM").Sum(r => r.TotalScanned),
                    g.Where(r => r.Kind == "Unknown").Sum(r => r.TotalScanned),
                    _merchNeedByCountry.GetValueOrDefault(g.Key)?.MerchNeedMonth ?? 0,
                    _merchNeedByCountry.GetValueOrDefault(g.Key)?.MerchNeedWeek  ?? 0,
                    _merchNeedByCountry.GetValueOrDefault(g.Key)?.MerchNeedDay   ?? 0,
                    sRows.Sum(s => (long)s.Ex2StoreQty),
                    sRows.Sum(s => s.Ex2TotalScanned),
                    sRows.Where(s => s.Kind == "Unknown").Sum(s => s.Ex2TotalScanned));
            })
            .OrderBy(c => c.Country)
            .ToList();
    }

    private sealed record DivisionPivotRow(
        string Country, DateTime ProductionDay, string Division,
        long Lpm, long NonLpm, long Mixed, long Unknown,
        long ScannedQty, int StoresQty, int UaeQty, int OmanQty, int Ex2Qty,
        long MerchNeedMonth, long MerchNeedWeek, long MerchNeedDay);

    // Current WH production day in GST (UTC+4). If "now" is before 06:00 GST,
    // the production day is yesterday.
    private static DateTime CurrentProductionDayGst()
    {
        var nowGst = DateTime.UtcNow.AddHours(4);
        return nowGst.Hour < 6 ? nowGst.Date.AddDays(-1) : nowGst.Date;
    }

    // Simple Week 1..52/53 list for the current calendar year — 7-day blocks
    // starting on the first Sunday on/after Jan 1 (the last week is truncated
    // to Dec 31). "4-4-5" grouping is a retail-calendar convention for rolling
    // these into months/quarters; this list only needs the flat week numbering
    // for the dropdown.
    private IEnumerable<(int Num, DateTime Start, DateTime End)> Weeks
    {
        get
        {
            var year       = CurrentProductionDayGst().Year;
            var week1Start = FirstWeekStart(year);
            var dec31      = new DateTime(year, 12, 31);
            var weekCount  = (int)Math.Ceiling(((dec31 - week1Start).Days + 1) / 7.0);
            for (var i = 0; i < weekCount; i++)
            {
                var start = week1Start.AddDays(i * 7);
                var end   = start.AddDays(6);
                if (end > dec31) end = dec31;
                yield return (i + 1, start, end);
            }
        }
    }

    private static DateTime FirstWeekStart(int year)
    {
        var jan1 = new DateTime(year, 1, 1);
        var daysUntilSunday = ((int)DayOfWeek.Sunday - (int)jan1.DayOfWeek + 7) % 7;
        return jan1.AddDays(daysUntilSunday);
    }

    private static string ComputeCurrentWeekNumber()
    {
        var today      = CurrentProductionDayGst();
        var week1Start = FirstWeekStart(today.Year);
        if (today < week1Start) return "1";
        return (((today - week1Start).Days / 7) + 1).ToString();
    }

    private static (DateTime Start, DateTime End) ComputeCurrentWeekRange()
    {
        var today      = CurrentProductionDayGst();
        var week1Start = FirstWeekStart(today.Year);
        var start = today < week1Start
            ? week1Start
            : week1Start.AddDays((today - week1Start).Days / 7 * 7);
        var dec31 = new DateTime(today.Year, 12, 31);
        var end = start.AddDays(6);
        if (end > dec31) end = dec31;
        return (start, end);
    }

    private void OnWeekChanged()
    {
        if (!int.TryParse(_selectedWeek, out var num)) return;
        foreach (var w in Weeks)
        {
            if (w.Num != num) continue;
            _from = w.Start;
            _to   = w.End;
            break;
        }
    }

    private async Task LoadAsync()
    {
        if (!CanLoad) return;
        _loading = true; _message = ""; _loadedOnce = false;
        _rows.Clear(); _summary.Clear(); _overallStoreQty = 0; _transferQty = 0; _transferQtyByCountry.Clear(); _merchNeedByCountry.Clear(); _merchNeedByCountryDivision.Clear(); _ex2ShopsByCountry.Clear();
        await InvokeAsync(StateHasChanged);
        try
        {
            var countries = _selectedCountries.ToList();
            var merchNeedErrors = new List<string>();
            var selectedWeekNum = int.TryParse(_selectedWeek, out var w) ? w : int.Parse(ComputeCurrentWeekNumber());
            var selectedWeekDayCount = Weeks.Where(x => x.Num == selectedWeekNum)
                .Select(x => (x.End - x.Start).Days + 1)
                .DefaultIfEmpty(7)
                .First();
            for (int i = 0; i < countries.Count; i++)
            {
                var country = countries[i];
                _loadingMsg = string.Equals(country, "UAE", StringComparison.OrdinalIgnoreCase)
                    ? $"Reading scans from UAE master… ({i + 1}/{countries.Count})"
                    : $"Connecting to {country} server, reading scans, then enriching against LPMSIM_Batch… ({i + 1}/{countries.Count})";
                await InvokeAsync(StateHasChanged);

                var result = await Svc.GetProductionCheckingAsync(country, _from, _to);
                _rows.AddRange(result.Rows.Select(r => new CountryRow(
                    country, r.ProductionDay, r.BatchNo, r.Kind, r.Division, r.TotalScanned, r.StoreQty)));
                _summary.AddRange(result.Summary.Select(s => new CountrySummaryRow(
                    country, s.ProductionDay, s.Kind, s.Division, s.TotalScanned, s.StoreQty,
                    s.UaeStoreQty, s.OmanStoreQty, s.Ex2StoreQty, s.Ex2TotalScanned)));
                _overallStoreQty += result.OverallStoreQty;
                _transferQty     += result.TransferQty;
                _transferQtyByCountry[country] = result.TransferQty;
                _ex2ShopsByCountry[country] = result.Ex2Shops;

                // Merch Need reads LPMSIM.dbo.tmpPlanningTarget directly, keyed off the
                // selected week (4-4-5 month bucket) — independent of the per-country scan
                // connection above, so fetch it even for countries with no scan connection.
                try { _merchNeedByCountry[country] = await Svc.GetMerchNeedAsync(country, selectedWeekNum, selectedWeekDayCount); }
                catch (Exception mnEx) { merchNeedErrors.Add($"{country}: {mnEx.Message}"); _merchNeedByCountry[country] = new MerchNeedRow(0, 0, 0); }

                try { _merchNeedByCountryDivision[country] = await Svc.GetMerchNeedByDivisionAsync(country, selectedWeekNum, selectedWeekDayCount); }
                catch (Exception mnEx) { merchNeedErrors.Add($"{country} (by division): {mnEx.Message}"); _merchNeedByCountryDivision[country] = new(); }
            }
            _loadedOnce = true;
            var unconfigured = countries.Where(c => !_configuredCountries.Contains(c)).ToList();
            var notes = new List<string>();
            if (unconfigured.Count > 0)
            {
                notes.Add($"{string.Join(", ", unconfigured)} {(unconfigured.Count == 1 ? "has" : "have")} no DB connection configured, so {(unconfigured.Count == 1 ? "it" : "they")} will always show 0 rows here.");
            }
            if (merchNeedErrors.Count > 0)
            {
                notes.Add($"Merch Need lookup failed for: {string.Join(" | ", merchNeedErrors)}");
            }
            if (notes.Count > 0) ShowInfo("Note: " + string.Join(" ", notes));
        }
        catch (Exception ex) { ShowError($"Load failed: {ex.Message}"); }
        finally { _loading = false; _loadingMsg = null; }
    }

    private async Task ExportCsvAsync()
    {
        var visibleRows    = VisibleRows();
        var visibleSummary = VisibleSummary();
        if (visibleRows.Count == 0) return;
        var sb = new StringBuilder();
        var multiCountry = _selectedCountries.Count > 1;
        if (_view == "Summary")
        {
            var pivot = visibleSummary
                .GroupBy(s => new { s.Country, s.ProductionDay, s.Division })
                .Select(g =>
                {
                    var mn = MerchNeedFor(g.Key.Country, g.Key.Division);
                    return new DivisionPivotRow(
                        g.Key.Country, g.Key.ProductionDay, g.Key.Division,
                        g.Where(x => x.Kind == "LPM").Sum(x => x.TotalScanned),
                        g.Where(x => x.Kind == "Non-LPM").Sum(x => x.TotalScanned),
                        g.Where(x => x.Kind == "Mixed").Sum(x => x.TotalScanned),
                        g.Where(x => x.Kind == "Unknown").Sum(x => x.TotalScanned),
                        g.Sum(x => x.TotalScanned), g.Sum(x => x.StoreQty),
                        g.Sum(x => x.UaeStoreQty), g.Sum(x => x.OmanStoreQty), g.Sum(x => x.Ex2StoreQty),
                        mn.Month, mn.Week, mn.Day);
                })
                .OrderByDescending(x => x.ProductionDay).ThenBy(x => x.Country).ThenBy(x => x.Division).ToList();
            pivot = WithMissingMerchNeedDivisions(pivot);
            var isUae = _selectedCountries.Contains("UAE");
            if (multiCountry) sb.Append("Country,");
            sb.Append("Date,Division,LPM,Non-LPM,Mixed,Unknown,Scanned Qty,Stores Qty");
            if (isUae) sb.Append(",UAE Qty,Oman Qty,Ex2 Qty");
            sb.Append(",Merch Need Month,Merch Need Week,Merch Need Day");
            sb.AppendLine();
            foreach (var p in pivot)
            {
                if (multiCountry) sb.Append(Csv(p.Country)).Append(',');
                sb.Append(p.ProductionDay.ToString("yyyy-MM-dd")).Append(',')
                  .Append(Csv(p.Division)).Append(',')
                  .Append(p.Lpm).Append(',').Append(p.NonLpm).Append(',')
                  .Append(p.Mixed).Append(',').Append(p.Unknown).Append(',')
                  .Append(p.ScannedQty).Append(',').Append(p.StoresQty);
                if (isUae) sb.Append(',').Append(p.UaeQty).Append(',').Append(p.OmanQty).Append(',').Append(p.Ex2Qty);
                sb.Append(',').Append(p.MerchNeedMonth).Append(',').Append(p.MerchNeedWeek).Append(',').Append(p.MerchNeedDay);
                sb.AppendLine();
            }
            if (multiCountry) sb.Append(",");
            sb.Append("TOTAL,,").Append(pivot.Sum(x => x.Lpm)).Append(',').Append(pivot.Sum(x => x.NonLpm)).Append(',')
              .Append(pivot.Sum(x => x.Mixed)).Append(',').Append(pivot.Sum(x => x.Unknown)).Append(',')
              .Append(pivot.Sum(x => x.ScannedQty)).Append(',').Append(pivot.Sum(x => x.StoresQty));
            if (isUae) sb.Append(',').Append(pivot.Sum(x => x.UaeQty)).Append(',').Append(pivot.Sum(x => x.OmanQty)).Append(',').Append(pivot.Sum(x => x.Ex2Qty));
            // Merch Need is a per-(Country, Division) constant; a division can span
            // multiple rows here (one per ProductionDay), so total each division's
            // value exactly once rather than once per row. Case-insensitive key: see
            // the on-screen TOTAL row above for why (Title Case scan rows vs ALL CAPS
            // synthetic missing-division rows).
            var distinctDivisionMerchNeedCsv = pivot
                .GroupBy(x => (x.Country.ToUpperInvariant(), x.Division.ToUpperInvariant()))
                .Select(g => g.First())
                .ToList();
            sb.Append(',').Append(distinctDivisionMerchNeedCsv.Sum(x => x.MerchNeedMonth))
              .Append(',').Append(distinctDivisionMerchNeedCsv.Sum(x => x.MerchNeedWeek))
              .Append(',').Append(distinctDivisionMerchNeedCsv.Sum(x => x.MerchNeedDay));
            sb.AppendLine();
        }
        else
        {
            if (multiCountry) sb.Append("Country,");
            sb.AppendLine("Date,BatchNo,Kind,Division,Total Scanned,Store Qty");
            foreach (var r in visibleRows)
            {
                if (multiCountry) sb.Append(Csv(r.Country)).Append(',');
                sb.AppendLine($"{r.ProductionDay:yyyy-MM-dd},{r.BatchNo?.ToString() ?? "Unknown"},{Csv(r.Kind)},{Csv(r.Division)},{r.TotalScanned},{r.StoreQty}");
            }
            if (multiCountry) sb.Append(",");
            sb.AppendLine($"TOTAL,,,,{visibleRows.Sum(r => r.TotalScanned)},{visibleRows.Sum(r => r.StoreQty)}");
        }
        var b64 = Convert.ToBase64String(Encoding.UTF8.GetBytes(sb.ToString()));
        var countryTag = _selectedCountries.Count > 3 ? $"Multi{_selectedCountries.Count}" : string.Join("-", _selectedCountries.OrderBy(c => c));
        var filename = $"ProductionSummary_{countryTag}_{_view}_{_from:yyyyMMdd}_{_to:yyyyMMdd}.csv";
        await JS.InvokeVoidAsync("eval", $"(function(){{var a=document.createElement('a');a.href='data:text/csv;base64,{b64}';a.download='{filename}';document.body.appendChild(a);a.click();document.body.removeChild(a);}})();");
    }

    private static string Csv(string? s) => s is null ? ""
        : (s.Contains(',') || s.Contains('"') || s.Contains('\n')) ? "\"" + s.Replace("\"", "\"\"") + "\"" : s;

    private RenderFragment MetricCard(string label, string value, string bg, string fg, bool big) => __builder =>
    {
        <div style="background:@bg; color:@fg; padding:12px 16px; border-radius:var(--r-sm); border:1px solid #00000010; text-align:center; display:flex; flex-direction:column; align-items:center; justify-content:center;">
            <div style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1px">@label</div>
            <div style="font-size:@(big ? "1.6rem" : "1.2rem"); font-weight:@(big ? "900" : "700")">@value</div>
        </div>
    };

    private RenderFragment ShopCard(string label, string value, string fg) => __builder =>
    {
        <div style="background:#f8f7fc; color:@fg; padding:12px 16px; border-radius:var(--r-sm); border:1px solid #00000010; text-align:center; display:flex; flex-direction:column; align-items:center; justify-content:center;">
            <div style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:1px">@label</div>
            <div style="font-size:1.2rem; font-weight:700">@value</div>
        </div>
    };

    private void ShowError(string msg) { _message = msg; _isError = true; }
    private void ShowInfo(string msg)  { _message = msg; _isError = false; }
