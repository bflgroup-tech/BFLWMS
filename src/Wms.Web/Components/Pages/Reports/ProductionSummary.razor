@page "/reports/production-summary"
@rendermode RenderMode.InteractiveServer
@using System.Text
@using Wms.Core
@using Wms.Data.Configuration
@using Wms.Data.Lpm
@attribute [Authorize(Policy = MenuKeys.RPT_PRODUCTION_SUMMARY)]
@inject ReportsService Svc
@inject IOnPremConnectionResolver Resolver
@inject ICurrentUser CurrentUser
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>WMS — Production Summary Report</PageTitle>

<style>
    .psr-country-select summary { list-style: none; }
    .psr-country-select summary::-webkit-details-marker { display: none; }
    .psr-country-select summary {
        transition: border-color .15s ease, box-shadow .15s ease;
    }
    .psr-country-select summary:hover {
        border-color: var(--border-strong);
    }
    .psr-country-select details[open] summary {
        border-color: var(--bfl-yellow);
        box-shadow: 0 0 0 3px rgba(255, 209, 0, .18);
    }
    .psr-country-select .psr-arrow {
        display: inline-block;
        transition: transform .15s ease;
    }
    .psr-country-select details[open] .psr-arrow {
        transform: rotate(180deg);
    }
    .psr-country-select .psr-option {
        border-radius: 4px;
        padding: 6px 8px;
        margin: 0 -2px;
        transition: background-color .1s ease;
    }
    .psr-country-select .psr-option:hover {
        background: var(--bfl-yellow-lite);
    }
    .psr-country-select .psr-option input[type="checkbox"] {
        width: 15px;
        height: 15px;
        accent-color: var(--bfl-yellow-hov);
        cursor: pointer;
    }
</style>

<div class="aiwms-page-header">
    <h2>Production Summary Report</h2>
    <p>Per-batch view of items scanned through QC (<code>usa.dbo.amechecking</code>), split by LPM vs Non-LPM via <code>LPMSIM_Batch.Sources</code>. Each picked date is one WH production day: <strong>06:00 GST → 06:00 GST next day</strong>.</p>
</div>

<div class="aiwms-section">
    <div style="display:grid; grid-template-columns: 1fr 1fr 1fr 1fr auto auto; gap:12px; align-items:end;">
        <div class="psr-country-select">
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">COUNTRY (select any) *</label>
            <details id="psr-country-dropdown" style="position:relative;">
                <summary style="display:flex; align-items:center; justify-content:space-between; gap:8px; width:100%; height:36px; box-sizing:border-box; padding:8px 12px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; font-weight:600; background:white; cursor:pointer; user-select:none;">
                    <span style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@CountrySelectionLabel</span>
                    <span class="psr-arrow" style="color:var(--text-secondary); font-size:10px; flex-shrink:0;">&#9660;</span>
                </summary>
                <div style="position:absolute; top:100%; left:0; right:0; z-index:20; margin-top:6px; display:flex; flex-direction:column; gap:2px; max-height:220px; overflow-y:auto; border:1px solid var(--border-default); border-radius:8px; padding:8px; background:white; box-shadow:0 8px 20px rgba(0,0,0,0.14);">
                    <label class="psr-option" style="display:flex; align-items:center; gap:8px; cursor:pointer; font-size:13px; font-weight:700; border-bottom:1px solid var(--border-default); padding-bottom:8px; margin-bottom:2px">
                        <input type="checkbox" checked="@_countries.All(c => _selectedCountries.Contains(c))" @onchange="@(e => ToggleAllCountries((bool)e.Value!))" />
                        Select all
                    </label>
                    @foreach (var c in _countries)
                    {
                        <label class="psr-option" style="display:flex; align-items:center; gap:8px; cursor:pointer; font-size:13px">
                            <input type="checkbox" checked="@_selectedCountries.Contains(c)" @onchange="@(e => ToggleCountry(c, (bool)e.Value!))" />
                            @c
                            @if (!_configuredCountries.Contains(c))
                            {
                                <span style="color:var(--s-pending, #C98512); font-size:11px; font-style:italic;">(not connected)</span>
                            }
                        </label>
                    }
                </div>
            </details>
        </div>
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">WEEK</label>
            <select @bind="_selectedWeek" @bind:after="OnWeekChanged" style="width:100%; height:36px; box-sizing:border-box; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;">
                @foreach (var w in Weeks)
                {
                    <option value="@w.Num">W@(w.Num) &middot; @w.Start.ToString("dd-MMM") &rarr; @w.End.ToString("dd-MMM")</option>
                }
            </select>
        </div>
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">FROM</label>
            <input type="date" @bind="_from" @bind:format="yyyy-MM-dd" max="@DateTime.Today.ToString("yyyy-MM-dd")" style="width:100%; height:36px; box-sizing:border-box; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
        </div>
        <div>
            <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">TO</label>
            <input type="date" @bind="_to" @bind:format="yyyy-MM-dd" max="@DateTime.Today.ToString("yyyy-MM-dd")" style="width:100%; height:36px; box-sizing:border-box; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
        </div>
        <button class="aiwms-btn aiwms-btn-primary" style="height:36px; box-sizing:border-box" @onclick="LoadAsync" disabled="@(_loading || !CanLoad)">@(_loading ? "Loading…" : "Load")</button>
        <button class="aiwms-btn aiwms-btn-secondary" style="height:36px; box-sizing:border-box" @onclick="ExportCsvAsync" disabled="@(!HasAnyVisibleRows || _loading)">Export to Excel</button>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="aiwms-alert @(_isError ? "error" : "info")" style="margin-top:12px">@_message</div>
    }
</div>

@if (_loading)
{
    <div class="aiwms-section" style="padding:0; overflow:hidden">
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
        <div style="padding:14px; font-style:italic; color:var(--text-secondary)">@(_loadingMsg ?? "Loading…")</div>
    </div>
}
else if (VisibleRows().Count > 0)
{
    var visibleRows    = VisibleRows();
    var visibleSummary = VisibleSummary();
    var canSeeOverallSummary = CurrentUser.HasAllCountriesAccess
        || string.Equals(CurrentUser.Name, "mukarram@bflgroup.ae", StringComparison.OrdinalIgnoreCase);

    @if (_selectedCountries.Count > 1 && canSeeOverallSummary)
    {
        var totScanned = visibleRows.Sum(r => r.TotalScanned);
        var unkQty     = visibleRows.Where(r => r.Kind == "Unknown").Sum(r => r.TotalScanned);
        var visibleStoreQty    = visibleRows.Sum(r => r.StoreQty);
        var visibleTransferQty = _transferQtyByCountry.Where(kv => _selectedCountries.Contains(kv.Key)).Sum(kv => kv.Value);
        var visibleMerchNeed   = _merchNeedByCountry.Where(kv => _selectedCountries.Contains(kv.Key)).Select(kv => kv.Value).ToList();
        var merchNeedWeek      = visibleMerchNeed.Sum(m => m.MerchNeedWeek);
        var merchNeedDay       = visibleMerchNeed.Sum(m => m.MerchNeedDay);
        var isUaeVisible       = _selectedCountries.Contains("UAE");
        var visibleEx2Qty      = visibleSummary.Sum(s => s.Ex2StoreQty);

        <div class="aiwms-section">
            <div style="display:grid; grid-template-columns: repeat(@(isUaeVisible ? 7 : 6), 1fr); gap:12px;">
                @MetricCard("Store Qty",      visibleStoreQty.ToString("N0"), "#fdf2f8", "#9d174d", false)
                @if (visibleTransferQty > 0)
                {
                    @MetricCard("Transfer Qty",   visibleTransferQty.ToString("N0"),     "#ccfbf1", "#0f766e", false)
                }
                @MetricCard("Total Scanned", totScanned.ToString("N0"),       "#dbeafe", "#1e40af", false)
                @MetricCard("Unknown",       unkQty.ToString("N0"),           "#fef3c7", "#92400e", false)
                @if (isUaeVisible)
                {
                    @MetricCard("EX2LOCATIONS", visibleEx2Qty.ToString("N0"), "#ede9fe", "#5b21b6", false)
                }
                @MetricCard("Merch Need (Week)",  merchNeedWeek.ToString("N0"),  "#ffedd5", "#9a3412", false)
                @MetricCard("Merch Need (Day)",   merchNeedDay.ToString("N0"),   "#ffedd5", "#9a3412", false)
            </div>
        </div>
    }

    @if (_selectedCountries.Count > 0)
    {
        <div class="aiwms-section">
            <div class="aiwms-card-header">By Country</div>
            @foreach (var cs in CountrySummaries(visibleRows))
            {
                var merchNeedPct = cs.MerchNeedWeek > 0 ? (double)cs.StoreQty / cs.MerchNeedWeek * 100 : 0;
                var merchNeedPctColor = merchNeedPct >= 100 ? "#15803d" : "#dc2626";
                <div style="margin-bottom:14px; border:1px solid var(--border-default); border-radius:var(--r-sm); padding:14px;">
                    <div style="display:flex; align-items:baseline; justify-content:space-between; margin-bottom:10px;">
                        <div style="font-size:16px; font-weight:800; text-transform:uppercase; letter-spacing:1px; color:var(--text-secondary);">@cs.Country</div>
                        <div style="font-size:16px; font-weight:800; text-transform:uppercase; letter-spacing:1px; color:@merchNeedPctColor;">
                            Merch Need % @merchNeedPct.ToString("N1")%
                        </div>
                    </div>
                    <div style="display:grid; grid-template-columns: repeat(6, 1fr); gap:12px;">
                        @MetricCard("Store Qty",      cs.StoreQty.ToString("N0"),     "#fdf2f8", "#9d174d", false)
                        @MetricCard("Transfer Qty",   cs.TransferQty.ToString("N0"),  "#ccfbf1", "#0f766e", false)
                        @MetricCard("Total Scanned",  cs.TotalScanned.ToString("N0"), "#dbeafe", "#1e40af", false)
                        @MetricCard("Unknown",        cs.Unknown.ToString("N0"),      "#fef3c7", "#92400e", false)
                        @MetricCard("Merch Need (Week)",  cs.MerchNeedWeek.ToString("N0"),  "#ffedd5", "#9a3412", false)
                        @MetricCard("Merch Need (Day)",   cs.MerchNeedDay.ToString("N0"),   "#ffedd5", "#9a3412", false)
                    </div>
                    @if (string.Equals(cs.Country, "UAE", StringComparison.OrdinalIgnoreCase))
                    {
                        <div style="margin:10px 12px 0 12px; padding-top:10px; border-top:1px dashed var(--border-default);">
                            <div style="display:grid; grid-template-columns: repeat(7, 1fr); gap:12px;">
                                @ShopCard("UA", "UAE Shops",   VisibleEx2ShopQty("UAE").ToString("N0"),  "#166534")
                                @ShopCard("OM", "Oman Shops",  VisibleEx2ShopQty("OMAN").ToString("N0"), "#166534")
                                @ShopCard("KS", "EX2KSA",      VisibleEx2ShopQty("KSA").ToString("N0"),      "#6d28d9")
                                @ShopCard("QA", "EX2QATAR",    VisibleEx2ShopQty("QATAR").ToString("N0"),    "#6d28d9")
                                @ShopCard("BH", "EX2BAHRAIN",  VisibleEx2ShopQty("BAHRAIN").ToString("N0"),   "#6d28d9")
                                @ShopCard("KW", "EX2KUWAIT",   VisibleEx2ShopQty("KUWAIT").ToString("N0"),    "#6d28d9")
                                @ShopCard("MY", "EX2MALAYSIA", VisibleEx2ShopQty("MALAYSIA").ToString("N0"),  "#6d28d9")
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <div class="aiwms-section">
        <div class="aiwms-card-header">Transfer Qty- Division wise</div>
        <div style="display:flex; gap:14px; align-items:center; margin-bottom:10px">
            <strong style="font-size:11px; text-transform:uppercase; letter-spacing:1px; color:var(--text-secondary)">View:</strong>
            <label style="display:flex; align-items:center; gap:4px; cursor:pointer"><input type="radio" name="vw" value="Summary"  checked="@(_view == "Summary")"  @onchange="@(_ => _view = "Summary")" /> Summary</label>
            <label style="display:flex; align-items:center; gap:4px; cursor:pointer"><input type="radio" name="vw" value="Detailed" checked="@(_view == "Detailed")" @onchange="@(_ => _view = "Detailed")" /> Detailed</label>
            <button class="aiwms-btn aiwms-btn-secondary" style="margin-left:auto" @onclick="@(() => _pivotCollapsed = !_pivotCollapsed)">
                @(_pivotCollapsed ? "Expand" : "Minimize")
            </button>
        </div>

        @if (!_pivotCollapsed)
        {
        @if (_view == "Summary")
        {
            var multiCountry = _selectedCountries.Count > 1;
            var pivot = visibleSummary
                .GroupBy(s => new { s.Country, s.ProductionDay, s.Division })
                .Select(g =>
                {
                    var mn = MerchNeedFor(g.Key.Country, g.Key.Division);
                    return new DivisionPivotRow(
                        g.Key.Country,
                        g.Key.ProductionDay,
                        g.Key.Division,
                        g.Where(x => x.Kind == "LPM").Sum(x => x.TotalScanned),
                        g.Where(x => x.Kind == "Non-LPM").Sum(x => x.TotalScanned),
                        g.Where(x => x.Kind == "Mixed").Sum(x => x.TotalScanned),
                        g.Where(x => x.Kind == "Unknown").Sum(x => x.TotalScanned),
                        g.Sum(x => x.TotalScanned),
                        g.Sum(x => x.StoreQty),
                        VisibleShopTransferQtyForDate("UAE", g.Key.ProductionDay),
                        VisibleShopTransferQtyForDate("OMAN", g.Key.ProductionDay),
                        VisibleEx2LocationsTransferQtyForDate(g.Key.ProductionDay),
                        mn.Month, mn.Week, mn.Day);
                })
                .OrderByDescending(x => x.ProductionDay)
                .ThenBy(x => x.Country)
                .ThenBy(x => x.Division)
                .ToList();
            pivot = WithMissingMerchNeedDivisions(pivot);
            var hasMixed = pivot.Sum(x => x.Mixed) > 0;
            var isUae = _selectedCountries.Contains("UAE");
            // Merch Need is a per-(Country, Division) constant, but a division can span
            // multiple rows here (one per ProductionDay it has scans on) — summing every
            // row would count that same Merch Need value once per day instead of once
            // overall, so total each division's value exactly once first. Key is
            // case-insensitive: real scan rows use Datareporting.subclassmaster's Title
            // Case division names, but WithMissingMerchNeedDivisions' synthetic rows use
            // tmpPlanningTarget's ALL CAPS names — same division, different casing.
            var distinctDivisionMerchNeed = pivot
                .GroupBy(x => (x.Country.ToUpperInvariant(), x.Division.ToUpperInvariant()))
                .Select(g => g.First())
                .ToList();
            var totalMerchNeedMonth = distinctDivisionMerchNeed.Sum(x => x.MerchNeedMonth);
            var totalMerchNeedWeek  = distinctDivisionMerchNeed.Sum(x => x.MerchNeedWeek);
            var totalMerchNeedDay   = distinctDivisionMerchNeed.Sum(x => x.MerchNeedDay);

            // Same dedupe idea for UaeQty/OmanQty/Ex2Qty -- a per-(Country, Day) constant
            // repeated on every Division row, so sum only the first row of each day.
            var distinctDayTransfer = pivot.GroupBy(x => (x.Country, x.ProductionDay)).Select(g => g.First()).ToList();
            var totalUaeQty  = distinctDayTransfer.Sum(x => x.UaeQty);
            var totalOmanQty = distinctDayTransfer.Sum(x => x.OmanQty);
            var totalEx2Qty  = distinctDayTransfer.Sum(x => x.Ex2Qty);
            (string Country, DateTime Day)? lastShownTransferDay = null;

            <table class="aiwms-table aiwms-table-dense">
                <thead>
                    <tr>
                        <th rowspan="2">Date</th>
                        @if (multiCountry) { <th rowspan="2">Country</th> }
                        <th rowspan="2">Division</th>
                        @if (hasMixed) { <th rowspan="2" style="text-align:right">Mixed</th> }
                        <th rowspan="2" style="text-align:right">Unknown</th>
                        <th rowspan="2" style="text-align:right">Scanned Qty</th>
                        <th rowspan="2" style="text-align:right">Transfer Qty</th>
                        @if (isUae)
                        {
                            <th rowspan="2" style="text-align:right">UAE Qty</th>
                            <th rowspan="2" style="text-align:right">Oman Qty</th>
                            <th rowspan="2" style="text-align:right">Ex2 Qty</th>
                        }
                        <th colspan="3" style="text-align:center">Merch Need</th>
                    </tr>
                    <tr>
                        <th style="text-align:right">Month</th>
                        <th style="text-align:right">Week</th>
                        <th style="text-align:right">Day</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in pivot)
                    {
                        var showTransfer = lastShownTransferDay is null ||
                            !string.Equals(lastShownTransferDay.Value.Country, p.Country, StringComparison.OrdinalIgnoreCase) ||
                            lastShownTransferDay.Value.Day != p.ProductionDay;
                        if (showTransfer) { lastShownTransferDay = (p.Country, p.ProductionDay); }
                        <tr>
                            <td>@p.ProductionDay.ToString("dd-MMM-yyyy")</td>
                            @if (multiCountry) { <td>@p.Country</td> }
                            <td>@p.Division</td>
                            @if (hasMixed) { <td style="text-align:right">@p.Mixed.ToString("N0")</td> }
                            <td style="text-align:right">@p.Unknown.ToString("N0")</td>
                            <td style="text-align:right; font-weight:600">@p.ScannedQty.ToString("N0")</td>
                            <td style="text-align:right; font-weight:600">@p.StoresQty.ToString("N0")</td>
                            @if (isUae)
                            {
                                <td style="text-align:right">@(showTransfer ? p.UaeQty.ToString("N0") : "")</td>
                                <td style="text-align:right">@(showTransfer ? p.OmanQty.ToString("N0") : "")</td>
                                <td style="text-align:right">@(showTransfer ? p.Ex2Qty.ToString("N0") : "")</td>
                            }
                            <td style="text-align:right">@p.MerchNeedMonth.ToString("N0")</td>
                            <td style="text-align:right">@p.MerchNeedWeek.ToString("N0")</td>
                            <td style="text-align:right">@p.MerchNeedDay.ToString("N0")</td>
                        </tr>
                    }
                    <tr style="font-weight:700; background:#fff7e0">
                        <td colspan="@(multiCountry ? 3 : 2)">TOTAL</td>
                        @if (hasMixed) { <td style="text-align:right">@pivot.Sum(x => x.Mixed).ToString("N0")</td> }
                        <td style="text-align:right">@pivot.Sum(x => x.Unknown).ToString("N0")</td>
                        <td style="text-align:right">@pivot.Sum(x => x.ScannedQty).ToString("N0")</td>
                        <td style="text-align:right">@pivot.Sum(x => x.StoresQty).ToString("N0")</td>
                        @if (isUae)
                        {
                            <td style="text-align:right">@totalUaeQty.ToString("N0")</td>
                            <td style="text-align:right">@totalOmanQty.ToString("N0")</td>
                            <td style="text-align:right">@totalEx2Qty.ToString("N0")</td>
                        }
                        <td style="text-align:right">@totalMerchNeedMonth.ToString("N0")</td>
                        <td style="text-align:right">@totalMerchNeedWeek.ToString("N0")</td>
                        <td style="text-align:right">@totalMerchNeedDay.ToString("N0")</td>
                    </tr>
                </tbody>
            </table>
        }
        else
        {
            var multiCountryDetail = _selectedCountries.Count > 1;
            <table class="aiwms-table aiwms-table-dense">
                <thead>
                    <tr>
                        <th>Date</th>
                        @if (multiCountryDetail) { <th>Country</th> }
                        <th>BatchNo</th>
                        <th>Kind</th>
                        <th>Division</th>
                        <th style="text-align:right">Total Scanned</th>
                        <th style="text-align:right">Store Qty</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in visibleRows)
                    {
                        <tr>
                            <td>@r.ProductionDay.ToString("dd-MMM-yyyy")</td>
                            @if (multiCountryDetail) { <td>@r.Country</td> }
                            <td>@(r.BatchNo?.ToString() ?? "Unknown")</td>
                            <td>@r.Kind</td>
                            <td>@r.Division</td>
                            <td style="text-align:right">@r.TotalScanned.ToString("N0")</td>
                            <td style="text-align:right">@r.StoreQty.ToString("N0")</td>
                        </tr>
                    }
                    <tr style="font-weight:700; background:#fff7e0">
                        <td colspan="@(multiCountryDetail ? 5 : 4)">TOTAL</td>
                        <td style="text-align:right">@visibleRows.Sum(r => r.TotalScanned).ToString("N0")</td>
                        <td style="text-align:right">@visibleRows.Sum(r => r.StoreQty).ToString("N0")</td>
                    </tr>
                </tbody>
            </table>
        }
        }
    </div>
}
else if (_loadedOnce && VisibleRows().Count == 0)
{
    <div class="aiwms-section"><div class="aiwms-alert info">No scans found for the selected range.</div></div>
}

@if (CanSeeDtbw)
{
        @if (_dtbwColumns.Count > 0)
        {
            var pivot = BuildDtbwPivot();
            <div class="aiwms-section">
                <div class="aiwms-card-header">Daily Transfer Qty by Warehouse — Week @_selectedWeek</div>
                <div style="overflow-x:auto">
                    <table class="aiwms-table aiwms-table-dense" style="font-size:12px">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Day</th>
                                @foreach (var col in pivot.Columns) { <th style="text-align:right">@col.Warehouse</th> }
                                <th style="text-align:right; background:#fdb623">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var day in pivot.Days)
                            {
                                <tr>
                                    <td>@day.ToString("MM/dd/yyyy")</td>
                                    <td>@day.DayOfWeek</td>
                                    @foreach (var col in pivot.Columns) { <td style="text-align:right">@pivot.DailyQty[(day, col.Warehouse)].ToString("N0")</td> }
                                    <td style="text-align:right; font-weight:600">@pivot.DailyTotal[day].ToString("N0")</td>
                                </tr>
                            }
                            <tr style="font-weight:700; background:#fff7e0">
                                <td colspan="2">TOTAL Sel @_selectedWeek</td>
                                @foreach (var col in pivot.Columns) { <td style="text-align:right">@pivot.ColumnTotal[col.Warehouse].ToString("N0")</td> }
                                <td style="text-align:right">@pivot.GrandTotal.ToString("N0")</td>
                            </tr>
                            <tr>
                                <td colspan="2">Merch Target</td>
                                @foreach (var col in pivot.Columns) { <td style="text-align:right">@pivot.ColumnMerchTarget[col.Warehouse].ToString("N0")</td> }
                                <td style="text-align:right">@pivot.GrandMerchTarget.ToString("N0")</td>
                            </tr>
                            <tr>
                                <td colspan="2">Variance (Act - M.Tgt)</td>
                                @foreach (var col in pivot.Columns)
                                {
                                    var v = pivot.ColumnVariance[col.Warehouse];
                                    <td style="text-align:right; color:@(v < 0 ? "#dc2626" : "#15803d")">@v.ToString("N0")</td>
                                }
                                <td style="text-align:right; color:@(pivot.GrandVariance < 0 ? "#dc2626" : "#15803d")">@pivot.GrandVariance.ToString("N0")</td>
                            </tr>
                            <tr>
                                <td colspan="2">Variance %</td>
                                @foreach (var col in pivot.Columns)
                                {
                                    var p = pivot.ColumnVariancePct[col.Warehouse];
                                    <td style="text-align:right; color:@(p < 0 ? "#dc2626" : "#15803d")">@p.ToString("N1")%</td>
                                }
                                <td style="text-align:right; color:@(pivot.GrandVariancePct < 0 ? "#dc2626" : "#15803d")">@pivot.GrandVariancePct.ToString("N1")%</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        }
}

@code {
    // "Daily Transfer Qty by Warehouse" — restricted to this one named account, not the
    // general Admin role, since it's still an experimental report. See BuildDtbwPivot() below.
    private bool CanSeeDtbw => string.Equals(CurrentUser.Name, "shabeela.p@bflgroup.ae", StringComparison.OrdinalIgnoreCase);
    private List<WarehouseTransferColumn>   _dtbwColumns    = new();
    private List<DailyWarehouseTransferRow> _dtbwDaily      = new();
    private List<WarehouseMerchNeedRow>     _dtbwMerchNeeds = new();

    private sealed class DtbwPivot
    {
        public List<DateTime> Days = new();
        public List<WarehouseTransferColumn> Columns = new();
        public Dictionary<(DateTime Day, string Warehouse), long> DailyQty = new();
        public Dictionary<DateTime, long> DailyTotal = new();
        public Dictionary<string, long> ColumnTotal = new();
        public Dictionary<string, long> ColumnMerchTarget = new();
        public Dictionary<string, long> ColumnVariance = new();
        public Dictionary<string, double> ColumnVariancePct = new();
        public long GrandTotal;
        public long GrandMerchTarget;
        public long GrandVariance;
        public double GrandVariancePct;
    }

    private DtbwPivot BuildDtbwPivot()
    {
        var p = new DtbwPivot { Columns = _dtbwColumns };
        var weekNum = int.TryParse(_selectedWeek, out var w) ? w : int.Parse(ComputeCurrentWeekNumber());
        var range = Weeks.FirstOrDefault(x => x.Num == weekNum);
        p.Days = Enumerable.Range(0, (range.End - range.Start).Days + 1).Select(i => range.Start.AddDays(i)).ToList();

        foreach (var day in p.Days)
        {
            long dayTotal = 0;
            foreach (var col in p.Columns)
            {
                var qty = _dtbwDaily
                    .Where(d => d.TrnDate.Date == day.Date && string.Equals(d.Warehouse, col.Warehouse, StringComparison.OrdinalIgnoreCase))
                    .Sum(d => d.TransferQty);
                p.DailyQty[(day, col.Warehouse)] = qty;
                dayTotal += qty;
            }
            p.DailyTotal[day] = dayTotal;
        }

        foreach (var col in p.Columns)
        {
            var total  = _dtbwDaily.Where(d => string.Equals(d.Warehouse, col.Warehouse, StringComparison.OrdinalIgnoreCase)).Sum(d => d.TransferQty);
            var target = _dtbwMerchNeeds.Where(m => string.Equals(m.TerritoryCode, col.TerritoryCode, StringComparison.OrdinalIgnoreCase)).Sum(m => m.MerchNeed);
            var variance = total - target;
            p.ColumnTotal[col.Warehouse] = total;
            p.ColumnMerchTarget[col.Warehouse] = target;
            p.ColumnVariance[col.Warehouse] = variance;
            p.ColumnVariancePct[col.Warehouse] = target == 0 ? 0 : (double)variance / target * 100.0;
        }

        p.GrandTotal = p.ColumnTotal.Values.Sum();
        p.GrandMerchTarget = p.ColumnMerchTarget.Values.Sum();
        p.GrandVariance = p.GrandTotal - p.GrandMerchTarget;
        p.GrandVariancePct = p.GrandMerchTarget == 0 ? 0 : (double)p.GrandVariance / p.GrandMerchTarget * 100.0;
        return p;
    }

    private List<string> _countries = new() { "UAE" };
    private HashSet<string> _selectedCountries = new(StringComparer.OrdinalIgnoreCase) { "UAE" };
    // UAE always reads via OnPremBackup (no per-country connection string needed), so it's
    // implicitly "configured" regardless of UAE_DB_ConnectionString. Every other country needs
    // a configured {Country}_DB_ConnectionString or GetProductionCheckingAsync silently returns 0 rows.
    private HashSet<string> _configuredCountries = new(StringComparer.OrdinalIgnoreCase) { "UAE" };
    private string _selectedWeek = ComputeCurrentWeekNumber();
    private DateTime _from = ComputeCurrentWeekRange().Start;
    private DateTime _to   = ComputeCurrentWeekRange().End;
    private string _view = "Summary";
    private bool _pivotCollapsed;
    private bool _loading;
    private string? _loadingMsg;
