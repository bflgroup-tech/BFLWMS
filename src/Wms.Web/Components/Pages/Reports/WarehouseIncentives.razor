@page "/reports/warehouse-incentives"
@rendermode RenderMode.InteractiveServer
@using Wms.Core
@using Wms.Data.Lpm
@using ClosedXML.Excel
@using MudBlazor
@attribute [Authorize(Policy = MenuKeys.RPT_WAREHOUSE_INCENTIVES)]
@inject WarehouseIncentivesService Svc
@inject TechnoPairingService PairingSvc
@inject TechnoBuildingService BuildingSvc
@inject TechnoPricingService PricingSvc
@inject TechnoTeamProductionService TeamProductionSvc
@inject RfidProductionService RfidSvc
@inject JafzaExportCheckingService JafzaCheckingSvc
@inject IJSRuntime JS

<PageTitle>WMS - Warehouse Incentives</PageTitle>

<div class="aiwms-page-header">
    <h2>Warehouse Incentives</h2>
</div>

<div style="display:flex; gap:4px; border-bottom:2px solid var(--border-default); margin:0 0 16px 0; flex-wrap:wrap;">
    @foreach (var t in Tabs)
    {
        var isActive = _activeTab == t;
        <button @onclick="@(() => _activeTab = t)"
                style="@($"padding:10px 18px; border:none; background:none; cursor:pointer; font-size:13px; font-weight:{(isActive ? "700" : "500")}; color:{(isActive ? "var(--bfl-black)" : "var(--text-secondary)")}; border-bottom:3px solid {(isActive ? "var(--bfl-yellow)" : "transparent")}; margin-bottom:-2px;")">
            @t
        </button>
    }
</div>

@if (_activeTab == TechnoTeamProduction)
{
    <div class="aiwms-section">
        <p style="color:var(--text-secondary); margin:0 0 12px 0">TECHNO whole-team pairing/production counts per day, split into AM/PM shift buckets. Pairing from BFLDATA.dbo.RFPairingCount, Production from BFLDATA.dbo.DailyCountCategoryTrf (manual) and DailyCountCategoryTrfRobo (auto). Production-Manual is reported net of Production-Auto for the same shift.</p>
        <div style="display:grid; grid-template-columns: auto auto auto 1fr auto; gap:12px; align-items:end;">
            <div>
                <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">FROM</label>
                <input type="date" @bind="_tpFrom" @bind:format="yyyy-MM-dd" max="@DateTime.Today.ToString("yyyy-MM-dd")" style="padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
            </div>
            <div>
                <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">TO</label>
                <input type="date" @bind="_tpTo" @bind:format="yyyy-MM-dd" max="@DateTime.Today.ToString("yyyy-MM-dd")" style="padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
            </div>
            <div>
                <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">MORNING SHIFT TIMING</label>
                <select value="@_tpShiftTiming" @onchange="@(e => _tpShiftTiming = e.Value?.ToString() ?? _tpShiftTiming)" style="width:100%; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white">
                    @foreach (var s in TechnoTeamProductionService.ShiftTimings)
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>
            <div>
                <label style="display:flex; align-items:center; gap:8px; cursor:pointer; font-size:13px; font-weight:700; color:var(--text-secondary);">
                    <input type="checkbox" checked="@_tpMultiplier" @onchange="@(e => _tpMultiplier = (bool)e.Value!)" />
                    Multiplier?
                </label>
            </div>
            <div style="display:flex; gap:8px">
                <button class="aiwms-btn" style="background:var(--s-live); color:#fff; border-radius:10px;"
                        @onclick="LoadTeamProductionAsync" disabled="@(_tpLoading || _tpFrom > _tpTo)">
                    <span class="mi" style="font-size:16px;">play_arrow</span> @(_tpLoading ? "Loading..." : "Show")
                </button>
                <button class="aiwms-btn" style="background:#fff; color:var(--text-primary); border:1.5px solid var(--border-strong); border-radius:10px;"
                        @onclick="ClearTeamProductionFilters" disabled="@_tpLoading">
                    <span class="mi" style="font-size:16px;">refresh</span> Clear Filters
                </button>
                <button class="aiwms-btn" style="background:#fff; color:var(--s-active); border:1.5px solid var(--s-active); border-radius:10px;"
                        @onclick="ExportTeamProductionExcelAsync" disabled="@(_tpExporting || _tpRows.Count == 0)">
                    <span class="mi" style="font-size:16px;">download</span> @(_tpExporting ? "Exporting..." : "Export Excel")
                </button>
            </div>
        </div>

        <p style="font-size:11px; color:var(--text-secondary); margin-top:8px">
            Date range capped at 366 days. Default range is the last 7 days.
        </p>

        @if (!string.IsNullOrEmpty(_tpMessage))
        {
            <div class="aiwms-alert @(_tpIsError ? "error" : "info")" style="margin-top:12px">@_tpMessage</div>
        }
    </div>

    @if (_tpLoaded)
    {
        <div class="aiwms-section">
            <div class="aiwms-card-header">Techno Team Production - @_tpRows.Count.ToString("N0") day(s)</div>
            <div style="overflow-x:auto">
            <table class="aiwms-table aiwms-table-dense">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th style="text-align:right">Pairing Auto AM</th>
                        <th style="text-align:right">Pairing Auto PM</th>
                        <th style="text-align:right">Pairing Manual</th>
                        <th style="text-align:right">Production Manual AM</th>
                        <th style="text-align:right">Production Manual PM</th>
                        <th style="text-align:right">Production Auto AM</th>
                        <th style="text-align:right">Production Auto PM</th>
                    </tr>
                </thead>
                <tbody>
                    <tr style="font-weight:700; background:var(--surface-1, #f7f7f5);">
                        <td>Total</td>
                        <td style="text-align:right">@_tpRows.Sum(r => r.PairingAutoAMShift).ToString("N0")</td>
                        <td style="text-align:right">@_tpRows.Sum(r => r.PairingAutoPMShift).ToString("N0")</td>
                        <td style="text-align:right">@_tpRows.Sum(r => r.PairingManualAMShift).ToString("N0")</td>
                        <td style="text-align:right">@_tpRows.Sum(r => r.ProductionManualAMShift).ToString("N0")</td>
                        <td style="text-align:right">@_tpRows.Sum(r => r.ProductionManualPMShift).ToString("N0")</td>
                        <td style="text-align:right">@_tpRows.Sum(r => r.ProductionAutoAMShift).ToString("N0")</td>
                        <td style="text-align:right">@_tpRows.Sum(r => r.ProductionAutoPMShift).ToString("N0")</td>
                    </tr>
                    @foreach (var r in _tpRows)
                    {
                        <tr>
                            <td style="white-space:nowrap">@r.TrnDate.ToString("dd-MMM-yyyy")</td>
                            <td style="text-align:right">@r.PairingAutoAMShift.ToString("N0")</td>
                            <td style="text-align:right">@r.PairingAutoPMShift.ToString("N0")</td>
                            <td style="text-align:right">@r.PairingManualAMShift.ToString("N0")</td>
                            <td style="text-align:right">@r.ProductionManualAMShift.ToString("N0")</td>
                            <td style="text-align:right">@r.ProductionManualPMShift.ToString("N0")</td>
                            <td style="text-align:right">@r.ProductionAutoAMShift.ToString("N0")</td>
                            <td style="text-align:right">@r.ProductionAutoPMShift.ToString("N0")</td>
                        </tr>
                    }
                    @if (_tpRows.Count == 0)
                    {
                        <tr><td colspan="8" style="color:var(--text-secondary)">No rows for the selected filters.</td></tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    }
}
else if (_activeTab == TechnoChecking)
{
    <div class="aiwms-section">
        <p style="color:var(--text-secondary); margin:0 0 12px 0">UAE/TECHNO checking counts per employee per day, from USA.dbo.AMEChecking and BFLDATA.dbo.JAFZAChecking. A checking scan between midnight and 05:00 is credited to the previous day. Employee names aren't available (PAYROLL isn't reachable from this app) — EmpCode only.</p>
        <div style="display:grid; grid-template-columns: auto auto 1fr 1fr 1fr auto; gap:12px; align-items:end;">
            <div>
                <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">FROM</label>
                <input type="date" @bind="_from" @bind:format="yyyy-MM-dd" max="@DateTime.Today.ToString("yyyy-MM-dd")" style="padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
            </div>
            <div>
                <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">TO</label>
                <input type="date" @bind="_to" @bind:format="yyyy-MM-dd" max="@DateTime.Today.ToString("yyyy-MM-dd")" style="padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
            </div>
            <div>
                <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">AREA (select any)</label>
                <MudSelect T="string" Dense="true" MultiSelection="true" SelectAll="true" Placeholder="All"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           SelectedValues="_selectedAreas" SelectedValuesChanged="@(v => _selectedAreas = v.ToHashSet())">
                    @foreach (var a in Areas) { <MudSelectItem T="string" Value="@a">@a</MudSelectItem> }
                </MudSelect>
            </div>
            <div>
                <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">DIVISION (select any)</label>
                <MudSelect T="string" Dense="true" MultiSelection="true" SelectAll="true" Placeholder="All"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           SelectedValues="_selectedDivisions" SelectedValuesChanged="@(v => _selectedDivisions = v.ToHashSet())">
                    @foreach (var d in _divisions) { <MudSelectItem T="string" Value="@d">@d</MudSelectItem> }
                </MudSelect>
            </div>
            <div>
                <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">EMP CODE</label>
                <input @bind="_empCode" @bind:event="oninput" placeholder="e.g. RT01" style="width:100%; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
            </div>
            <div style="display:flex; gap:8px">
                <button class="aiwms-btn" style="background:var(--s-live); color:#fff; border-radius:10px;"
                        @onclick="LoadAsync" disabled="@(_loading || _from > _to)">
                    <span class="mi" style="font-size:16px;">play_arrow</span> @(_loading ? "Loading..." : "Load")
                </button>
                <button class="aiwms-btn" style="background:#fff; color:var(--text-primary); border:1.5px solid var(--border-strong); border-radius:10px;"
                        @onclick="ClearFilters" disabled="@_loading">
                    <span class="mi" style="font-size:16px;">refresh</span> Clear Filters
                </button>
                <button class="aiwms-btn" style="background:#fff; color:var(--s-active); border:1.5px solid var(--s-active); border-radius:10px;"
                        @onclick="ExportExcelAsync" disabled="@(_exporting || _rows.Count == 0)">
                    <span class="mi" style="font-size:16px;">download</span> @(_exporting ? "Exporting..." : "Export Excel")
                </button>
            </div>
        </div>

        <p style="font-size:11px; color:var(--text-secondary); margin-top:8px">
            A wider date range takes longer — roughly 10-15s per week of data. Default range is the last 7 days.
        </p>

        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="aiwms-alert @(_isError ? "error" : "info")" style="margin-top:12px">@_message</div>
        }
    </div>

    @if (_loaded)
    {
        <div class="aiwms-section">
            <div class="aiwms-card-header">Techno Checking - @_rows.Count.ToString("N0") row(s)</div>
            <div style="overflow-x:auto">
            <table class="aiwms-table aiwms-table-dense">
                <thead>
                    <tr>
                        <th>Country</th>
                        <th>Warehouse</th>
                        <th>Type</th>
                        <th>Area</th>
                        <th>Date</th>
                        <th>Emp Code</th>
                        <th>Division</th>
                        <th style="text-align:right">Qty</th>
                    </tr>
                </thead>
                <tbody>
                    <tr style="font-weight:700; background:var(--surface-1, #f7f7f5);">
                        <td colspan="7">Total</td>
                        <td style="text-align:right">@_rows.Sum(r => r.Qty).ToString("N0")</td>
                    </tr>
                    @foreach (var r in _rows)
                    {
                        <tr>
                            <td>@r.Country</td>
                            <td>@r.Warehouse</td>
                            <td>@r.Type</td>
                            <td>@r.Area</td>
                            <td style="white-space:nowrap">@r.TrnDate.ToString("dd-MMM-yyyy")</td>
                            <td style="font-family:var(--font-mono)">@r.EmpCode</td>
                            <td style="word-break:break-word">@r.Division</td>
                            <td style="text-align:right">@r.Qty.ToString("N0")</td>
                        </tr>
                    }
                    @if (_rows.Count == 0)
                    {
                        <tr><td colspan="8" style="color:var(--text-secondary)">No rows for the selected filters.</td></tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    }
}
else if (_activeTab == TechnoPairing)
{
    <div class="aiwms-section">
        <p style="color:var(--text-secondary); margin:0 0 12px 0">TECHNO pairing counts per employee per day — MANUAL from BFLDATA.dbo.RFPairDetail, AUTO from the TECHNO robotics server's BFLDATA.dbo.RFPairDetail + robotics.dbo.PairDetail. A pairing scan between midnight and 05:00 is credited to the previous day. Employee names aren't available (FABSMAIN isn't reachable from this app) — EmpCode only.</p>
        <div style="display:grid; grid-template-columns: auto auto 1fr 1fr 1fr auto; gap:12px; align-items:end;">
            <div>
                <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">FROM</label>
                <input type="date" @bind="_pFrom" @bind:format="yyyy-MM-dd" max="@DateTime.Today.ToString("yyyy-MM-dd")" style="padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
            </div>
            <div>
                <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">TO</label>
                <input type="date" @bind="_pTo" @bind:format="yyyy-MM-dd" max="@DateTime.Today.ToString("yyyy-MM-dd")" style="padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
            </div>
            <div>
                <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">AREA (select any)</label>
                <MudSelect T="string" Dense="true" MultiSelection="true" SelectAll="true" Placeholder="All"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           SelectedValues="_pSelectedAreas" SelectedValuesChanged="@(v => _pSelectedAreas = v.ToHashSet())">
                    @foreach (var a in Areas) { <MudSelectItem T="string" Value="@a">@a</MudSelectItem> }
                </MudSelect>
            </div>
            <div>
                <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">DIVISION (select any)</label>
                <MudSelect T="string" Dense="true" MultiSelection="true" SelectAll="true" Placeholder="All"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           SelectedValues="_pSelectedDivisions" SelectedValuesChanged="@(v => _pSelectedDivisions = v.ToHashSet())">
                    @foreach (var d in _pDivisions) { <MudSelectItem T="string" Value="@d">@d</MudSelectItem> }
                </MudSelect>
            </div>
            <div>
                <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">EMP CODE</label>
                <input @bind="_pEmpCode" @bind:event="oninput" placeholder="e.g. RT01" style="width:100%; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
            </div>
            <div style="display:flex; gap:8px">
                <button class="aiwms-btn" style="background:var(--s-live); color:#fff; border-radius:10px;"
                        @onclick="LoadPairingAsync" disabled="@(_pLoading || _pFrom > _pTo)">
                    <span class="mi" style="font-size:16px;">play_arrow</span> @(_pLoading ? "Loading..." : "Load")
                </button>
                <button class="aiwms-btn" style="background:#fff; color:var(--text-primary); border:1.5px solid var(--border-strong); border-radius:10px;"
                        @onclick="ClearPairingFilters" disabled="@_pLoading">
                    <span class="mi" style="font-size:16px;">refresh</span> Clear Filters
                </button>
                <button class="aiwms-btn" style="background:#fff; color:var(--s-active); border:1.5px solid var(--s-active); border-radius:10px;"
                        @onclick="ExportPairingExcelAsync" disabled="@(_pExporting || _pRows.Count == 0)">
                    <span class="mi" style="font-size:16px;">download</span> @(_pExporting ? "Exporting..." : "Export Excel")
                </button>
            </div>
        </div>

        <p style="font-size:11px; color:var(--text-secondary); margin-top:8px">
            AUTO reads from a separate robotics server — a wider date range can take a while. Default range is the last 7 days.
        </p>

        @if (!string.IsNullOrEmpty(_pMessage))
        {
            <div class="aiwms-alert @(_pIsError ? "error" : "info")" style="margin-top:12px">@_pMessage</div>
        }
    </div>

    @if (_pLoaded)
    {
        <div class="aiwms-section">
            <div class="aiwms-card-header">Techno Pairing - @_pRows.Count.ToString("N0") row(s)</div>
            <div style="overflow-x:auto">
            <table class="aiwms-table aiwms-table-dense">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Area</th>
                        <th>Date</th>
                        <th>Emp Code</th>
                        <th>Group</th>
                        <th>Division</th>
                        <th style="text-align:right">Qty</th>
                    </tr>
                </thead>
                <tbody>
                    <tr style="font-weight:700; background:var(--surface-1, #f7f7f5);">
                        <td colspan="6">Total</td>
                        <td style="text-align:right">@_pRows.Sum(r => r.Qty).ToString("N0")</td>
                    </tr>
                    @foreach (var r in _pRows)
                    {
                        <tr>
                            <td>@r.Type</td>
                            <td>@r.Area</td>
                            <td style="white-space:nowrap">@r.TrnDate.ToString("dd-MMM-yyyy")</td>
                            <td style="font-family:var(--font-mono)">@r.EmpCode</td>
                            <td style="word-break:break-word">@r.GroupName</td>
                            <td style="word-break:break-word">@r.Division</td>
                            <td style="text-align:right">@r.Qty.ToString("N0")</td>
                        </tr>
                    }
                    @if (_pRows.Count == 0)
                    {
                        <tr><td colspan="7" style="color:var(--text-secondary)">No rows for the selected filters.</td></tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    }
}
else if (_activeTab == TechnoBuilding)
{
    <div class="aiwms-section">
        <p style="color:var(--text-secondary); margin:0 0 12px 0">TECHNO building counts per employee per day, from ONLINE.dbo.RFPairingCountPhotoCheckBuild. A building scan between 18:00 and 23:59 is credited to the day the shift started. Employee names aren't available (PAYROLL isn't reachable from this app) — EmpCode only.</p>
        <div style="display:grid; grid-template-columns: auto auto 1fr 1fr auto; gap:12px; align-items:end;">
            <div>
                <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">FROM</label>
                <input type="date" @bind="_bFrom" @bind:format="yyyy-MM-dd" max="@DateTime.Today.ToString("yyyy-MM-dd")" style="padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
            </div>
            <div>
                <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">TO</label>
                <input type="date" @bind="_bTo" @bind:format="yyyy-MM-dd" max="@DateTime.Today.ToString("yyyy-MM-dd")" style="padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
            </div>
            <div>
                <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">AREA (select any)</label>
                <MudSelect T="string" Dense="true" MultiSelection="true" SelectAll="true" Placeholder="All"
                           Variant="Variant.Outlined" Margin="Margin.Dense"
                           SelectedValues="_bSelectedAreas" SelectedValuesChanged="@(v => _bSelectedAreas = v.ToHashSet())">
                    @foreach (var a in Areas) { <MudSelectItem T="string" Value="@a">@a</MudSelectItem> }
                </MudSelect>
            </div>
            <div>
                <label style="display:block; font-size:11px; font-weight:700; color:var(--text-secondary); margin-bottom:4px;">EMP CODE</label>
                <input @bind="_bEmpCode" @bind:event="oninput" placeholder="e.g. RT01" style="width:100%; padding:8px 10px; border:1px solid var(--border-default); border-radius:var(--r-sm); font-size:13px; background:white;" />
            </div>
            <div style="display:flex; gap:8px">
                <button class="aiwms-btn" style="background:var(--s-live); color:#fff; border-radius:10px;"
                        @onclick="LoadBuildingAsync" disabled="@(_bLoading || _bFrom > _bTo)">
                    <span class="mi" style="font-size:16px;">play_arrow</span> @(_bLoading ? "Loading..." : "Load")
                </button>
                <button class="aiwms-btn" style="background:#fff; color:var(--text-primary); border:1.5px solid var(--border-strong); border-radius:10px;"
                        @onclick="ClearBuildingFilters" disabled="@_bLoading">
                    <span class="mi" style="font-size:16px;">refresh</span> Clear Filters
                </button>
                <button class="aiwms-btn" style="background:#fff; color:var(--s-active); border:1.5px solid var(--s-active); border-radius:10px;"
                        @onclick="ExportBuildingExcelAsync" disabled="@(_bExporting || _bRows.Count == 0)">
                    <span class="mi" style="font-size:16px;">download</span> @(_bExporting ? "Exporting..." : "Export Excel")
                </button>
            </div>
        </div>

        <p style="font-size:11px; color:var(--text-secondary); margin-top:8px">
            Default range is the last 7 days.
        </p>

        @if (!string.IsNullOrEmpty(_bMessage))
        {
            <div class="aiwms-alert @(_bIsError ? "error" : "info")" style="margin-top:12px">@_bMessage</div>
        }
    </div>

    @if (_bLoaded)
    {
        <div class="aiwms-section">
            <div class="aiwms-card-header">Techno Building - @_bRows.Count.ToString("N0") row(s)</div>
            <div style="overflow-x:auto">
            <table class="aiwms-table aiwms-table-dense">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Area</th>
                        <th>Date</th>
                        <th>Emp Code</th>
                        <th style="text-align:right">Qty</th>
                    </tr>
                </thead>
                <tbody>
