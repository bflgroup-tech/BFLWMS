@using Wms.Core
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthProvider
@inject IAuthorizationService AuthService
@inject NavigationManager Nav

<nav class="aiwms-nav">
    <NavLink class="aiwms-nav-link" ActiveClass="active" href="" Match="NavLinkMatch.All">
        <span class="aiwms-nav-icon">home</span>
        <span>Home</span>
    </NavLink>

    @{
        // Section header only renders if at least one menu inside is visible.
        var grouped = MenuKeys.All
            .Where(m => _visible.Contains(m.Key))
            .GroupBy(m => m.Group)
            .ToList();
    }
    @foreach (var grp in grouped)
    {
        var isExpanded = _expandedGroups.Contains(grp.Key);
        <div class="aiwms-nav-section" style="cursor:pointer;display:flex;align-items:center;gap:6px"
             @onclick="@(() => ToggleGroup(grp.Key))">
            <span style="font-size:13px">@(isExpanded ? "−" : "+")</span>
            <span>@grp.Key</span>
        </div>
        @if (isExpanded)
        {
            @foreach (var cat in grp.GroupBy(m => m.Category))
            {
                var subKey = cat.Key is null ? null : $"{grp.Key}::{cat.Key}";
                var isSubExpanded = subKey is null || _expandedGroups.Contains(subKey);
                @if (cat.Key is not null)
                {
                    <div class="aiwms-nav-subsection" style="cursor:pointer;display:flex;align-items:center;gap:6px;color:var(--bfl-yellow)"
                         @onclick="@(() => ToggleGroup(subKey!))">
                        <span style="font-size:13px">@(isSubExpanded ? "−" : "+")</span>
                        <span>@cat.Key</span>
                    </div>
                }
                @if (isSubExpanded)
                {
                    @foreach (var menu in cat)
                    {
                        <NavLink class="@(cat.Key is not null ? "aiwms-nav-link aiwms-nav-link-indent" : "aiwms-nav-link")" ActiveClass="active" href="@menu.Url">
                            <span class="aiwms-nav-icon">@IconFor(menu.Key)</span>
                            <span>@menu.Label</span>
                        </NavLink>
                    }
                }
            }
        }
    }
</nav>

@code {
    private HashSet<string> _visible = new();
    private HashSet<string> _expandedGroups = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        foreach (var menu in MenuKeys.All)
        {
            var result = await AuthService.AuthorizeAsync(user, null, menu.Key);
            if (result.Succeeded) _visible.Add(menu.Key);
        }

        // Expand whichever group (and subsection, if any) contains the current page so
        // navigating straight to a link (bookmark, refresh) doesn't leave the active item
        // hidden in a collapsed section.
        var currentPath = new Uri(Nav.Uri).AbsolutePath.Trim('/');
        var activeMenu = MenuKeys.All
            .FirstOrDefault(m => string.Equals(m.Url.Trim('/'), currentPath, StringComparison.OrdinalIgnoreCase));
        if (activeMenu is not null)
        {
            _expandedGroups.Add(activeMenu.Group);
            if (activeMenu.Category is not null) _expandedGroups.Add($"{activeMenu.Group}::{activeMenu.Category}");
        }
    }

    private void ToggleGroup(string group)
    {
        if (!_expandedGroups.Remove(group)) _expandedGroups.Add(group);
    }

    private static string IconFor(string key) => key switch
    {
        MenuKeys.LPM_MANUAL_BUILDING       => "inventory_2",
        MenuKeys.CONTAINER_ALLOCATION      => "assignment_turned_in",
        MenuKeys.OTS_FOR_PO_ALLOCATION     => "calculate",
        MenuKeys.MANUAL_ALLOCATION_UPLOAD  => "upload_file",
        MenuKeys.OPEN_CONTAINER            => "lock_open",
        MenuKeys.ROBOTIC_CHUTE_MAPPING     => "grid_view",
        MenuKeys.ROBOTIC_CHUTE_MAPPING_TECHNO => "grid_view",
        MenuKeys.DATASYNC_CONTAINER_ALLOCATION => "sync_alt",
        MenuKeys.DATASYNC_MASTER           => "storage",
        MenuKeys.DATASYNC_BOXES_TO_WMSPROD => "publish",
        MenuKeys.ITEM_ENCODING             => "sell",
        MenuKeys.LPM_PRODUCTION            => "local_shipping",
        MenuKeys.RPT_MISSING_EXCESS        => "assessment",
        MenuKeys.RPT_NON_LPM_WH_STOCK      => "inventory_2",
        MenuKeys.RPT_LPM_WH_STOCK          => "inventory",
        MenuKeys.RPT_PRODUCTION_SUMMARY    => "qr_code_scanner",
        MenuKeys.RPT_WAREHOUSE_BOXES       => "warehouse",
        MenuKeys.RPT_TRANSFER_GIN_GRN      => "swap_horiz",
        MenuKeys.RPT_COUNTING_COMPLETION   => "checklist",
        MenuKeys.RPT_JAFZA_DIVISION_PROD   => "precision_manufacturing",
        MenuKeys.RPT_SHIPMENT_STATUS        => "route",
        MenuKeys.RPT_WAREHOUSE_SON_SUMMARY  => "summarize",
        MenuKeys.ADMIN_USERS               => "group",
        MenuKeys.ADMIN_WH_MASTER           => "apartment",
        MenuKeys.ADMIN_AUDIT_LOG           => "history",
        MenuKeys.ADMIN_NIGHTLY_BATCHES     => "schedule",
        _ => "circle",
    };
}
